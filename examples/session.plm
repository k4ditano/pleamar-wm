            }
            zone box dmpin.3 { at: (dk.x0.3 + 14 + max(dmenu.3, 0) * 60 + 30), mn.y.3 - if(pick(max(dmenu.3, 0), win.dock.3.0.windows, win.dock.3.1.windows, win.dock.3.2.windows, win.dock.3.3.windows, win.dock.3.4.windows, win.dock.3.5.windows, win.dock.3.6.windows, win.dock.3.7.windows, win.dock.3.8.windows, win.dock.3.9.windows, win.dock.3.10.windows, win.dock.3.11.windows) > 0, 34, 0); size: 160, 30; corner: 9; cursor: pointer; active: dmenu.3 >= 0 }
            box { at: (dk.x0.3 + 14 + max(dmenu.3, 0) * 60 + 30), mn.y.3 - if(pick(max(dmenu.3, 0), win.dock.3.0.windows, win.dock.3.1.windows, win.dock.3.2.windows, win.dock.3.3.windows, win.dock.3.4.windows, win.dock.3.5.windows, win.dock.3.6.windows, win.dock.3.7.windows, win.dock.3.8.windows, win.dock.3.9.windows, win.dock.3.10.windows, win.dock.3.11.windows) > 0, 34, 0); size: 160, 28; corner: 9; color: ink; opacity: 8% * dmpin.3.hover }
            text "Take off the shore" { at: (dk.x0.3 + 14 + max(dmenu.3, 0) * 60 + 30) - 68, mn.y.3 - if(pick(max(dmenu.3, 0), win.dock.3.0.windows, win.dock.3.1.windows, win.dock.3.2.windows, win.dock.3.3.windows, win.dock.3.4.windows, win.dock.3.5.windows, win.dock.3.6.windows, win.dock.3.7.windows, win.dock.3.8.windows, win.dock.3.9.windows, win.dock.3.10.windows, win.dock.3.11.windows) > 0, 34, 0); anchor: left center; size: 12; weight: 500; color: ink; show: pick(max(dmenu.3, 0), win.dock.3.0.pinned, win.dock.3.1.pinned, win.dock.3.2.pinned, win.dock.3.3.pinned, win.dock.3.4.pinned, win.dock.3.5.pinned, win.dock.3.6.pinned, win.dock.3.7.pinned, win.dock.3.8.pinned, win.dock.3.9.pinned, win.dock.3.10.pinned, win.dock.3.11.pinned) > 0.5 }
            text "Keep on the shore" { at: (dk.x0.3 + 14 + max(dmenu.3, 0) * 60 + 30) - 68, mn.y.3 - if(pick(max(dmenu.3, 0), win.dock.3.0.windows, win.dock.3.1.windows, win.dock.3.2.windows, win.dock.3.3.windows, win.dock.3.4.windows, win.dock.3.5.windows, win.dock.3.6.windows, win.dock.3.7.windows, win.dock.3.8.windows, win.dock.3.9.windows, win.dock.3.10.windows, win.dock.3.11.windows) > 0, 34, 0); anchor: left center; size: 12; weight: 500; color: ink; show: pick(max(dmenu.3, 0), win.dock.3.0.pinned, win.dock.3.1.pinned, win.dock.3.2.pinned, win.dock.3.3.pinned, win.dock.3.4.pinned, win.dock.3.5.pinned, win.dock.3.6.pinned, win.dock.3.7.pinned, win.dock.3.8.pinned, win.dock.3.9.pinned, win.dock.3.10.pinned, win.dock.3.11.pinned) < 0.5 }
            group {
                show: pick(max(dmenu.3, 0), win.dock.3.0.windows, win.dock.3.1.windows, win.dock.3.2.windows, win.dock.3.3.windows, win.dock.3.4.windows, win.dock.3.5.windows, win.dock.3.6.windows, win.dock.3.7.windows, win.dock.3.8.windows, win.dock.3.9.windows, win.dock.3.10.windows, win.dock.3.11.windows) > 0
