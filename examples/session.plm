        // Between the programs and what is put away, and before the pools: a line of water.
        box { at: dk.x0.1 + 14 + dk.n.1 * 60 + 10, dk.cy.1; size: 1, 30; color: ink; opacity: 18%; show: dk.m.1 > 0 }
        box { at: dk.px.1 - 10, dk.cy.1; size: 1, 30; color: ink; opacity: 18% }
        ellipse { at: (dk.px.1 + 0 * 26 + 13), dk.cy.1; radius: 8; stroke: 1.3; color: ink; opacity: if(1 == dk.p.1 and win.used.1 < 1, 22%, 45%); show: 0 < dk.p.1 and win.shown.1 != 1 }
        ellipse { at: (dk.px.1 + 0 * 26 + 13), dk.cy.1; radius: 8; color: mint; opacity: 90%; show: 0 < dk.p.1 and win.shown.1 == 1 }
        text "1" { at: (dk.px.1 + 0 * 26 + 13), dk.cy.1; anchor: center; size: 9; weight: 700; color: #0c0e10; show: 0 < dk.p.1 and win.shown.1 == 1 }
        zone ellipse dkpool.0.1 { at: (dk.px.1 + 0 * 26 + 13), dk.cy.1; radius: 12; cursor: pointer; active: shore.1 > 0.6 and 0 < dk.p.1 and not overview; label: "Workspace 1" }
