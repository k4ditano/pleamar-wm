    on press dmpin.0 while dmenu.0 == 0 and win.dock.0.0.pinned > 0.5 {
        dock 0 on 0 unpin
        dmenu.0 = -1
    }
    on press dmpin.0 while dmenu.0 == 0 and win.dock.0.0.pinned < 0.5 {
        dock 0 on 0 pin
        dmenu.0 = -1
