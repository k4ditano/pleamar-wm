            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 3 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 4 == pc.n.0 and win.used.0 < 4 }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 3 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 4 == pc.n.0 and win.used.0 < 4 }
            text "4" { at: pc.x.0 - 12, (pc.y.0 + 3 * (pc.h.0 + 20)) + pc.h.0 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(4 == win.shown.0, 85%, 40%) }
            zone box pcard.3.0 { from: pc.x.0, (pc.y.0 + 3 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10; cursor: pointer; active: overview and not sharing and 3 < pc.n.0; label: "Workspace 4"; role: item }
        }
        group {
            show: 4 < pc.n.0
            opacity: smooth(0.20, 0.75, ov) * if(pdrag.s == 0 and pdrag.k == 4, 40%, 100%)
            move: 70 * (1 - smooth(0.20, 0.75, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.4.0.hover, (overview and drop.ok and mon == 0 and drop.k == 5 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.4.0.hover, 28, 45%
                box { from: pc.x.0, (pc.y.0 + 4 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10 }
            }
            box { from: pc.x.0 - 3, (pc.y.0 + 4 * (pc.h.0 + 20)) - 3; size: pc.w.0 + 6, pc.h.0 + 6; corner: 13; stroke: 1.6; color: mint; opacity: if(5 == win.shown.0, 85%, 0%) + 60% * (overview and drop.ok and mon == 0 and drop.k == 5 and (ovdrag >= 0 or pdrag.s >= 0)) }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 4 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 5 == pc.n.0 and win.used.0 < 5 }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 4 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 5 == pc.n.0 and win.used.0 < 5 }
            text "5" { at: pc.x.0 - 12, (pc.y.0 + 4 * (pc.h.0 + 20)) + pc.h.0 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(5 == win.shown.0, 85%, 40%) }
            zone box pcard.4.0 { from: pc.x.0, (pc.y.0 + 4 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10; cursor: pointer; active: overview and not sharing and 4 < pc.n.0; label: "Workspace 5"; role: item }
        }
        group {
            show: 5 < pc.n.0
            opacity: smooth(0.25, 0.80, ov) * if(pdrag.s == 0 and pdrag.k == 5, 40%, 100%)
            move: 70 * (1 - smooth(0.25, 0.80, ov)), 0
            body {
