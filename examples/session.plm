            image dockicon.3.0 { at: mouse.x - 24, mouse.y - 24; size: 48, 48; show: dkdrag.3 == 0 }
            image dockicon.3.1 { at: mouse.x - 24, mouse.y - 24; size: 48, 48; show: dkdrag.3 == 1 }
