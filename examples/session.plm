    on press dkpool.0.3 { workspace 1 on 3 }
    on press dkpool.1.3 { workspace 2 on 3 }
    on press dkpool.2.3 { workspace 3 on 3 }
    on press dkpool.3.3 { workspace 4 on 3 }
    on press dkpool.4.3 { workspace 5 on 3 }
    on press dkpool.5.3 { workspace 6 on 3 }
    on press dkpool.6.3 { workspace 7 on 3 }
    on press dkpool.7.3 { workspace 8 on 3 }

    // Monitor 0's shore: the item being carried out of it, the one whose
    // windows rise from the water, the one whose menu is open.
    fact dkdrag.0 = -1
    fact pv.0 = -1
    fact dmenu.0 = -1
    fact poofx.0 = 0
    fact poofy.0 = 0
    prop poof.0 = 1 ~700ms
    prop pvup.0 = 0 ~pop
    follow pvup.0 = if(pv.0 >= 0, 1, 0)
    prop mnup.0 = 0 ~pop
    follow mnup.0 = if(dmenu.0 >= 0, 1, 0)
    let dk.hk.0 = clamp(floor(dk.t.0 + 0.5), 0, 11)
    // The previews: as wide as there are windows of that item, over its icon.
    let pv.n.0 = pick(max(pv.0, 0), win.dock.0.0.windows, win.dock.0.1.windows, win.dock.0.2.windows, win.dock.0.3.windows, win.dock.0.4.windows, win.dock.0.5.windows, win.dock.0.6.windows, win.dock.0.7.windows, win.dock.0.8.windows, win.dock.0.9.windows, win.dock.0.10.windows, win.dock.0.11.windows)
    let pv.cx.0 = clamp(dk.x0.0 + 14 + max(pv.0, 0) * 60 + 30, pv.n.0 * 116 + 20, screen.0.width - pv.n.0 * 116 - 20)
    let pv.top.0 = dk.cy.0 - 48 - 170
    // Away from the shore and from its previews or its menu, they sink.
    let pv.near.0 = mon == 0 and mouse.y >= pv.top.0 - 24 and mouse.x >= min(dk.x0.0, pv.cx.0 - pv.n.0 * 116 - 24) and mouse.x <= max(dk.x0.0 + dkw.0, pv.cx.0 + pv.n.0 * 116 + 24)
    on change pv.near.0 while not pv.near.0 {
        pv.0 = -1
        dmenu.0 = -1
    }
    on key Escape while dmenu.0 >= 0 or pv.0 >= 0 {
        dmenu.0 = -1
        pv.0 = -1
    }
    group {
        z: 99984
        show: shore.0 > 0.01 and screen.index == 0
        measure tip.0.0
        group {
            show: dk.on.0 and dk.hk.0 == 0 and 0 < dk.n.0 and pv.0 < 0 and dmenu.0 < 0 and dkdrag.0 < 0
            body {
                color: #0c0e10
                rim: 12%
                shadow: 0, 6, 16, 40%
                box { at: (dk.x0.0 + 14 + 0 * 60 + 30), dk.cy.0 - 66 - 12 * buoy.0.0; size: tip.0.0.width + 22, 26; corner: 13 }
            }
            text win.dock.0.0.name { at: (dk.x0.0 + 14 + 0 * 60 + 30), dk.cy.0 - 66 - 12 * buoy.0.0; anchor: center; size: 12; weight: 600; color: ink; measure: tip.0.0; lines: 1 }
        }
        // Unread, a drop of coral on its corner.
        group {
            show: win.dock.0.0.badge > 0 and 0 < dk.n.0
            body {
                color: #ef7a66
                rim: 20%
                shadow: 0, 2, 5, 40%
                ellipse { at: (dk.x0.0 + 14 + 0 * 60 + 30) + 17, dk.cy.0 - 20 - 12 * buoy.0.0; radius: 8.5 }
            }
            text "{win.dock.0.0.badge, 0}" { at: (dk.x0.0 + 14 + 0 * 60 + 30) + 17, dk.cy.0 - 20 - 12 * buoy.0.0; anchor: center; size: 10; weight: 700; color: #1a0c09 }
        }
        measure tip.0.1
        group {
            show: dk.on.0 and dk.hk.0 == 1 and 1 < dk.n.0 and pv.0 < 0 and dmenu.0 < 0 and dkdrag.0 < 0
            body {
                color: #0c0e10
                rim: 12%
                shadow: 0, 6, 16, 40%
                box { at: (dk.x0.0 + 14 + 1 * 60 + 30), dk.cy.0 - 66 - 12 * buoy.0.1; size: tip.0.1.width + 22, 26; corner: 13 }
            }
            text win.dock.0.1.name { at: (dk.x0.0 + 14 + 1 * 60 + 30), dk.cy.0 - 66 - 12 * buoy.0.1; anchor: center; size: 12; weight: 600; color: ink; measure: tip.0.1; lines: 1 }
        }
        // Unread, a drop of coral on its corner.
        group {
            show: win.dock.0.1.badge > 0 and 1 < dk.n.0
            body {
                color: #ef7a66
                rim: 20%
                shadow: 0, 2, 5, 40%
                ellipse { at: (dk.x0.0 + 14 + 1 * 60 + 30) + 17, dk.cy.0 - 20 - 12 * buoy.0.1; radius: 8.5 }
            }
            text "{win.dock.0.1.badge, 0}" { at: (dk.x0.0 + 14 + 1 * 60 + 30) + 17, dk.cy.0 - 20 - 12 * buoy.0.1; anchor: center; size: 10; weight: 700; color: #1a0c09 }
        }
        measure tip.0.2
        group {
            show: dk.on.0 and dk.hk.0 == 2 and 2 < dk.n.0 and pv.0 < 0 and dmenu.0 < 0 and dkdrag.0 < 0
            body {
                color: #0c0e10
                rim: 12%
                shadow: 0, 6, 16, 40%
