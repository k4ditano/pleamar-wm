            zone box pcard.9.3 { from: pc.x.3, (pc.y.3 + 9 * (pc.h.3 + 20)); size: pc.w.3, pc.h.3; corner: 10; cursor: pointer; active: overview and not sharing and 9 < pc.n.3; label: "Workspace 10"; role: item }
        }
    }
    on drag pcard.0.3 while pdrag.s < 0 {
        pdrag.s = 3
        pdrag.k = 0
    }
    on release pcard.0.3 while pdrag.s < 0 {
        workspace 1 on 3
        overview = false
    }
    on release pcard.0.3 while pdrag.s == 3 and mon != 3 and 0 < win.used.3 { send workspace 1 on 3 to mon }
    on release pcard.0.3 { pdrag.s = -1 }
    on drag pcard.1.3 while pdrag.s < 0 {
        pdrag.s = 3
        pdrag.k = 1
    }
    on release pcard.1.3 while pdrag.s < 0 {
        workspace 2 on 3
        overview = false
