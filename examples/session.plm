        z: 99984
        show: shore.3 > 0.01 and screen.index == 3
        measure tip.3.0
        group {
            show: dk.on.3 and dk.hk.3 == 0 and 0 < dk.n.3 and pv.3 < 0 and dmenu.3 < 0 and dkdrag.3 < 0
