            text "3" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp2.$s), if(dkvert, dkp2.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); anchor: center; size: 9; weight: 700; color: #0c0e10; show: 2 < dk.p.$s and win.shown.$s == 3 }
            zone ellipse dkpool.2.$s { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp2.$s), if(dkvert, dkp2.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 12; cursor: pointer; active: shore.$s > 0.6 and 2 < dk.p.$s and not overview; label: "Workspace 3" }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp3.$s), if(dkvert, dkp3.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; stroke: 1.3; color: ink; opacity: if(4 == dk.p.$s and win.used.$s < 4, 22%, 45%); show: 3 < dk.p.$s and win.shown.$s != 4 }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp3.$s), if(dkvert, dkp3.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; color: mint; opacity: 90%; show: 3 < dk.p.$s and win.shown.$s == 4 }
            text "4" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp3.$s), if(dkvert, dkp3.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); anchor: center; size: 9; weight: 700; color: #0c0e10; show: 3 < dk.p.$s and win.shown.$s == 4 }
            zone ellipse dkpool.3.$s { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp3.$s), if(dkvert, dkp3.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 12; cursor: pointer; active: shore.$s > 0.6 and 3 < dk.p.$s and not overview; label: "Workspace 4" }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp4.$s), if(dkvert, dkp4.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; stroke: 1.3; color: ink; opacity: if(5 == dk.p.$s and win.used.$s < 5, 22%, 45%); show: 4 < dk.p.$s and win.shown.$s != 5 }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp4.$s), if(dkvert, dkp4.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; color: mint; opacity: 90%; show: 4 < dk.p.$s and win.shown.$s == 5 }
            text "5" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp4.$s), if(dkvert, dkp4.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); anchor: center; size: 9; weight: 700; color: #0c0e10; show: 4 < dk.p.$s and win.shown.$s == 5 }
            zone ellipse dkpool.4.$s { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp4.$s), if(dkvert, dkp4.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 12; cursor: pointer; active: shore.$s > 0.6 and 4 < dk.p.$s and not overview; label: "Workspace 5" }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp5.$s), if(dkvert, dkp5.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; stroke: 1.3; color: ink; opacity: if(6 == dk.p.$s and win.used.$s < 6, 22%, 45%); show: 5 < dk.p.$s and win.shown.$s != 6 }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp5.$s), if(dkvert, dkp5.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; color: mint; opacity: 90%; show: 5 < dk.p.$s and win.shown.$s == 6 }
            text "6" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp5.$s), if(dkvert, dkp5.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); anchor: center; size: 9; weight: 700; color: #0c0e10; show: 5 < dk.p.$s and win.shown.$s == 6 }
            zone ellipse dkpool.5.$s { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp5.$s), if(dkvert, dkp5.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 12; cursor: pointer; active: shore.$s > 0.6 and 5 < dk.p.$s and not overview; label: "Workspace 6" }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp6.$s), if(dkvert, dkp6.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; stroke: 1.3; color: ink; opacity: if(7 == dk.p.$s and win.used.$s < 7, 22%, 45%); show: 6 < dk.p.$s and win.shown.$s != 7 }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp6.$s), if(dkvert, dkp6.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; color: mint; opacity: 90%; show: 6 < dk.p.$s and win.shown.$s == 7 }
            text "7" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp6.$s), if(dkvert, dkp6.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); anchor: center; size: 9; weight: 700; color: #0c0e10; show: 6 < dk.p.$s and win.shown.$s == 7 }
            zone ellipse dkpool.6.$s { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp6.$s), if(dkvert, dkp6.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 12; cursor: pointer; active: shore.$s > 0.6 and 6 < dk.p.$s and not overview; label: "Workspace 7" }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp7.$s), if(dkvert, dkp7.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; stroke: 1.3; color: ink; opacity: if(8 == dk.p.$s and win.used.$s < 8, 22%, 45%); show: 7 < dk.p.$s and win.shown.$s != 8 }
            ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp7.$s), if(dkvert, dkp7.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 8; color: mint; opacity: 90%; show: 7 < dk.p.$s and win.shown.$s == 8 }
            text "8" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp7.$s), if(dkvert, dkp7.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); anchor: center; size: 9; weight: 700; color: #0c0e10; show: 7 < dk.p.$s and win.shown.$s == 8 }
            zone ellipse dkpool.7.$s { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), dkp7.$s), if(dkvert, dkp7.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s)); radius: 12; cursor: pointer; active: shore.$s > 0.6 and 7 < dk.p.$s and not overview; label: "Workspace 8" }
        }
        // Dragged, its icon goes out of the shore (far enough, unpinned, it
        // bursts into drops); only past a few pixels: a real mouse moves one
        // between press and release, and the click that opens the program was
        // taken for a drag. Pressed with nothing open, it hops while its program
        // starts (three times at most, until a window comes).
        repeat j in 0..12 {
            on press dockz.$j.$s { impulse buoy.$s.$j -9 }
            on drag dockz.$j.$s while dkdrag.$s < 0 and (abs(drag.dx) > 6 or abs(drag.dy) > 6) {
                dkdrag.$s = j
                pv.$s = -1
            }
            on release dockz.$j.$s while dkdrag.$s < 0 {
                dock j on s
                pv.$s = -1
                ring.$s.$j: 0 ~0ms
                ring.$s.$j: 1 ~760ms after 16ms
            }
            on release dockz.$j.$s while dkdrag.$s < 0 and win.dock.$s.$j.windows == 0 {
                hops.$s.$j = 3
                hop.$s.$j: 1 ~0ms
            }
            on change hop.$s.$j while hop.$s.$j < 0.02 and hops.$s.$j > 1 and win.dock.$s.$j.windows == 0 {
                hops.$s.$j = hops.$s.$j - 1
                hop.$s.$j: 1 ~0ms
            }
            on release dockz.$j.$s while dkdrag.$s == j and dk.mq.$s > dk.q.$s + dkpl / 2 + 78 and win.dock.$s.$j.pinned > 0.5 {
                dock j on s unpin
                poofx.$s = mouse.x
                poofy.$s = mouse.y
                poof.$s: 0 ~0ms
                poof.$s: 1 ~700ms after 16ms
            }
            on release dockz.$j.$s { dkdrag.$s = -1 }
            on drop dockz.$j.$s {
                dock j on s with drop
                ring.$s.$j: 0 ~0ms
                ring.$s.$j: 1 ~760ms after 16ms
            }
            on press right dockz.$j.$s {
                dmenu.$s = j
                dmk.$s = j
                pv.$s = -1
            }
            on hover dockz.$j.$s for 450ms while dkdrag.$s < 0 and dmenu.$s < 0 and win.dock.$s.$j.windows > 0 { pv.$s = j }
        }
        repeat j in 0..8 {
            on press dkpool.$j.$s { workspace (j + 1) on s }
        }
        // Its previews, as many as it has windows: over its icon at the bottom,
        // beside it on a side (window.plm's per window: pv.bx + pv.sx · turn).
        pv.n[s] = pick(max(pv.$s, 0), win.dock.$s.0.windows, win.dock.$s.1.windows, win.dock.$s.2.windows, win.dock.$s.3.windows, win.dock.$s.4.windows, win.dock.$s.5.windows, win.dock.$s.6.windows, win.dock.$s.7.windows, win.dock.$s.8.windows, win.dock.$s.9.windows, win.dock.$s.10.windows, win.dock.$s.11.windows)
        let pv.ia.$s = pick(max(pv.$s, 0), dka0.$s, dka1.$s, dka2.$s, dka3.$s, dka4.$s, dka5.$s, dka6.$s, dka7.$s, dka8.$s, dka9.$s, dka10.$s, dka11.$s)
        pv.bx[s] = if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s + dkpl / 2 + 127), clamp(pv.ia.$s, pv.n.$s * 116 + 20, screen.$s.width - pv.n.$s * 116 - 20) - (pv.n.$s - 1) * 116)
        pv.sx[s] = if(dkvert, dk.cs.$s * 232, 232)
        pv.by[s] = if(dkvert, clamp(pv.ia.$s, 110, screen.$s.height - 110) - 10, screen.$s.height - dk.q.$s - 140)
        pv.ox[s] = if(dkvert, 0 - dk.cs.$s * 30, 0)
        pv.oy[s] = if(dkvert, 0, 30)
        let pv.ext.$s = dk.q.$s + dkpl / 2 + 16 + pv.n.$s * 232 + 24
        let pv.x1.$s = if(dkvert, if(dock.side == 1, 0, screen.$s.width - pv.ext.$s), pv.bx.$s - 135)
        let pv.x2.$s = if(dkvert, if(dock.side == 1, pv.ext.$s, screen.$s.width), pv.bx.$s + (pv.n.$s - 1) * 232 + 135)
        let pv.y1.$s = pv.by.$s - 99
        let pv.y2.$s = if(dkvert, pv.by.$s + 119, screen.$s.height)
        // Its menu: the item's windows (window.plm's rows), then New window and
        // Hide while it has some, keep it on the shore or take it off, and close
        // them —or Open, with none—. Over its icon at the bottom, beside it on a side.
        let mn.wn.$s = min(pick(max(dmenu.$s, 0), win.dock.$s.0.windows, win.dock.$s.1.windows, win.dock.$s.2.windows, win.dock.$s.3.windows, win.dock.$s.4.windows, win.dock.$s.5.windows, win.dock.$s.6.windows, win.dock.$s.7.windows, win.dock.$s.8.windows, win.dock.$s.9.windows, win.dock.$s.10.windows, win.dock.$s.11.windows), 6)
        let mn.run.$s = pick(dmk.$s, win.dock.$s.0.windows, win.dock.$s.1.windows, win.dock.$s.2.windows, win.dock.$s.3.windows, win.dock.$s.4.windows, win.dock.$s.5.windows, win.dock.$s.6.windows, win.dock.$s.7.windows, win.dock.$s.8.windows, win.dock.$s.9.windows, win.dock.$s.10.windows, win.dock.$s.11.windows) > 0
        let mn.pin.$s = pick(dmk.$s, win.dock.$s.0.pinned, win.dock.$s.1.pinned, win.dock.$s.2.pinned, win.dock.$s.3.pinned, win.dock.$s.4.pinned, win.dock.$s.5.pinned, win.dock.$s.6.pinned, win.dock.$s.7.pinned, win.dock.$s.8.pinned, win.dock.$s.9.pinned, win.dock.$s.10.pinned, win.dock.$s.11.pinned) > 0.5
        let mn.base.$s = 6 + mn.wn.$s * 28 + if(mn.wn.$s > 0, 10, 0)
        let mn.h.$s = mn.base.$s + if(mn.run.$s, 4, 2) * 28 + 6
        let mn.ia.$s = pick(dmk.$s, dka0.$s, dka1.$s, dka2.$s, dka3.$s, dka4.$s, dka5.$s, dka6.$s, dka7.$s, dka8.$s, dka9.$s, dka10.$s, dka11.$s)
        mn.x[s] = if(dkvert, if(dock.side == 1, dk.q.$s + dkpl / 2 + 14, screen.$s.width - dk.q.$s - dkpl / 2 - 14 - 220), clamp(mn.ia.$s - 110, 8, screen.$s.width - 228))
        mn.y[s] = if(dkvert, clamp(mn.ia.$s - mn.h.$s / 2, 8, screen.$s.height - mn.h.$s - 8), screen.$s.height - dk.q.$s - dkpl / 2 - 14 - mn.h.$s)
        // Away from the shore, its previews and its menu, they sink.
        let pv.near.$s = mon == s and (dk.on.$s or (pv.$s >= 0 and mouse.x >= pv.x1.$s and mouse.x <= pv.x2.$s and mouse.y >= pv.y1.$s and mouse.y <= pv.y2.$s) or (dmenu.$s >= 0 and mouse.x >= mn.x.$s - 24 and mouse.x <= mn.x.$s + 244 and mouse.y >= mn.y.$s - 24 and mouse.y <= mn.y.$s + mn.h.$s + 24))
        on change pv.near.$s while not pv.near.$s {
            pv.$s = -1
            dmenu.$s = -1
        }
        on key Escape while dmenu.$s >= 0 or pv.$s >= 0 {
            dmenu.$s = -1
            pv.$s = -1
        }
        group {
            z: 99984
            show: shore.$s > 0.01 and screen.index == s
            measure tip.$s.0
            group {
                show: dk.on.$s and dk.hk.$s == 0 and 0 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq0.$s + dksz0.$s / 2 + 14 + (tip.$s.0.width + 22) / 2), dka0.$s), if(dkvert, dka0.$s, dk.cr.$s + dk.cs.$s * (dkiq0.$s + dksz0.$s / 2 + 41)); size: (tip.$s.0.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.0.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq0.$s + dksz0.$s / 2 + 14 + (tip.$s.0.width + 22) / 2), dka0.$s), if(dkvert, dka0.$s, dk.cr.$s + dk.cs.$s * (dkiq0.$s + dksz0.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.0; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.0.badge > 0 and 0 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq0.$s), dka0.$s) + 0.39 * dksz0.$s, if(dkvert, dka0.$s, dk.cr.$s + dk.cs.$s * (dkiq0.$s)) - 0.39 * dksz0.$s; radius: 8.5 }
                }
                text "{win.dock.$s.0.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq0.$s), dka0.$s) + 0.39 * dksz0.$s, if(dkvert, dka0.$s, dk.cr.$s + dk.cs.$s * (dkiq0.$s)) - 0.39 * dksz0.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            measure tip.$s.1
            group {
                show: dk.on.$s and dk.hk.$s == 1 and 1 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq1.$s + dksz1.$s / 2 + 14 + (tip.$s.1.width + 22) / 2), dka1.$s), if(dkvert, dka1.$s, dk.cr.$s + dk.cs.$s * (dkiq1.$s + dksz1.$s / 2 + 41)); size: (tip.$s.1.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.1.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq1.$s + dksz1.$s / 2 + 14 + (tip.$s.1.width + 22) / 2), dka1.$s), if(dkvert, dka1.$s, dk.cr.$s + dk.cs.$s * (dkiq1.$s + dksz1.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.1; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.1.badge > 0 and 1 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq1.$s), dka1.$s) + 0.39 * dksz1.$s, if(dkvert, dka1.$s, dk.cr.$s + dk.cs.$s * (dkiq1.$s)) - 0.39 * dksz1.$s; radius: 8.5 }
                }
