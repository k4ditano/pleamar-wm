                rim: 10% + 12% * max(pcard.6.3.hover, (overview and drop.ok and mon == 3 and drop.k == 7 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.6.3.hover, 28, 45%
                box { from: pc.x.3, (pc.y.3 + 6 * (pc.h.3 + 20)); size: pc.w.3, pc.h.3; corner: 10 }
            }
            box { from: pc.x.3 - 3, (pc.y.3 + 6 * (pc.h.3 + 20)) - 3; size: pc.w.3 + 6, pc.h.3 + 6; corner: 13; stroke: 1.6; color: mint; opacity: if(7 == win.shown.3, 85%, 0%) + 60% * (overview and drop.ok and mon == 3 and drop.k == 7 and (ovdrag >= 0 or pdrag.s >= 0)) }
            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 6 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 7 == pc.n.3 and win.used.3 < 7 }
            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 6 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 7 == pc.n.3 and win.used.3 < 7 }
            text "7" { at: pc.x.3 - 12, (pc.y.3 + 6 * (pc.h.3 + 20)) + pc.h.3 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(7 == win.shown.3, 85%, 40%) }
            zone box pcard.6.3 { from: pc.x.3, (pc.y.3 + 6 * (pc.h.3 + 20)); size: pc.w.3, pc.h.3; corner: 10; cursor: pointer; active: overview and not sharing and 6 < pc.n.3; label: "Workspace 7"; role: item }
        }
        group {
            show: 7 < pc.n.3
            opacity: smooth(0.35, 0.90, ov) * if(pdrag.s == 3 and pdrag.k == 7, 40%, 100%)
            move: 70 * (1 - smooth(0.35, 0.90, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.7.3.hover, (overview and drop.ok and mon == 3 and drop.k == 8 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.7.3.hover, 28, 45%
