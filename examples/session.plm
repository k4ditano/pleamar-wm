    let pv.cx.3 = clamp(dk.x0.3 + 14 + max(pv.3, 0) * 60 + 30, pv.n.3 * 116 + 20, screen.3.width - pv.n.3 * 116 - 20)
    let pv.top.3 = dk.cy.3 - 48 - 170
    // Away from the shore and from its previews or its menu, they sink.
    let pv.near.3 = mon == 3 and mouse.y >= pv.top.3 - 24 and mouse.x >= min(dk.x0.3, pv.cx.3 - pv.n.3 * 116 - 24) and mouse.x <= max(dk.x0.3 + dkw.3, pv.cx.3 + pv.n.3 * 116 + 24)
    on change pv.near.3 while not pv.near.3 {
        pv.3 = -1
        dmenu.3 = -1
    }
