    on press dockz.0.2 { impulse buoy.2.0 -9 }
    on drag dockz.0.2 while dkdrag.2 < 0 {
        dkdrag.2 = 0
        pv.2 = -1
    }
    on release dockz.0.2 while dkdrag.2 < 0 {
        dock 0 on 2
        pv.2 = -1
        ring.2.0: 0 ~0ms
        ring.2.0: 1 ~760ms after 16ms
    }
    on release dockz.0.2 while dkdrag.2 == 0 and mouse.y < dk.cy.2 - 110 and win.dock.2.0.pinned > 0.5 {
        dock 0 on 2 unpin
        poofx.2 = mouse.x
        poofy.2 = mouse.y
        poof.2: 0 ~0ms
        poof.2: 1 ~700ms after 16ms
    }
    on release dockz.0.2 { dkdrag.2 = -1 }
    on drop dockz.0.2 {
        dock 0 on 2 with drop
        ring.2.0: 0 ~0ms
        ring.2.0: 1 ~760ms after 16ms
    }
    on press right dockz.0.2 {
        dmenu.2 = 0
        pv.2 = -1
    }
    on hover dockz.0.2 for 450ms while dkdrag.2 < 0 and dmenu.2 < 0 and win.dock.2.0.windows > 0 { pv.2 = 0 }
