        overview = false
    }
    on release pcard.9.3 while pdrag.s == 3 and mon != 3 and 9 < win.used.3 { send workspace 10 on 3 to mon }
    on release pcard.9.3 { pdrag.s = -1 }
    // The card being carried, under the mouse, on whichever monitor it is.
    group {
        z: 99987
        show: pdrag.s >= 0 and screen.index == mon
        opacity: 90%
        body {
            color: #0c0e10
            rim: 18%
            shadow: 0, 18, 40, 55%
            box { at: mouse.x, mouse.y; size: pick(pdrag.s, pc.w.0, pc.w.1, pc.w.2, pc.w.3), pick(pdrag.s, pc.h.0, pc.h.1, pc.h.2, pc.h.3); corner: 10 }
        }
        box { at: mouse.x, mouse.y; size: pick(pdrag.s, pc.w.0, pc.w.1, pc.w.2, pc.w.3) + 6, pick(pdrag.s, pc.h.0, pc.h.1, pc.h.2, pc.h.3) + 6; corner: 13; stroke: 1.6; color: mint; opacity: 70% }
        text "{pdrag.k + 1, 0}" { at: mouse.x, mouse.y; anchor: center; size: 15; weight: 700; color: mint }
    }

    // The mouse over a dialog (they are in the middle of their monitor): the
    // window under it does not take the keyboard from it. Without this,
    // going into a «Save as» to type a name gave the keys to the window
    // beneath it.
    let Wmon = pick(mon, screen.0.width, screen.1.width, screen.2.width, screen.3.width)
    let Hmon = pick(mon, screen.0.height, screen.1.height, screen.2.height, screen.3.height)
    let on.dialog = (win.0.dialog and win.0.open and win.0.screen == mon and win.0.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.0.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.0.height, 40) + tb) / 2) + (win.1.dialog and win.1.open and win.1.screen == mon and win.1.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.1.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.1.height, 40) + tb) / 2) + (win.2.dialog and win.2.open and win.2.screen == mon and win.2.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.2.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.2.height, 40) + tb) / 2) + (win.3.dialog and win.3.open and win.3.screen == mon and win.3.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.3.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.3.height, 40) + tb) / 2) + (win.4.dialog and win.4.open and win.4.screen == mon and win.4.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.4.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.4.height, 40) + tb) / 2) + (win.5.dialog and win.5.open and win.5.screen == mon and win.5.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.5.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.5.height, 40) + tb) / 2) + (win.6.dialog and win.6.open and win.6.screen == mon and win.6.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.6.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.6.height, 40) + tb) / 2) + (win.7.dialog and win.7.open and win.7.screen == mon and win.7.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.7.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.7.height, 40) + tb) / 2) + (win.8.dialog and win.8.open and win.8.screen == mon and win.8.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.8.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.8.height, 40) + tb) / 2) + (win.9.dialog and win.9.open and win.9.screen == mon and win.9.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.9.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.9.height, 40) + tb) / 2) + (win.10.dialog and win.10.open and win.10.screen == mon and win.10.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.10.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.10.height, 40) + tb) / 2) + (win.11.dialog and win.11.open and win.11.screen == mon and win.11.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.11.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.11.height, 40) + tb) / 2) + (win.12.dialog and win.12.open and win.12.screen == mon and win.12.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.12.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.12.height, 40) + tb) / 2) + (win.13.dialog and win.13.open and win.13.screen == mon and win.13.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.13.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.13.height, 40) + tb) / 2) + (win.14.dialog and win.14.open and win.14.screen == mon and win.14.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.14.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.14.height, 40) + tb) / 2) + (win.15.dialog and win.15.open and win.15.screen == mon and win.15.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and abs(mouse.x - Wmon / 2) <= max(win.15.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.15.height, 40) + tb) / 2) > 0.5

    // The workspace of the window with the keyboard, and whether it is a
    // dialog or floats: another one taking the keyboard there puts a
    // maximized one back.
    let focus.pool = pick(win.focus, win.0.pool, win.1.pool, win.2.pool, win.3.pool, win.4.pool, win.5.pool, win.6.pool, win.7.pool, win.8.pool, win.9.pool, win.10.pool, win.11.pool, win.12.pool, win.13.pool, win.14.pool, win.15.pool)
    let focus.dialog = pick(win.focus, win.0.dialog, win.1.dialog, win.2.dialog, win.3.dialog, win.4.dialog, win.5.dialog, win.6.dialog, win.7.dialog, win.8.dialog, win.9.dialog, win.10.dialog, win.11.dialog, win.12.dialog, win.13.dialog, win.14.dialog, win.15.dialog)
    let focus.floats = pick(win.focus, win.0.floating, win.1.floating, win.2.floating, win.3.floating, win.4.floating, win.5.floating, win.6.floating, win.7.floating, win.8.floating, win.9.floating, win.10.floating, win.11.floating, win.12.floating, win.13.floating, win.14.floating, win.15.floating)
    repeat i in 0..16 {
        // A window is laid out on its own monitor: how big that one is and how
        // many windows share it. Each copy of the scene draws only its own.
        let sc = win.$i.screen
        // On the phone (see `phone`): an app, whatever its pool.
        let onph = phone >= 0 and sc == phone
        // (Asked to close: see `seen`.)
        prop bye.$i = 0 ~0ms
        // On the workspace its monitor shows; or how far from it, while they slide.
        // On the pool its monitor shows; and drawn, the one the water has left.
        let ws.here = win.$i.pool == pick(sc, win.pool.0, win.pool.1, win.pool.2, win.pool.3)
        let ws.vis = win.$i.pool == pick(sc, inpool.0, inpool.1, inpool.2, inpool.3) or onph
        // (On the phone its zones are the phone's: no title bars, no edges.)
        let here = win.$i.open and sc == screen.index and not win.$i.minimized and bye.$i < 0.5 and ws.vis and not onph
        // (Drawn while it goes away into the island, too.)
        let drawn = win.$i.open and sc == screen.index and ws.vis
        let n = max(win.$i.among, 1)
        let p = max(win.$i.place, 0)
        let L = pick(sc, lay.0, lay.1, lay.2, lay.3)
        // ── where it goes, in its monitor's layout ──
        let Ws = pick(sc, screen.0.width, screen.1.width, screen.2.width, screen.3.width) - pick(sc, win.reserved.0.left, win.reserved.1.left, win.reserved.2.left, win.reserved.3.left) - pick(sc, win.reserved.0.right, win.reserved.1.right, win.reserved.2.right, win.reserved.3.right)
        let Hs = pick(sc, screen.0.height, screen.1.height, screen.2.height, screen.3.height) - pick(sc, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) - pick(sc, win.reserved.0.bottom, win.reserved.1.bottom, win.reserved.2.bottom, win.reserved.3.bottom)
        let x0 = pick(sc, win.reserved.0.left, win.reserved.1.left, win.reserved.2.left, win.reserved.3.left)
        let y0 = pick(sc, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) + bar
        let ah = Hs - bar - gap
        let lw = if(n < 1.5, Ws - 2 * gap, (Ws - 3 * gap) * ratio)
        let sw = Ws - 3 * gap - lw
        let sh = (ah - (n - 2) * gap) / max(n - 1, 1)
        let cw = (Ws - (n + 1) * gap) / max(n, 1)
        let rh = (ah - (n - 1) * gap) / max(n, 1)
        let gc = ceil(sqrt(n))
        let gw = (Ws - (gc + 1) * gap) / gc
        let gh = (ah - (ceil(n / gc) - 1) * gap) / ceil(n / gc)
        let tx = x0 + pick(L, if(p < 0.5, gap, 2 * gap + lw), gap + p * (cw + gap), gap, gap + mod(p, gc) * (gw + gap), if(p < 0.5, 2 * gap + sw, gap))
        let ty = y0 + pick(L, if(p < 0.5, 0, (p - 1) * (sh + gap)), 0, p * (rh + gap), floor(p / gc) * (gh + gap), if(p < 0.5, 0, (p - 1) * (sh + gap)))
        let tw = pick(L, if(p < 0.5, lw, sw), cw, Ws - 2 * gap, gw, if(p < 0.5, lw, sw))
        let th = pick(L, if(p < 0.5, ah, sh), ah, rh, gh, if(p < 0.5, ah, sh))
        // Under the mouse while another is carried —measured on where it is,
        // not where it is shown moving aside—: it would change places with it.
        let under = dragging >= 0 and not dfl and dragging != i and win.$i.open and sc == mon and not on.strip and pick(sc, free.0, free.1, free.2, free.3) < 0.5 and mouse.x >= tx and mouse.x < tx + tw and mouse.y >= ty and mouse.y < ty + th
        on change under {
            over = if(under, i, if(over == i, -1, over))
        }
        // ── where it is shown going, while one is carried ── (the program is
        // asked for that size too: it changes only when the mouse goes onto
        // another window, monitor or layout, so it draws itself as it would
        // be instead of being stretched)
        let ord.me = win.$i.rank
        let swaps = over == i and sc == mon
        let promoted = leads and not crossing and sc == dsc and dragging >= 0
        let n.shown = max(if(crossing and not xswap and sc == mon, n + 1, if(crossing and not xswap and sc == dsc, n - 1, n)), 1)
        let p.shown = if(dragging == i and promoted, 0, if(promoted, p + (p < dplace), if(swaps and not crossing, dplace, if(xswap, p, if(crossing and sc == mon, p + if(leads, 1, ordD < ord.me), if(crossing and sc == dsc, p - (ord.me > ordD), p))))))
        let L.shown = if(dragging >= 0 and picked >= 0 and sc == mon, picked, L)
        let Wsv = pick(sc, screen.0.width, screen.1.width, screen.2.width, screen.3.width) - pick(sc, win.reserved.0.left, win.reserved.1.left, win.reserved.2.left, win.reserved.3.left) - pick(sc, win.reserved.0.right, win.reserved.1.right, win.reserved.2.right, win.reserved.3.right)
        let Hsv = pick(sc, screen.0.height, screen.1.height, screen.2.height, screen.3.height) - pick(sc, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) - pick(sc, win.reserved.0.bottom, win.reserved.1.bottom, win.reserved.2.bottom, win.reserved.3.bottom)
        let x0v = pick(sc, win.reserved.0.left, win.reserved.1.left, win.reserved.2.left, win.reserved.3.left)
        let y0v = pick(sc, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) + bar
        let ahv = Hsv - bar - gap
        let lwv = if(n.shown < 1.5, Wsv - 2 * gap, (Wsv - 3 * gap) * ratio)
        let swv = Wsv - 3 * gap - lwv
        let shv = (ahv - (n.shown - 2) * gap) / max(n.shown - 1, 1)
        let cwv = (Wsv - (n.shown + 1) * gap) / max(n.shown, 1)
        let rhv = (ahv - (n.shown - 1) * gap) / max(n.shown, 1)
        let gcv = ceil(sqrt(n.shown))
        let gwv = (Wsv - (gcv + 1) * gap) / gcv
        let ghv = (ahv - (ceil(n.shown / gcv) - 1) * gap) / ceil(n.shown / gcv)
        let txv = x0v + pick(L.shown, if(p.shown < 0.5, gap, 2 * gap + lwv), gap + p.shown * (cwv + gap), gap, gap + mod(p.shown, gcv) * (gwv + gap), if(p.shown < 0.5, 2 * gap + swv, gap))
        let tyv = y0v + pick(L.shown, if(p.shown < 0.5, 0, (p.shown - 1) * (shv + gap)), 0, p.shown * (rhv + gap), floor(p.shown / gcv) * (ghv + gap), if(p.shown < 0.5, 0, (p.shown - 1) * (shv + gap)))
        let twv = pick(L.shown, if(p.shown < 0.5, lwv, swv), cwv, Wsv - 2 * gap, gwv, if(p.shown < 0.5, lwv, swv))
        let thv = pick(L.shown, if(p.shown < 0.5, ahv, shv), ahv, rhv, ghv, if(p.shown < 0.5, ahv, shv))
        // Where the carried one would land on the other monitor.
        let Wsg = pick(mon, screen.0.width, screen.1.width, screen.2.width, screen.3.width) - pick(mon, win.reserved.0.left, win.reserved.1.left, win.reserved.2.left, win.reserved.3.left) - pick(mon, win.reserved.0.right, win.reserved.1.right, win.reserved.2.right, win.reserved.3.right)
        let Hsg = pick(mon, screen.0.height, screen.1.height, screen.2.height, screen.3.height) - pick(mon, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) - pick(mon, win.reserved.0.bottom, win.reserved.1.bottom, win.reserved.2.bottom, win.reserved.3.bottom)
        let x0g = pick(mon, win.reserved.0.left, win.reserved.1.left, win.reserved.2.left, win.reserved.3.left)
        let y0g = pick(mon, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) + bar
        let ahg = Hsg - bar - gap
        let lwg = if(landing.n < 1.5, Wsg - 2 * gap, (Wsg - 3 * gap) * ratio)
        let swg = Wsg - 3 * gap - lwg
        let shg = (ahg - (landing.n - 2) * gap) / max(landing.n - 1, 1)
        let cwg = (Wsg - (landing.n + 1) * gap) / max(landing.n, 1)
        let rhg = (ahg - (landing.n - 1) * gap) / max(landing.n, 1)
        let gcg = ceil(sqrt(landing.n))
        let gwg = (Wsg - (gcg + 1) * gap) / gcg
        let ghg = (ahg - (ceil(landing.n / gcg) - 1) * gap) / ceil(landing.n / gcg)
        let txg = x0g + pick(landing.lay, if(landing.place < 0.5, gap, 2 * gap + lwg), gap + landing.place * (cwg + gap), gap, gap + mod(landing.place, gcg) * (gwg + gap), if(landing.place < 0.5, 2 * gap + swg, gap))
        let tyg = y0g + pick(landing.lay, if(landing.place < 0.5, 0, (landing.place - 1) * (shg + gap)), 0, landing.place * (rhg + gap), floor(landing.place / gcg) * (ghg + gap), if(landing.place < 0.5, 0, (landing.place - 1) * (shg + gap)))
        let twg = pick(landing.lay, if(landing.place < 0.5, lwg, swg), cwg, Wsg - 2 * gap, gwg, if(landing.place < 0.5, lwg, swg))
        let thg = pick(landing.lay, if(landing.place < 0.5, ahg, shg), ahg, rhg, ghg, if(landing.place < 0.5, ahg, shg))
        // (the grid at a glance)
        let cols = ceil(sqrt(n))
        let rows = ceil(n / cols)
        let cell.w = (Ws - 80 - pick(sc, pc.w.0, pc.w.1, pc.w.2, pc.w.3) - 70 - (cols - 1) * 30) / cols
        let cell.h = (ah - 40 - (rows - 1) * 30) / rows
        // ── and at a glance: in a grid, each one keeping its shape ──
        let s = min(cell.w / tw, cell.h / th)
        let ox = pick(sc, win.reserved.0.left, win.reserved.1.left, win.reserved.2.left, win.reserved.3.left) + 40 + mod(p, cols) * (cell.w + 30) + (cell.w - tw * s) / 2
        let oy = pick(sc, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) + bar + 20 + floor(p / cols) * (cell.h + 30) + (cell.h - th * s) / 2

        // ── free: where it was left, as big as it was made (all of the
        // monitor, maximized) ──
        fact fx.$i = 0
        fact fy.$i = 0
        fact fw.$i = 0
        fact fh.$i = 0
        fact maxed.$i = 0
        fact stamp.$i = 0
        // Which monitor its free place was made on: monitors differ in size,
        // so a place from the other one is not a place here.
        fact fsc.$i = -1
        //  Free: its monitor is (`Fm`), or this window floats on its own over
        //  the tiles (`float`, Super+V). Floating, it is as a free one: a place
        //  of its own, a title bar, carried and resized; the others close up.
        let Fm = pick(sc, free.0, free.1, free.2, free.3)
        let F = if(win.$i.floating, 1, Fm)
        // (Only once it has a place of its own on this monitor: the frame free
        // is taken, it has none yet, and it headed for the corner.)
        let fr = F > 0.5 and fw.$i > 0.5 and fsc.$i == sc and not win.$i.fullscreen and not win.$i.dialog
        // Never lost: no bigger than its monitor, and always with a good
        // piece of it —and all of its title bar— inside, to take it by.
        // (Free, the shore at the bottom is kept clear.)
        let ahf = ah - 92 * pick(sc, shore.0, shore.1, shore.2, shore.3)
        let fgw = if(maxed.$i, Ws - 2 * gap, min(fw.$i, Ws - 2 * gap))
        let fgh = if(maxed.$i, ahf, min(fh.$i, ahf))
        let fgx = if(maxed.$i, x0 + gap, clamp(fx.$i, x0 + 160 - fgw, x0 + Ws - 160))
        let fgy = if(maxed.$i, y0, clamp(fy.$i, pick(sc, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top), y0 + ahf - tb - 40))
        // ── tiled, maximized (`maximize`): all of its monitor's room —the
        // bars and the gaps kept, as one window alone has it—, over the
        // others, which keep their places beneath. Again, back to its tile;
        // and so too when another one there takes the keyboard (it would be
        // under it), or when it is carried. ──
        fact tmax.$i = 0
        let tm = tmax.$i > 0.5 and F < 0.5 and not win.$i.fullscreen and not win.$i.dialog and not win.$i.minimized
        // (Free or floating, the same as its green button.)
        on maximize while win.focus == i and not win.$i.dialog and (F < 0.5 or fr) {
            tmax.$i = if(F < 0.5, 1 - tmax.$i, tmax.$i)
            maxed.$i = if(fr, 1 - maxed.$i, maxed.$i)
            wave.$i: 0 ~0ms
            wave.$i: 1 after 16ms
        }
        on change win.focus while tmax.$i > 0.5 and win.focus >= 0 and win.focus != i and fscreen == sc and focus.pool == win.$i.pool and not focus.dialog and not focus.floats { tmax.$i = 0 }
        on change dragging while dragging == i { tmax.$i = 0 }
        // Put away, it stays where it was (the others close up without it),
        // and flies from there into Marea's island.
        fact mx.$i = 0
        fact my.$i = 0
        fact mw.$i = 0
        fact mh.$i = 0
        on change win.$i.minimized while win.$i.minimized {
            mx.$i = x.$i
            my.$i = y.$i
            mw.$i = w.$i
            mh.$i = h.$i
            last_min = i
        }
        // Back to tiled, what was put away comes out of the island to its
        // place: tiled, every window has one.
        on change Fm while Fm < 0.5 and win.$i.minimized { restore win.$i }
        // Tiled there is no putting away: whoever asks (a program, a dock), it comes back.
        on change win.$i.minimized while win.$i.minimized and Fm < 0.5 { restore win.$i }
        // On the phone: all of it under the status line; the ones that are
        // not in front wait beside it, the earlier ones to the left.
        let ph.rel = ph.k.$i - ph.kf
        // Two side by side (a tablet lying down): the one in front on its
        // side of the line, the other on the other.
        let ph.pair = ph.split and (ph.front == i or ph.sd == i)
        let ph.lft = (ph.front == i) == (ph.fl > 0.5)
        let ph.px = if(ph.lft, 0, ph.xr + 4)
        let ph.pw = if(ph.lft, ph.xr - 4, W.ph - ph.xr - 4)
        let ph.gx = if(ph.pair, ph.px, if(ph.front == i or ph.front < 0, 0, if(ph.rel > 0, W.ph + 40, 0 - W.ph - 40)))
        let goal.x = if(onph, ph.gx, if(win.$i.minimized, mx.$i, if(fr, fgx, if(tm, x0 + gap, txv))))
        let goal.y = if(onph, ph.sb, if(win.$i.minimized, my.$i, if(fr, fgy, if(tm, y0, tyv))))
        let goal.w = if(onph, if(ph.pair, ph.pw, W.ph), if(win.$i.minimized, mw.$i, if(fr, fgw, if(tm, Ws - 2 * gap, twv))))
        let goal.h = if(onph, H.ph - ph.sb - ph.hb, if(win.$i.minimized, mh.$i, if(fr, fgh, if(tm, ah, thv))))
        // As a card, in a deck: each one a step below the one before, the
        // one at `ph.at` whole near the top, the ones behind it piled up
        // above, a little smaller. Lying down, in a row: the one at `ph.at`
        // in the middle, the others beside it, a little smaller.
        let ph.d = ph.k.$i - ph.at
        let ph.r0 = min(0.62, (H.ph - ph.sb - ph.hb - 200) / max(H.ph - ph.sb - ph.hb, 1))
        let ph.cs = if(ph.row, ph.r0 * (1 - 0.08 * min(abs(ph.d), 1)), 0.84 * (1 - 0.06 * clamp(0 - ph.d, 0, 4)))
        let ph.cw = W.ph * ph.cs
        let ph.ch = (H.ph - ph.sb - ph.hb) * ph.cs
        let ph.cx = if(ph.row, (W.ph - ph.cw) / 2 + ph.d * (W.ph * ph.r0 + 36), (W.ph - ph.cw) / 2)
        let ph.cy = if(ph.row, (ph.sb + H.ph - ph.hb - 62) / 2 - ph.ch / 2, ph.sb + 96 + if(ph.d < 0, max(ph.d, -4) * 26, ph.d * 150))
        let card = onph and ph.home
        // Over the others: on the phone, the app in front; as cards, each over the one before.
        let zz = if(onph, if(card, 100000 + ph.k.$i * 10, if(ph.front == i or ph.pair, 100500, 100000)), stamp.$i)
        // How far into the island: 0 here, 1 put away.
        prop mini.$i = 0 ~720ms
        follow mini.$i = if(win.$i.minimized, 1, 0)
        // Free for the first time: where it is now. Opened free: in the middle, a step down per slot.
        // (A little smaller than its tile, in the middle of it: it is seen
        // coming off.)
        // From where its tile is on this monitor —not from where it is shown
        // going, which may be mid-glide or on the other monitor—. The same
        // when it arrives free on a monitor its place was not made on
        // (unless it was let go there: then that is its place).
        let unplaced = F > 0.5 and win.$i.open and (fw.$i < 1 or fsc.$i != sc) and dragging != i and not (landing == i and sc != landing.to)
        on change unplaced while unplaced and Fm > 0.5 {
            fx.$i = tx + tw * 0.07
            fy.$i = ty + th * 0.06
            fw.$i = tw * 0.86
            fh.$i = th * 0.88
            fsc.$i = sc
            maxed.$i = 0
        }
        // Tiled to free and back, each one gives a little jump, and free it
        // floats: a deeper shadow.
        prop lift.$i = 0 ~pop
        follow lift.$i = F
        // Its title bar, with its buttons, only free: tiled, the layout already
        // says where each one is, and the program has all of its tile. It
        // unrolls when the monitor goes free, and rolls up when it goes back.
        prop hb.$i = 0 ~glide
        // Carried at a glance over the cards, it shrinks towards them.
        prop ovcarry.$i = 0 ~pop
        follow ovcarry.$i = if(ovdrag == i and on.col, 1, 0)
        follow hb.$i = if(F > 0.5, 1, 0)
        // ── born from the water, as Marea comes out of hers: a window that
        // opens comes out of the edge of the monitor nearest to where it goes.
        // The water there holds a drop that pushes through it, stretched,
        // hanging by a neck; the thread breaks, the surface gives its tug and
        // two ripples run along it, a droplet is left behind and swallowed, and
        // the drop, shaking round, flies to its place with weight, squashes as
        // it lands and spreads into the window —black, then, pum, the window—.
        // `out` 0 sunk → 1 separated; `fly` 0 at the edge → 1 at its place;
        // `swell` 0 a drop → 1 the window (the window is seen at the end of it).
        prop out.$i = 1 ~420ms
        prop fly.$i = 1 ~homing
        prop swell.$i = 1 ~380ms
        prop wet.$i = 0 ~120ms
        prop bounce.$i = 0 ~splash
        prop wobble.$i = 0 ~splash
        prop ripple.$i = 1 ~900ms
        prop stray.$i = 0 ~520ms
        fact edge.$i = 0                  // 0 left, 1 right, 2 top, 3 bottom
        fact ex.$i = 0
        fact ey.$i = 0
        let nb.Wm = pick(sc, screen.0.width, screen.1.width, screen.2.width, screen.3.width)
        let nb.Hm = pick(sc, screen.0.height, screen.1.height, screen.2.height, screen.3.height)
        let nb.gcx = goal.x + goal.w / 2
        let nb.gcy = goal.y + goal.h / 2
        // Alone on its monitor it is centred, as far from one edge as from the
        // other: then it comes from the edge nearest to the mouse, where
        // you are looking.
        let nb.centred = abs(nb.gcx - nb.Wm / 2) < 60 and abs(nb.gcy - nb.Hm / 2) < 60
        let nb.bx = if(nb.centred and mon == sc, mouse.x, nb.gcx)
        let nb.by = if(nb.centred and mon == sc, mouse.y, nb.gcy)
        let nb.near = min(min(nb.bx, nb.Wm - nb.bx), min(nb.by, nb.Hm - nb.by))
        // As it opens, its place among the others is not known yet —a slot
        // used before still says the place of the window it held—: it waits,
        // unseen, a few frames, until the compositor has laid it out.
        fact fresh.$i = 0
        on change win.$i.open while win.$i.open and not win.$i.dialog {
            fresh.$i = 1
            swell.$i: 0 ~0ms
            out.$i: 0 ~0ms
            fly.$i: 0 ~0ms
        }
        on still swell.$i for 80ms while fresh.$i > 0.5 and swell.$i < 0.01 {
            fresh.$i = 0
            edge.$i = if(nb.near == nb.bx, 0, if(nb.near == nb.Wm - nb.bx, 1, if(nb.near == nb.by, 2, 3)))
            ex.$i = if(nb.near == nb.bx, 0, if(nb.near == nb.Wm - nb.bx, nb.Wm, nb.bx))
            ey.$i = if(nb.near == nb.bx or nb.near == nb.Wm - nb.bx, nb.by, if(nb.near == nb.by, 0, nb.Hm))
            // Where it is going, at once: it is the drop that travels.
            x.$i: goal.x ~0ms
            y.$i: goal.y ~0ms
            w.$i: goal.w ~0ms
            h.$i: goal.h ~0ms
            // The water stirs, and the drop starts pushing through it.
            wet.$i: 1 ~120ms
            impulse wobble.$i 190
            out.$i: 1 ~420ms after 30ms
        }
        // The thread breaks: the tug, the ripples, the droplet left behind,
        // the drop shaking round; and off it goes.
        on change out.$i > 0.84 while out.$i > 0.84 and fly.$i < 0.01 and swell.$i < 0.01 and fresh.$i < 0.5 {
            impulse bounce.$i -150
            impulse wobble.$i -340
            ripple.$i: 0 ~16ms
            ripple.$i: 1 ~900ms after 30ms
            stray.$i: 1 ~16ms
            stray.$i: 0 ~520ms after 60ms
            fly.$i: 1 ~homing after 50ms
        }
        // Landing: it squashes and spreads into the window; the water behind
        // lies flat again.
        on change fly.$i > 0.93 while fly.$i > 0.93 and swell.$i < 0.01 and fresh.$i < 0.5 {
            impulse wobble.$i 300
            swell.$i: 1 ~380ms
            wet.$i: 0 ~500ms after 500ms
        }
        // Never hidden for good: whatever cut the journey short, it is there.
        on still fly.$i for 2500ms while swell.$i < 0.01 and win.$i.open {
            fresh.$i = 0
            swell.$i: 1
        }
        // (What comes from the compositor is already new when the rules look.)
        on change win.$i.open while win.$i.open and F > 0.5 {
            fw.$i = Ws * 0.6
            fh.$i = ah * 0.7
            fx.$i = x0 + Ws * 0.2 + 28 * i
            fy.$i = y0 + ah * 0.1 + 28 * i
            fsc.$i = sc
            maxed.$i = 0
        }
        on change win.$i.open while not win.$i.open {
            fw.$i = 0
            maxed.$i = 0
            tmax.$i = 0
        }
        // Carried or being resized when it goes —closed, put away—: nothing
        // is carried any more (the release would never come to it).
        on change win.$i.open while not win.$i.open and dragging == i { dragging = -1 }
        on change win.$i.open while not win.$i.open and sizing == i { sizing = -1 }
        on change win.$i.minimized while win.$i.minimized and dragging == i { dragging = -1 }
        on change win.$i.minimized while win.$i.minimized and sizing == i { sizing = -1 }
        // The one that gets the keyboard comes over the rest.
        on change win.$i.focused while win.$i.focused {
            stamp.$i = stamp.top + 1
            stamp.top = stamp.top + 1
        }

        prop x.$i = 24 ~glide
        prop y.$i = 12 ~glide
        prop w.$i = 60 ~glide
        prop h.$i = 34 ~glide
        //  Floated off a tiled monitor: it lifts off its tile, smaller, in the
        //  middle of where it was (its tile is the others' now).
        let flw = min(w.$i * 0.86, Ws * 0.62)
        let flh = min(h.$i * 0.88, ah * 0.72)
        on change unplaced while unplaced and Fm < 0.5 {
            fx.$i = x.$i + (w.$i - flw) / 2
            fy.$i = y.$i + (h.$i - flh) / 2
            fw.$i = flw
            fh.$i = flh
            fsc.$i = sc
            maxed.$i = 0
        }
        follow x.$i = if(win.$i.open, if(card, ph.cx, if(overview, ox, goal.x)), home.x)
        follow y.$i = if(win.$i.open, if(card, ph.cy, if(overview, oy, goal.y)), home.y)
        follow w.$i = if(win.$i.open, if(card, ph.cw, if(overview, tw * s, goal.w)), 60)
        follow h.$i = if(win.$i.open, if(card, ph.ch, if(overview, th * s, goal.h)), 34)
        // Carried with the mouse: how far from its place.
        prop dx.$i = 0 ~glide
        prop dy.$i = 0 ~glide
        // Asked to close, it goes at once: the program may take its time to
        // leave (a browser, a second), and nobody should wait for it. If it
        // is still there a while later —it asked whether to save—, it is back.
        on change win.$i.open while win.$i.open { bye.$i: 0 }
        prop seen.$i = 0 ~260ms
        follow seen.$i = if(win.$i.open and bye.$i < 0.5, 1, 0)
        prop lit.$i = 0 ~220ms
        // Maximized or back: a wave runs through it from the button, and
        // it swells a little as it passes, like water filling a basin.
        prop wave.$i = 1 ~720ms
        follow lit.$i = if(win.$i.focused and not overview, 1, if(overview, 1, 0))

        let x = x.$i + dx.$i
        let y = y.$i + dy.$i
        let w = w.$i
        let h = h.$i
        // Born from the water (see `out`, `fly`, `swell`): one body —the sheet
        // beyond the edge, its bulge and its ripples, the droplet, the drop,
        // the window it becomes— melted into a single silhouette, so every
        // neck between them is nobody's drawing, as in Marea.
        let nb.nx = pick(edge.$i, 1, -1, 0, 0)
        let nb.ny = pick(edge.$i, 0, 0, 1, -1)
        let nb.tx = abs(nb.ny)
        let nb.ty = abs(nb.nx)
        let nb.along = abs(nb.nx) > 0.5
        let nb.R = 30
        let nb.o = out.$i
        let nb.f = fly.$i
        let nb.s = swell.$i
        let nb.wet = wet.$i
        // The surface: stretched towards the drop while it holds it (a bell),
        // tugged and bouncing when it lets it go.
        let nb.tension = 4 * nb.o * (1 - nb.o) * (nb.f < 0.02)
        let nb.sag = max((30 * nb.tension + bounce.$i) * nb.wet, 0.3)
        let nb.rx = 14 + 90 * ripple.$i
        let nb.rh = 16 * (1 - ripple.$i) * clamp(ripple.$i * 6, 0, 1) * nb.wet
        let nb.sr = 8 * stray.$i
        // The neck while it hangs: nothing sunk, most halfway, nothing loose.
        let nb.neck = 34 * 4 * nb.o * (1 - nb.o) * (nb.f < 0.02)
        // The drop: pushing through the edge, then flying to the middle of
        // its window.
        let nb.px = ex.$i + nb.nx * (-nb.R + (2 * nb.R + 18) * nb.o)
        let nb.py = ey.$i + nb.ny * (-nb.R + (2 * nb.R + 18) * nb.o)
        let nb.cx = nb.px + (x + w / 2 - nb.px) * nb.f
        let nb.cy = nb.py + (y + h / 2 - nb.py) * nb.f
        // Stretched by the pull and by its own speed; shaking round after.
        let nb.k = nb.tension * 0.3 + clamp(abs(vel(fly.$i)) * 0.05, 0, 0.35)
        let nb.dr = wobble.$i * 0.0012
        let nb.sa = 1 + nb.k + nb.dr
        let nb.sb = 1 - nb.k * 0.45 - nb.dr
        // Landing it spreads: from the drop to the window, squashed a hair.
        // (Whole by 0.85 of it: the window only shows through the black once
        // the black is all of it.)
        let nb.g = smooth(0, 0.85, nb.s)
        let nb.bw = (2 * nb.R + (w - 2 * nb.R) * nb.g) * (1 + wobble.$i * 0.0004 * (1 - nb.g))
        let nb.bh = (2 * nb.R + (h - 2 * nb.R) * nb.g) * (1 - wobble.$i * 0.0004 * (1 - nb.g))
        // The window drawn at that size while it spreads.
        let nb.sx = if(swell.$i < 0.999, nb.bw / max(w, 1), 1)
        let nb.sy = if(swell.$i < 0.999, nb.bh / max(h, 1), 1)
        // A hollow where the carried one would land: where this one is, if it
        // is under it; its own place, if it is under nothing; its place on the
        // other monitor, if it is over that one.
        // (A prop is one for every monitor's copy: what it follows cannot
        // depend on which copy it is. Which monitor shows it goes in `show`.)
        let hollow.there = dragging == i and crossing and not xswap
        prop hollow.$i = 0 ~140ms
        follow hollow.$i = if(not fr and (swaps or (dragging == i and over < 0 and not crossing) or hollow.there), 1, 0)
        // (Its own place as it would be: in the layout picked, if one is.)
        let hx = if(hollow.there, txg, if(dragging == i, txv, tx))
        let hy = if(hollow.there, tyg, if(dragging == i, tyv, ty))
        let hw = if(hollow.there, twg, if(dragging == i, twv, tw))
        let hh = if(hollow.there, thg, if(dragging == i, thv, th))
        group {
            show: hollow.$i > 0.01 and if(hollow.there, mon, sc) == screen.index
            opacity: hollow.$i
            box { from: hx + 4, hy + 4; size: hw - 8, hh - 8; corner: 12; color: mint; opacity: 7% }
            box { from: hx + 4, hy + 4; size: hw - 8, hh - 8; corner: 12; stroke: 1.5; color: mint; opacity: 55% }
        }
        // Where it is laid out, not where it is carried: a drag goes on while
        // its zone still holds the point it was pressed on.
        // (In a group of their own, just over the window's `z:`: where
        // windows overlap, the one on top takes the mouse, and on its own
        // window its edges and buttons go before what the program shows.)
        group {
            z: zz + 0.5 + if(win.$i.floating, 50000, 0)
            // Free, it is carried by its title bar; tiled, by the gap just
            // above it, which takes nothing from the program.
            // With Super held, all of it.
            let whole = keys.super > 0.5 or dragging == i
            zone box title.$i { from: x.$i + if(whole or F > 0.5, 0, 12), y.$i - if(whole or F > 0.5, 0, gap - 1); size: if(whole, w, if(F > 0.5, w - 76, w - 24)), if(whole, h, if(F > 0.5, tb, gap - 2)); cursor: pointer; active: here and not overview and not win.$i.dialog; label: "{win.$i.title}"; role: button }
            zone ellipse lead_zone.$i { at: x + w - 40, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview and not win.$i.dialog and F > 0.5; label: "Enlarge {win.$i.title}" }
            zone ellipse mini_zone.$i { at: x + w - 60, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview and not win.$i.dialog and Fm > 0.5; label: "Minimize {win.$i.title}" }
            zone ellipse close_zone.$i { at: x + w - 20, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview and not win.$i.dialog and F > 0.5; label: "Close {win.$i.title}" }
            // At a glance, the whole window is a button: pressing it chooses it.
            zone box choose.$i { from: x, y; size: w, h; cursor: pointer; active: here and overview and not win.$i.dialog; label: "{win.$i.title}"; role: item }
            // Free: its edges and its corner make it bigger or smaller.
            // (While it is being resized, where they were when taken: a drag
            // goes on while its zone holds the point it was pressed on.)
            let ex = if(sizing == i, g.x, x)
            let ey = if(sizing == i, g.y, y)
            let ew = if(sizing == i, g.w, w)
            let eh = if(sizing == i, g.h, h)
            zone box left_edge.$i { from: ex - 5, ey + tb; size: 10, eh - tb - 12; cursor: grab; active: here and fr and not maxed.$i and not overview; label: "Resize {win.$i.title}"; role: region }
            zone box right_edge.$i { from: ex + ew - 5, ey + tb; size: 10, eh - tb - 12; cursor: grab; active: here and fr and not maxed.$i and not overview; label: "Resize {win.$i.title}"; role: region }
            zone box bottom_edge.$i { from: ex + 12, ey + eh - 5; size: ew - 24, 10; cursor: grab; active: here and fr and not maxed.$i and not overview; label: "Resize {win.$i.title}"; role: region }
            zone box corner.$i { from: ex + ew - 14, ey + eh - 14; size: 20, 20; cursor: grab; active: here and fr and not maxed.$i and not overview; label: "Resize {win.$i.title}"; role: region }
        }
        group {
            // Over the others as it was last touched (free, they overlap).
            z: zz + if(win.$i.floating, 50000, 0)
            // Carried, it is drawn over the others, further down; flying into
            // the island or out of it, too.
            show: seen.$i > 0.01 and sc == screen.index and ws.vis and dragging != i and not (landing == i and sc != landing.to) and not win.$i.dialog and mini.$i <= 0.02
            // Born, it grows out of the drop: the same size as the black that
            // spreads, showing through it as the black clears.
            opacity: seen.$i * smooth(0.2, 0.5, swell.$i) * (1 - 0.25 * ovcarry.$i) * if(card, if(ph.row, clamp(1.2 - 0.35 * abs(ph.d), 0.4, 1), clamp(1 + 0.2 * ph.d, 0.3, 1)), 1)
            pivot: x + w / 2, y + h / 2
            move: (nb.cx - x - w / 2) * (1 - nb.g) * (swell.$i < 0.999), (nb.cy - y - h / 2) * (1 - nb.g) * (swell.$i < 0.999)
            scale: (0.92 + 0.08 * seen.$i + 0.025 * choose.$i.hover * ov) * (1 + 0.05 * (lift.$i - F)) * (1 + 0.012 * sin(180 * wave.$i)) * (1 + 0.03 * sin(180 * smooth(0.8, 1, swell.$i))) * nb.sx * (1 - 0.6 * ovcarry.$i), (0.92 + 0.08 * seen.$i + 0.025 * choose.$i.hover * ov) * (1 + 0.05 * (lift.$i - F)) * (1 + 0.012 * sin(180 * wave.$i)) * (1 + 0.03 * sin(180 * smooth(0.8, 1, swell.$i))) * nb.sy * (1 - 0.6 * ovcarry.$i)
            body {
                color: #0c0e10
                shadow: 0, 14 + 8 * lit.$i + 10 * lift.$i, 34 + 18 * lift.$i, 45% + 20% * lit.$i + 10% * lift.$i
                box { from: x, y; size: w, h; corner: 12 }
            }
            // Without the keyboard, only its title bar steps back: what it shows
            // stays as it is (a video left playing on another monitor, full colour).
            group {
                show: wet <= 0.001 and cold <= 0.001
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: mix(#1a1e22, #1d2b27, lit.$i); show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 110, 10); lines: 1; color: ink; opacity: (55% + 45% * lit.$i) * hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: goal.w, goal.h - tb * (F > 0.5); show: drawn and not win.$i.fullscreen and wet <= 0.001 and cold <= 0.001 }
            }
            // The same, in the rain: the window seen through wet glass.
            group {
                show: wet > 0.001
                shader: rain, wet * pour
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: mix(#1a1e22, #1d2b27, lit.$i); show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 110, 10); lines: 1; color: ink; opacity: (55% + 45% * lit.$i) * hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: goal.w, goal.h - tb * (F > 0.5); show: drawn and not win.$i.fullscreen and wet > 0.001 }
            }
            // And in the snow: frosted glass with snow on top.
            group {
                show: cold > 0.001 and wet <= 0.001
                shader: snow, cold
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: mix(#1a1e22, #1d2b27, lit.$i); show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 110, 10); lines: 1; color: ink; opacity: (55% + 45% * lit.$i) * hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: goal.w, goal.h - tb * (F > 0.5); show: drawn and not win.$i.fullscreen and cold > 0.001 and wet <= 0.001 }
            }
            // (The wave: two soft crests of light, the second behind the first.)
            group {
                show: wave.$i > 0.001 and wave.$i < 0.999
                blur: 6
                mode: screen
                clip box { from: x, y; size: w, h; corner: 12 }
                ellipse { at: x + w - 40, y + tb / 2; radius: 20 + wave.$i * (w + h); stroke: 44 * (1 - wave.$i) + 4; color: mint; opacity: 55% * (1 - wave.$i) }
                ellipse { at: x + w - 40, y + tb / 2; radius: 10 + max(wave.$i - 0.2, 0) * (w + h); stroke: 20 * (1 - wave.$i) + 2; color: #dffaf0; opacity: 40% * (1 - wave.$i) }
            }
            // Its three buttons, three drops of water: put away (into
            // Marea), to the front (free, the whole monitor), and away for
            // good. Lit from above, a glint on top; the mouse over one, it
            // swells, a halo spreads round it and it shows what it does.
            let by = y + tb / 2
            let b.any = max(max(mini_zone.$i.hover, lead_zone.$i.hover), close_zone.$i.hover)
            group {
                show: hb.$i > 0.01
                opacity: (45% + 55% * max(lit.$i, b.any)) * hb.$i
                ellipse { at: x + w - 60, by; radius: 8 + 3 * mini_zone.$i.hover; stroke: 1.2; color: amber; opacity: 55% * mini_zone.$i.hover }
                ellipse { at: x + w - 40, by; radius: 8 + 3 * lead_zone.$i.hover; stroke: 1.2; color: mint; opacity: 55% * lead_zone.$i.hover }
                ellipse { at: x + w - 20, by; radius: 8 + 3 * close_zone.$i.hover; stroke: 1.2; color: coral; opacity: 55% * close_zone.$i.hover }
                //  (Floating on a tiled monitor there is no putting away: no amber.)
                body {
                    gradient: radial x + w - 62, by - 3 radius 10, #fff3d6, amber 45%, #a8781f
                    rim: 35%
                    shadow: 0, 1, 3, 40%
                    opacity: if(Fm > 0.5, 1, 0)
                    ellipse { at: x + w - 60, by; radius: 6 + 1.5 * mini_zone.$i.hover }
                }
                body {
                    gradient: radial x + w - 42, by - 3 radius 10, #e8fff5, mint 45%, #3f8f76
                    rim: 35%
                    shadow: 0, 1, 3, 40%
                    ellipse { at: x + w - 40, by; radius: 6 + 1.5 * lead_zone.$i.hover }
                }
                body {
                    gradient: radial x + w - 22, by - 3 radius 10, #ffe4dc, coral 45%, #b0412f
                    rim: 35%
                    shadow: 0, 1, 3, 40%
                    ellipse { at: x + w - 20, by; radius: 6 + 1.5 * close_zone.$i.hover }
                }
                ellipse { at: x + w - 62, by - 3; radius: 2; scale: 1.3, 0.75; color: #fff; opacity: 75% * if(Fm > 0.5, 1, 0) }
                ellipse { at: x + w - 42, by - 3; radius: 2; scale: 1.3, 0.75; color: #fff; opacity: 75% }
                ellipse { at: x + w - 22, by - 3; radius: 2; scale: 1.3, 0.75; color: #fff; opacity: 75% }
                // What each does, over the one the mouse is on.
                box { at: x + w - 60, by + 0.5; size: 6.5, 1.6; corner: 0.8; color: #4a3308; opacity: mini_zone.$i.hover }
                box { at: x + w - 40, by + 0.5; size: 6.5, 6.5; corner: 1.5; stroke: 1.4; color: #0f3d2f; opacity: lead_zone.$i.hover * (1 - maxed.$i) }
                box { at: x + w - 41.2, by + 1.7; size: 5, 5; corner: 1.2; stroke: 1.3; color: #0f3d2f; opacity: lead_zone.$i.hover * maxed.$i }
                box { at: x + w - 38.8, by - 0.7; size: 5, 5; corner: 1.2; stroke: 1.3; color: #0f3d2f; opacity: lead_zone.$i.hover * maxed.$i * 0.6 }
                box { at: x + w - 20, by + 0.3; size: 7.5, 1.6; corner: 0.8; rotate: 45deg; color: #4a140b; opacity: close_zone.$i.hover }
                box { at: x + w - 20, by + 0.3; size: 7.5, 1.6; corner: 0.8; rotate: -45deg; color: #4a140b; opacity: close_zone.$i.hover }
            }
            box { from: x, y; size: w, h; corner: 12; stroke: 1.5; color: mint; opacity: lit.$i * 70% * (1 - ov) }
            // Tiled, where it is taken to carry it: a little bar in the gap
            // above it, seen when the mouse is there.
            box { at: x + w / 2, y - gap / 2; size: 40 + 24 * title.$i.hover, 4; corner: 2; color: ink; opacity: 55% * title.$i.hover * (1 - hb.$i); show: hb.$i < 0.99 }
            // Choosing what to share: the one under the pointer lights up and says so.
            group {
                show: share.windows and share.in > 0.01
                opacity: share.in
                box { from: x - 3, y - 3; size: w + 6, h + 6; corner: 15; stroke: 2.5; color: mint; opacity: choose.$i.hover }
                group {
                    opacity: choose.$i.hover
                    scale: 0.9 + 0.1 * choose.$i.hover
                    pivot: x + w / 2, y + h / 2
                    body {
                        color: #0c0e10
                        rim: 10%
                        shadow: 0, 6, 18, 45%
                        box { at: x + w / 2, y + h / 2; size: 176, 40; corner: 20 }
                    }
                    ellipse { at: x + w / 2 - 66, y + h / 2; radius: 5; color: #ef7a66 }
                    text "Share this window" { at: x + w / 2 + 8, y + h / 2; anchor: center; size: 13; weight: 600; color: ink }
                }
            }
        }
        // An agent at work on it: a mint outline that breathes round it, over
        // it (the agent's own monitor glow is further down).
        group {
            z: zz + 0.45 + if(win.$i.floating, 50000, 0)
            show: agent.on > 0.01 and agent.win == i and win.$i.open and sc == screen.index and ws.vis
            opacity: agent.on * (0.75 + 0.15 * ag.breath)
            group {
                blur: 10
                box { from: x - 3, y - 3; size: w + 6, h + 6; corner: 14; stroke: 5; color: mint; opacity: 70% }
            }
            box { from: x - 1, y - 1; size: w + 2, h + 2; corner: 13; stroke: 1.6; color: mint }
        }
        // ── on the phone, as a card: its name over it and a cross to close
        // it; pressed, it opens. The ones piled behind show only their edge. ──
        // (On a tablet lying down, another button: beside the one in front.)
        let ph.besides = card and ph.wide and ph.front >= 0 and ph.front != i and win.$i.open and (ph.d > -0.5 or ph.row)
        group {
            z: zz + 0.7
            zone box phcard.$i { from: x, y - 30; size: w, if(ph.d < -0.5 and not ph.row, 14, h + 30); active: card and sc == screen.index and win.$i.open and pc > 0.9; label: "{win.$i.title}"; role: item }
            zone ellipse phx.$i { at: x + w - 14, y - 17; radius: 16; active: card and sc == screen.index and win.$i.open and pc > 0.9 and (ph.d > -0.5 or ph.row); label: "Close {win.$i.title}"; role: button }
            zone ellipse phsd.$i { at: x + w - 46, y - 17; radius: 16; active: ph.besides and sc == screen.index and pc > 0.9; label: "Beside {win.$i.title}"; role: button }
        }
        group {
            z: zz + 0.6
            show: card and sc == screen.index and win.$i.open and pc > 0.02 and (ph.d > -0.5 or ph.row)
            opacity: smooth(0.4, 1, pc)
            text win.$i.title { at: x + 4, y - 17; anchor: left center; size: 13; weight: 650; width: w - if(ph.besides, 84, 50); lines: 1; color: ink; opacity: 92% }
            ellipse { at: x + w - 14, y - 17; radius: 12; color: #ffffff; opacity: 10% + 14% * phx.$i.hover }
            box { at: x + w - 14, y - 17; size: 11, 1.8; corner: 1; rotate: 45deg; color: ink }
            box { at: x + w - 14, y - 17; size: 11, 1.8; corner: 1; rotate: -45deg; color: ink }
            group {
                show: ph.besides
                ellipse { at: x + w - 46, y - 17; radius: 12; color: mint; opacity: 12% + 18% * phsd.$i.hover }
                box { at: x + w - 50, y - 17; size: 6, 11; corner: 1.5; stroke: 1.4; color: ink }
                box { at: x + w - 42, y - 17; size: 6, 11; corner: 1.5; color: mint }
            }
        }
        on release phx.$i { close win.$i }
        on release phsd.$i while ph.besides {
            ph.side = i
            ph.solo = 0
            ph.cards = 0
        }
        on release phcard.$i while not phx.$i.hover and not phsd.$i.hover {
            // (The one beside, pressed: the two change places in front.)
            ph.fl = if(ph.split and ph.sd == i, 1 - ph.fl, ph.fl)
            ph.side = if(ph.split and ph.sd == i, ph.front, ph.side)
            focus win.$i
            ph.front = i
            ph.cards = 0
        }
        // In front, it has the keyboard (put in front by the line between
        // two, a swipe, a card).
        on change ph.front while onph and ph.front == i and win.$i.open and win.focus != i { focus win.$i }
        // Along the bottom edge, to the next app and the one before.
        on phone_next while onph and win.$i.open and not ph.home and ph.k.$i == ph.kf + 1 {
            focus win.$i
            ph.front = i
        }
        on phone_prev while onph and win.$i.open and not ph.home and ph.k.$i == ph.kf - 1 {
            focus win.$i
            ph.front = i
        }
        // The one in front closed: the cards, or the one beside it.
        on change win.$i.open while not win.$i.open and ph.front == i { ph.front = -1 }
        // ── to the phone and back: on the desk it pours into the phone drawn
        // on the curtain (`phone_curtain`), and comes back out of it ──
        // Its monitor at the desk, and where it was on it, when it went (see `pour.`).
        on change win.$i.screen while phone < 0 or win.$i.screen != phone { sc.last.$i = win.$i.screen }
        // (On the phone's coming, not on the window's moving: which of the
        // two the compositor says first is not known.)
        on change phone while phone >= 0 and win.$i.open and not win.$i.dialog and was.ph.$i < 0.5 {
            gx.$i = x.$i
            gy.$i = y.$i
            gw.$i = w.$i
            gh.$i = h.$i
            was.ph.$i = 1
            pour.$i: 0 ~0ms
            pour.$i: 1 ~spring(70, 13) after 120ms
        }
        // Back at the desk: out of the phone, where it was drawn, to its place.
        on change phone while phone < 0 and was.ph.$i > 0.5 {
            was.ph.$i = 0
            x.$i: pick(sc.last.$i, screen.0.width, screen.1.width, screen.2.width, screen.3.width) / 2 - 28 ~0ms
            y.$i: pick(sc.last.$i, screen.0.height, screen.1.height, screen.2.height, screen.3.height) / 2 - 92 ~0ms
            w.$i: 56 ~0ms
            h.$i: 104 ~0ms
        }

        // Born from the water: its drawing (its shape is worked out above, with `nb.`).
        group {
            z: zz + 0.4 + if(win.$i.floating, 50000, 0)
            show: nb.s < 0.995 and fresh.$i < 0.5 and win.$i.open and sc == screen.index and ws.here and not win.$i.dialog
            opacity: 1 - smooth(0.3, 0.75, nb.s)
            body {
                color: #0c0e10
                rim: 12%
                shadow: 0, 6 + 10 * nb.s, 16 + 22 * nb.s, 40%
                // The water, beyond the edge: only what it pushes in is seen.
                box { at: ex.$i - nb.nx * 60, ey.$i - nb.ny * 60; size: if(nb.along, 120 * nb.wet + 1, 420), if(nb.along, 420, 120 * nb.wet + 1) }
                ellipse { at: ex.$i, ey.$i; radius: 34; scale: if(nb.along, nb.sag / 34, 1), if(nb.along, 1, nb.sag / 34); blend: 18 * clamp(nb.sag / 6, 0, 1) }
                ellipse { at: ex.$i - nb.tx * nb.rx, ey.$i - nb.ty * nb.rx; radius: 11; scale: if(nb.along, nb.rh / 11, 1), if(nb.along, 1, nb.rh / 11); blend: 9 * clamp(nb.rh / 3, 0, 1) }
                ellipse { at: ex.$i + nb.tx * nb.rx, ey.$i + nb.ty * nb.rx; radius: 11; scale: if(nb.along, nb.rh / 11, 1), if(nb.along, 1, nb.rh / 11); blend: 9 * clamp(nb.rh / 3, 0, 1) }
                ellipse { at: ex.$i + nb.nx * nb.sr * 0.7, ey.$i + nb.ny * nb.sr * 0.7; radius: nb.sr; blend: 8 * clamp(nb.sr / 3, 0, 1) }
                ellipse { at: nb.cx, nb.cy; radius: nb.R; scale: if(nb.along, nb.sa, nb.sb), if(nb.along, nb.sb, nb.sa); blend: nb.neck }
                box { at: nb.cx, nb.cy; size: nb.bw, nb.bh; corner: nb.R + (12 - nb.R) * nb.g; blend: 28 * 4 * nb.g * (1 - nb.g); show: nb.s > 0.001 }
            }
            // A glint on the drop, as on Marea: light from above.
            ellipse { at: nb.cx - 7, nb.cy - 9; radius: 4; scale: 1.4, 0.8; color: ink; opacity: 35% * (1 - nb.s) * (nb.o > 0.3) }
        }
        // At a glance, its miniature in its pool's card: where it is laid out,
        // and its program's icon.
        let mk = win.$i.workspace - 1
        let mf = pick(sc, pc.w.0, pc.w.1, pc.w.2, pc.w.3) / max(pick(sc, screen.0.width, screen.1.width, screen.2.width, screen.3.width), 1)
        let mx0 = pick(sc, pc.x.0, pc.x.1, pc.x.2, pc.x.3) + goal.x * mf
        let my0 = pick(sc, pc.y.0, pc.y.1, pc.y.2, pc.y.3) + mk * (pick(sc, pc.h.0, pc.h.1, pc.h.2, pc.h.3) + 20) + goal.y * mf
        let mw0 = goal.w * mf
        let mh0 = goal.h * mf
        let ma0 = clamp((ov - 0.05 * mk - 0.08) / 0.52, 0, 1)
        let ma = ma0 * ma0 * (3 - 2 * ma0)
        group {
            z: 99986
            show: ov > 0.01 and win.$i.open and sc == screen.index and not win.$i.dialog and not win.$i.minimized and mk >= 0 and ovdrag != i
            opacity: ma * if(pdrag.s == sc and pdrag.k == mk, 40%, 100%)
            move: 70 * (1 - ma), 0
            box { from: mx0 + 1, my0 + 1; size: max(mw0 - 2, 2), max(mh0 - 2, 2); corner: 3; color: #1d2226 }
            box { from: mx0 + 1, my0 + 1; size: max(mw0 - 2, 2), max(mh0 - 2, 2); corner: 3; stroke: 1; color: if(win.$i.focused, mint, ink); opacity: if(win.$i.focused, 80%, 18%) }
            image appicon.$i { at: mx0 + mw0 / 2 - min(28, min(mw0, mh0) * 0.55) / 2, my0 + mh0 / 2 - min(28, min(mw0, mh0) * 0.55) / 2; size: min(28, min(mw0, mh0) * 0.55), min(28, min(mw0, mh0) * 0.55) }
        }
        // Taken by an edge or the corner: where it was and how big.
        on press left_edge.$i {
            sizing = i
            g.x = fx.$i
            g.y = fy.$i
            g.w = fw.$i
            g.h = fh.$i
        }
        on press right_edge.$i {
            sizing = i
            g.x = fx.$i
            g.y = fy.$i
            g.w = fw.$i
            g.h = fh.$i
        }
        on press bottom_edge.$i {
            sizing = i
            g.x = fx.$i
            g.y = fy.$i
            g.w = fw.$i
            g.h = fh.$i
        }
        on press corner.$i {
            sizing = i
            g.x = fx.$i
            g.y = fy.$i
            g.w = fw.$i
            g.h = fh.$i
        }
        on release left_edge.$i { sizing = -1 }
        on release right_edge.$i { sizing = -1 }
        on release bottom_edge.$i { sizing = -1 }
        on release corner.$i { sizing = -1 }
        on drag left_edge.$i {
            fx.$i = min(g.x + drag.dx, g.x + g.w - 240)
            fw.$i = max(g.w - drag.dx, 240)
        }
        on drag right_edge.$i { fw.$i = max(g.w + drag.dx, 240) }
        on drag bottom_edge.$i { fh.$i = max(g.h + drag.dy, 140) }
        on drag corner.$i {
            fw.$i = max(g.w + drag.dx, 240)
            fh.$i = max(g.h + drag.dy, 140)
        }
        on press lead_zone.$i while fr {
            focus win.$i
            toggle maxed.$i
            wave.$i: 0 ~0ms
            wave.$i: 1 after 16ms
        }
        on press title.$i {
            focus win.$i
            grab.x = pointer.x - x.$i
            grab.y = pointer.y - y.$i
        }
        // Carried by its title bar. Let go on another window, they change
        // places; at the edge towards the other monitor, it goes there.
        // (While carried it is drawn at the mouse, further down; its place
        // here waits.)
        // Only the one that started it: another shown moving aside may come
        // to hold the point pressed.
        on drag title.$i while dragging < 0 or dragging == i {
            dragging = i
        }
        // Let go, it starts from where it was left —on the monitor it was left
        // on— and glides to its place from there.
        on release title.$i {
            dragging = -1
            dx.$i: mouse.x - grab.x - x.$i ~0ms
            dy.$i: mouse.y - grab.y - y.$i ~0ms
            dx.$i: 0 after 30ms
            dy.$i: 0 after 30ms
        }
        // Free: it stays where it was let go (on the monitor it was let go on).
        // (Right there, at once: nothing to glide to.)
        on release title.$i while (pick(mon, free.0, free.1, free.2, free.3) > 0.5 or win.$i.floating) and picked < 0 {
            fx.$i = mouse.x - grab.x
            fy.$i = max(mouse.y - grab.y, pick(mon, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top))
            fsc.$i = mon
            maxed.$i = 0
            x.$i: mouse.x - grab.x ~0ms
            y.$i: max(mouse.y - grab.y, pick(mon, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top)) ~0ms
            dx.$i: 0 ~0ms
            dy.$i: 0 ~0ms
        }
        // Let go on another one (the one under it, as the others showed).
        on release title.$i while over >= 0 and not crossing { swap win.$i with win(over) }
        // …and on one of the other monitor: each takes the other's place and
        // monitor (the compositor sends both across).
        on release title.$i while xswap {
            swap win.$i with win(over)
            landing = i
            landing.to = mon
        }
        // Let go on the other monitor (the mouse is off this one), or at the
        // edge that leads to it.
        // Until the compositor says it is there, it stays with the mouse
        // (`landing`): not a frame back on the monitor it left.
        on release title.$i while (pointer.y < 0 or pointer.y > H) and over < 0 {
            send win.$i to 1 - screen.index
            landing = i
            landing.to = 1 - screen.index
        }
        on release title.$i while screen.index == 0 and pointer.x > W - 40 and pointer.y >= 0 and pointer.y <= H and over < 0 {
            send win.$i to 1
            landing = i
            landing.to = 1
        }
        on release title.$i while screen.index == 1 and pointer.x < 40 and pointer.y >= 0 and pointer.y <= H and over < 0 {
            send win.$i to 0
            landing = i
            landing.to = 0
        }
        // Let go on a layout of the strip: that monitor takes it, and with a
        // leader, the one carried leads.
        on release title.$i while picked >= 0 and mon == 0 {
            lay.0 = choice
            free.0 = 0
        }
        on release title.$i while picked >= 0 and mon == 1 {
            lay.1 = choice
            free.1 = 0
        }
        on release title.$i while picked >= 0 and mon == 2 {
            lay.2 = choice
            free.2 = 0
        }
        on release title.$i while picked >= 0 and mon == 3 {
            lay.3 = choice
            free.3 = 0
        }
        on release title.$i while leads { promote win.$i }
        on release title.$i {
            over = -1
        }
        on press lead_zone.$i while not fr { promote win.$i }
        on press close_zone.$i {
            close win.$i
            bye.$i: 1
            bye.$i: 0 after 2500ms
        }
        on close while win.focus == i {
            bye.$i: 1
            bye.$i: 0 after 2500ms
        }
        on press mini_zone.$i { minimize win.$i }
        // At a glance: pressed and let go, it is the one; carried, it goes to
        // the pool whose card it is let go on, or to the other monitor.
        on drag choose.$i while overview and not sharing and (ovdrag < 0 or ovdrag == i) {
            ovdrag = i
            dx.$i: drag.dx ~0ms
            dy.$i: drag.dy ~0ms
        }
        on release choose.$i while ovdrag < 0 and not sharing {
            focus win.$i
            overview = false
        }
        on release choose.$i while ovdrag == i and drop.ok { send win.$i to workspace drop.k on mon }
        on release choose.$i while ovdrag == i and not on.col and mon != sc { send win.$i to mon }
        on release choose.$i {
            ovdrag = -1
            dx.$i: 0
            dy.$i: 0
        }
        // Sharing the screen: the window pressed is the one shared.
        on press choose.$i while share.windows { pick win.$i }
        // The light goes where the keyboard is.
        on change win.$i.focused while win.$i.focused {
            lx: tx + tw / 2
            ly: ty + th / 2
        }
    }


    // (After the windows: each one's box is known by now.)
    repeat i in 0..16 {
        let sc = win.$i.screen
        let ws.here = win.$i.pool == pick(sc, win.pool.0, win.pool.1, win.pool.2, win.pool.3)
        // The mouse over a window floating over the tiles: the tiles under it
        // do not take the keyboard from it.
        let on.float = (win.0.floating and win.0.open and not win.0.minimized and win.0.screen == mon and win.0.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.0 and mouse.x < x.0 + w.0 and mouse.y >= y.0 and mouse.y < y.0 + h.0) + (win.1.floating and win.1.open and not win.1.minimized and win.1.screen == mon and win.1.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.1 and mouse.x < x.1 + w.1 and mouse.y >= y.1 and mouse.y < y.1 + h.1) + (win.2.floating and win.2.open and not win.2.minimized and win.2.screen == mon and win.2.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.2 and mouse.x < x.2 + w.2 and mouse.y >= y.2 and mouse.y < y.2 + h.2) + (win.3.floating and win.3.open and not win.3.minimized and win.3.screen == mon and win.3.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.3 and mouse.x < x.3 + w.3 and mouse.y >= y.3 and mouse.y < y.3 + h.3) + (win.4.floating and win.4.open and not win.4.minimized and win.4.screen == mon and win.4.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.4 and mouse.x < x.4 + w.4 and mouse.y >= y.4 and mouse.y < y.4 + h.4) + (win.5.floating and win.5.open and not win.5.minimized and win.5.screen == mon and win.5.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.5 and mouse.x < x.5 + w.5 and mouse.y >= y.5 and mouse.y < y.5 + h.5) + (win.6.floating and win.6.open and not win.6.minimized and win.6.screen == mon and win.6.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.6 and mouse.x < x.6 + w.6 and mouse.y >= y.6 and mouse.y < y.6 + h.6) + (win.7.floating and win.7.open and not win.7.minimized and win.7.screen == mon and win.7.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.7 and mouse.x < x.7 + w.7 and mouse.y >= y.7 and mouse.y < y.7 + h.7) + (win.8.floating and win.8.open and not win.8.minimized and win.8.screen == mon and win.8.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.8 and mouse.x < x.8 + w.8 and mouse.y >= y.8 and mouse.y < y.8 + h.8) + (win.9.floating and win.9.open and not win.9.minimized and win.9.screen == mon and win.9.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.9 and mouse.x < x.9 + w.9 and mouse.y >= y.9 and mouse.y < y.9 + h.9) + (win.10.floating and win.10.open and not win.10.minimized and win.10.screen == mon and win.10.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.10 and mouse.x < x.10 + w.10 and mouse.y >= y.10 and mouse.y < y.10 + h.10) + (win.11.floating and win.11.open and not win.11.minimized and win.11.screen == mon and win.11.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.11 and mouse.x < x.11 + w.11 and mouse.y >= y.11 and mouse.y < y.11 + h.11) + (win.12.floating and win.12.open and not win.12.minimized and win.12.screen == mon and win.12.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.12 and mouse.x < x.12 + w.12 and mouse.y >= y.12 and mouse.y < y.12 + h.12) + (win.13.floating and win.13.open and not win.13.minimized and win.13.screen == mon and win.13.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.13 and mouse.x < x.13 + w.13 and mouse.y >= y.13 and mouse.y < y.13 + h.13) + (win.14.floating and win.14.open and not win.14.minimized and win.14.screen == mon and win.14.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.14 and mouse.x < x.14 + w.14 and mouse.y >= y.14 and mouse.y < y.14 + h.14) + (win.15.floating and win.15.open and not win.15.minimized and win.15.screen == mon and win.15.workspace == pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3) and mouse.x >= x.15 and mouse.x < x.15 + w.15 and mouse.y >= y.15 and mouse.y < y.15 + h.15) > 0.5
        // The keyboard goes to the window the mouse is over, as it enters it:
        // no click needed first (Super+Q closes the one under the mouse).
        // (Only one that is seen: on the workspace its monitor shows, and not
        // under a dialog. One on another workspace in the same place took
        // the keys, unseen.)
        let pointed = win.$i.open and sc == mon and ws.here and not win.$i.dialog and not win.$i.minimized and not on.dialog and (win.$i.floating or not on.float) and mouse.x >= x.$i and mouse.x < x.$i + w.$i and mouse.y >= y.$i and mouse.y < y.$i + h.$i
        // (Free, they overlap: the keyboard goes with a click, as on Windows.)
        // (Only the one entered gives it. The one left said «nobody» too, and
        // when both changed in the same round and the leaving one spoke last,
        // nobody had it: a click was needed.)
        on change pointed while pointed and dragging < 0 and not overview and fs.on < 0.5 and pick(mon, free.0, free.1, free.2, free.3) < 0.5 {
            focus win.$i
        }
    }

    // The window being carried, over all the others: lifted, a little smaller
    // and see-through, so that where it will land shows below it. It goes with
    // the mouse on the whole desktop: each monitor draws its part of it, so
    // crossing from one to the other it is seen half on each.
    repeat i in 0..16 {
        // Monitor 1 starts where monitor 0 ends.
        let x = mouse.x + pick(mon, mx.0, mx.1, mx.2, mx.3) - pick(screen.index, mx.0, mx.1, mx.2, mx.3) - grab.x
        let y = mouse.y - grab.y
        let w = w.$i
        let h = h.$i
        group {
            show: dragging == i or (landing == i and win.$i.open and win.$i.screen != landing.to)
            opacity: 88%
            pivot: x + w / 2, y + h / 2
            scale: 1
            body {
                color: #0c0e10
                shadow: 0, 26, 50, 60%
                box { from: x, y; size: w, h; corner: 12 }
            }
            let carried = dragging == i or (landing == i and win.$i.open and win.$i.screen != landing.to)
            group {
                show: wet <= 0.001 and cold <= 0.001
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: #1d2b27; show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink; opacity: hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: win.$i.width, win.$i.height; show: carried and wet <= 0.001 and cold <= 0.001 }
            }
            // Carried in the rain, its water goes with it, lagging behind.
            group {
                show: wet > 0.001
                shader: rain, wet * pour, mouse.x - lag.x, mouse.y - lag.y
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: #1d2b27; show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink; opacity: hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: win.$i.width, win.$i.height; show: carried and wet > 0.001 }
            }
            // And in the snow, its snow and its frost.
            group {
                show: cold > 0.001 and wet <= 0.001
                shader: snow, cold, mouse.x - lag.x, mouse.y - lag.y
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: #1d2b27; show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink; opacity: hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: win.$i.width, win.$i.height; show: carried and cold > 0.001 and wet <= 0.001 }
            }
            box { from: x, y; size: w, h; corner: 12; stroke: 1.5; color: mint; opacity: 80% }
        }
    }

    // ── the layouts strip: while a window is carried, at the top of the
    // monitor under the mouse, if that one is tiled. Over one, everything
    // shows how it would be ──
    prop strip = 0 ~160ms
    follow strip = if(dragging >= 0 and not dfl and pick(mon, free.0, free.1, free.2, free.3) < 0.5, 1, 0)
    let ico = #f5f7f5
    group {
        show: strip > 0.01 and screen.index == mon
        opacity: strip
        body {
            color: #0d1013
            shadow: 0, 10, 28, 45%
            box { from: strip.x - 6, strip.y - 4; size: 5 * 60 + 12, 52; corner: 14; opacity: 90% }
        }
        box { from: strip.x - 6, strip.y - 4; size: 5 * 60 + 12, 52; corner: 14; stroke: 1; color: mint; opacity: 35% }
        repeat k in 0..5 {
            box { from: strip.x + k * 60 + 3, strip.y + 1; size: 54, 42; corner: 10; color: mint; opacity: 22% * (picked == k) }
        }
        // A leader on the left, and the rest on the right.
        group {
            opacity: 50% + 50% * (picked == 0)
            box { from: strip.x + 10, strip.y + 9; size: 22, 26; corner: 3; color: ico }
            box { from: strip.x + 34, strip.y + 9; size: 16, 12; corner: 3; color: ico }
            box { from: strip.x + 34, strip.y + 23; size: 16, 12; corner: 3; color: ico }
        }
        // Columns.
        group {
            opacity: 50% + 50% * (picked == 1)
            box { from: strip.x + 70, strip.y + 9; size: 12, 26; corner: 3; color: ico }
            box { from: strip.x + 84, strip.y + 9; size: 12, 26; corner: 3; color: ico }
            box { from: strip.x + 98, strip.y + 9; size: 12, 26; corner: 3; color: ico }
        }
        // Rows.
        group {
            opacity: 50% + 50% * (picked == 2)
            box { from: strip.x + 130, strip.y + 9; size: 40, 8; corner: 2; color: ico }
            box { from: strip.x + 130, strip.y + 18; size: 40, 8; corner: 2; color: ico }
            box { from: strip.x + 130, strip.y + 27; size: 40, 8; corner: 2; color: ico }
        }
        // A grid.
        group {
            opacity: 50% + 50% * (picked == 3)
            box { from: strip.x + 190, strip.y + 9; size: 19, 12; corner: 3; color: ico }
            box { from: strip.x + 211, strip.y + 9; size: 19, 12; corner: 3; color: ico }
            box { from: strip.x + 190, strip.y + 23; size: 19, 12; corner: 3; color: ico }
            box { from: strip.x + 211, strip.y + 23; size: 19, 12; corner: 3; color: ico }
        }
        // A leader on the right.
        group {
            opacity: 50% + 50% * (picked == 4)
            box { from: strip.x + 250, strip.y + 9; size: 16, 12; corner: 3; color: ico }
            box { from: strip.x + 250, strip.y + 23; size: 16, 12; corner: 3; color: ico }
            box { from: strip.x + 268, strip.y + 9; size: 22, 26; corner: 3; color: ico }
        }
    }

    // ── what it can be asked to do: its actions ──
    // Keys and gestures are not here: `keys.conf` binds them to these —the one
    // that comes with pleamar-wm, or yours in ~/.config/pleamar/keys.conf—.
    // Each is an event, so Marea or anyone can ask too
    // (`pleamar-wm --say wm "emit overview"`).
    let fplace = pick(win.focus, win.0.place, win.1.place, win.2.place, win.3.place, win.4.place, win.5.place, win.6.place, win.7.place, win.8.place, win.9.place, win.10.place, win.11.place, win.12.place, win.13.place, win.14.place, win.15.place)
    let next = pick(mod(focus_at + 1, all), win.order.0, win.order.1, win.order.2, win.order.3, win.order.4, win.order.5)
    let previous = pick(mod(focus_at + all - 1, all), win.order.0, win.order.1, win.order.2, win.order.3, win.order.4, win.order.5)
    event close
    event minimize
    // One window over the tiles, and back (Super+V): its monitor stays tiled.
    event toggle_float
    let focus.floating = pick(win.focus, win.0.floating, win.1.floating, win.2.floating, win.3.floating, win.4.floating, win.5.floating, win.6.floating, win.7.floating, win.8.floating, win.9.floating, win.10.floating, win.11.floating, win.12.floating, win.13.floating, win.14.floating, win.15.floating)
    on toggle_float while win.focus >= 0 and not focus.floating { float win(win.focus) }
    on toggle_float while win.focus >= 0 and focus.floating { tile win(win.focus) }
    event restore_last
    event fullscreen
    // All of its monitor and back: tiled, over the others (the bars and the
    // gaps kept); free, its green button.
    event maximize
    event overview
    event focus_next
    event focus_previous
    event move_left
    event move_right
    event move_up
    event move_down
    event narrower
    event wider
    on close { close win(win.focus) }
    // Put away into Marea, and the last one back.
    on minimize while pick(fscreen, free.0, free.1, free.2, free.3) > 0.5 { minimize win(win.focus) }
    on restore_last { restore win(last_min) }
    on fullscreen { fullscreen win(win.focus) }
    on overview { toggle overview }
    on key Escape while overview { overview = false }

    // ── sharing the screen: what a program in a call wants to show ──
    // The compositor asks (`win.picking`: 1 a monitor, 2 a window, 3 either):
    // the overview opens, a window is chosen by pressing it, a whole monitor
    // by the band on top of it, and nothing with Escape or «Cancel».
    let sharing = win.picking > 0
    let share.windows = win.picking >= 2
    let share.screens = win.picking == 1 or win.picking == 3
    on change win.picking while win.picking > 0 { overview = true }
    on change win.picking while win.picking < 1 { overview = false }
    on key Escape while sharing { pick none }
    prop share.in = 0 ~160ms
    follow share.in = if(sharing, 1, 0)
    repeat s in 0..4 {
        let band.y = pick(s, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) + 52
        let band.w = if(share.screens, 560, 420)
        prop screen_glow.$s = 0 ~140ms
        prop cancel_glow.$s = 0 ~140ms
        group {
            z: 99995
            show: share.in > 0.01 and screen.index == s
            opacity: share.in
            move: 0, -14 * (1 - share.in)
            body {
                color: #0c0e10
                rim: 8%
                shadow: 0, 10, 30, 50%
                box { at: W / 2, band.y; size: band.w, 56; corner: 28 }
            }
            // A red dot, as a camera that is about to see.
            ellipse { at: W / 2 - band.w / 2 + 28, band.y; radius: 6; color: #ef7a66 }
            ellipse { at: W / 2 - band.w / 2 + 28, band.y; radius: 10; stroke: 1.5; color: #ef7a66; opacity: 40% }
            text pick(win.picking - 1, "Share a screen", "Choose a window", "Choose what to share") { at: W / 2 - band.w / 2 + 48, band.y - 8; anchor: left center; size: 13.5; weight: 600; color: ink }
            text pick(win.picking - 1, "This one, or another", "Press the one to share", "Press a window, or share a whole screen") { at: W / 2 - band.w / 2 + 48, band.y + 10; anchor: left center; size: 11; color: #8b8f95 }
            group {
                show: share.screens
                box { at: W / 2 + band.w / 2 - 190, band.y; size: 150, 36; corner: 18; color: mix(#1a2a25, #24524a, screen_glow.$s) }
                box { at: W / 2 + band.w / 2 - 190, band.y; size: 150, 36; corner: 18; stroke: 1.2; color: mint; opacity: 50% + 50% * screen_glow.$s }
                text "This whole screen" { at: W / 2 + band.w / 2 - 190, band.y; anchor: center; size: 12; weight: 600; color: ink }
                zone box share_screen.$s { at: W / 2 + band.w / 2 - 190, band.y; size: 150, 36; corner: 18; cursor: pointer; agent: no }
            }
            box { at: W / 2 + band.w / 2 - 62, band.y; size: 88, 36; corner: 18; color: mix(#1c1d1f, #3a2424, cancel_glow.$s) }
            text "Cancel" { at: W / 2 + band.w / 2 - 62, band.y; anchor: center; size: 12; weight: 500; color: ink }
            zone box share_cancel.$s { at: W / 2 + band.w / 2 - 62, band.y; size: 88, 36; corner: 18; cursor: pointer }
        }
        on enter share_screen.$s { screen_glow.$s: 1 }
        on leave share_screen.$s { screen_glow.$s: 0 }
        on enter share_cancel.$s { cancel_glow.$s: 1 }
        on leave share_cancel.$s { cancel_glow.$s: 0 }
        on press share_screen.$s { pick screen s }
        on press share_cancel.$s { pick none }
    }
    // The keyboard to the next one, or the one before.
    on focus_next { focus win(next) }
    on focus_previous { focus win(previous) }
    // Moving it: left, to lead (and if it already leads, to the monitor on the
    // left); right, to the monitor on the right; up and down, in the order.
    on move_left while fplace > 0.5 { promote win(win.focus) }
    on move_left while fplace < 0.5 and fscreen > 0.5 { send win(win.focus) to 0 }
    on move_right while fscreen < 0.5 { send win(win.focus) to 1 }
    on move_up { swap win(win.focus) with win(previous) }
    on move_down { swap win(win.focus) with win(next) }
    // The leader narrower or wider.
    on narrower { ratio = clamp(ratio - 0.05, 0.25, 0.8) }
    on wider { ratio = clamp(ratio + 0.05, 0.25, 0.8) }
    // ── into Marea's island, and out of it ──
    // A window put away is sucked into the island where Marea lives —on its
    // monitor, or on the other one: Marea says which (`island.screen`)—, up
    // first, shrinking and fading as it goes, over everything; brought back,
    // it comes out of it the same way. Drawn on every monitor it crosses, as
    // a carried one is: monitor 1 starts where monitor 0 ends.
    fact island.screen = -1
    repeat i in 0..16 {
        let sc = win.$i.screen
        // (Into its own monitor's shore, now; no longer Marea's island.)
        let isl = sc
        // (Eased in: the spring is quick at first, and the melting is to be seen.)
        let m = pow(mini.$i, 1.8)
        let off = pick(sc, mx.0, mx.1, mx.2, mx.3) - pick(screen.index, mx.0, mx.1, mx.2, mx.3)
        let x = x.$i + off
        let y = y.$i
        let w = w.$i
        let h = h.$i
        // Where it goes, from this monitor's corner: its place among the ones
        // put away on the shore.
        let tx = off + pick(sc, dk.x0.0, dk.x0.1, dk.x0.2, dk.x0.3) + 14 + pick(sc, win.docks.0, win.docks.1, win.docks.2, win.docks.3) * 60 + 20 + max(win.$i.minat, 0) * 76 + 38
        let ty = pick(sc, dk.cy.0, dk.cy.1, dk.cy.2, dk.cy.3)
        // On its way it melts into water: its corners round off, it turns
        // Marea's colour and draws out along its path like a falling
        // drop; halfway a real drop takes over, with two droplets behind it,
        // and where it lands the island ripples. Brought back, the same
        // backwards: the drop leaves the ripple and swells into the window.
        let q = smooth(0.05, 0.5, m)
        // (It shrinks to the size of the drop by the time the drop takes over.)
        let s0 = 1 - smooth(0, 0.62, m) * (1 - 22 / max(max(w, h), 22))
        let cx = x + w / 2 + (tx - x - w / 2) * m
        let cy = y + h / 2 + (ty - y - h / 2) * (2 * m - m * m)
        let round = 12 + q * min(w, h) * 0.5
        group {
            // (Hands over to the window at the same point it takes over: never
            // a frame with neither, which a spring's long tail made a second.)
            show: mini.$i > 0.02 and m < 0.75 and win.$i.open and (screen.index == sc or screen.index == isl)
            opacity: 1 - smooth(0.5, 0.68, m)
            pivot: x + w / 2, y + h / 2
            move: (tx - x - w / 2) * m, (ty - y - h / 2) * (2 * m - m * m)
            scale: s0 * (1 - 0.2 * sin(180 * m)), s0 * (1 + 0.25 * sin(180 * m))
            body {
                color: #0c0e10
                shadow: 0, 18 * (1 - q), 44, 55%
                box { from: x, y; size: w, h; corner: round }
            }
            group {
                clip box { from: x, y; size: w, h; corner: round }
                box { from: x, y; size: w, tb * hb.$i; color: #1d2b27; show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 110, 10); lines: 1; color: ink; opacity: hb.$i; show: hb.$i > 0.01 }
                // Its program keeps the size it has while it shrinks into the drop: the
                // picture is scaled, not the program asked (a browser asked for
                // 60 × 4 froze).
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: win.$i.width, win.$i.height }
                body {
                    gradient: x, y to x, y + h, #2b3030, marea 55%, #0e0f0f
                    opacity: 96% * q
                    box { from: x, y; size: w, h }
                }
            }
            box { from: x, y; size: w, h; corner: round; stroke: 1.5 + 2 * q; color: ink; opacity: 18% + 10% * q }
        }
        let drop = smooth(0.45, 0.62, m) * (1 - smooth(0.9, 0.995, m))
        let c1 = max(m - 0.07, 0)
        let c2 = max(m - 0.14, 0)
        group {
            show: drop > 0.01 and win.$i.open and (screen.index == sc or screen.index == isl)
            opacity: drop
            // Marea's own skin, and its tail melted into it.
            body {
                color: marea
                rim: 22%
                shadow: 0, 4, 12, 40%
                ellipse { at: cx, cy; radius: 11; scale: 1 - 0.2 * sin(180 * m), 1 + 0.3 * sin(180 * m) }
                ellipse { at: x + w / 2 + (tx - x - w / 2) * c1, y + h / 2 + (ty - y - h / 2) * (2 * c1 - c1 * c1); radius: 5.5; blend: 9 }
                ellipse { at: x + w / 2 + (tx - x - w / 2) * c2, y + h / 2 + (ty - y - h / 2) * (2 * c2 - c2 * c2); radius: 3.2; blend: 7 }
            }
            ellipse { at: cx - 3.5, cy - 4.5; radius: 2.4; scale: 1.3, 0.8; color: ink; opacity: 35% }
        }
        // Put away, it floats on its shore as it is, small, with its
        // program's icon; pressed, it comes back.
        let dm.x = tx
        let dm.h = 40
        let dm.w = clamp(40 * win.$i.width / max(win.$i.height, 1), 30, 68)
        group {
            z: 99983
            show: win.$i.minimized and win.$i.open and win.$i.minat >= 0 and mini.$i > 0.7 and sc == screen.index and pick(sc, shore.0, shore.1, shore.2, shore.3) > 0.3
            opacity: smooth(0.7, 0.95, mini.$i)
            body {
                color: #0c0e10
                rim: 14%
                shadow: 0, 3, 10, 40%
                box { at: dm.x, ty - 2 * dockmin.$i.hover; size: dm.w + 4, dm.h + 4; corner: 6 }
            }
            group {
                clip box { at: dm.x, ty - 2 * dockmin.$i.hover; size: dm.w, dm.h; corner: 4 }
                window win.$i { at: dm.x - dm.w / 2, ty - 2 * dockmin.$i.hover - dm.h / 2; size: dm.w, dm.h; ask: win.$i.width, win.$i.height }
            }
            image appicon.$i { at: dm.x + dm.w / 2 - 12, ty + dm.h / 2 - 12; size: 18, 18 }
            zone box dockmin.$i { at: dm.x, ty; size: dm.w + 10, dm.h + 10; corner: 8; cursor: pointer; active: not overview; label: "{win.$i.title}" }
        }
        on press dockmin.$i { restore win.$i }
        // Its preview, rising from the shore's water when its program's icon is
        // hovered a moment: the window as it is, live, and its title; pressed,
        // it is the one (brought back, if put away). A picture only: it asks
        // the window for no size (`ask: -1, -1`).
        let pvk = pick(sc, pv.0, pv.1, pv.2, pv.3)
        let pvn = pick(sc, pv.n.0, pv.n.1, pv.n.2, pv.n.3)
        let pvup = pick(sc, pvup.0, pvup.1, pvup.2, pvup.3)
        let pvw = min(210, 132 * max(win.$i.width, 1) / max(win.$i.height, 1))
        let pvh = min(132, 210 * max(win.$i.height, 1) / max(win.$i.width, 1))
        let pvx = pick(sc, pv.cx.0, pv.cx.1, pv.cx.2, pv.cx.3) + (win.$i.dockturn - (pvn - 1) / 2) * 232
        let pvy = pick(sc, pv.top.0, pv.top.1, pv.top.2, pv.top.3) + 78 + 30 * (1 - pvup)
        group {
            z: 99985
            show: pvk >= 0 and win.$i.dockat == pvk and win.$i.dockturn >= 0 and pvup > 0.01 and sc == screen.index
            opacity: pvup
            zone box dockpv.$i { at: pvx, pvy + 10; size: 222, 170; corner: 14; cursor: pointer; active: pvup > 0.9; label: "{win.$i.title}" }
            group {
                pivot: pvx, pvy + 70
                scale: 0.92 + 0.08 * pvup + 0.03 * dockpv.$i.hover
                body {
                    color: #0c0e10
                    rim: 12% + 10% * dockpv.$i.hover
                    shadow: 0, 12, 28, 45%
                    box { at: pvx, pvy + 10; size: 222, 170; corner: 14 }
                }
                group {
                    clip box { at: pvx, pvy; size: pvw, pvh; corner: 6 }
                    window win.$i { at: pvx - pvw / 2, pvy - pvh / 2; size: pvw, pvh; ask: -1, -1 }
                }
                text win.$i.title { at: pvx, pvy + 80; anchor: center; size: 11; weight: 500; width: 196; lines: 1; color: ink; opacity: 85% }
                box { at: pvx, pvy + 10; size: 222, 170; corner: 14; stroke: 1.4; color: mint; opacity: 70% * win.$i.focused }
            }
        }
        on press dockpv.$i while win.$i.minimized {
            restore win.$i
            focus win.$i
        }
        on press dockpv.$i while not win.$i.minimized { focus win.$i }
        on press dockpv.$i {
            pv.0 = -1
            pv.1 = -1
            pv.2 = -1
            pv.3 = -1
        }
        // The ripple where it lands (or leaves from).
        prop splash.$i = 1 ~900ms
        on change win.$i.minimized while win.$i.minimized {
            splash.$i: 0 ~0ms
            splash.$i: 1 after 430ms
        }
        on change win.$i.minimized while not win.$i.minimized and win.$i.open {
            splash.$i: 0 ~0ms
            splash.$i: 1 after 16ms
        }
        group {
            show: splash.$i > 0.001 and splash.$i < 0.995 and screen.index == isl and win.$i.open
            ellipse { at: tx, ty; radius: 4 + 30 * splash.$i; scale: 1, 0.45; stroke: 2.5 * (1 - splash.$i) + 0.6; color: ink; opacity: 45% * (1 - splash.$i) }
            ellipse { at: tx, ty; radius: 2 + 20 * max(splash.$i - 0.15, 0); scale: 1, 0.45; stroke: 2 * (1 - splash.$i) + 0.5; color: ink; opacity: 28% * (1 - splash.$i) }
            ellipse { at: tx, ty - 10 * sin(180 * splash.$i); radius: 2.4 * (1 - splash.$i); color: ink; opacity: 50% * (1 - splash.$i) }
        }
    }

    // ── fullscreen: one that asked (F11, a video, a game) or Super+F covers
    // its monitor, over the bar and the other programs' bars ──
    repeat i in 0..16 {
        let fs.ws = win.$i.pool == pick(win.$i.screen, inpool.0, inpool.1, inpool.2, inpool.3)
        let fs.here = win.$i.fullscreen and win.$i.open and win.$i.screen == screen.index and fs.ws
        prop fs.$i = 0 ~160ms
        follow fs.$i = if(win.$i.fullscreen and win.$i.open and fs.ws, 1, 0)
        group {
            show: fs.$i > 0.01 and win.$i.screen == screen.index
            opacity: fs.$i
            box { from: 0, 0; size: W, H; color: #000 }
            window win.$i { at: 0, 0; size: W, H; ask: W, H; show: fs.here }
        }
    }
    // ── dialogs: a message, a file chooser, a window of another's: over the
    // fullscreen ones too (drawn after them): a «Save image» asked by a
    // fullscreen viewer was hidden behind it, and being modal, the viewer
    // took nothing until it went —nobody could see it to close it—.
    // rest, at the size it chooses, in the middle of its monitor ──
    repeat i in 0..16 {
        let dw = max(win.$i.width, 120)
        let dh = max(win.$i.height, 40) + tb
        let dx = (W - dw) / 2
        let dy = (H - dh) / 2
        prop dlg.$i = 0 ~220ms
        let dlg.ws = win.$i.pool == pick(win.$i.screen, inpool.0, inpool.1, inpool.2, inpool.3)
        // The mouse going into it gives it the keyboard, as it does a window.
        let dlg.pointed = win.$i.dialog and win.$i.open and dlg.ws and win.$i.screen == mon and abs(mouse.x - Wmon / 2) <= dw / 2 and abs(mouse.y - Hmon / 2) <= dh / 2
        on change dlg.pointed while dlg.pointed and dragging < 0 and not overview { focus win.$i }
        follow dlg.$i = if(win.$i.dialog and win.$i.open and dlg.ws, 1, 0)
        group {
            show: dlg.$i > 0.01 and win.$i.screen == screen.index
            opacity: dlg.$i
            pivot: dx + dw / 2, dy + dh / 2
            scale: 0.94 + 0.06 * dlg.$i
            body {
                color: #0c0e10
                shadow: 0, 18, 44, 55%
                box { from: dx, dy; size: dw, dh; corner: 12 }
            }
            group {
                clip box { from: dx, dy; size: dw, dh; corner: 12 }
                box { from: dx, dy; size: dw, tb; color: #1d2b27 }
                text win.$i.title { at: dx + 14, dy + tb / 2; anchor: left center; size: 12; weight: 500; width: max(dw - 40, 10); lines: 1; color: ink }
                window win.$i { at: dx, dy + tb; size: win.$i.width, win.$i.height; ask: 0, 0; show: win.$i.dialog and win.$i.open and win.$i.screen == screen.index and dlg.ws }
            }
            box { from: dx, dy; size: dw, dh; corner: 12; stroke: 1.5; color: mint; opacity: 70% * win.$i.focused }
        }
    }

    // The rain itself, in front of everything: streaks, slanted a little.
    group {
        z: 100000
        show: wet > 0.001
        opacity: wet * (0.45 + 0.55 * pour)
        particles {
            at: W / 2, -40; area: W + 300, 1; count: 130
            life: 0.55s .. 0.9s; speed: 1600 .. 2100
            direction: 100deg; spread: 3deg; gravity: 0, 0
            size: 1.2, 0.9; colors: #e4f0ff, #c8dcf0; opacity: 24%, 12%
            shape: spark; emit: rain
        }
    }
    // (The rest of the downpour, only when it pours.)
    group {
        z: 100000
        show: wet > 0.001 and pour > 0.4
        opacity: wet * smooth(0.4, 0.9, pour)
        particles {
            at: W / 2, -40; area: W + 300, 1; count: 250
            life: 0.55s .. 0.9s; speed: 1600 .. 2100
            direction: 100deg; spread: 3deg; gravity: 0, 0
            size: 1.2, 0.9; colors: #e4f0ff, #c8dcf0; opacity: 24%, 12%
            shape: spark; emit: rain
        }
    }
    // And the snow, drifting down in front of everything: big slow flakes and
    // small quick ones.
    group {
        z: 100001
        show: cold > 0.001
        opacity: cold
        particles {
            at: W / 2, -20; area: W + 200, 1; count: 500
            life: 9s .. 12s; speed: 120 .. 170
            direction: 95deg; spread: 30deg; gravity: 0, 4
            size: 3.2, 2.6; colors: #ffffff, #e8f2ff; opacity: 85%, 60%
            shape: dot; emit: snow
        }
        particles {
            at: W / 2, -20; area: W + 200, 1; count: 700
            life: 7s .. 10s; speed: 150 .. 220
            direction: 100deg; spread: 20deg; gravity: 0, 6
            size: 1.8, 1.4; colors: #ffffff, #dfeaf7; opacity: 70%, 45%
            shape: dot; emit: snow
        }
    }
    // Marea follows the mouse from monitor to monitor: she is told which.
    on change mon while mon == 0 { launch "pleamar-wm --say marea 'emit pointer_monitor 0'" }
    on change mon while mon == 1 { launch "pleamar-wm --say marea 'emit pointer_monitor 1'" }
    on change mon while mon == 2 { launch "pleamar-wm --say marea 'emit pointer_monitor 2'" }
    on change mon while mon == 3 { launch "pleamar-wm --say marea 'emit pointer_monitor 3'" }
    // Tiled or free, on the monitor under the mouse (Super+W; Marea's menu too).
    event toggle_free
    on toggle_free while mon == 0 { free.0 = 1 - free.0 }
    on toggle_free while mon == 1 { free.1 = 1 - free.1 }
    on toggle_free while mon == 2 { free.2 = 1 - free.2 }
    on toggle_free while mon == 3 { free.3 = 1 - free.3 }

    // ── Marea rides a window ──
    // Marea asks (`emit ride`): she leaves her island by the top edge, and here
    // she drops onto the title bar of the window with the keyboard. She rides
    // it: carried, she leans against the move and sways when it stops; shaken
    // hard, she falls off. She hops to the window you settle on, jumps home
    // when hers closes or is put away, and a press on her sends her home too.
    // Back home, Marea is told (`ride_back`) and comes out of her island.
    // Everything here is in the desktop's coordinates —monitor 1 starts where
    // monitor 0 ends—, so she can ride a window from one monitor to the other.
    event ride
    event unride
    fact riding = false
    fact rider = -1
    fact homing = false
    fact falling = false
    fact from.x = 0
    fact from.y = 0
    fact fall.dir = 1
    prop hop = 1 ~650ms                  // from `from` to where she goes: 0 → 1
    prop drop = 0 ~1300ms                // falling off: 0 → 1
    // Leaning against the move, and swaying back when it stops.
    prop sway = 0 ~pop
    follow sway = clamp(-(mouse.x - lag.x) * 0.007, -0.55, 0.55) * (dragging == rider and rider >= 0)
    // Her real size, the one she has in her island: a 46 px body, eyes of
    // 5 × 13, 13 apart and 2.5 below the centre.
    let r.r = 23
    // Where Marea lives, as seen from the desktop: the island, just above the top edge.
    let r.isl = if(island.screen >= 0, island.screen, max(pick(max(rider, 0), win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen, win.6.screen, win.7.screen, win.8.screen, win.9.screen, win.10.screen, win.11.screen, win.12.screen, win.13.screen, win.14.screen, win.15.screen), 0))
    let home.rx = pick(r.isl, mx.0, mx.1, mx.2, mx.3) + pick(r.isl, screen.0.width, screen.1.width, screen.2.width, screen.3.width) / 2 - 50
    let home.ry = -40
    on ride while win.focus >= 0 and not riding {
        riding = true
        homing = false
        falling = false
        rider = win.focus
        from.x = pick(max(if(island.screen >= 0, island.screen, pick(win.focus, win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen, win.6.screen, win.7.screen, win.8.screen, win.9.screen, win.10.screen, win.11.screen, win.12.screen, win.13.screen, win.14.screen, win.15.screen)), 0), mx.0, mx.1, mx.2, mx.3) + pick(max(if(island.screen >= 0, island.screen, pick(win.focus, win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen, win.6.screen, win.7.screen, win.8.screen, win.9.screen, win.10.screen, win.11.screen, win.12.screen, win.13.screen, win.14.screen, win.15.screen)), 0), screen.0.width, screen.1.width, screen.2.width, screen.3.width) / 2 - 50
        from.y = -40
        hop: 0 ~0ms
        hop: 1 ~800ms after 16ms
    }
    // Nothing to ride: she stays at home.
    on ride while win.focus < 0 and not riding and screen.index == 0 { launch "pleamar-wm --say marea 'emit ride_back'" }
    // Home: Marea takes over.
    on still hop for 60ms while riding and homing and hop > 0.97 {
        riding = false
        homing = false
        rider = -1
    }
    on still hop for 60ms while riding and homing and hop > 0.97 and screen.index == 0 { launch "pleamar-wm --say marea 'emit ride_back'" }
    on still drop for 60ms while falling and drop > 0.97 {
        falling = false
        riding = false
        rider = -1
    }
    on still drop for 60ms while falling and drop > 0.97 and screen.index == 0 { launch "pleamar-wm --say marea 'emit ride_back'" }
    repeat i in 0..16 {
        let sc = win.$i.screen
        let carried = dragging == i or (landing == i and win.$i.open and win.$i.screen != landing.to)
        // (On a workspace sliding away, she slides away with it.)
        let ride.slide = 0
        // The window's corner on the desktop: where it is laid out, or where
        // the hand carries it.
        let wx = if(carried, mouse.x + pick(mon, mx.0, mx.1, mx.2, mx.3) - grab.x, x.$i + dx.$i + ride.slide + pick(sc, mx.0, mx.1, mx.2, mx.3))
        let wy = if(carried, mouse.y - grab.y, y.$i + dy.$i)
        // Her seat: on the top edge, left of the buttons; with no room above
        // it (tiled, against the top of the monitor), in the title bar itself.
        let seat.x = wx + max(w.$i * 0.5, w.$i - 140)
        // (Tiled there is no title bar: she sits astride its top edge.)
        let seat.y = if(wy - r.r + 2 > 8, wy - r.r + 2, wy + tb * hb.$i / 2 - 1)
        let to.x = if(homing, home.rx, seat.x)
        let to.y = if(homing, home.ry, seat.y)
        // On her way she goes up and comes down, like something with weight.
        let at.x = from.x + (to.x - from.x) * hop
        let at.y = from.y + (to.y - from.y) * hop - 130 * 4 * hop * (1 - hop)
        let off = pick(screen.index, mx.0, mx.1, mx.2, mx.3)
        // Settling on another window: she hops over to it.
        on still win.focus for 350ms while riding and not homing and not falling and rider == i and win.focus >= 0 and win.focus != i and not win.$i.minimized {
            from.x = at.x
            from.y = at.y
            rider = win.focus
            hop: 0 ~0ms
            hop: 1 ~650ms after 16ms
        }
        // Hers goes away —closed, put away— or she is asked: home.
        on change bye.$i while riding and rider == i and not homing and bye.$i > 0.5 {
            from.x = at.x
            from.y = at.y
            homing = true
            hop: 0 ~0ms
            hop: 1 ~700ms after 16ms
        }
        on change win.$i.minimized while riding and rider == i and not homing and win.$i.minimized {
            from.x = at.x
            from.y = at.y
            homing = true
            hop: 0 ~0ms
            hop: 1 ~700ms after 16ms
        }
        on unride while riding and rider == i and not homing and not falling {
            from.x = at.x
            from.y = at.y
            homing = true
            hop: 0 ~0ms
            hop: 1 ~700ms after 16ms
        }
        // Shaken hard while carried: she lets go.
        on change mouse.x while riding and rider == i and carried and not homing and not falling and hop > 0.97 and abs(mouse.x - lag.x) > 120 {
            from.x = at.x
            from.y = at.y
            fall.dir = -sign(mouse.x - lag.x)
            falling = true
            drop: 0 ~0ms
            drop: 1 ~1300ms after 16ms
        }
        // Her, as Marea looks: a drop of coal with two eyes that follow the mouse.
        // Stretched while in the air, leaning while carried.
        let st = clamp(abs(vel(hop)) * 0.06, 0, 0.3) * (1 - falling)
        let px = if(falling, from.x + fall.dir * 90 * drop, at.x) - off
        let py = if(falling, from.y - 40 * drop + 1500 * drop * drop, at.y)
        let look = clamp((pointer.x - px) / 160, -1, 1) * 3
        group {
            z: 99999
            show: riding and rider == i
            opacity: if(falling, 1 - drop * drop, 1)
            pivot: px, py + r.r
            rotate: sway + if(falling, fall.dir * drop * 3, 0)
            scale: 1 - st * 0.4, 1 + st
            body {
                color: marea
                rim: 10%
                shadow: 0, 4, 10, 35%
                ellipse { at: px, py; radius: r.r }
            }
            box { at: px - 6.5 + look, py + 2.5; size: 5, 13 * (1 - 0.6 * st); corner: 2.5; color: #f5f7f5 }
            box { at: px + 6.5 + look, py + 2.5; size: 5, 13 * (1 - 0.6 * st); corner: 2.5; color: #f5f7f5 }
            zone ellipse rider_zone.$i { at: px, py; radius: r.r + 4; cursor: pointer; active: riding and rider == i and not homing and not falling }
        }
        on press rider_zone.$i { emit unride }
    }

    // ── the phone's own (see `phone`, above): its water, its status line,
    // the bar at the bottom, the cards' deck and what to open ──
    event phone_cards
    event phone_next
    event phone_prev
    event phone_taken_back
    // From the phone's bottom edge (the page): up, the cards —or back to the
    // app—; sideways, the next app or the one before. In the cards, sideways
    // goes along the deck.
    on phone_cards while phone >= 0 {
        ph.cards = if(ph.home and ph.front >= 0 and ph.n > 0, 0, 1)
        ph.at = clamp(ph.kf, 0, max(ph.n - 1, 0))
    }
    on phone_next while ph.home { ph.at = clamp(round(ph.at) + 1, 0, max(ph.n - 1, 0)) }
    on phone_prev while ph.home { ph.at = clamp(round(ph.at) - 1, 0, max(ph.n - 1, 0)) }
    // The phone arrives: everything that was open comes in as a deck of
    // cards, and a moment later the one that had the keyboard opens out of
    // it to all of the screen.
    fact ph.intro = 0
    on change phone while phone >= 0 {
        ph.front = if(win.focus >= 0, win.focus, -1)
        ph.cards = 1
        ph.intro = 1
        ph.side = -1
        ph.solo = 0
        ph.fl = 1
        ph.ratio = 0.5
        ph.at = clamp(ph.kf, 0, max(ph.n - 1, 0))
    }
    on still phone for 1300ms while ph.intro > 0.5 and phone >= 0 {
        ph.intro = 0
        ph.cards = if(ph.front >= 0 and ph.n > 0, 0, 1)
    }
    on change phone while phone < 0 {
        ph.front = -1
        ph.cards = 0
    }
    // The one with the keyboard on the phone is the one in front.
    on change win.focus while phone >= 0 and win.focus >= 0 and fscreen == phone and not focus.dialog {
        // Two side by side and the other one touched: it is in front now,
        // and the one that was, beside it (each stays on its side).
        ph.fl = if(ph.split and win.focus == ph.sd, 1 - ph.fl, ph.fl)
        ph.side = if(ph.split and win.focus == ph.sd, ph.front, ph.side)
        ph.front = win.focus
    }
    // The deck goes along with a finger (the wheel, from the page), and
    // settles on a card.
    on scroll ph_deck while ph.n > 1 { ph.at = clamp(ph.at - wheel * 0.3, 0, ph.n - 1) }
    on still ph.at for 160ms while ph.at != round(ph.at) { ph.at = round(ph.at) }
    on release ph_bar {
        ph.cards = if(ph.home and ph.front >= 0 and ph.n > 0, 0, 1)
        ph.at = clamp(ph.kf, 0, max(ph.n - 1, 0))
    }
    // Two side by side: the line between them. Held and moved (a pointer, or
    // a finger held a moment first) or moved by a finger sideways, it makes
    // one wider; while it moves, the two wait under a veil with their names.
    let ph.lx = if(ph.lv >= 0, W * ph.lv, ph.xr)
    prop ph.veil = 0 ~220ms
    follow ph.veil = if(ph.lv >= 0, 1, 0)
    group {
        show: is.ph and ph.split and pc < 0.99
        z: 100600
        opacity: 1 - pc
        group {
            show: ph.veil > 0.01
            opacity: ph.veil
            box { from: 0, ph.sb; size: max(ph.lx - 4, 0), H - ph.sb - ph.hb; corner: 16; color: #0b1518; opacity: 92% }
            box { from: ph.lx + 4, ph.sb; size: max(W - ph.lx - 4, 0), H - ph.sb - ph.hb; corner: 16; color: #0b1518; opacity: 92% }
            group {
                show: ph.lx > 150
                opacity: smooth(150, 260, ph.lx)
                text pick(max(ph.front, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: ph.lx / 2, H / 2; anchor: center; size: 17; weight: 600; width: max(ph.lx - 60, 20); lines: 2; align: center; color: ink; show: ph.fl > 0.5 }
                text pick(max(ph.sd, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: ph.lx / 2, H / 2; anchor: center; size: 17; weight: 600; width: max(ph.lx - 60, 20); lines: 2; align: center; color: ink; show: ph.fl < 0.5 }
            }
            group {
                show: W - ph.lx > 150
                opacity: smooth(150, 260, W - ph.lx)
                text pick(max(ph.sd, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: (ph.lx + W) / 2, H / 2; anchor: center; size: 17; weight: 600; width: max(W - ph.lx - 60, 20); lines: 2; align: center; color: ink; show: ph.fl > 0.5 }
                text pick(max(ph.front, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: (ph.lx + W) / 2, H / 2; anchor: center; size: 17; weight: 600; width: max(W - ph.lx - 60, 20); lines: 2; align: center; color: ink; show: ph.fl < 0.5 }
            }
            // Near an edge, the one about to go fades out.
            box { from: 0, ph.sb; size: max(ph.lx - 4, 0), H - ph.sb - ph.hb; corner: 16; color: #05090b; opacity: 70% * (1 - smooth(0.08, 0.2, ph.lv)) }
            box { from: ph.lx + 4, ph.sb; size: max(W - ph.lx - 4, 0), H - ph.sb - ph.hb; corner: 16; color: #05090b; opacity: 70% * smooth(0.8, 0.92, ph.lv) }
        }
        // The line's handle, and which of the two has the keyboard.
        group {
            blur: 10
            box { at: ph.lx, (ph.sb + H - ph.hb) / 2; size: 8, 70; corner: 4; color: mint; opacity: 50% * ph.veil }
        }
        box { at: ph.lx, (ph.sb + H - ph.hb) / 2; size: 5, 52 + 18 * ph_div.hover + 18 * ph.veil; corner: 3; color: ink; opacity: 70% + 20% * ph_div.hover }
        box { at: ph.lx, (ph.sb + H - ph.hb) / 2; size: 5, 52 + 18 * ph_div.hover + 18 * ph.veil; corner: 3; color: mint; opacity: 90% * ph.veil }
        box { at: if(ph.fl > 0.5, ph.xr / 2, (ph.xr + W) / 2), ph.sb + 3; size: 40, 3; corner: 2; color: mint; opacity: 70% * (1 - ph.veil) }
        // (While it moves, all of the screen: the line goes from under the finger.)
        zone box ph_div { from: if(ph.lv >= 0, 0, ph.lx - 18), ph.sb; size: if(ph.lv >= 0, W, 36), H - ph.sb - ph.hb; cursor: grab; active: is.ph and ph.split and not ph.home; label: "The line between the two apps"; role: slider }
    }
    on press ph_div { ph.dv = 1 }
    on release ph_div while ph.dv > 0.5 {
        // To an edge, the other goes and the one left has all of it; else
        // the line settles at a third, the middle or two thirds.
        ph.front = if(ph.lv > 0.88, if(ph.fl > 0.5, ph.front, ph.sd), if(ph.lv < 0.12, if(ph.fl > 0.5, ph.sd, ph.front), ph.front))
        ph.solo = if(ph.lv > 0.88 or ph.lv < 0.12, 1, ph.solo)
        ph.side = if(ph.lv > 0.88 or ph.lv < 0.12, -1, ph.side)
        ph.ratio = if(ph.lv > 0.88 or ph.lv < 0.12, ph.ratio, if(ph.lv < 0.42, 0.34, if(ph.lv > 0.58, 0.66, 0.5)))
        ph.dv = 0
    }
    on scroll ph_div while ph.split { ph.wl = clamp(if(ph.wl < 0, ph.ratio, ph.wl) + wheel * 41 / max(W.ph, 1), 0.04, 0.96) }
    on still ph.wl for 380ms while ph.wl >= 0 and ph.dv < 0.5 {
        // To an edge, the other goes and the one left has all of it; else
        // the line settles at a third, the middle or two thirds.
        ph.front = if(ph.lv > 0.88, if(ph.fl > 0.5, ph.front, ph.sd), if(ph.lv < 0.12, if(ph.fl > 0.5, ph.sd, ph.front), ph.front))
        ph.solo = if(ph.lv > 0.88 or ph.lv < 0.12, 1, ph.solo)
        ph.side = if(ph.lv > 0.88 or ph.lv < 0.12, -1, ph.side)
        ph.ratio = if(ph.lv > 0.88 or ph.lv < 0.12, ph.ratio, if(ph.lv < 0.42, 0.34, if(ph.lv > 0.58, 0.66, 0.5)))
        ph.wl = -1
    }
    // The water behind: three soft lights that drift, now and then.
    prop phb.x.0 = 0.2 ~spring(8, 6)
    prop phb.y.0 = 0.25 ~spring(8, 6)
    prop phb.x.1 = 0.8 ~spring(7, 6)
    prop phb.y.1 = 0.55 ~spring(7, 6)
    prop phb.x.2 = 0.35 ~spring(9, 7)
    prop phb.y.2 = 0.85 ~spring(9, 7)
    fact phb.seed = 0
    // Only while it is seen (the cards, or no app): behind an app it kept the
    // phone's monitor put together, read back and encoded, frame after
    // frame, for a picture that did not change.
    every 4s..7s while phone >= 0 and ph.home {
        phb.seed = phb.seed + 1
        phb.x.0: 0.1 + 0.5 * random(phb.seed * 3 + 1)
        phb.y.0: 0.1 + 0.4 * random(phb.seed * 3 + 2)
        phb.x.1: 0.5 + 0.45 * random(phb.seed * 5 + 3)
        phb.y.1: 0.35 + 0.4 * random(phb.seed * 5 + 4)
        phb.x.2: 0.1 + 0.7 * random(phb.seed * 7 + 5)
        phb.y.2: 0.6 + 0.35 * random(phb.seed * 7 + 6)
    }
    group {
        show: is.ph
        z: 90000
        box { from: 0, 0; size: W, H; color: #071014 }
        group {
            blur: 70
            ellipse { at: W * phb.x.0, H * phb.y.0; radius: W * 0.55; color: #1f5a4c; opacity: 55% }
            ellipse { at: W * phb.x.1, H * phb.y.1; radius: W * 0.5; color: #173f5a; opacity: 50% }
            ellipse { at: W * phb.x.2, H * phb.y.2; radius: W * 0.45; color: #2a6b5b; opacity: 40% }
        }
        // Behind the cards the water darkens a little, as if it got deeper.
        box { from: 0, 0; size: W, H; color: #000000; opacity: 28% * pc }
        // Nothing open: the hour, large, and what can be done.
        group {
            show: ph.n < 1
            text now.time { at: W / 2, H * 0.3; anchor: center; size: 76; weight: 250; color: ink }
            text "Nothing open" { at: W / 2, H * 0.3 + 62; anchor: center; size: 15; weight: 600; color: ink; opacity: 75% }
            text "Open something from below" { at: W / 2, H * 0.3 + 86; anchor: center; size: 13; color: #9aa3a8 }
        }
        zone box ph_deck { from: 0, ph.sb; size: W, H - ph.sb - ph.hb - 92; active: is.ph and ph.home }
    }
    // What to open: the programs of the dock, along the bottom, under the cards.
    group {
        show: is.ph and pc > 0.01
        z: 180000
        opacity: pc
        group {
            blur: 24
            box { from: 18, H - ph.hb - 84 + 30 * (1 - pc); size: W - 36, 76; corner: 30; color: #000000; opacity: 35% }
        }
        body {
            color: #0d1519
            rim: 14%
            box { from: 18, H - ph.hb - 84 + 30 * (1 - pc); size: W - 36, 76; corner: 30 }
        }
        group {
            show: phone == 0 and 0 < win.docks.0
            let ax = W / 2 + (0 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.0.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.0.hover }
            image dockicon.0.0 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.0.windows > 0 }
            zone ellipse phapp.0.0 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.0.name}"; role: button }
        }
        group {
            show: phone == 0 and 1 < win.docks.0
            let ax = W / 2 + (1 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.1.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.1.hover }
            image dockicon.0.1 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.1.windows > 0 }
            zone ellipse phapp.0.1 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.1.name}"; role: button }
        }
        group {
            show: phone == 0 and 2 < win.docks.0
            let ax = W / 2 + (2 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.2.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.2.hover }
            image dockicon.0.2 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.2.windows > 0 }
            zone ellipse phapp.0.2 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.2.name}"; role: button }
        }
        group {
            show: phone == 0 and 3 < win.docks.0
            let ax = W / 2 + (3 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.3.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.3.hover }
            image dockicon.0.3 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.3.windows > 0 }
            zone ellipse phapp.0.3 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.3.name}"; role: button }
        }
        group {
            show: phone == 0 and 4 < win.docks.0
            let ax = W / 2 + (4 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.4.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.4.hover }
            image dockicon.0.4 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.4.windows > 0 }
            zone ellipse phapp.0.4 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.4.name}"; role: button }
        }
        group {
            show: phone == 0 and 5 < win.docks.0
            let ax = W / 2 + (5 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.5.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.5.hover }
            image dockicon.0.5 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.5.windows > 0 }
            zone ellipse phapp.0.5 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.5.name}"; role: button }
        }
        group {
            show: phone == 1 and 0 < win.docks.1
            let ax = W / 2 + (0 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.0.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.0.hover }
            image dockicon.1.0 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.0.windows > 0 }
            zone ellipse phapp.1.0 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.0.name}"; role: button }
        }
        group {
            show: phone == 1 and 1 < win.docks.1
            let ax = W / 2 + (1 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.1.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.1.hover }
            image dockicon.1.1 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.1.windows > 0 }
            zone ellipse phapp.1.1 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.1.name}"; role: button }
        }
        group {
            show: phone == 1 and 2 < win.docks.1
            let ax = W / 2 + (2 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.2.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.2.hover }
            image dockicon.1.2 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.2.windows > 0 }
            zone ellipse phapp.1.2 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.2.name}"; role: button }
        }
        group {
            show: phone == 1 and 3 < win.docks.1
            let ax = W / 2 + (3 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.3.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.3.hover }
            image dockicon.1.3 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.3.windows > 0 }
            zone ellipse phapp.1.3 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.3.name}"; role: button }
        }
        group {
            show: phone == 1 and 4 < win.docks.1
            let ax = W / 2 + (4 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.4.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.4.hover }
            image dockicon.1.4 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.4.windows > 0 }
            zone ellipse phapp.1.4 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.4.name}"; role: button }
        }
        group {
            show: phone == 1 and 5 < win.docks.1
            let ax = W / 2 + (5 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.5.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.5.hover }
            image dockicon.1.5 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.5.windows > 0 }
            zone ellipse phapp.1.5 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.5.name}"; role: button }
        }
        group {
            show: phone == 2 and 0 < win.docks.2
            let ax = W / 2 + (0 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.0.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.0.hover }
            image dockicon.2.0 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.0.windows > 0 }
            zone ellipse phapp.2.0 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.0.name}"; role: button }
        }
        group {
            show: phone == 2 and 1 < win.docks.2
            let ax = W / 2 + (1 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.1.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.1.hover }
            image dockicon.2.1 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.1.windows > 0 }
            zone ellipse phapp.2.1 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.1.name}"; role: button }
        }
        group {
            show: phone == 2 and 2 < win.docks.2
            let ax = W / 2 + (2 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.2.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.2.hover }
            image dockicon.2.2 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.2.windows > 0 }
            zone ellipse phapp.2.2 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.2.name}"; role: button }
        }
        group {
            show: phone == 2 and 3 < win.docks.2
            let ax = W / 2 + (3 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.3.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.3.hover }
            image dockicon.2.3 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.3.windows > 0 }
            zone ellipse phapp.2.3 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.3.name}"; role: button }
        }
        group {
            show: phone == 2 and 4 < win.docks.2
            let ax = W / 2 + (4 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.4.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.4.hover }
            image dockicon.2.4 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.4.windows > 0 }
            zone ellipse phapp.2.4 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.4.name}"; role: button }
        }
        group {
            show: phone == 2 and 5 < win.docks.2
            let ax = W / 2 + (5 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.5.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.5.hover }
            image dockicon.2.5 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.5.windows > 0 }
            zone ellipse phapp.2.5 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.5.name}"; role: button }
        }
        group {
            show: phone == 3 and 0 < win.docks.3
            let ax = W / 2 + (0 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.0.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.0.hover }
            image dockicon.3.0 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.0.windows > 0 }
            zone ellipse phapp.3.0 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.0.name}"; role: button }
        }
        group {
            show: phone == 3 and 1 < win.docks.3
            let ax = W / 2 + (1 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.1.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.1.hover }
            image dockicon.3.1 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.1.windows > 0 }
            zone ellipse phapp.3.1 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.1.name}"; role: button }
        }
        group {
            show: phone == 3 and 2 < win.docks.3
            let ax = W / 2 + (2 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.2.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.2.hover }
            image dockicon.3.2 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.2.windows > 0 }
            zone ellipse phapp.3.2 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.2.name}"; role: button }
        }
        group {
            show: phone == 3 and 3 < win.docks.3
            let ax = W / 2 + (3 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.3.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.3.hover }
            image dockicon.3.3 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.3.windows > 0 }
            zone ellipse phapp.3.3 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.3.name}"; role: button }
        }
        group {
            show: phone == 3 and 4 < win.docks.3
            let ax = W / 2 + (4 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.4.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.4.hover }
            image dockicon.3.4 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.4.windows > 0 }
            zone ellipse phapp.3.4 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.4.name}"; role: button }
        }
        group {
            show: phone == 3 and 5 < win.docks.3
            let ax = W / 2 + (5 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.5.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.5.hover }
            image dockicon.3.5 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.5.windows > 0 }
            zone ellipse phapp.3.5 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.5.name}"; role: button }
        }
    }
    on release phapp.0.0 {
        dock 0 on 0
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.0.1 {
        dock 1 on 0
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.0.2 {
        dock 2 on 0
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.0.3 {
        dock 3 on 0
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.0.4 {
        dock 4 on 0
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.0.5 {
        dock 5 on 0
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.1.0 {
        dock 0 on 1
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.1.1 {
        dock 1 on 1
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.1.2 {
        dock 2 on 1
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.1.3 {
        dock 3 on 1
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.1.4 {
        dock 4 on 1
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.1.5 {
        dock 5 on 1
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.2.0 {
        dock 0 on 2
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.2.1 {
        dock 1 on 2
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.2.2 {
        dock 2 on 2
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.2.3 {
        dock 3 on 2
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.2.4 {
        dock 4 on 2
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.2.5 {
        dock 5 on 2
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.3.0 {
        dock 0 on 3
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.3.1 {
        dock 1 on 3
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.3.2 {
        dock 2 on 3
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.3.3 {
        dock 3 on 3
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.3.4 {
        dock 4 on 3
        ph.cards = 0
        ph.front = -1
    }
    on release phapp.3.5 {
        dock 5 on 3
        ph.cards = 0
        ph.front = -1
    }
    // The status line and the bar at the bottom, over everything.
    group {
        show: is.ph
        z: 200000
        box { from: 0, 0; size: W, ph.sb; color: #05090b; opacity: 80% * (1 - pc) }
        text now.time { at: 22, ph.sb / 2 + 1; anchor: left center; size: 13.5; weight: 700; color: ink }
        // The app in front, beside the hour: the middle is Marea's (her island).
        text pick(max(ph.front, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: 66, ph.sb / 2 + 1; anchor: left center; size: 12; weight: 600; width: W / 2 - 112; lines: 1; color: ink; opacity: 70% * (1 - pc); show: ph.front >= 0 }
        ellipse { at: W - 82, ph.sb / 2 + 1; radius: 3.5; color: mint }
        text "pleamar" { at: W - 74, ph.sb / 2 + 1; anchor: left center; size: 12.5; weight: 600; color: ink; opacity: 80% }
        box { from: 0, H - ph.hb; size: W, ph.hb; color: #05090b; opacity: 80% * (1 - pc) }
        box { at: W / 2, H - ph.hb / 2; size: 132 + 24 * ph_bar.hover, 5; corner: 3; color: ink; opacity: 75% }
        zone box ph_bar { from: W / 2 - 110, H - ph.hb - 6; size: 220, ph.hb + 6; cursor: pointer; active: is.ph; label: "Apps"; role: button }
    }

    // ── while the session is on the phone, the real monitors are covered:
    // whoever walks past sees where it went, not what is being done. A key
    // or the mouse here brings it back, locked (the session says so). ──
    prop curtain.wave = 0 ~2600ms
    prop curtain.float = 0 ~spring(6, 5)
    fact curtain.n = 0
    every 2600ms while phone >= 0 {
        curtain.n = curtain.n + 1
        curtain.wave: 0 ~0ms
        curtain.wave: 1 ~2600ms after 16ms
        curtain.float: if(mod(curtain.n, 2) == 0, -8, 8)
    }
    prop curtain.shown = 0 ~700ms
    follow curtain.shown = if(phone >= 0, 1, 0)
    surface phone_curtain {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 4
        open: curtain.shown > 0.001 and screen.index != phone
        // Nobody is at the desk to watch it: a few frames a second. At the
        // monitor's own rate (165 Hz) its blurs took most of the card while
        // the phone's monitor and its encoder were waiting for it.
        rate: 20
        // (Each copy, its own monitor's: the surface's own measure is one for all of them.)
        let cw.w = pick(screen.index, screen.0.width, screen.1.width, screen.2.width, screen.3.width)
        let cw.h = pick(screen.index, screen.0.height, screen.1.height, screen.2.height, screen.3.height)
        let cx = cw.w / 2
        let cy = cw.h / 2 - 40 + curtain.float
        box { from: 0, 0; size: cw.w, cw.h; color: #05090b; opacity: 94% * curtain.shown }
        // The windows that were here pour into the phone (over the dark,
        // not faded in with the rest).
        repeat i in 0..16 {
            let t = smooth(0, 1, pour.$i)
            let pw = mix(gw.$i, 18, t)
            let ph2 = mix(gh.$i, 30, t)
            let px = mix(gx.$i + gw.$i / 2, cx, t)
            let py = mix(gy.$i + gh.$i / 2, cy + 40 * t * (1 - t), t)
            group {
                show: pour.$i < 0.995 and sc.last.$i == screen.index and win.$i.open and not win.$i.dialog
                opacity: 1 - smooth(0.65, 1, pour.$i)
                body {
                    color: #0c0e10
                    shadow: 0, 18, 40, 50%
                    box { at: px, py; size: pw, ph2; corner: 12 + 10 * t }
                }
                group {
                    clip box { at: px, py; size: pw, ph2; corner: 12 + 10 * t }
                    window win.$i { at: px - pw / 2, py - ph2 / 2; size: pw, ph2; ask: -1, -1 }
                }
            }
        }
        group {
            opacity: curtain.shown
            group {
                blur: 90
                ellipse { at: cx, cy; radius: 260; color: #1f5a4c; opacity: 45% }
            }
            // Rings of water going out from it.
            ellipse { at: cx, cy; radius: 70 + 220 * curtain.wave; stroke: 1.5; color: mint; opacity: 30% * (1 - curtain.wave) }
            ellipse { at: cx, cy; radius: 70 + 110 * curtain.wave; stroke: 1; color: mint; opacity: 18% * (1 - curtain.wave) }
            // The phone.
            group {
                blur: 18
                box { at: cx, cy; size: 112, 214; corner: 22; stroke: 6; color: mint; opacity: 35% }
            }
            body {
                color: #0b1316
                rim: 20%
                box { at: cx, cy; size: 112, 214; corner: 22 }
            }
            box { at: cx, cy; size: 112, 214; corner: 22; stroke: 1.6; color: mint; opacity: 85% }
            box { at: cx, cy - 92; size: 30, 5; corner: 3; color: mint; opacity: 50% }
            box { at: cx, cy + 96; size: 34, 3; corner: 2; color: ink; opacity: 60% }
            // Its water, sloshing.
            group {
                clip box { at: cx, cy; size: 106, 208; corner: 19 }
                ellipse { at: cx - 20 + curtain.float * 2, cy + 74; radius: 90; scale: 1, 0.35; color: #2a6b5b; opacity: 70% }
                ellipse { at: cx + 26 - curtain.float * 2, cy + 86; radius: 80; scale: 1, 0.3; color: #9ed6bd; opacity: 35% }
            }
            text "Your session is on your phone" { at: cx, cy + 160; anchor: center; size: 24; weight: 650; color: ink }
            text "Touch a key or the mouse here to bring it back · it will ask you to unlock" { at: cx, cy + 194; anchor: center; size: 13.5; color: #9aa3a8 }
        }
    }

    // ── this desktop used from elsewhere (`pleamar-wm remote`) ──
    // While someone is in from another computer, whoever sits here sees it:
    // the edges glow amber —the monitor they look at, brighter— and a pill
    // says from where, and how to send them away. All of it on a surface
    // left out of captures: the one using it from elsewhere sees the desktop
    // as it is, without this over it. It takes no clicks (a button there
    // would be invisible from there, waiting to be pressed by mistake):
    // Super+Shift+Escape ends it.
    fact remote.on = 0
    fact remote.screen = -1
    text remote.who = ""
    prop remote.shown = 0 ~900ms
    follow remote.shown = remote.on
    surface remote_mark {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 4
        captures: hidden
        // Not on the phone's monitor: nobody sits at it, and a surface left out
        // of its pictures made each of them be drawn again without it,
        // instead of read straight from what was put together.
        open: remote.shown > 0.001 and screen.index != phone
        let rm.w = remote_mark.width
        let rm.h = remote_mark.height
        let rm.here = remote.screen == screen.index
        group {
            opacity: remote.shown * if(rm.here, 1, 0.45)
            group {
                blur: 20
                opacity: 38%
                box { from: 4, 4; size: rm.w - 8, rm.h - 8; corner: 18; stroke: 9; color: amber }
            }
            box { from: 2, 2; size: rm.w - 4, rm.h - 4; corner: 16; stroke: 1.5; color: amber; opacity: 60% }
        }
        group {
            opacity: remote.shown
            show: rm.here
            body {
                color: #0c0f12
                rim: 16%
                shadow: 0, 6, 18, 40%
                box { at: 186, rm.h - 30; size: 340, 38; corner: 19 }
            }
            ellipse { at: 34, rm.h - 30; radius: 5; color: amber }
            text "Used from elsewhere · {remote.who}" { at: 48, rm.h - 36; anchor: left center; size: 11.5; weight: 600; color: ink }
            text "Super+Shift+Esc sends them away" { at: 48, rm.h - 22; anchor: left center; size: 10.5; color: #9aa3a8 }
        }
    }

    // ── a computer-use agent's cursors (`agent on` in session.conf) ──
    // An agent (Cua Driver) drives the windows with a pointer of its own: the
    // compositor says where each of its cursors is, on which monitor, and
    // when it presses. It is drawn here, in mint, over everything: a second
    // cursor that moves on its own, a ring where it clicks, and its name. It
    // fades a few seconds after it last did something.
    // The monitor it works on says so, apart from its cursors: its edges
    // glow in mint, breathing slowly, a soft light goes round them, and a
    // pill says an agent is using it. The window it works on gets an outline
    // (in the windows' loop). It stays while the agent is at work —thinking
    // between one action and the next is working too: the compositor says
    // when it is (`agent.active`)— and fades slowly after.
    fact agent.seen = 0
    fact agent.screen = -1
    fact agent.win = -1
    fact agent.active = 0
    prop agent.on = 0 ~1600ms
    follow agent.on = agent.active
    prop agent.t = 0
    spin agent.t by if(agent.on > 0.01, 1, 0)
    let ag.here = agent.on > 0.01 and agent.screen == screen.index
    // Where the light that goes round the edges is: one lap every 30 s, calm.
    let ag.lap = fract(agent.t / 30) * 2 * (W + H)
    let ag.lx = if(ag.lap < W, ag.lap, if(ag.lap < W + H, W, if(ag.lap < 2 * W + H, 2 * W + H - ag.lap, 0)))
    let ag.ly = if(ag.lap < W, 0, if(ag.lap < W + H, ag.lap - W, if(ag.lap < 2 * W + H, H, 2 * (W + H) - ag.lap)))
    // A breath every 8 s.
    let ag.breath = 0.5 + 0.5 * sin(agent.t * 45)
    group {
        z: 99995
        show: ag.here
        opacity: agent.on
        // The edges: a wide soft glow, and a thin bright line on them.
        group {
            blur: 22
            opacity: 40% + 12% * ag.breath
            box { from: 4, 4; size: W - 8, H - 8; corner: 18; stroke: 10; color: mint }
        }
        box { from: 2, 2; size: W - 4, H - 4; corner: 16; stroke: 1.5; color: mint; opacity: 55% }
        // And the light going round them, soft.
        group {
            blur: 16
            ellipse { at: ag.lx, ag.ly; radius: 34; color: mint; opacity: 35% }
        }
        // The pill, in the bottom right corner (the top middle is Marea's): a
        // dot that beats, what is going on, and «Stop»: the agent's hands are
        // refused from then on (it hears that you stopped it), whoever it is.
        let ag.px = W - 196
        let ag.py = H - 30
        body {
            color: #0c0f12
            rim: 16%
            shadow: 0, 6, 18, 40%
            box { at: ag.px, ag.py; size: 340, 30; corner: 15 }
        }
        ellipse { at: ag.px - 152, ag.py; radius: 4 + 2 * ag.breath; color: mint }
        ellipse { at: ag.px - 152, ag.py; radius: 9 * ag.breath + 4; stroke: 1.2; color: mint; opacity: 60% * (1 - ag.breath) }
        text "An agent is using this monitor" { at: ag.px - 28, ag.py + 0.5; anchor: center; size: 11.5; weight: 600; color: ink }
        box { at: ag.px + 130, ag.py; size: 64, 22; corner: 11; color: #ef7a66; opacity: 18% + 30% * ag.stop.hover }
        box { at: ag.px + 109, ag.py; size: 7, 7; corner: 1.5; color: #ef7a66 }
        text "Stop" { at: ag.px + 136, ag.py + 0.5; anchor: center; size: 11.5; weight: 700; color: #ffb3a6 }
    }
    prop ag.stop.hover = 0 ~120ms
    zone box ag_stop { at: W - 66, H - 30; size: 64, 22; cursor: pointer; active: ag.here and agent.on > 0.5; agent: no }
    on enter ag_stop { ag.stop.hover: 1 }
    on leave ag_stop { ag.stop.hover: 0 }
    on press ag_stop { launch "pleamar-wm agent stop" }
    // Who it is (`PLEAMAR_AGENT_NAME`: Marea says hers), for its label.
    text agent.name = "agent"
    // Where each cursor is, as pleamar-wm says (on its monitor, in units).
    fact agent.0.x = 0
    fact agent.0.y = 0
    fact agent.0.screen = 0
    fact agent.0.down = 0
    fact agent.0.seen = 0
    fact agent.1.x = 0
    fact agent.1.y = 0
    fact agent.1.screen = 0
    fact agent.1.down = 0
    fact agent.1.seen = 0
    // The cursors on a surface of their own, over everything on the monitor:
    // over the programs' menus too (a browser's right-click menu hid it).
    // Only drawn: clicks go through.
    surface agent_hands {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 4
        open: agent.on > 0.001 or agent.active
        repeat k in 0..2 {
            // `pleamar-wm agent` takes it along the way, as a hand would;
            // this only smooths the steps.
            prop ag.$k.x = 0 ~140ms
            prop ag.$k.y = 0 ~140ms
            prop ag.$k.on = 0 ~220ms
            prop ag.$k.press = 0 ~90ms
            prop ag.$k.ring = 1 ~560ms
            follow ag.$k.x = agent.$k.x
            follow ag.$k.y = agent.$k.y
            follow ag.$k.press = agent.$k.down
            // Seen again after a while, or on another monitor: where it is, at
            // once, not flying in from where it was.
            on change agent.$k.seen while ag.$k.on < 0.05 {
                ag.$k.x: agent.$k.x ~0ms
                ag.$k.y: agent.$k.y ~0ms
            }
            on change agent.$k.screen {
                ag.$k.x: agent.$k.x ~0ms
                ag.$k.y: agent.$k.y ~0ms
            }
            on change agent.$k.seen { ag.$k.on: 1 }
            // It stays while the agent is at work —it thinks between two steps,
            // and a cursor that went and came back did not seem to move—, and
            // goes when it is done.
            on change agent.active while not agent.active { ag.$k.on: 0 ~900ms }
            on change agent.$k.down while agent.$k.down > 0.5 {
                ag.$k.ring: 0 ~0ms
                ag.$k.ring: 1 after 16ms
            }
            let ax = ag.$k.x
            let ay = ag.$k.y
            measure tag.$k
            group {
                show: ag.$k.on > 0.01 and agent.$k.screen == screen.index
                opacity: ag.$k.on
                // Where it clicks: a ring that spreads.
                ellipse { at: ax, ay; radius: 4 + 22 * ag.$k.ring; stroke: 2.2 * (1 - ag.$k.ring) + 0.4; color: if(k == 0, mint, #c9b3f2); opacity: 80% * (1 - ag.$k.ring) }
                group {
                    pivot: ax, ay
                    scale: 1 - 0.12 * ag.$k.press, 1 - 0.12 * ag.$k.press
                    // A soft light under it, so it is found on any window.
                    ellipse { at: ax + 5, ay + 8; radius: 15; color: if(k == 0, mint, #c9b3f2); opacity: 16% }
                    // The arrow: dark edge, mint body, its tip on the point.
                    path { at: ax - 1.2, ay - 1.6; color: #0c0f12
                           move 0, 0; line 0, 21; line 5.6, 16; line 9.2, 24.2; line 13, 22.6; line 9.5, 14.6; line 16.4, 14.6; close }
                    path { at: ax, ay; color: if(k == 0, mint, #c9b3f2)
                           move 0, 0; line 0, 17.5; line 4.6, 13.4; line 7.8, 20.6; line 10.2, 19.6; line 7.1, 12.6; line 12.6, 12.6; close }
                }
                // Its name, up and to the right of the tip: a page's tooltip
                // opens below the pointer, and the name sat on it.
                body {
                    color: #0c0f12
                    rim: 14%
                    box { from: ax + 16, ay - 21; size: tag.$k.width + 16, 18; corner: 9 }
                }
                text agent.name { at: ax + 24, ay - 11.5; anchor: left center; size: 10; weight: 600; color: if(k == 0, mint, #c9b3f2); measure: tag.$k }
            }
        }
    }
}
