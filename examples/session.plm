            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 7 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 8 == pc.n.3 and win.used.3 < 8 }
            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 7 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 8 == pc.n.3 and win.used.3 < 8 }
            text "8" { at: pc.x.3 - 12, (pc.y.3 + 7 * (pc.h.3 + 20)) + pc.h.3 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(8 == win.shown.3, 85%, 40%) }
