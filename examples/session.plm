                box { at: (dk.x0.3 + 14 + max(dmenu.3, 0) * 60 + 30), mn.y.3; size: 160, 28; corner: 9; color: #ef7a66; opacity: 12% * dmclose.3.hover }
                text "Close its windows" { at: (dk.x0.3 + 14 + max(dmenu.3, 0) * 60 + 30) - 68, mn.y.3; anchor: left center; size: 12; weight: 500; color: #ef7a66 }
            }
        }
    }
    on press dmpin.3 while dmenu.3 == 0 and win.dock.3.0.pinned > 0.5 {
        dock 0 on 3 unpin
        dmenu.3 = -1
    }
    on press dmpin.3 while dmenu.3 == 0 and win.dock.3.0.pinned < 0.5 {
        dock 0 on 3 pin
        dmenu.3 = -1
    }
    on press dmclose.3 while dmenu.3 == 0 {
        dock 0 on 3 close
        dmenu.3 = -1
    }
    on press dmpin.3 while dmenu.3 == 1 and win.dock.3.1.pinned > 0.5 {
        dock 1 on 3 unpin
        dmenu.3 = -1
    }
    on press dmpin.3 while dmenu.3 == 1 and win.dock.3.1.pinned < 0.5 {
        dock 1 on 3 pin
        dmenu.3 = -1
