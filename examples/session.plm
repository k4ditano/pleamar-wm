    // ── the pools at a glance (Super+Tab): beside the windows of the pool
    // shown, a column of cards at the right of each monitor, one per pool,
    // each with its windows as they are laid out and their programs' icons
    // —that is its name—, the empty one last with a +. A card pressed shows
    // its pool; dragged to the other monitor, the whole pool goes there. A
    // window dragged onto a card goes to that pool, on either monitor ──
    fact ovdrag = -1
    fact pdrag.s = -1
    fact pdrag.k = 0
    image appicon.0 = from win.0.icon, 64, 64
    image appicon.1 = from win.1.icon, 64, 64
    image appicon.2 = from win.2.icon, 64, 64
    image appicon.3 = from win.3.icon, 64, 64
    image appicon.4 = from win.4.icon, 64, 64
    image appicon.5 = from win.5.icon, 64, 64
    image appicon.6 = from win.6.icon, 64, 64
    image appicon.7 = from win.7.icon, 64, 64
    image appicon.8 = from win.8.icon, 64, 64
    image appicon.9 = from win.9.icon, 64, 64
    image appicon.10 = from win.10.icon, 64, 64
    image appicon.11 = from win.11.icon, 64, 64
    image appicon.12 = from win.12.icon, 64, 64
    image appicon.13 = from win.13.icon, 64, 64
    image appicon.14 = from win.14.icon, 64, 64
    image appicon.15 = from win.15.icon, 64, 64
    let pc.n.0 = max(win.pools.0, win.used.0 + 1)
    let pc.w.0 = min(screen.0.width * 0.12, (screen.0.height - 160 - (pc.n.0 - 1) * 20) / pc.n.0 * screen.0.width / max(screen.0.height, 1))
    let pc.h.0 = pc.w.0 * screen.0.height / max(screen.0.width, 1)
    let pc.x.0 = screen.0.width - pc.w.0 - 40
    let pc.y.0 = screen.0.height / 2 - (pc.n.0 * pc.h.0 + (pc.n.0 - 1) * 20) / 2
    let pc.n.1 = max(win.pools.1, win.used.1 + 1)
    let pc.w.1 = min(screen.1.width * 0.12, (screen.1.height - 160 - (pc.n.1 - 1) * 20) / pc.n.1 * screen.1.width / max(screen.1.height, 1))
    let pc.h.1 = pc.w.1 * screen.1.height / max(screen.1.width, 1)
    let pc.x.1 = screen.1.width - pc.w.1 - 40
    let pc.y.1 = screen.1.height / 2 - (pc.n.1 * pc.h.1 + (pc.n.1 - 1) * 20) / 2
    let pc.n.2 = max(win.pools.2, win.used.2 + 1)
    let pc.w.2 = min(screen.2.width * 0.12, (screen.2.height - 160 - (pc.n.2 - 1) * 20) / pc.n.2 * screen.2.width / max(screen.2.height, 1))
    let pc.h.2 = pc.w.2 * screen.2.height / max(screen.2.width, 1)
    let pc.x.2 = screen.2.width - pc.w.2 - 40
    let pc.y.2 = screen.2.height / 2 - (pc.n.2 * pc.h.2 + (pc.n.2 - 1) * 20) / 2
    let pc.n.3 = max(win.pools.3, win.used.3 + 1)
    let pc.w.3 = min(screen.3.width * 0.12, (screen.3.height - 160 - (pc.n.3 - 1) * 20) / pc.n.3 * screen.3.width / max(screen.3.height, 1))
    let pc.h.3 = pc.w.3 * screen.3.height / max(screen.3.width, 1)
    let pc.x.3 = screen.3.width - pc.w.3 - 40
    let pc.y.3 = screen.3.height / 2 - (pc.n.3 * pc.h.3 + (pc.n.3 - 1) * 20) / 2
    // Where the mouse is among its monitor's cards: which one it is over.
    let pc.mn = pick(mon, pc.n.0, pc.n.1, pc.n.2, pc.n.3)
    let pc.mw = pick(mon, pc.w.0, pc.w.1, pc.w.2, pc.w.3)
    let pc.mh = pick(mon, pc.h.0, pc.h.1, pc.h.2, pc.h.3)
    let pc.mx = pick(mon, pc.x.0, pc.x.1, pc.x.2, pc.x.3)
    let pc.my = pick(mon, pc.y.0, pc.y.1, pc.y.2, pc.y.3)
    let on.col = overview and mouse.x >= pc.mx - 24 and mouse.x <= pc.mx + pc.mw + 24
    let drop.k = if(on.col, floor((mouse.y - pc.my + 10) / (pc.mh + 20)) + 1, 0)
    let drop.ok = drop.k >= 1 and drop.k <= pc.mn
    group {
        z: 99985
        show: ov > 0.01 and screen.index == 0
        group {
            show: 0 < pc.n.0
            opacity: smooth(0.00, 0.55, ov) * if(pdrag.s == 0 and pdrag.k == 0, 40%, 100%)
            move: 70 * (1 - smooth(0.00, 0.55, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.0.0.hover, (overview and drop.ok and mon == 0 and drop.k == 1 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.0.0.hover, 28, 45%
                box { from: pc.x.0, (pc.y.0 + 0 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10 }
            }
            box { from: pc.x.0 - 3, (pc.y.0 + 0 * (pc.h.0 + 20)) - 3; size: pc.w.0 + 6, pc.h.0 + 6; corner: 13; stroke: 1.6; color: mint; opacity: if(1 == win.shown.0, 85%, 0%) + 60% * (overview and drop.ok and mon == 0 and drop.k == 1 and (ovdrag >= 0 or pdrag.s >= 0)) }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 0 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 1 == pc.n.0 and win.used.0 < 1 }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 0 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 1 == pc.n.0 and win.used.0 < 1 }
            text "1" { at: pc.x.0 - 12, (pc.y.0 + 0 * (pc.h.0 + 20)) + pc.h.0 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(1 == win.shown.0, 85%, 40%) }
            zone box pcard.0.0 { from: pc.x.0, (pc.y.0 + 0 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10; cursor: pointer; active: overview and not sharing and 0 < pc.n.0; label: "Workspace 1"; role: item }
        }
        group {
            show: 1 < pc.n.0
            opacity: smooth(0.05, 0.60, ov) * if(pdrag.s == 0 and pdrag.k == 1, 40%, 100%)
            move: 70 * (1 - smooth(0.05, 0.60, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.1.0.hover, (overview and drop.ok and mon == 0 and drop.k == 2 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.1.0.hover, 28, 45%
                box { from: pc.x.0, (pc.y.0 + 1 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10 }
            }
            box { from: pc.x.0 - 3, (pc.y.0 + 1 * (pc.h.0 + 20)) - 3; size: pc.w.0 + 6, pc.h.0 + 6; corner: 13; stroke: 1.6; color: mint; opacity: if(2 == win.shown.0, 85%, 0%) + 60% * (overview and drop.ok and mon == 0 and drop.k == 2 and (ovdrag >= 0 or pdrag.s >= 0)) }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 1 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 2 == pc.n.0 and win.used.0 < 2 }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 1 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 2 == pc.n.0 and win.used.0 < 2 }
            text "2" { at: pc.x.0 - 12, (pc.y.0 + 1 * (pc.h.0 + 20)) + pc.h.0 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(2 == win.shown.0, 85%, 40%) }
            zone box pcard.1.0 { from: pc.x.0, (pc.y.0 + 1 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10; cursor: pointer; active: overview and not sharing and 1 < pc.n.0; label: "Workspace 2"; role: item }
        }
        group {
            show: 2 < pc.n.0
            opacity: smooth(0.10, 0.65, ov) * if(pdrag.s == 0 and pdrag.k == 2, 40%, 100%)
            move: 70 * (1 - smooth(0.10, 0.65, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.2.0.hover, (overview and drop.ok and mon == 0 and drop.k == 3 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.2.0.hover, 28, 45%
                box { from: pc.x.0, (pc.y.0 + 2 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10 }
            }
            box { from: pc.x.0 - 3, (pc.y.0 + 2 * (pc.h.0 + 20)) - 3; size: pc.w.0 + 6, pc.h.0 + 6; corner: 13; stroke: 1.6; color: mint; opacity: if(3 == win.shown.0, 85%, 0%) + 60% * (overview and drop.ok and mon == 0 and drop.k == 3 and (ovdrag >= 0 or pdrag.s >= 0)) }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 2 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: 3 == pc.n.0 and win.used.0 < 3 }
            box { at: pc.x.0 + pc.w.0 / 2, (pc.y.0 + 2 * (pc.h.0 + 20)) + pc.h.0 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 3 == pc.n.0 and win.used.0 < 3 }
            text "3" { at: pc.x.0 - 12, (pc.y.0 + 2 * (pc.h.0 + 20)) + pc.h.0 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(3 == win.shown.0, 85%, 40%) }
            zone box pcard.2.0 { from: pc.x.0, (pc.y.0 + 2 * (pc.h.0 + 20)); size: pc.w.0, pc.h.0; corner: 10; cursor: pointer; active: overview and not sharing and 2 < pc.n.0; label: "Workspace 3"; role: item }
        }
        group {
            show: 3 < pc.n.0
            opacity: smooth(0.15, 0.70, ov) * if(pdrag.s == 0 and pdrag.k == 3, 40%, 100%)
            move: 70 * (1 - smooth(0.15, 0.70, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.3.0.hover, (overview and drop.ok and mon == 0 and drop.k == 4 and (ovdrag >= 0 or pdrag.s >= 0)))
