    on press dockz.0.0 { impulse buoy.0.0 -9 }
    on drag dockz.0.0 while dkdrag.0 < 0 {
        dkdrag.0 = 0
        pv.0 = -1
    }
    on release dockz.0.0 while dkdrag.0 < 0 {
        dock 0 on 0
        pv.0 = -1
        ring.0.0: 0 ~0ms
        ring.0.0: 1 ~760ms after 16ms
    }
    on release dockz.0.0 while dkdrag.0 == 0 and mouse.y < dk.cy.0 - 110 and win.dock.0.0.pinned > 0.5 {
        dock 0 on 0 unpin
        poofx.0 = mouse.x
        poofy.0 = mouse.y
        poof.0: 0 ~0ms
        poof.0: 1 ~700ms after 16ms
    }
    on release dockz.0.0 { dkdrag.0 = -1 }
    on drop dockz.0.0 {
        dock 0 on 0 with drop
        ring.0.0: 0 ~0ms
        ring.0.0: 1 ~760ms after 16ms
    }
    on press right dockz.0.0 {
        dmenu.0 = 0
        pv.0 = -1
    }
    on hover dockz.0.0 for 450ms while dkdrag.0 < 0 and dmenu.0 < 0 and win.dock.0.0.windows > 0 { pv.0 = 0 }
