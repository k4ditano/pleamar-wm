            box { at: pc.x.3 + pc.w.3 / 2, (pc.y.3 + 8 * (pc.h.3 + 20)) + pc.h.3 / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: 9 == pc.n.3 and win.used.3 < 9 }
            text "9" { at: pc.x.3 - 12, (pc.y.3 + 8 * (pc.h.3 + 20)) + pc.h.3 / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if(9 == win.shown.3, 85%, 40%) }
            zone box pcard.8.3 { from: pc.x.3, (pc.y.3 + 8 * (pc.h.3 + 20)); size: pc.w.3, pc.h.3; corner: 10; cursor: pointer; active: overview and not sharing and 8 < pc.n.3; label: "Workspace 9"; role: item }
        }
