            opacity: smooth(0.30, 0.85, ov) * if(pdrag.s == 0 and pdrag.k == 6, 40%, 100%)
            move: 70 * (1 - smooth(0.30, 0.85, ov)), 0
            body {
                color: #0c0e10
                rim: 10% + 12% * max(pcard.6.0.hover, (overview and drop.ok and mon == 0 and drop.k == 7 and (ovdrag >= 0 or pdrag.s >= 0)))
                shadow: 0, 10 + 6 * pcard.6.0.hover, 28, 45%
