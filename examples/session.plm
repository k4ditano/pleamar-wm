        // Between the programs and what is put away, and before the pools: a line of water.
        box { at: dk.x0.3 + 14 + dk.n.3 * 60 + 10, dk.cy.3; size: 1, 30; color: ink; opacity: 18%; show: dk.m.3 > 0 }
        box { at: dk.px.3 - 10, dk.cy.3; size: 1, 30; color: ink; opacity: 18% }
        ellipse { at: (dk.px.3 + 0 * 26 + 13), dk.cy.3; radius: 8; stroke: 1.3; color: ink; opacity: if(1 == dk.p.3 and win.used.3 < 1, 22%, 45%); show: 0 < dk.p.3 and win.shown.3 != 1 }
        ellipse { at: (dk.px.3 + 0 * 26 + 13), dk.cy.3; radius: 8; color: mint; opacity: 90%; show: 0 < dk.p.3 and win.shown.3 == 1 }
        text "1" { at: (dk.px.3 + 0 * 26 + 13), dk.cy.3; anchor: center; size: 9; weight: 700; color: #0c0e10; show: 0 < dk.p.3 and win.shown.3 == 1 }
