            }
            measure tip.$s.3
            group {
                show: dk.on.$s and dk.hk.$s == 3 and 3 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq3.$s + dksz3.$s / 2 + 14 + (tip.$s.3.width + 22) / 2), dka3.$s), if(dkvert, dka3.$s, dk.cr.$s + dk.cs.$s * (dkiq3.$s + dksz3.$s / 2 + 41)); size: (tip.$s.3.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.3.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq3.$s + dksz3.$s / 2 + 14 + (tip.$s.3.width + 22) / 2), dka3.$s), if(dkvert, dka3.$s, dk.cr.$s + dk.cs.$s * (dkiq3.$s + dksz3.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.3; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
