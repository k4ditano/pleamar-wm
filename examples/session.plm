                    text "↔" { at: pm.x + 9, y - gap / 2; anchor: center; size: 8; color: mint }
                    text wire.7.label { at: pm.x + 17, y - gap / 2; anchor: left center; size: 8.5; weight: 600; color: ink; width: 78; lines: 1; show: wlm.7.width > 0.5 }
