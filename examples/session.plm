            // Answered by another window's agent, through a wire: who.
            group {
                show: ansv.$i > 0.01
                opacity: ansv.$i
                body {
                    color: #0c0e10
                    rim: 16%
                    shadow: 0, 6, 16, 50%
                    box { at: x + w / 2, y + tb + 26; size: 236, 28; corner: 14 }
                }
                box { at: x + w / 2, y + tb + 26; size: 236, 28; corner: 14; stroke: 1.4; color: amber; opacity: 75% }
                text "answered by window {ansby.$i, 0}, through a wire" { at: x + w / 2, y + tb + 26; anchor: center; size: 11; color: ink }
            }
            // Waiting for you: its edge, amber, beating.
            box { from: x, y; size: w, h; corner: 12; stroke: 2; color: amber; opacity: (50% + 30% * sin(time * 240)) * smooth(0.75, 1, water); show: ag.$i > 2.5 }
            // Far away (a canvas zoomed out): what each agent is doing, big.
            let ag.far = clamp((0.55 - cz) / 0.12, 0, 1) * C * (ag.$i > 0.5)
            group {
                show: ag.far > 0.01
                opacity: ag.far
                body {
                    color: #0c0e10
                    rim: 14%
                    shadow: 0, 8, 22, 50%
                    box { at: x + w / 2, y + h / 2; size: 190, 46; corner: 23 }
                }
                box { at: x + w / 2, y + h / 2; size: 190, 46; corner: 23; stroke: 1.5; color: if(ag.$i > 2.5, amber, mint); opacity: 60% }
                group {
                    clip box { from: x + w / 2 - 82, y + h / 2 - 12; size: 28, 24; corner: 7.0 }
                    box { from: x + w / 2 - 82, y + h / 2 - 12 + 24 - ag.lvl * 2; size: 28, 24; color: if(ag.$i > 2.5, amber, mint); opacity: 85% }
                    ellipse { at: x + w / 2 - 82 + 14 + 10 * sin(time * 260), y + h / 2 - 12 + 24 - ag.lvl * 2; radius: 8; scale: 1.7, 0.45; color: #dffaf0; opacity: 70%; show: ag.$i > 0.5 and ag.$i < 1.5 }
                }
                box { from: x + w / 2 - 82, y + h / 2 - 12; size: 28, 24; corner: 7.0; stroke: 2.4; color: if(ag.$i > 2.5, amber, mint); opacity: 85% }
                text pick(max(ag.$i - 1, 0), "Working", "Ready", "Waiting for you") { at: x + w / 2 - 44, y + h / 2 - 6; anchor: left center; size: 14; weight: 650; color: ink }
                text agt.$i { at: x + w / 2 - 44, y + h / 2 + 10; anchor: left center; size: 10; color: ink; opacity: 55%; width: 128; lines: 1 }
            }
            // Waiting for you out of sight (a canvas): a drop at the monitor's
            // edge, towards it; pressed, the camera goes there.
            let em.out = C and fr and ag.$i > 2.5 and (fgx + fgw / 2 < x0 or fgx + fgw / 2 > x0 + Ws or fgy + fgh / 2 < y0 or fgy + fgh / 2 > y0 + ah)
            let em.x = clamp(fgx + fgw / 2, x0 + 34, x0 + Ws - 34)
            let em.y = clamp(fgy + fgh / 2, y0 + 34, y0 + ah - 34)
            group {
                show: em.out
                ellipse { at: em.x, em.y; radius: 15 + 5 * sin(time * 240); color: amber; opacity: 18% }
                body {
                    gradient: radial em.x - 2, em.y - 3 radius 12, #fff3d6, amber 45%, #a8781f
                    rim: 35%
                    shadow: 0, 4, 12, 45%
                    ellipse { at: em.x, em.y; radius: 10 }
                }
                text "!" { at: em.x, em.y; anchor: center; size: 12; weight: 800; color: #3a2606 }
            }
            // Tiled, where it is taken to carry it: a little bar in the gap
            // above it, seen when the mouse is there.
            box { at: x + w / 2, y - gap / 2; size: 40 + 24 * title.$i.hover, 4; corner: 2; color: ink; opacity: 55% * title.$i.hover * (1 - hb.$i); show: hb.$i < 0.99 }
            // Choosing what to share: the one under the pointer lights up and says so.
            group {
                show: share.windows and share.in > 0.01
                opacity: share.in
                box { from: x - 3, y - 3; size: w + 6, h + 6; corner: 15; stroke: 2.5; color: mint; opacity: choose.$i.hover }
                group {
                    opacity: choose.$i.hover
                    scale: 0.9 + 0.1 * choose.$i.hover
                    pivot: x + w / 2, y + h / 2
                    body {
                        color: #0c0e10
                        rim: 10%
                        shadow: 0, 6, 18, 45%
                        box { at: x + w / 2, y + h / 2; size: 176, 40; corner: 20 }
                    }
                    ellipse { at: x + w / 2 - 66, y + h / 2; radius: 5; color: #ef7a66 }
                    text "Share this window" { at: x + w / 2 + 8, y + h / 2; anchor: center; size: 13; weight: 600; color: ink }
                }
            }
        }
        // An agent at work on it: a mint outline that breathes round it, over
        // it (the agent's own monitor glow is further down).
        group {
            z: zz + 0.45 + if(win.$i.floating, 50000, 0)
            show: agent.on > 0.01 and agent.win == i and win.$i.open and sc == screen.index and ws.vis
            opacity: agent.on * (0.75 + 0.15 * ag.breath)
            group {
                blur: 10
                box { from: x - 3, y - 3; size: w + 6, h + 6; corner: 14; stroke: 5; color: mint; opacity: 70% }
            }
            box { from: x - 1, y - 1; size: w + 2, h + 2; corner: 13; stroke: 1.6; color: mint }
        }
        // ── on the phone, as a card: its name over it and a cross to close
        // it; pressed, it opens. The ones piled behind show only their edge. ──
        // (On a tablet lying down, another button: beside the one in front.)
        let ph.besides = card and ph.wide and ph.front >= 0 and ph.front != i and win.$i.open and (ph.d > -0.5 or ph.row)
        group {
            z: zz + 0.7
            zone box phcard.$i { from: x, y - 30; size: w, if(ph.d < -0.5 and not ph.row, 14, h + 30); active: card and sc == screen.index and win.$i.open and pc > 0.9; label: "{win.$i.title}"; role: item }
            zone ellipse phx.$i { at: x + w - 14, y - 17; radius: 16; active: card and sc == screen.index and win.$i.open and pc > 0.9 and (ph.d > -0.5 or ph.row); label: "Close {win.$i.title}"; role: button }
            zone ellipse phsd.$i { at: x + w - 46, y - 17; radius: 16; active: ph.besides and sc == screen.index and pc > 0.9; label: "Beside {win.$i.title}"; role: button }
        }
        group {
            z: zz + 0.6
            show: card and sc == screen.index and win.$i.open and pc > 0.02 and (ph.d > -0.5 or ph.row)
            opacity: smooth(0.4, 1, pc)
            text win.$i.title { at: x + 4, y - 17; anchor: left center; size: 13; weight: 650; width: w - if(ph.besides, 84, 50); lines: 1; color: ink; opacity: 92% }
            ellipse { at: x + w - 14, y - 17; radius: 12; color: #ffffff; opacity: 10% + 14% * phx.$i.hover }
            box { at: x + w - 14, y - 17; size: 11, 1.8; corner: 1; rotate: 45deg; color: ink }
            box { at: x + w - 14, y - 17; size: 11, 1.8; corner: 1; rotate: -45deg; color: ink }
            group {
                show: ph.besides
                ellipse { at: x + w - 46, y - 17; radius: 12; color: mint; opacity: 12% + 18% * phsd.$i.hover }
                box { at: x + w - 50, y - 17; size: 6, 11; corner: 1.5; stroke: 1.4; color: ink }
                box { at: x + w - 42, y - 17; size: 6, 11; corner: 1.5; color: mint }
            }
        }
        on release phx.$i { close win.$i }
        on release phsd.$i while ph.besides {
            ph.side = i
            ph.solo = 0
            ph.cards = 0
        }
        on release phcard.$i while not phx.$i.hover and not phsd.$i.hover {
            // (The one beside, pressed: the two change places in front.)
            ph.fl = if(ph.split and ph.sd == i, 1 - ph.fl, ph.fl)
            ph.side = if(ph.split and ph.sd == i, ph.front, ph.side)
            focus win.$i
            ph.front = i
            ph.cards = 0
        }
        // In front, it has the keyboard (put in front by the line between
        // two, a swipe, a card).
        on change ph.front while onph and ph.front == i and win.$i.open and win.focus != i { focus win.$i }
        // Along the bottom edge, to the next app and the one before.
        on phone_next while onph and win.$i.open and not ph.home and ph.k.$i == ph.kf + 1 {
            focus win.$i
            ph.front = i
        }
        on phone_prev while onph and win.$i.open and not ph.home and ph.k.$i == ph.kf - 1 {
            focus win.$i
            ph.front = i
        }
        // The one in front closed: the cards, or the one beside it.
        on change win.$i.open while not win.$i.open and ph.front == i { ph.front = -1 }
        // ── to the phone and back: on the desk it pours into the phone drawn
        // on the curtain (`phone_curtain`), and comes back out of it ──
        // Its monitor at the desk, and where it was on it, when it went (see `pour.`).
        on change win.$i.screen while phone < 0 or win.$i.screen != phone { sc.last.$i = win.$i.screen }
        // (On the phone's coming, not on the window's moving: which of the
        // two the compositor says first is not known.)
        on change phone while phone >= 0 and win.$i.open and not win.$i.dialog and was.ph.$i < 0.5 {
            gx.$i = x.$i
            gy.$i = y.$i
            gw.$i = w.$i
            gh.$i = h.$i
            was.ph.$i = 1
            pour.$i: 0 ~0ms
            pour.$i: 1 ~spring(70, 13) after 120ms
        }
        // Back at the desk: out of the phone, where it was drawn, to its place.
        on change phone while phone < 0 and was.ph.$i > 0.5 {
            was.ph.$i = 0
            x.$i: screen[max(sc.last.$i, 0)].width / 2 - 28 ~0ms
            y.$i: screen[max(sc.last.$i, 0)].height / 2 - 92 ~0ms
            w.$i: 56 ~0ms
            h.$i: 104 ~0ms
        }

        // At a glance, its miniature in its pool's card: where it is laid out,
        // and its program's icon.
        let mk = win.$i.workspace - 1
        let mf = pc.w[sc] / max(screen[sc].width, 1)
        let mx0 = pc.x[sc] + goal.x * mf
        let my0 = pc.y[sc] + mk * (pc.h[sc] + 20) + goal.y * mf
        let mw0 = goal.w * mf
        let mh0 = goal.h * mf
        let ma0 = clamp((ov - 0.05 * mk - 0.08) / 0.52, 0, 1)
        let ma = ma0 * ma0 * (3 - 2 * ma0)
        group {
            z: 99986
            show: ov > 0.01 and win.$i.open and sc == screen.index and not win.$i.dialog and not win.$i.minimized and mk >= 0 and ovdrag != i
            opacity: ma * if(pdrag.s == sc and pdrag.k == mk, 40%, 100%)
            move: 70 * (1 - ma), 0
            box { from: mx0 + 1, my0 + 1; size: max(mw0 - 2, 2), max(mh0 - 2, 2); corner: 3; color: #1d2226 }
            box { from: mx0 + 1, my0 + 1; size: max(mw0 - 2, 2), max(mh0 - 2, 2); corner: 3; stroke: 1; color: if(win.$i.focused, mint, ink); opacity: if(win.$i.focused, 80%, 18%) }
            image appicon.$i { at: mx0 + mw0 / 2 - min(28, min(mw0, mh0) * 0.55) / 2, my0 + mh0 / 2 - min(28, min(mw0, mh0) * 0.55) / 2; size: min(28, min(mw0, mh0) * 0.55), min(28, min(mw0, mh0) * 0.55) }
        }
        // Taken by an edge or the corner: where it was and how big.
        on press left_edge.$i {
            sizing = i
            sedge = 0
            g.x = fx.$i
            g.y = fy.$i
            g.w = fw.$i
            g.h = fh.$i
        }
        on press right_edge.$i {
            sizing = i
            sedge = 1
            g.x = fx.$i
            g.y = fy.$i
            g.w = fw.$i
            g.h = fh.$i
        }
        on press bottom_edge.$i {
            sizing = i
            sedge = 2
            g.x = fx.$i
            g.y = fy.$i
            g.w = fw.$i
            g.h = fh.$i
        }
        on press corner.$i {
            sizing = i
            sedge = 3
            g.x = fx.$i
            g.y = fy.$i
            g.w = fw.$i
            g.h = fh.$i
        }
        // Taken by an edge with the camera far away: it comes close first
        // (as Super and the wheel would, all the way in), the point taken
        // staying under the pointer. Resized from far away it was made huge
        // on the plane while what it showed was a tenth of its size.
        on press left_edge.$i while C and cz < 0.95 { cvw.k = sc; cvw.d = 100; cvw.x = mouse.x; cvw.y = mouse.y; cvw.n = cvw.n + 1 }
        on press right_edge.$i while C and cz < 0.95 { cvw.k = sc; cvw.d = 100; cvw.x = mouse.x; cvw.y = mouse.y; cvw.n = cvw.n + 1 }
        on press bottom_edge.$i while C and cz < 0.95 { cvw.k = sc; cvw.d = 100; cvw.x = mouse.x; cvw.y = mouse.y; cvw.n = cvw.n + 1 }
        on press corner.$i while C and cz < 0.95 { cvw.k = sc; cvw.d = 100; cvw.x = mouse.x; cvw.y = mouse.y; cvw.n = cvw.n + 1 }
        // Let go of an edge: the camera comes to the window, whole and in the
        // middle (as close as it fits, never closer than as it is).
        on change cvc.n while cvc.w == i and C and fr and not maxed.$i and not win.$i.minimized {
            cvf.only = i
            cvf.k = sc
            cvf.l = 1000000
            cvf.t = 1000000
            cvf.r = -1000000
            cvf.b = -1000000
            cvf.n = cvf.n + 1
            cvf.go: 0 ~0ms
            cvf.go: 1 after 16ms
        }
        on release left_edge.$i {
            sizing = -1
            sedge = -1
            cvc.w = i
            cvc.n = cvc.n + 1
        }
        on release right_edge.$i {
            sizing = -1
            sedge = -1
            cvc.w = i
            cvc.n = cvc.n + 1
        }
        on release bottom_edge.$i {
            sizing = -1
            sedge = -1
            cvc.w = i
            cvc.n = cvc.n + 1
        }
        on release corner.$i {
            sizing = -1
            sedge = -1
            cvc.w = i
            cvc.n = cvc.n + 1
        }
        // Only the edge pressed: another one brought under the point pressed
        // —a canvas's camera moved with Super— took the drag, and stretched
        // its window to the size the last one taken had: windows shrank and
        // moved as the canvas was moved.
        on drag left_edge.$i while sizing == i and sedge == 0 {
            fx.$i = min(g.x + drag.dx / cz, g.x + g.w - 240)
            fw.$i = max(g.w - drag.dx / cz, 240)
        }
        on drag right_edge.$i while sizing == i and sedge == 1 { fw.$i = max(g.w + drag.dx / cz, 240) }
        on drag bottom_edge.$i while sizing == i and sedge == 2 { fh.$i = max(g.h + drag.dy / cz, 140) }
        on drag corner.$i while sizing == i and sedge == 3 {
            fw.$i = max(g.w + drag.dx / cz, 240)
            fh.$i = max(g.h + drag.dy / cz, 140)
        }
        on press lead_zone.$i while fr {
            focus win.$i
            toggle maxed.$i
            wave.$i: 0 ~0ms
            wave.$i: 1 after 16ms
        }
        on press title.$i while keys.super > 0.5 and dcl.t > 0.5 and dcl.w == i and C and fr and not maxed.$i {
            cvc.w = i
            cvc.n = cvc.n + 1
        }
        on press title.$i while keys.super > 0.5 and C {
            dcl.w = i
            dcl.t: 1 ~0ms
            dcl.t: 0 after 400ms
        }
        on press title.$i {
            tgrab = i
            tsup = keys.super
            focus win.$i
            grab.x = pointer.x - x.$i
            grab.y = pointer.y - y.$i
        }
        // Carried by its title bar. Let go on another window, they change
        // places; at the edge towards the other monitor, it goes there.
        // (While carried it is drawn at the mouse, further down; its place
        // here waits.)
        // Only the one that started it, and only if it was its title bar that
        // was pressed: another shown moving aside —or brought there by a
        // canvas's camera, moved with Super— may come to hold the point
        // pressed, and it was carried with no title bar to let go of.
        on drag title.$i while dragging == i or (dragging < 0 and tgrab == i) {
            dragging = i
        }
        // Let go, it starts from where it was left —on the monitor it was left
        // on— and glides to its place from there.
        on release title.$i {
            dragging = -1
            tgrab = -1
            dx.$i: mouse.x - grab.x - x.$i ~0ms
            dy.$i: mouse.y - grab.y - y.$i ~0ms
            dx.$i: 0 after 30ms
            dy.$i: 0 after 30ms
        }
        // Free: it stays where it was let go (on the monitor it was let go on).
        // (Right there, at once: nothing to glide to.)
        on release title.$i while (free[mon] > 0.5 or win.$i.floating) and picked < 0 and cv[mon] < 0.5 {
            fx.$i = mouse.x - grab.x
            fy.$i = max(mouse.y - grab.y, win.reserved[mon].top)
            fsc.$i = mon
            maxed.$i = 0
            x.$i: mouse.x - grab.x ~0ms
            y.$i: max(mouse.y - grab.y, win.reserved[mon].top) ~0ms
            dx.$i: 0 ~0ms
            dy.$i: 0 ~0ms
        }
        // On a canvas: there on the plane, as the camera sees it. Then the
        // others near it offer their edges (`cvs`): the nearest takes it.
        on release title.$i while cv[mon] > 0.5 and free[mon] > 0.5 and picked < 0 {
            fx.$i = mg.x0 + cvx[mon] + (mouse.x - grab.x - mg.x0) / cvz[mon]
            fy.$i = mg.y0 + cvy[mon] + (mouse.y - grab.y - mg.y0) / cvz[mon]
            fsc.$i = mon
            maxed.$i = 0
            x.$i: mouse.x - grab.x ~0ms
            y.$i: mouse.y - grab.y ~0ms
            dx.$i: 0 ~0ms
            dy.$i: 0 ~0ms
            cvs.i = i
            cvs.ax = fx.$i
            cvs.ay = fy.$i
            cvs.aw = fw.$i
            cvs.ah = fh.$i
            cvs.dx = 0
            cvs.dy = 0
            cvs.bx = 28 / cvz[mon]
            cvs.by = 28 / cvz[mon]
            cvs.n = cvs.n + 1
            cvs.go: 0 ~0ms
            cvs.go: 1 after 16ms
        }
        // …unless it was held against an edge or a corner: the magnet's place.
        on release title.$i while (free[mon] > 0.5 or win.$i.floating) and picked < 0 and magnet > 0 {
            // (On a canvas, the half or quarter of what the camera sees, on the plane.)
            mg.cz = if(cv[mon] > 0.5, cvz[mon], 1)
            fx.$i = mg.x0 + if(cv[mon] > 0.5, cvx[mon], 0) + pick(magnet, gap, gap, gap, gap, gap, gap, 2 * gap + mg.hw, 2 * gap + mg.hw) / mg.cz
            fy.$i = mg.y0 + if(cv[mon] > 0.5, cvy[mon], 0) + pick(magnet, 0, 0, 0, 0, 0, mg.qh + gap, 0, mg.qh + gap) / mg.cz
            fw.$i = pick(magnet, 240, mg.hw, mg.hw, mg.Ws - 2 * gap, mg.hw, mg.hw, mg.hw, mg.hw) / mg.cz
            fh.$i = (pick(magnet, 140, mg.ah, mg.ah, mg.ah, mg.qh, mg.qh, mg.qh, mg.qh) - tb * win.$i.framed) / mg.cz + tb * win.$i.framed
            maxed.$i = if(magnet == 3, 1, 0)
            magnet = 0
            // (Not taken by another window's side after that.)
            cvs.i = -1
        }
        // Let go on another one (the one under it, as the others showed).
        on release title.$i while over >= 0 and not crossing { swap win.$i with win(over) }
        // Its port, dragged to another window: the two are wired (`wtgt` is
        // the one under the mouse, found after the windows).
        on press port.$i {
            wiring = i
            focus win.$i
        }
        on release port.$i while wtgt >= 0 and wtgt != i {
            wnew.a = i
            wnew.b = wtgt
            wnew.go: 0 ~0ms
            wnew.go: 1 after 16ms
        }
        on release port.$i {
            wiring = -1
            wtgt = -1
        }
        // Gone, its wires go with it.
        on change win.$i.open while not win.$i.open {
            wgone = i
            wgone.n = wgone.n + 1
        }
        // The drop at the edge for one waiting out of sight: the camera to it.
        zone ellipse seek.$i { at: em.x, em.y; radius: 16; cursor: pointer; active: em.out and sc == screen.index; label: "Go to {win.$i.title}, waiting for you"; role: button }
        on press seek.$i { focus win.$i }
        // ── canvas magnets: beside the one let go (`cvs.a…`), this one offers
        // it its sides (a gap from it) and its edges in line; the nearest of
        // them all takes it, if it is within `cvs.b…`. (Every guard is read
        // before any of them runs: each keeps the nearest so far as it runs,
        // or the last offer within reach took it, not the nearest.) ──
        let cvs.ok = C and fr and win.$i.open and not win.$i.minimized and ws.here and sc == mon
        on change cvs.n while cvs.i >= 0 and cvs.i != i and cvs.ok and cvs.ay < fy.$i + fh.$i + gap and cvs.ay + cvs.ah > fy.$i - gap and abs(fx.$i + fw.$i + gap - cvs.ax) < cvs.bx {
            cvs.dx = if(abs(fx.$i + fw.$i + gap - cvs.ax) < cvs.bx, fx.$i + fw.$i + gap - cvs.ax, cvs.dx)
            cvs.bx = min(cvs.bx, abs(fx.$i + fw.$i + gap - cvs.ax))
        }
        on change cvs.n while cvs.i >= 0 and cvs.i != i and cvs.ok and cvs.ay < fy.$i + fh.$i + gap and cvs.ay + cvs.ah > fy.$i - gap and abs(fx.$i - gap - cvs.ax - cvs.aw) < cvs.bx {
            cvs.dx = if(abs(fx.$i - gap - cvs.ax - cvs.aw) < cvs.bx, fx.$i - gap - cvs.ax - cvs.aw, cvs.dx)
            cvs.bx = min(cvs.bx, abs(fx.$i - gap - cvs.ax - cvs.aw))
        }
        on change cvs.n while cvs.i >= 0 and cvs.i != i and cvs.ok and cvs.ax < fx.$i + fw.$i + gap and cvs.ax + cvs.aw > fx.$i - gap and abs(fx.$i - cvs.ax) < cvs.bx {
            cvs.dx = if(abs(fx.$i - cvs.ax) < cvs.bx, fx.$i - cvs.ax, cvs.dx)
            cvs.bx = min(cvs.bx, abs(fx.$i - cvs.ax))
        }
        on change cvs.n while cvs.i >= 0 and cvs.i != i and cvs.ok and cvs.ax < fx.$i + fw.$i + gap and cvs.ax + cvs.aw > fx.$i - gap and abs(fx.$i + fw.$i - cvs.ax - cvs.aw) < cvs.bx {
            cvs.dx = if(abs(fx.$i + fw.$i - cvs.ax - cvs.aw) < cvs.bx, fx.$i + fw.$i - cvs.ax - cvs.aw, cvs.dx)
            cvs.bx = min(cvs.bx, abs(fx.$i + fw.$i - cvs.ax - cvs.aw))
        }
        on change cvs.n while cvs.i >= 0 and cvs.i != i and cvs.ok and cvs.ax < fx.$i + fw.$i + gap and cvs.ax + cvs.aw > fx.$i - gap and abs(fy.$i + fh.$i + gap - cvs.ay) < cvs.by {
            cvs.dy = if(abs(fy.$i + fh.$i + gap - cvs.ay) < cvs.by, fy.$i + fh.$i + gap - cvs.ay, cvs.dy)
            cvs.by = min(cvs.by, abs(fy.$i + fh.$i + gap - cvs.ay))
        }
        on change cvs.n while cvs.i >= 0 and cvs.i != i and cvs.ok and cvs.ax < fx.$i + fw.$i + gap and cvs.ax + cvs.aw > fx.$i - gap and abs(fy.$i - gap - cvs.ay - cvs.ah) < cvs.by {
            cvs.dy = if(abs(fy.$i - gap - cvs.ay - cvs.ah) < cvs.by, fy.$i - gap - cvs.ay - cvs.ah, cvs.dy)
            cvs.by = min(cvs.by, abs(fy.$i - gap - cvs.ay - cvs.ah))
        }
        on change cvs.n while cvs.i >= 0 and cvs.i != i and cvs.ok and cvs.ay < fy.$i + fh.$i + gap and cvs.ay + cvs.ah > fy.$i - gap and abs(fy.$i - cvs.ay) < cvs.by {
            cvs.dy = if(abs(fy.$i - cvs.ay) < cvs.by, fy.$i - cvs.ay, cvs.dy)
            cvs.by = min(cvs.by, abs(fy.$i - cvs.ay))
        }
        on change cvs.n while cvs.i >= 0 and cvs.i != i and cvs.ok and cvs.ay < fy.$i + fh.$i + gap and cvs.ay + cvs.ah > fy.$i - gap and abs(fy.$i + fh.$i - cvs.ay - cvs.ah) < cvs.by {
            cvs.dy = if(abs(fy.$i + fh.$i - cvs.ay - cvs.ah) < cvs.by, fy.$i + fh.$i - cvs.ay - cvs.ah, cvs.dy)
            cvs.by = min(cvs.by, abs(fy.$i + fh.$i - cvs.ay - cvs.ah))
        }
        on change cvs.go while cvs.go > 0.5 and cvs.i == i {
            fx.$i = fx.$i + cvs.dx
            fy.$i = fy.$i + cvs.dy
            cvs.i = -1
        }
        // The one that gets the keyboard, mostly out of sight on a canvas:
        // the camera goes to it.
        on change win.$i.focused while win.$i.focused and C and fr and dragging < 0 and (fgx + fgw / 2 < x0 or fgx + fgw / 2 > x0 + Ws or fgy + fgh / 2 < y0 or fgy + fgh / 2 > y0 + ah) {
            cvx[sc] = fx.$i + fw.$i / 2 - x0 - Ws / 2 / cz
            cvy[sc] = fy.$i + fh.$i / 2 - y0 - ah / 2 / cz
        }
        // Super+0: its box, for the camera to take them all in.
        on change cvf.n while cvf.k == sc and (cvf.only < 0 or cvf.only == i) and C and fr and win.$i.open and not win.$i.minimized and ws.here {
            cvf.l = min(cvf.l, fx.$i)
            cvf.t = min(cvf.t, fy.$i)
            cvf.r = max(cvf.r, fx.$i + fw.$i)
            cvf.b = max(cvf.b, fy.$i + fh.$i)
        }
        // Fractal: near one of its edges, it docks on that side of it (its own
        // room going to the ones beside it first); in its middle, the two make
        // a group in that one's box. From the other monitor, the same.
        let dk.cx = cam[mon].x
        let dk.cy = cam[mon].y
        let dk.cw = cam[mon].w
        let dk.ch = cam[mon].h
        let dk.ah = screen[mon].height - mg.top - win.reserved[mon].bottom - bar - gap
        let dk.wx = dk.cx + (mouse.x - mg.x0 - gap / 2) / max(mg.Ws - gap, 1) * dk.cw
        let dk.wy = dk.cy + (mouse.y - mg.y0 + gap / 2) / max(dk.ah + gap, 1) * dk.ch
        let dk.u = (dk.wx - pick(max(over, 0), tre.ox.0 + tre.sx.0 * tre.x.0, tre.ox.1 + tre.sx.1 * tre.x.1, tre.ox.2 + tre.sx.2 * tre.x.2, tre.ox.3 + tre.sx.3 * tre.x.3, tre.ox.4 + tre.sx.4 * tre.x.4, tre.ox.5 + tre.sx.5 * tre.x.5, tre.ox.6 + tre.sx.6 * tre.x.6, tre.ox.7 + tre.sx.7 * tre.x.7, tre.ox.8 + tre.sx.8 * tre.x.8, tre.ox.9 + tre.sx.9 * tre.x.9, tre.ox.10 + tre.sx.10 * tre.x.10, tre.ox.11 + tre.sx.11 * tre.x.11, tre.ox.12 + tre.sx.12 * tre.x.12, tre.ox.13 + tre.sx.13 * tre.x.13, tre.ox.14 + tre.sx.14 * tre.x.14, tre.ox.15 + tre.sx.15 * tre.x.15)) / max(pick(max(over, 0), tre.sx.0 * tre.w.0, tre.sx.1 * tre.w.1, tre.sx.2 * tre.w.2, tre.sx.3 * tre.w.3, tre.sx.4 * tre.w.4, tre.sx.5 * tre.w.5, tre.sx.6 * tre.w.6, tre.sx.7 * tre.w.7, tre.sx.8 * tre.w.8, tre.sx.9 * tre.w.9, tre.sx.10 * tre.w.10, tre.sx.11 * tre.w.11, tre.sx.12 * tre.w.12, tre.sx.13 * tre.w.13, tre.sx.14 * tre.w.14, tre.sx.15 * tre.w.15), 0.001)
        let dk.v = (dk.wy - pick(max(over, 0), tre.oy.0 + tre.sy.0 * tre.y.0, tre.oy.1 + tre.sy.1 * tre.y.1, tre.oy.2 + tre.sy.2 * tre.y.2, tre.oy.3 + tre.sy.3 * tre.y.3, tre.oy.4 + tre.sy.4 * tre.y.4, tre.oy.5 + tre.sy.5 * tre.y.5, tre.oy.6 + tre.sy.6 * tre.y.6, tre.oy.7 + tre.sy.7 * tre.y.7, tre.oy.8 + tre.sy.8 * tre.y.8, tre.oy.9 + tre.sy.9 * tre.y.9, tre.oy.10 + tre.sy.10 * tre.y.10, tre.oy.11 + tre.sy.11 * tre.y.11, tre.oy.12 + tre.sy.12 * tre.y.12, tre.oy.13 + tre.sy.13 * tre.y.13, tre.oy.14 + tre.sy.14 * tre.y.14, tre.oy.15 + tre.sy.15 * tre.y.15)) / max(pick(max(over, 0), tre.sy.0 * tre.h.0, tre.sy.1 * tre.h.1, tre.sy.2 * tre.h.2, tre.sy.3 * tre.h.3, tre.sy.4 * tre.h.4, tre.sy.5 * tre.h.5, tre.sy.6 * tre.h.6, tre.sy.7 * tre.h.7, tre.sy.8 * tre.h.8, tre.sy.9 * tre.h.9, tre.sy.10 * tre.h.10, tre.sy.11 * tre.h.11, tre.sy.12 * tre.h.12, tre.sy.13 * tre.h.13, tre.sy.14 * tre.h.14, tre.sy.15 * tre.h.15), 0.001)
        let dk.edge = min(min(dk.u, 1 - dk.u), min(dk.v, 1 - dk.v))
        let dk.side = if(dk.u == dk.edge, 0, if(1 - dk.u == dk.edge, 1, if(dk.v == dk.edge, 2, 3)))
        let dk.frac = over >= 0 and not crossing and lay[mon] == 7 and free[mon] < 0.5 and tre.w.$i > 0.001
        on release title.$i while dk.frac and dk.edge < 0.25 and tre.lv < 0 {
            tre.dk.src = i
            tre.dk.dst = over
            tre.dk.side = dk.side
            tre.dk.grp = 0
            tre.lv = i
            tre.n = tre.n + 1
        }
        on release title.$i while dk.frac and dk.edge >= 0.25 and tre.lv < 0 {
            tre.dk.src = i
            tre.dk.dst = over
            tre.dk.side = if(screen[mon].width >= screen[mon].height, 1, 3)
            tre.dk.grp = 1
            tre.lv = i
            tre.n = tre.n + 1
        }
        let dk.cross = over >= 0 and crossing and lay[mon] == 7 and free[mon] < 0.5
        on release title.$i while dk.cross {
            tre.dk.src = i
            tre.dk.dst = over
            tre.dk.side = if(dk.edge < 0.25, dk.side, if(screen[mon].width >= screen[mon].height, 1, 3))
            tre.dk.grp = if(dk.edge < 0.25, 0, 1)
        }
        // Super and the wheel on a fractal monitor: closer or further, there.
        on scroll title.$i while keys.super > 0.5 and not overview and lay[sc] == 7 and free[sc] < 0.5 {
            zw.d = wheel
            zw.k = sc
            zw.x = dk.wx
            zw.y = dk.wy
            zw.n = zw.n + 1
        }
        // Super and the wheel on a scrolling monitor: the keyboard to the
        // column beside (up, the one before), and the strip glides there.
        on scroll title.$i while keys.super > 0.5 and not overview and lay[sc] == 5 and free[sc] < 0.5 {
            zs.acc = zs.acc + wheel
            zs.k = sc
            zs.p = if(abs(zs.acc) >= 1, clamp(if(fscreen == sc, max(fplace, 0), p) - sign(zs.acc), 0, n - 1), -1)
            zs.acc = if(abs(zs.acc) >= 1, 0, zs.acc)
            zs.quiet = 1
            zs.n = zs.n + 1
        }
        on change zs.n while zs.p >= 0 and sc == zs.k and ws.here and win.$i.place == zs.p and not win.$i.minimized { focus win.$i }
        // …and on one of the other monitor: it goes there, among the ones that
        // monitor has (which made room for it while it was carried), as on an
        // empty spot of it. Changing places across monitors left the one let
        // go never where it was taken to, and took one away from there.
        on release title.$i while crossing and over >= 0 {
            send win.$i to mon
            landing = i
            landing.to = mon
        }
        // Let go on the other monitor (the mouse is off this one), or at the
        // edge that leads to it.
        // Until the compositor says it is there, it stays with the mouse
        // (`landing`): not a frame back on the monitor it left.
        on release title.$i while (pointer.y < 0 or pointer.y > H) and over < 0 {
            send win.$i to 1 - screen.index
            landing = i
            landing.to = 1 - screen.index
        }
        on release title.$i while screen.index == 0 and pointer.x > W - 40 and pointer.y >= 0 and pointer.y <= H and over < 0 {
            send win.$i to 1
            landing = i
            landing.to = 1
        }
        on release title.$i while screen.index == 1 and pointer.x < 40 and pointer.y >= 0 and pointer.y <= H and over < 0 {
            send win.$i to 0
            landing = i
            landing.to = 0
        }
        // Let go on a layout of the strip: that monitor takes it, and with a
        // leader, the one carried leads.
        repeat j in 0..4 {
            on release title.$i while picked >= 0 and mon == j {
                lay.$j = if(choice < 8, choice, lay.$j)
                free.$j = if(choice == 8, 1, 0)
                cv.$j = if(choice == 8, 1, 0)
            }
        }
        on release title.$i while leads { promote win.$i }
        on release title.$i {
            over = -1
        }
        on press lead_zone.$i while not fr { promote win.$i }
        on press close_zone.$i {
            close win.$i
            bye.$i: 1
            bye.$i: 0 after 2500ms
        }
        on close while win.focus == i {
            bye.$i: 1
            bye.$i: 0 after 2500ms
        }
        on press mini_zone.$i { minimize win.$i }
        // At a glance: pressed and let go, it is the one; carried, it goes to
        // the pool whose card it is let go on, or to the other monitor.
        on drag choose.$i while overview and not sharing and (ovdrag < 0 or ovdrag == i) {
            ovdrag = i
            dx.$i: drag.dx ~0ms
            dy.$i: drag.dy ~0ms
        }
        on release choose.$i while ovdrag < 0 and not sharing {
            focus win.$i
            overview = false
        }
        on release choose.$i while ovdrag == i and drop.ok { send win.$i to workspace drop.k on mon }
        on release choose.$i while ovdrag == i and not on.col and mon != sc { send win.$i to mon }
        on release choose.$i {
            ovdrag = -1
            dx.$i: 0
            dy.$i: 0
        }
        // Sharing the screen: the window pressed is the one shared.
        on press choose.$i while share.windows { pick win.$i }
        // The light goes where the keyboard is.
        on change win.$i.focused while win.$i.focused {
            lx: tx + tw / 2
            ly: ty + th / 2
        }
    }


    // (After the windows: each one's box is known by now.)
    repeat i in 0..16 {
        // Super and the wheel on a canvas, anywhere: a zone has the wheel over
        // every zone under it, and the plane is under every window. Without
        // Super the wheel is the window's, or nobody's. (Once.)
        on scroll canvas_bg while i == 0 and cv[mon] > 0.5 and keys.super > 0.5 {
            cvw.k = mon
            cvw.d = wheel
            cvw.x = mouse.x
            cvw.y = mouse.y
            cvw.n = cvw.n + 1
        }
        let sc = win.$i.screen
        let ws.here = win.$i.pool == win.pool[sc]
        // The mouse over a window floating over the tiles: the tiles under it
        // do not take the keyboard from it.
        let on.float = (win.0.floating and win.0.open and not win.0.minimized and win.0.screen == mon and win.0.workspace == win.shown[mon] and mouse.x >= x.0 and mouse.x < x.0 + w.0 and mouse.y >= y.0 and mouse.y < y.0 + h.0) + (win.1.floating and win.1.open and not win.1.minimized and win.1.screen == mon and win.1.workspace == win.shown[mon] and mouse.x >= x.1 and mouse.x < x.1 + w.1 and mouse.y >= y.1 and mouse.y < y.1 + h.1) + (win.2.floating and win.2.open and not win.2.minimized and win.2.screen == mon and win.2.workspace == win.shown[mon] and mouse.x >= x.2 and mouse.x < x.2 + w.2 and mouse.y >= y.2 and mouse.y < y.2 + h.2) + (win.3.floating and win.3.open and not win.3.minimized and win.3.screen == mon and win.3.workspace == win.shown[mon] and mouse.x >= x.3 and mouse.x < x.3 + w.3 and mouse.y >= y.3 and mouse.y < y.3 + h.3) + (win.4.floating and win.4.open and not win.4.minimized and win.4.screen == mon and win.4.workspace == win.shown[mon] and mouse.x >= x.4 and mouse.x < x.4 + w.4 and mouse.y >= y.4 and mouse.y < y.4 + h.4) + (win.5.floating and win.5.open and not win.5.minimized and win.5.screen == mon and win.5.workspace == win.shown[mon] and mouse.x >= x.5 and mouse.x < x.5 + w.5 and mouse.y >= y.5 and mouse.y < y.5 + h.5) + (win.6.floating and win.6.open and not win.6.minimized and win.6.screen == mon and win.6.workspace == win.shown[mon] and mouse.x >= x.6 and mouse.x < x.6 + w.6 and mouse.y >= y.6 and mouse.y < y.6 + h.6) + (win.7.floating and win.7.open and not win.7.minimized and win.7.screen == mon and win.7.workspace == win.shown[mon] and mouse.x >= x.7 and mouse.x < x.7 + w.7 and mouse.y >= y.7 and mouse.y < y.7 + h.7) + (win.8.floating and win.8.open and not win.8.minimized and win.8.screen == mon and win.8.workspace == win.shown[mon] and mouse.x >= x.8 and mouse.x < x.8 + w.8 and mouse.y >= y.8 and mouse.y < y.8 + h.8) + (win.9.floating and win.9.open and not win.9.minimized and win.9.screen == mon and win.9.workspace == win.shown[mon] and mouse.x >= x.9 and mouse.x < x.9 + w.9 and mouse.y >= y.9 and mouse.y < y.9 + h.9) + (win.10.floating and win.10.open and not win.10.minimized and win.10.screen == mon and win.10.workspace == win.shown[mon] and mouse.x >= x.10 and mouse.x < x.10 + w.10 and mouse.y >= y.10 and mouse.y < y.10 + h.10) + (win.11.floating and win.11.open and not win.11.minimized and win.11.screen == mon and win.11.workspace == win.shown[mon] and mouse.x >= x.11 and mouse.x < x.11 + w.11 and mouse.y >= y.11 and mouse.y < y.11 + h.11) + (win.12.floating and win.12.open and not win.12.minimized and win.12.screen == mon and win.12.workspace == win.shown[mon] and mouse.x >= x.12 and mouse.x < x.12 + w.12 and mouse.y >= y.12 and mouse.y < y.12 + h.12) + (win.13.floating and win.13.open and not win.13.minimized and win.13.screen == mon and win.13.workspace == win.shown[mon] and mouse.x >= x.13 and mouse.x < x.13 + w.13 and mouse.y >= y.13 and mouse.y < y.13 + h.13) + (win.14.floating and win.14.open and not win.14.minimized and win.14.screen == mon and win.14.workspace == win.shown[mon] and mouse.x >= x.14 and mouse.x < x.14 + w.14 and mouse.y >= y.14 and mouse.y < y.14 + h.14) + (win.15.floating and win.15.open and not win.15.minimized and win.15.screen == mon and win.15.workspace == win.shown[mon] and mouse.x >= x.15 and mouse.x < x.15 + w.15 and mouse.y >= y.15 and mouse.y < y.15 + h.15) > 0.5
        // The window under the mouse (the ones wired to it light up).
        let hv.over = win.$i.open and sc == mon and ws.here and not win.$i.minimized and mouse.x >= x.$i and mouse.x < x.$i + w.$i and mouse.y >= y.$i and mouse.y < y.$i + h.$i
        on change hv.over { hovwin = if(hv.over, i, if(hovwin == i, -1, hovwin)) }
        // Wiring from a window's port: the one under the mouse is where it would go.
        let wt.over = wiring >= 0 and wiring != i and win.$i.open and sc == mon and ws.here and not win.$i.minimized and mouse.x >= x.$i and mouse.x < x.$i + w.$i and mouse.y >= y.$i and mouse.y < y.$i + h.$i
        on change wt.over { wtgt = if(wt.over, i, if(wtgt == i, -1, wtgt)) }
        // The keyboard goes to the window the mouse is over, as it enters it:
        // no click needed first (Super+Q closes the one under the mouse).
        // (Only one that is seen: on the workspace its monitor shows, and not
        // under a dialog. One on another workspace in the same place took
        // the keys, unseen.)
        let pointed = win.$i.open and sc == mon and ws.here and not win.$i.dialog and not win.$i.minimized and not on.dialog and (win.$i.floating or not on.float) and mouse.x >= x.$i and mouse.x < x.$i + w.$i and mouse.y >= y.$i and mouse.y < y.$i + h.$i
        // (Free, they overlap: the keyboard goes with a click, as on Windows.)
        // (Only the one entered gives it. The one left said «nobody» too, and
        // when both changed in the same round and the leaving one spoke last,
        // nobody had it: a click was needed.)
        on change pointed while pointed and dragging < 0 and zs.quiet < 0.5 and not overview and fs.on < 0.5 and (max.on < 0.5 or tmax.$i > 0.5) and free[mon] < 0.5 {
            focus win.$i
        }
    }

    // ── fractal: carried over another window, a pool shows where it docks
    // (the half of it on that side) or, in its middle, the group they make ──
    let dq.on = dragging >= 0 and over >= 0 and lay[mon] == 7 and free[mon] < 0.5
    let dq.cx = cam[mon].x
    let dq.cy = cam[mon].y
    let dq.cw = max(cam[mon].w, 0.01)
    let dq.ch = max(cam[mon].h, 0.01)
    let dq.ah = screen[mon].height - mg.top - win.reserved[mon].bottom - bar - gap
    let dq.tx = pick(max(over, 0), tre.ox.0 + tre.sx.0 * tre.x.0, tre.ox.1 + tre.sx.1 * tre.x.1, tre.ox.2 + tre.sx.2 * tre.x.2, tre.ox.3 + tre.sx.3 * tre.x.3, tre.ox.4 + tre.sx.4 * tre.x.4, tre.ox.5 + tre.sx.5 * tre.x.5, tre.ox.6 + tre.sx.6 * tre.x.6, tre.ox.7 + tre.sx.7 * tre.x.7, tre.ox.8 + tre.sx.8 * tre.x.8, tre.ox.9 + tre.sx.9 * tre.x.9, tre.ox.10 + tre.sx.10 * tre.x.10, tre.ox.11 + tre.sx.11 * tre.x.11, tre.ox.12 + tre.sx.12 * tre.x.12, tre.ox.13 + tre.sx.13 * tre.x.13, tre.ox.14 + tre.sx.14 * tre.x.14, tre.ox.15 + tre.sx.15 * tre.x.15)
    let dq.ty = pick(max(over, 0), tre.oy.0 + tre.sy.0 * tre.y.0, tre.oy.1 + tre.sy.1 * tre.y.1, tre.oy.2 + tre.sy.2 * tre.y.2, tre.oy.3 + tre.sy.3 * tre.y.3, tre.oy.4 + tre.sy.4 * tre.y.4, tre.oy.5 + tre.sy.5 * tre.y.5, tre.oy.6 + tre.sy.6 * tre.y.6, tre.oy.7 + tre.sy.7 * tre.y.7, tre.oy.8 + tre.sy.8 * tre.y.8, tre.oy.9 + tre.sy.9 * tre.y.9, tre.oy.10 + tre.sy.10 * tre.y.10, tre.oy.11 + tre.sy.11 * tre.y.11, tre.oy.12 + tre.sy.12 * tre.y.12, tre.oy.13 + tre.sy.13 * tre.y.13, tre.oy.14 + tre.sy.14 * tre.y.14, tre.oy.15 + tre.sy.15 * tre.y.15)
    let dq.tw = pick(max(over, 0), tre.sx.0 * tre.w.0, tre.sx.1 * tre.w.1, tre.sx.2 * tre.w.2, tre.sx.3 * tre.w.3, tre.sx.4 * tre.w.4, tre.sx.5 * tre.w.5, tre.sx.6 * tre.w.6, tre.sx.7 * tre.w.7, tre.sx.8 * tre.w.8, tre.sx.9 * tre.w.9, tre.sx.10 * tre.w.10, tre.sx.11 * tre.w.11, tre.sx.12 * tre.w.12, tre.sx.13 * tre.w.13, tre.sx.14 * tre.w.14, tre.sx.15 * tre.w.15)
    let dq.th = pick(max(over, 0), tre.sy.0 * tre.h.0, tre.sy.1 * tre.h.1, tre.sy.2 * tre.h.2, tre.sy.3 * tre.h.3, tre.sy.4 * tre.h.4, tre.sy.5 * tre.h.5, tre.sy.6 * tre.h.6, tre.sy.7 * tre.h.7, tre.sy.8 * tre.h.8, tre.sy.9 * tre.h.9, tre.sy.10 * tre.h.10, tre.sy.11 * tre.h.11, tre.sy.12 * tre.h.12, tre.sy.13 * tre.h.13, tre.sy.14 * tre.h.14, tre.sy.15 * tre.h.15)
    // Its box on the screen, and where the mouse is in it.
    let dq.X = mg.x0 + gap + (dq.tx - dq.cx) / dq.cw * (mg.Ws - gap)
    let dq.Y = mg.y0 + (dq.ty - dq.cy) / dq.ch * (dq.ah + gap)
    let dq.W = dq.tw / dq.cw * (mg.Ws - gap) - gap
    let dq.H = dq.th / dq.ch * (dq.ah + gap) - gap
    let dq.u = (mouse.x - dq.X) / max(dq.W, 1)
    let dq.v = (mouse.y - dq.Y) / max(dq.H, 1)
    let dq.edge = min(min(dq.u, 1 - dq.u), min(dq.v, 1 - dq.v))
    let dq.side = if(dq.edge >= 0.25, 4, if(dq.u == dq.edge, 0, if(1 - dq.u == dq.edge, 1, if(dq.v == dq.edge, 2, 3))))
    prop dqo = 0 ~160ms
    follow dqo = if(dq.on, 1, 0)
    prop dqx = 0 ~glide
    prop dqy = 0 ~glide
    prop dqw = 0 ~glide
    prop dqh = 0 ~glide
    follow dqx = dq.X + if(dq.side == 1, dq.W / 2, 0)
    follow dqy = dq.Y + if(dq.side == 3, dq.H / 2, 0)
    follow dqw = if(dq.side < 1.5, dq.W / 2, dq.W)
    follow dqh = if(dq.side == 2 or dq.side == 3, dq.H / 2, dq.H)
    group {
        show: dqo > 0.01 and screen.index == mon
        opacity: dqo
        box { from: dqx, dqy; size: max(dqw, 1), max(dqh, 1); corner: 12; color: mint; opacity: if(dq.side == 4, 10%, 16%) }
        box { from: dqx, dqy; size: max(dqw, 1), max(dqh, 1); corner: 12; stroke: 2; color: mint; opacity: 75% }
        box { from: dqx + 10, dqy + 6; size: max(dqw - 20, 1), 2; corner: 1; color: #e9fff6; opacity: if(dq.side == 4, 0, 55%) }
        // (A group: the two side by side, smaller, in that box.)
        box { from: dqx + dqw * 0.12, dqy + dqh * 0.2; size: max(dqw * 0.36, 1), max(dqh * 0.6, 1); corner: 8; color: mint; opacity: if(dq.side == 4, 30%, 0) }
        box { from: dqx + dqw * 0.52, dqy + dqh * 0.2; size: max(dqw * 0.36, 1), max(dqh * 0.6, 1); corner: 8; color: mint; opacity: if(dq.side == 4, 30%, 0) }
    }

    // ── the magnet's pool: where the window will be if let go now ──
    group {
        show: mgo > 0.01 and screen.index == mon
        opacity: mgo
        box { from: mgx, mgy; size: max(mgw, 1), max(mgh, 1); corner: 14; color: mint; opacity: 14% }
        box { from: mgx, mgy + max(mgh, 1) * 0.55; size: max(mgw, 1), max(mgh, 1) * 0.45; corner: 14; color: mint; opacity: 10% }
        box { from: mgx, mgy; size: max(mgw, 1), max(mgh, 1); corner: 14; stroke: 2; color: mint; opacity: 75% }
        // The water's edge, gently moving, along its top.
        box { from: mgx + 10, mgy + 6; size: max(mgw - 20, 1), 2; corner: 1; color: #e9fff6; opacity: 55% }
    }

    // The window being carried, over all the others: lifted, a little smaller
    // and see-through, so that where it will land shows below it. It goes with
    // the mouse on the whole desktop: each monitor draws its part of it, so
    // crossing from one to the other it is seen half on each.
    repeat i in 0..16 {
        // Monitor 1 starts where monitor 0 ends.
        let x = mouse.x + mx[mon] - mx[screen.index] - grab.x
        let y = mouse.y - grab.y
        let w = w.$i
        let h = h.$i
        group {
            show: dragging == i or (landing == i and win.$i.open and win.$i.screen != landing.to)
            opacity: 88%
            pivot: x + w / 2, y + h / 2
            scale: 1
            body {
                color: #0c0e10
                shadow: 0, 26, 50, 60%
                box { from: x, y; size: w, h; corner: 12 }
            }
            let carried = dragging == i or (landing == i and win.$i.open and win.$i.screen != landing.to)
            group {
                show: wet <= 0.001 and cold <= 0.001
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: #1d2b27; show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink; opacity: hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: win.$i.width, win.$i.height; show: carried and wet <= 0.001 and cold <= 0.001 }
            }
            // Carried in the rain, its water goes with it, lagging behind.
            group {
                show: wet > 0.001
                shader: rain, wet * pour, mouse.x - lag.x, mouse.y - lag.y
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: #1d2b27; show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink; opacity: hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: win.$i.width, win.$i.height; show: carried and wet > 0.001 }
            }
            // And in the snow, its snow and its frost.
            group {
                show: cold > 0.001 and wet <= 0.001
                shader: snow, cold, mouse.x - lag.x, mouse.y - lag.y
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: #1d2b27; show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 90, 10); lines: 1; color: ink; opacity: hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: win.$i.width, win.$i.height; show: carried and cold > 0.001 and wet <= 0.001 }
            }
            box { from: x, y; size: w, h; corner: 12; stroke: 1.5; color: mint; opacity: 80% }
        }
    }

    // ── the layouts strip: while a window is carried, at the top of the
    // monitor under the mouse, if that one is tiled. Over one, everything
    // shows how it would be ──
    prop strip = 0 ~160ms
    follow strip = if(dragging >= 0 and not dfl and free[mon] < 0.5, 1, 0)
    let ico = #f5f7f5
    group {
        show: strip > 0.01 and screen.index == mon
        opacity: strip
        body {
            color: #0d1013
            shadow: 0, 10, 28, 45%
            box { from: strip.x - 6, strip.y - 4; size: 9 * 60 + 12, 52; corner: 14; opacity: 90% }
        }
        box { from: strip.x - 6, strip.y - 4; size: 9 * 60 + 12, 52; corner: 14; stroke: 1; color: mint; opacity: 35% }
        repeat k in 0..9 {
            box { from: strip.x + k * 60 + 3, strip.y + 1; size: 54, 42; corner: 10; color: mint; opacity: 22% * (picked == k) }
        }
        // A leader on the left, and the rest on the right.
        group {
            opacity: 50% + 50% * (picked == 0)
            box { from: strip.x + 10, strip.y + 9; size: 22, 26; corner: 3; color: ico }
            box { from: strip.x + 34, strip.y + 9; size: 16, 12; corner: 3; color: ico }
            box { from: strip.x + 34, strip.y + 23; size: 16, 12; corner: 3; color: ico }
        }
        // Columns.
        group {
            opacity: 50% + 50% * (picked == 1)
            box { from: strip.x + 70, strip.y + 9; size: 12, 26; corner: 3; color: ico }
            box { from: strip.x + 84, strip.y + 9; size: 12, 26; corner: 3; color: ico }
            box { from: strip.x + 98, strip.y + 9; size: 12, 26; corner: 3; color: ico }
        }
        // Rows.
        group {
            opacity: 50% + 50% * (picked == 2)
            box { from: strip.x + 130, strip.y + 9; size: 40, 8; corner: 2; color: ico }
            box { from: strip.x + 130, strip.y + 18; size: 40, 8; corner: 2; color: ico }
            box { from: strip.x + 130, strip.y + 27; size: 40, 8; corner: 2; color: ico }
        }
        // A grid.
        group {
            opacity: 50% + 50% * (picked == 3)
            box { from: strip.x + 190, strip.y + 9; size: 19, 12; corner: 3; color: ico }
            box { from: strip.x + 211, strip.y + 9; size: 19, 12; corner: 3; color: ico }
            box { from: strip.x + 190, strip.y + 23; size: 19, 12; corner: 3; color: ico }
            box { from: strip.x + 211, strip.y + 23; size: 19, 12; corner: 3; color: ico }
        }
        // A leader on the right.
        group {
            opacity: 50% + 50% * (picked == 4)
            box { from: strip.x + 250, strip.y + 9; size: 16, 12; corner: 3; color: ico }
            box { from: strip.x + 250, strip.y + 23; size: 16, 12; corner: 3; color: ico }
            box { from: strip.x + 268, strip.y + 9; size: 22, 26; corner: 3; color: ico }
        }
        // Scrolling: columns that go on past the edge.
        group {
            opacity: 50% + 50% * (picked == 5)
            box { from: strip.x + 304, strip.y + 9; size: 18, 26; corner: 3; color: ico }
            box { from: strip.x + 324, strip.y + 9; size: 18, 26; corner: 3; color: ico }
            box { from: strip.x + 344, strip.y + 9; size: 8, 26; corner: 3; color: ico; opacity: 45% }
        }
        // «marea»: one wide, the rest narrower, and the water under them.
        group {
            opacity: 50% + 50% * (picked == 6)
            box { from: strip.x + 370, strip.y + 9; size: 22, 22; corner: 3; color: ico }
            box { from: strip.x + 394, strip.y + 9; size: 10, 22; corner: 3; color: ico }
            box { from: strip.x + 406, strip.y + 9; size: 6, 22; corner: 2; color: ico }
            box { from: strip.x + 370, strip.y + 33; size: 42, 3; corner: 1.5; color: mint }
        }
        // Fractal: a box split, and one of its halves split again, and again.
        group {
            opacity: 50% + 50% * (picked == 7)
            box { from: strip.x + 430, strip.y + 9; size: 20, 26; corner: 3; color: ico }
            box { from: strip.x + 452, strip.y + 9; size: 18, 12; corner: 3; color: ico }
            box { from: strip.x + 452, strip.y + 23; size: 8, 12; corner: 2; color: ico }
            box { from: strip.x + 462, strip.y + 23; size: 8, 5; corner: 1.5; color: ico }
            box { from: strip.x + 462, strip.y + 30; size: 8, 5; corner: 1.5; color: ico }
        }
        // A canvas: windows here and there on a plane, one of them going off it.
        group {
            opacity: 50% + 50% * (picked == 8)
            repeat k in 0..4 {
                ellipse { at: strip.x + 492 + k * 12, strip.y + 5; radius: 0.9; color: ico; opacity: 50% }
                ellipse { at: strip.x + 492 + k * 12, strip.y + 39; radius: 0.9; color: ico; opacity: 50% }
            }
            box { from: strip.x + 489, strip.y + 10; size: 16, 12; corner: 2.5; color: ico }
            box { from: strip.x + 508, strip.y + 14; size: 14, 18; corner: 2.5; color: ico }
            box { from: strip.x + 494, strip.y + 25; size: 11, 9; corner: 2; color: ico }
            box { from: strip.x + 525, strip.y + 24; size: 6, 10; corner: 1.5; color: ico; opacity: 45% }
        }
    }

    // ── what it can be asked to do: its actions ──
    // Keys and gestures are not here: `keys.conf` binds them to these —the one
    // that comes with pleamar-wm, or yours in ~/.config/pleamar/keys.conf—.
    // Each is an event, so Marea or anyone can ask too
    // (`pleamar-wm --say wm "emit overview"`).
    let fplace = win[max(win.focus, 0)].place
    let next = win.order[mod(focus_at + 1, all)]
    let previous = win.order[mod(focus_at + all - 1, all)]
    // Scrolling: its monitor's strip glides just enough for the one with the
    // keyboard to be whole in sight, and never past either end.
    let f.among = max(win[max(win.focus, 0)].among, 1)
    let sws[4]
    let scw[4]
    let sl[4]
    repeat j in 0..4 {
        sws[j] = screen.$j.width - win.reserved.$j.left - win.reserved.$j.right
        scw[j] = if(f.among < 1.5, sws.$j - 2 * gap, (sws.$j - 3 * gap) * ratio)
        sl[j] = gap + max(fplace, 0) * (scw.$j + gap)
        on change sl.$j + f.among * 7919 + win.focus * 131 + lay.$j * 17 + ratio * 1000 while win.focus >= 0 and fscreen == j and lay.$j == 5 {
            sco.$j = max(0, min(min(max(sco.$j, sl.$j + scw.$j + gap - sws.$j), sl.$j - gap), gap + f.among * (scw.$j + gap) - sws.$j))
        }
    }
    // ── the keyboard to the window that way (Super+arrows): the nearest one
    // whose middle is that way, by where the windows are drawn, across
    // monitors too; the same in every layout, free too. The one with the
    // keyboard says where it is and which way; each window says how near
    // it is that way, and a moment later the nearest one has it. ──
    event focus_left
    event focus_right
    event focus_up
    event focus_down
    fact dir.q = 0                 // 1 left · 2 right · 3 up · 4 down
    fact dir.fx = 0
    fact dir.fy = 0
    prop dir.go = 0 ~0ms
    on focus_left while win.focus >= 0 { dir.q = 1; dir.fx = dir.cx[win.focus]; dir.fy = dir.cy[win.focus]; dir.go: 0 ~0ms; dir.go: 1 after 16ms }
    on focus_right while win.focus >= 0 { dir.q = 2; dir.fx = dir.cx[win.focus]; dir.fy = dir.cy[win.focus]; dir.go: 0 ~0ms; dir.go: 1 after 16ms }
    on focus_up while win.focus >= 0 { dir.q = 3; dir.fx = dir.cx[win.focus]; dir.fy = dir.cy[win.focus]; dir.go: 0 ~0ms; dir.go: 1 after 16ms }
    on focus_down while win.focus >= 0 { dir.q = 4; dir.fx = dir.cx[win.focus]; dir.fy = dir.cy[win.focus]; dir.go: 0 ~0ms; dir.go: 1 after 16ms }
    // The nearest that way: the first with the lowest score.
    let dir.bs = 1000000
    let dir.best = -1
    repeat i in 0..16 {
        dir.best = if(dir.score[i] < dir.bs, i, dir.best)
        dir.bs = min(dir.bs, dir.score[i])
    }
    on change dir.go while dir.go > 0.5 and dir.best >= 0 and dir.bs < 999999 { focus win(dir.best) }
    event close
    event minimize
    // One window over the tiles, and back (Super+V): its monitor stays tiled.
    event toggle_float
    let focus.floating = win[max(win.focus, 0)].floating
    on toggle_float while win.focus >= 0 and not focus.floating { float win(win.focus) }
    on toggle_float while win.focus >= 0 and focus.floating { tile win(win.focus) }
    event restore_last
    event fullscreen
    // All of its monitor and back: tiled, over the others (the bars and the
    // gaps kept); free, its green button.
    event maximize
    event overview
    event focus_next
    event focus_previous
    event move_left
    event move_right
    event move_up
    event move_down
    event narrower
    event wider
    on close { close win(win.focus) }
    // Put away into Marea, and the last one back.
    on minimize while free[max(fscreen, 0)] > 0.5 { minimize win(win.focus) }
    on restore_last { restore win(last_min) }
    on fullscreen { fullscreen win(win.focus) }
    on overview { toggle overview }
    on key Escape while overview { overview = false }

    // ── sharing the screen: what a program in a call wants to show ──
    // The compositor asks (`win.picking`: 1 a monitor, 2 a window, 3 either):
    // the overview opens, a window is chosen by pressing it, a whole monitor
    // by the band on top of it, and nothing with Escape or «Cancel».
    let sharing = win.picking > 0
    let share.windows = win.picking >= 2
    let share.screens = win.picking == 1 or win.picking == 3
    on change win.picking while win.picking > 0 { overview = true }
    on change win.picking while win.picking < 1 { overview = false }
    on key Escape while sharing { pick none }
    prop share.in = 0 ~160ms
    follow share.in = if(sharing, 1, 0)
    repeat s in 0..4 {
        let band.y = win.reserved[s].top + 52
        let band.w = if(share.screens, 560, 420)
        prop screen_glow.$s = 0 ~140ms
        prop cancel_glow.$s = 0 ~140ms
        group {
            z: 99995
            show: share.in > 0.01 and screen.index == s
            opacity: share.in
            move: 0, -14 * (1 - share.in)
            body {
                color: #0c0e10
                rim: 8%
                shadow: 0, 10, 30, 50%
                box { at: W / 2, band.y; size: band.w, 56; corner: 28 }
            }
            // A red dot, as a camera that is about to see.
            ellipse { at: W / 2 - band.w / 2 + 28, band.y; radius: 6; color: #ef7a66 }
            ellipse { at: W / 2 - band.w / 2 + 28, band.y; radius: 10; stroke: 1.5; color: #ef7a66; opacity: 40% }
            text pick(win.picking - 1, "Share a screen", "Choose a window", "Choose what to share") { at: W / 2 - band.w / 2 + 48, band.y - 8; anchor: left center; size: 13.5; weight: 600; color: ink }
            text pick(win.picking - 1, "This one, or another", "Press the one to share", "Press a window, or share a whole screen") { at: W / 2 - band.w / 2 + 48, band.y + 10; anchor: left center; size: 11; color: #8b8f95 }
            group {
                show: share.screens
                box { at: W / 2 + band.w / 2 - 190, band.y; size: 150, 36; corner: 18; color: mix(#1a2a25, #24524a, screen_glow.$s) }
                box { at: W / 2 + band.w / 2 - 190, band.y; size: 150, 36; corner: 18; stroke: 1.2; color: mint; opacity: 50% + 50% * screen_glow.$s }
                text "This whole screen" { at: W / 2 + band.w / 2 - 190, band.y; anchor: center; size: 12; weight: 600; color: ink }
                zone box share_screen.$s { at: W / 2 + band.w / 2 - 190, band.y; size: 150, 36; corner: 18; cursor: pointer; agent: no }
            }
            box { at: W / 2 + band.w / 2 - 62, band.y; size: 88, 36; corner: 18; color: mix(#1c1d1f, #3a2424, cancel_glow.$s) }
            text "Cancel" { at: W / 2 + band.w / 2 - 62, band.y; anchor: center; size: 12; weight: 500; color: ink }
            zone box share_cancel.$s { at: W / 2 + band.w / 2 - 62, band.y; size: 88, 36; corner: 18; cursor: pointer }
        }
        on enter share_screen.$s { screen_glow.$s: 1 }
        on leave share_screen.$s { screen_glow.$s: 0 }
        on enter share_cancel.$s { cancel_glow.$s: 1 }
        on leave share_cancel.$s { cancel_glow.$s: 0 }
        on press share_screen.$s { pick screen s }
        on press share_cancel.$s { pick none }
    }
    // The keyboard to the next one, or the one before.
    on focus_next { focus win(next) }
    on focus_previous { focus win(previous) }
    // Moving it: left, to lead (and if it already leads, to the monitor on the
    // left); right, to the monitor on the right; up and down, in the order.
    on move_left while fplace > 0.5 { promote win(win.focus) }
    on move_left while fplace < 0.5 and fscreen > 0.5 { send win(win.focus) to 0 }
    on move_right while fscreen < 0.5 { send win(win.focus) to 1 }
    on move_up { swap win(win.focus) with win(previous) }
    on move_down { swap win(win.focus) with win(next) }
    // The leader narrower or wider.
    on narrower while not zf and not zc { ratio = clamp(ratio - 0.05, 0.25, 0.8) }
    on wider while not zf and not zc { ratio = clamp(ratio + 0.05, 0.25, 0.8) }
    on narrower while zc { emit zoom_out }
    on wider while zc { emit zoom_in }
    on narrower while zf { emit zoom_out }
    on wider while zf { emit zoom_in }
    // ── into Marea's island, and out of it ──
    // A window put away is sucked into the island where Marea lives —on its
    // monitor, or on the other one: Marea says which (`island.screen`)—, up
    // first, shrinking and fading as it goes, over everything; brought back,
    // it comes out of it the same way. Drawn on every monitor it crosses, as
    // a carried one is: monitor 1 starts where monitor 0 ends.
    fact island.screen = -1
    repeat i in 0..16 {
        let sc = win.$i.screen
        // (Into its own monitor's shore, now; no longer Marea's island.)
        let isl = sc
        // (Eased in: the spring is quick at first, and the melting is to be seen.)
        let m = pow(mini.$i, 1.8)
        let off = mx[sc] - mx[screen.index]
        let x = x.$i + off
        let y = y.$i
        let w = w.$i
        let h = h.$i
        // Where it goes, from this monitor's corner: its place among the ones
        // put away on the shore —or its program's icon, with `dock.into`—,
        // moved aside as the icons before it swell (see the shore).
        let dq = dk.q[sc]
        let dcr = dk.cr[sc]
        let dcs = dk.cs[sc]
        let da0 = dk.a0[sc]
        let mc0 = if(dock.into > 0.5, da0 + 14 + max(win.$i.dockat, 0) * dkcell + dkcell / 2, da0 + 14 + win.docks[sc] * dkcell + 20 + max(win.$i.minat, 0) * dkmc + dkmc / 2)
        let md = (mc0 - dk.ma[sc]) / dkreach
        let ma = mc0 + dk.K[sc] * (if(md < -1, 0, if(md < 0, pow(1 + md, 3) / 3, if(md < 1, (2 - pow(1 - md, 3)) / 3, 2 / 3))) - 1 / 3)
        let tx = off + if(dkvert, dcr + dcs * dq, ma)
        let ty = if(dkvert, ma, dcr + dcs * dq)
        // On its way it melts into water: its corners round off, it turns
        // Marea's colour and draws out along its path like a falling
        // drop; halfway a real drop takes over, with two droplets behind it,
        // and where it lands the island ripples. Brought back, the same
        // backwards: the drop leaves the ripple and swells into the window.
        let q = smooth(0.05, 0.5, m)
        // (It shrinks to the size of the drop by the time the drop takes over.)
        let s0 = 1 - smooth(0, 0.62, m) * (1 - 22 / max(max(w, h), 22))
        let cx = x + w / 2 + (tx - x - w / 2) * m
        let cy = y + h / 2 + (ty - y - h / 2) * (2 * m - m * m)
        let round = 12 + q * min(w, h) * 0.5
        group {
            // (Hands over to the window at the same point it takes over: never
            // a frame with neither, which a spring's long tail made a second.)
            show: mini.$i > 0.02 and m < 0.75 and win.$i.open and (screen.index == sc or screen.index == isl)
            opacity: 1 - smooth(0.5, 0.68, m)
            pivot: x + w / 2, y + h / 2
            move: (tx - x - w / 2) * m, (ty - y - h / 2) * (2 * m - m * m)
            scale: s0 * (1 - 0.2 * sin(180 * m)), s0 * (1 + 0.25 * sin(180 * m))
            body {
                color: #0c0e10
                shadow: 0, 18 * (1 - q), 44, 55%
                box { from: x, y; size: w, h; corner: round }
            }
            group {
                clip box { from: x, y; size: w, h; corner: round }
                box { from: x, y; size: w, tb * hb.$i; color: #1d2b27; show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 110, 10); lines: 1; color: ink; opacity: hb.$i; show: hb.$i > 0.01 }
                // Its program keeps the size it has while it shrinks into the drop: the
                // picture is scaled, not the program asked (a browser asked for
                // 60 × 4 froze).
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: win.$i.width, win.$i.height }
                body {
                    gradient: x, y to x, y + h, #2b3030, marea 55%, #0e0f0f
                    opacity: 96% * q
                    box { from: x, y; size: w, h }
                }
            }
            box { from: x, y; size: w, h; corner: round; stroke: 1.5 + 2 * q; color: ink; opacity: 18% + 10% * q }
        }
        let drop = smooth(0.45, 0.62, m) * (1 - smooth(0.9, 0.995, m))
        let c1 = max(m - 0.07, 0)
        let c2 = max(m - 0.14, 0)
        group {
            show: drop > 0.01 and win.$i.open and (screen.index == sc or screen.index == isl)
            opacity: drop
            // Marea's own skin, and its tail melted into it.
            body {
                color: marea
                rim: 22%
                shadow: 0, 4, 12, 40%
                ellipse { at: cx, cy; radius: 11; scale: 1 - 0.2 * sin(180 * m), 1 + 0.3 * sin(180 * m) }
                ellipse { at: x + w / 2 + (tx - x - w / 2) * c1, y + h / 2 + (ty - y - h / 2) * (2 * c1 - c1 * c1); radius: 5.5; blend: 9 }
                ellipse { at: x + w / 2 + (tx - x - w / 2) * c2, y + h / 2 + (ty - y - h / 2) * (2 * c2 - c2 * c2); radius: 3.2; blend: 7 }
            }
            ellipse { at: cx - 3.5, cy - 4.5; radius: 2.4; scale: 1.3, 0.8; color: ink; opacity: 35% }
        }
        // Put away, it floats on its shore as it is, small, with its
        // program's icon; pressed, it comes back.
        let dm.h = 40 * dkf
        let dm.w = clamp(dm.h * win.$i.width / max(win.$i.height, 1), 30 * dkf, if(dkvert, 60, 68) * dkf)
        group {
            z: 99983
            show: dock.into < 0.5 and win.$i.minimized and win.$i.open and win.$i.minat >= 0 and mini.$i > 0.7 and sc == screen.index and shore[sc] > 0.3
            opacity: smooth(0.7, 0.95, mini.$i)
            body {
                color: #0c0e10
                rim: 14%
                shadow: 0, 3, 10, 40%
                // (Lifted a little, out from the edge, under the mouse.)
                box { at: tx + if(dkvert, dcs * 2 * dockmin.$i.hover, 0), ty + if(dkvert, 0, dcs * 2 * dockmin.$i.hover); size: dm.w + 4, dm.h + 4; corner: 6 }
            }
            group {
                clip box { at: tx + if(dkvert, dcs * 2 * dockmin.$i.hover, 0), ty + if(dkvert, 0, dcs * 2 * dockmin.$i.hover); size: dm.w, dm.h; corner: 4 }
                window win.$i { at: tx + if(dkvert, dcs * 2 * dockmin.$i.hover, 0) - dm.w / 2, ty + if(dkvert, 0, dcs * 2 * dockmin.$i.hover) - dm.h / 2; size: dm.w, dm.h; ask: win.$i.width, win.$i.height }
            }
            image appicon.$i { at: tx + dm.w / 2 - 12 * dkf, ty + dm.h / 2 - 12 * dkf; size: 18 * dkf, 18 * dkf }
            zone box dockmin.$i { at: tx, ty; size: dm.w + 10, dm.h + 10; corner: 8; cursor: pointer; active: not overview and dock.into < 0.5; label: "{win.$i.title}" }
        }
        on press dockmin.$i { restore win.$i }
        // Its preview, rising from the shore's water when its program's icon is
        // hovered a moment: the window as it is, live, and its title; pressed,
        // it is the one (brought back, if put away). A picture only: it asks
        // the window for no size (`ask: -1, -1`).
        let pvk = pv[sc]
        let pvn = pv.n[sc]
        let pvup = pvup[sc]
        let pvw = min(210, 132 * max(win.$i.width, 1) / max(win.$i.height, 1))
        let pvh = min(132, 210 * max(win.$i.height, 1) / max(win.$i.width, 1))
        // (Over its icon at the bottom, a row; beside it on a side, a row going out.)
        let pvx = pv.bx[sc] + pv.sx[sc] * win.$i.dockturn + pv.ox[sc] * (1 - pvup)
        let pvy = pv.by[sc] + pv.oy[sc] * (1 - pvup)
        group {
            z: 99985
            show: pvk >= 0 and win.$i.dockat == pvk and win.$i.dockturn >= 0 and pvup > 0.01 and sc == screen.index
            opacity: pvup
            zone box dockpv.$i { at: pvx, pvy + 10; size: 222, 170; corner: 14; cursor: pointer; active: pvup > 0.9; label: "{win.$i.title}" }
            group {
                pivot: pvx, pvy + 70
                scale: 0.92 + 0.08 * pvup + 0.03 * dockpv.$i.hover
                body {
                    color: #0c0e10
                    rim: 12% + 10% * dockpv.$i.hover
                    shadow: 0, 12, 28, 45%
                    box { at: pvx, pvy + 10; size: 222, 170; corner: 14 }
                }
                group {
                    clip box { at: pvx, pvy; size: pvw, pvh; corner: 6 }
                    window win.$i { at: pvx - pvw / 2, pvy - pvh / 2; size: pvw, pvh; ask: -1, -1 }
                }
                text win.$i.title { at: pvx, pvy + 80; anchor: center; size: 11; weight: 500; width: 196; lines: 1; color: ink; opacity: 85% }
                box { at: pvx, pvy + 10; size: 222, 170; corner: 14; stroke: 1.4; color: mint; opacity: 70% * win.$i.focused }
            }
        }
        on press dockpv.$i while win.$i.minimized {
            restore win.$i
            focus win.$i
        }
        on press dockpv.$i while not win.$i.minimized { focus win.$i }
        on press dockpv.$i {
            repeat k in 0..4 {
                pv.$k = -1
            }
        }
        // Its row in its program's menu on the shore (the shore draws the
        // menu): pressed, it is the one, brought back if put away.
        let dmk = dmenu[sc]
        let dmup = mnup[sc]
        let rx = mn.x[sc]
        let ry = mn.y[sc] + 6 + win.$i.dockturn * 28
        group {
            z: 99986
            show: dmk >= 0 and win.$i.dockat == dmk and win.$i.dockturn >= 0 and win.$i.dockturn < 6 and dmup > 0.01 and sc == screen.index and win.$i.open
            opacity: dmup
            zone box dmw.$i { from: rx + 6, ry; size: 208, 28; corner: 8; cursor: pointer; active: dmup > 0.9; label: "{win.$i.title}" }
            box { from: rx + 6, ry; size: 208, 28; corner: 8; color: ink; opacity: 8% * dmw.$i.hover }
            ellipse { at: rx + 18, ry + 14; radius: 2.6; color: mint; show: win.$i.focused }
            text win.$i.title { at: rx + 28, ry + 14; anchor: left center; size: 12; weight: 500; width: 176; lines: 1; color: ink; opacity: if(win.$i.minimized, 50%, 100%) }
        }
        on press dmw.$i while win.$i.minimized { restore win.$i }
        on press dmw.$i {
            focus win.$i
            repeat k in 0..4 {
                dmenu.$k = -1
            }
        }
        // The ripple where it lands (or leaves from).
        prop splash.$i = 1 ~900ms
        on change win.$i.minimized while win.$i.minimized {
            splash.$i: 0 ~0ms
            splash.$i: 1 after 430ms
        }
        on change win.$i.minimized while not win.$i.minimized and win.$i.open {
            splash.$i: 0 ~0ms
            splash.$i: 1 after 16ms
        }
        group {
            show: splash.$i > 0.001 and splash.$i < 0.995 and screen.index == isl and win.$i.open
            ellipse { at: tx, ty; radius: 4 + 30 * splash.$i; scale: 1, 0.45; stroke: 2.5 * (1 - splash.$i) + 0.6; color: ink; opacity: 45% * (1 - splash.$i) }
            ellipse { at: tx, ty; radius: 2 + 20 * max(splash.$i - 0.15, 0); scale: 1, 0.45; stroke: 2 * (1 - splash.$i) + 0.5; color: ink; opacity: 28% * (1 - splash.$i) }
            ellipse { at: tx, ty - 10 * sin(180 * splash.$i); radius: 2.4 * (1 - splash.$i); color: ink; opacity: 50% * (1 - splash.$i) }
        }
    }

    // ── fullscreen: one that asked (F11, a video, a game) or Super+F covers
    // its monitor, over the bar and the other programs' bars ──
    repeat i in 0..16 {
        let fs.ws = win.$i.pool == inpool[max(win.$i.screen, 0)]
        let fs.here = win.$i.fullscreen and win.$i.open and win.$i.screen == screen.index and fs.ws
        prop fs.$i = 0 ~160ms
        follow fs.$i = if(win.$i.fullscreen and win.$i.open and fs.ws, 1, 0)
        group {
            show: fs.$i > 0.01 and win.$i.screen == screen.index
            opacity: fs.$i
            box { from: 0, 0; size: W, H; color: #000 }
            window win.$i { at: 0, 0; size: W, H; ask: W, H; show: fs.here }
        }
    }
    // ── dialogs: a message, a file chooser, a window of another's: over the
    // fullscreen ones too (drawn after them): a «Save image» asked by a
    // fullscreen viewer was hidden behind it, and being modal, the viewer
    // took nothing until it went —nobody could see it to close it—.
    // rest, at the size it chooses, in the middle of its monitor ──
    repeat i in 0..16 {
        let dw = max(win.$i.width, 120)
        let dh = max(win.$i.height, 40) + tb
        let dx = (W - dw) / 2
        let dy = (H - dh) / 2
        prop dlg.$i = 0 ~220ms
        let dlg.ws = win.$i.pool == inpool[max(win.$i.screen, 0)]
        // The mouse going into it gives it the keyboard, as it does a window.
        let dlg.pointed = win.$i.dialog and win.$i.open and dlg.ws and win.$i.screen == mon and abs(mouse.x - Wmon / 2) <= dw / 2 and abs(mouse.y - Hmon / 2) <= dh / 2
        on change dlg.pointed while dlg.pointed and dragging < 0 and not overview { focus win.$i }
        follow dlg.$i = if(win.$i.dialog and win.$i.open and dlg.ws, 1, 0)
        group {
            show: dlg.$i > 0.01 and win.$i.screen == screen.index
            opacity: dlg.$i
            pivot: dx + dw / 2, dy + dh / 2
            scale: 0.94 + 0.06 * dlg.$i
            body {
                color: #0c0e10
                shadow: 0, 18, 44, 55%
                box { from: dx, dy; size: dw, dh; corner: 12 }
            }
            group {
                clip box { from: dx, dy; size: dw, dh; corner: 12 }
                box { from: dx, dy; size: dw, tb; color: #1d2b27 }
                text win.$i.title { at: dx + 14, dy + tb / 2; anchor: left center; size: 12; weight: 500; width: max(dw - 40, 10); lines: 1; color: ink }
                window win.$i { at: dx, dy + tb; size: win.$i.width, win.$i.height; ask: 0, 0; show: win.$i.dialog and win.$i.open and win.$i.screen == screen.index and dlg.ws }
            }
            box { from: dx, dy; size: dw, dh; corner: 12; stroke: 1.5; color: mint; opacity: 70% * win.$i.focused }
        }
    }

    // The rain itself, in front of everything: streaks, slanted a little.
    group {
        z: 100000
        show: wet > 0.001
        opacity: wet * (0.45 + 0.55 * pour)
        particles {
            at: W / 2, -40; area: W + 300, 1; count: 130
            life: 0.55s .. 0.9s; speed: 1600 .. 2100
            direction: 100deg; spread: 3deg; gravity: 0, 0
            size: 1.2, 0.9; colors: #e4f0ff, #c8dcf0; opacity: 24%, 12%
            shape: spark; emit: rain
        }
    }
    // (The rest of the downpour, only when it pours.)
    group {
        z: 100000
        show: wet > 0.001 and pour > 0.4
        opacity: wet * smooth(0.4, 0.9, pour)
        particles {
            at: W / 2, -40; area: W + 300, 1; count: 250
            life: 0.55s .. 0.9s; speed: 1600 .. 2100
            direction: 100deg; spread: 3deg; gravity: 0, 0
            size: 1.2, 0.9; colors: #e4f0ff, #c8dcf0; opacity: 24%, 12%
            shape: spark; emit: rain
        }
    }
    // And the snow, drifting down in front of everything: big slow flakes and
    // small quick ones.
    group {
        z: 100001
        show: cold > 0.001
        opacity: cold
        particles {
            at: W / 2, -20; area: W + 200, 1; count: 500
            life: 9s .. 12s; speed: 120 .. 170
            direction: 95deg; spread: 30deg; gravity: 0, 4
            size: 3.2, 2.6; colors: #ffffff, #e8f2ff; opacity: 85%, 60%
            shape: dot; emit: snow
        }
        particles {
            at: W / 2, -20; area: W + 200, 1; count: 700
            life: 7s .. 10s; speed: 150 .. 220
            direction: 100deg; spread: 20deg; gravity: 0, 6
            size: 1.8, 1.4; colors: #ffffff, #dfeaf7; opacity: 70%, 45%
            shape: dot; emit: snow
        }
    }
    // Marea follows the mouse from monitor to monitor: she is told which.
    repeat k in 0..4 {
        on change mon while mon == k { launch "pleamar-wm --say marea 'emit pointer_monitor k'" }
    }
    // Tiled or free, on the monitor under the mouse (Super+W; Marea's menu too).
    event toggle_free
    repeat k in 0..4 {
        on toggle_free while mon == k { free.$k = 1 - free.$k }
    }

    // ── Marea rides a window ──
    // Marea asks (`emit ride`): she leaves her island by the top edge, and here
    // she drops onto the title bar of the window with the keyboard. She rides
    // it: carried, she leans against the move and sways when it stops; shaken
    // hard, she falls off. She hops to the window you settle on, jumps home
    // when hers closes or is put away, and a press on her sends her home too.
    // Back home, Marea is told (`ride_back`) and comes out of her island.
    // Everything here is in the desktop's coordinates —monitor 1 starts where
    // monitor 0 ends—, so she can ride a window from one monitor to the other.
    // ── the wires: a new one, a frame after it is asked for —not twice
    // between the same two; in the first free place—, and the ones of a
    // window that goes ──
    repeat q in 0..1 {
        let wn.free = if(wire.0.a < 0, 0, if(wire.1.a < 0, 1, if(wire.2.a < 0, 2, if(wire.3.a < 0, 3, if(wire.4.a < 0, 4, if(wire.5.a < 0, 5, if(wire.6.a < 0, 6, if(wire.7.a < 0, 7, -1))))))))
        let wn.dup = (wire.0.a == wnew.a and wire.0.b == wnew.b) or (wire.0.a == wnew.b and wire.0.b == wnew.a) or (wire.1.a == wnew.a and wire.1.b == wnew.b) or (wire.1.a == wnew.b and wire.1.b == wnew.a) or (wire.2.a == wnew.a and wire.2.b == wnew.b) or (wire.2.a == wnew.b and wire.2.b == wnew.a) or (wire.3.a == wnew.a and wire.3.b == wnew.b) or (wire.3.a == wnew.b and wire.3.b == wnew.a) or (wire.4.a == wnew.a and wire.4.b == wnew.b) or (wire.4.a == wnew.b and wire.4.b == wnew.a) or (wire.5.a == wnew.a and wire.5.b == wnew.b) or (wire.5.a == wnew.b and wire.5.b == wnew.a) or (wire.6.a == wnew.a and wire.6.b == wnew.b) or (wire.6.a == wnew.b and wire.6.b == wnew.a) or (wire.7.a == wnew.a and wire.7.b == wnew.b) or (wire.7.a == wnew.b and wire.7.b == wnew.a)
        repeat j in 0..8 {
            on change wnew.go while wnew.go > 0.5 and wn.free == j and not wn.dup {
                wire.$j.a = wnew.a
                wire.$j.b = wnew.b
                wire.$j.flow = 0
                wire.$j.label = ""
                wborn.$j: 0 ~0ms
                wborn.$j: 1 after 16ms
            }
        }
    }
    repeat k in 0..8 {
        prop wborn.$k = 1 ~pop
        prop wcut.$k = 0 ~280ms
        on change wgone.n while wire.$k.a == wgone or wire.$k.b == wgone {
            wire.$k.a = -1
            wire.$k.b = -1
            wire.$k.flow = 0
            wire.$k.label = ""
        }
        // Each drawn as a current between the two, under the windows: from
        // the middle of the sides that face each other, an S that leaves and
        // arrives straight. Still while nothing goes along it; amber if the
        // agent at either end waits for you; and while something goes, a
        // drop of light runs along it and rings out where it arrives.
        let wv.a = max(wire.$k.a, 0)
        let wv.b = max(wire.$k.b, 0)
        let wv.on = wire.$k.a >= 0 and wire.$k.b >= 0 and free[screen.index] > 0.5 and pick(wv.a, (win.0.open and not win.0.minimized and win.0.screen == screen.index and win.0.pool == win.pool[screen.index]), (win.1.open and not win.1.minimized and win.1.screen == screen.index and win.1.pool == win.pool[screen.index]), (win.2.open and not win.2.minimized and win.2.screen == screen.index and win.2.pool == win.pool[screen.index]), (win.3.open and not win.3.minimized and win.3.screen == screen.index and win.3.pool == win.pool[screen.index]), (win.4.open and not win.4.minimized and win.4.screen == screen.index and win.4.pool == win.pool[screen.index]), (win.5.open and not win.5.minimized and win.5.screen == screen.index and win.5.pool == win.pool[screen.index]), (win.6.open and not win.6.minimized and win.6.screen == screen.index and win.6.pool == win.pool[screen.index]), (win.7.open and not win.7.minimized and win.7.screen == screen.index and win.7.pool == win.pool[screen.index]), (win.8.open and not win.8.minimized and win.8.screen == screen.index and win.8.pool == win.pool[screen.index]), (win.9.open and not win.9.minimized and win.9.screen == screen.index and win.9.pool == win.pool[screen.index]), (win.10.open and not win.10.minimized and win.10.screen == screen.index and win.10.pool == win.pool[screen.index]), (win.11.open and not win.11.minimized and win.11.screen == screen.index and win.11.pool == win.pool[screen.index]), (win.12.open and not win.12.minimized and win.12.screen == screen.index and win.12.pool == win.pool[screen.index]), (win.13.open and not win.13.minimized and win.13.screen == screen.index and win.13.pool == win.pool[screen.index]), (win.14.open and not win.14.minimized and win.14.screen == screen.index and win.14.pool == win.pool[screen.index]), (win.15.open and not win.15.minimized and win.15.screen == screen.index and win.15.pool == win.pool[screen.index])) and pick(wv.b, (win.0.open and not win.0.minimized and win.0.screen == screen.index and win.0.pool == win.pool[screen.index]), (win.1.open and not win.1.minimized and win.1.screen == screen.index and win.1.pool == win.pool[screen.index]), (win.2.open and not win.2.minimized and win.2.screen == screen.index and win.2.pool == win.pool[screen.index]), (win.3.open and not win.3.minimized and win.3.screen == screen.index and win.3.pool == win.pool[screen.index]), (win.4.open and not win.4.minimized and win.4.screen == screen.index and win.4.pool == win.pool[screen.index]), (win.5.open and not win.5.minimized and win.5.screen == screen.index and win.5.pool == win.pool[screen.index]), (win.6.open and not win.6.minimized and win.6.screen == screen.index and win.6.pool == win.pool[screen.index]), (win.7.open and not win.7.minimized and win.7.screen == screen.index and win.7.pool == win.pool[screen.index]), (win.8.open and not win.8.minimized and win.8.screen == screen.index and win.8.pool == win.pool[screen.index]), (win.9.open and not win.9.minimized and win.9.screen == screen.index and win.9.pool == win.pool[screen.index]), (win.10.open and not win.10.minimized and win.10.screen == screen.index and win.10.pool == win.pool[screen.index]), (win.11.open and not win.11.minimized and win.11.screen == screen.index and win.11.pool == win.pool[screen.index]), (win.12.open and not win.12.minimized and win.12.screen == screen.index and win.12.pool == win.pool[screen.index]), (win.13.open and not win.13.minimized and win.13.screen == screen.index and win.13.pool == win.pool[screen.index]), (win.14.open and not win.14.minimized and win.14.screen == screen.index and win.14.pool == win.pool[screen.index]), (win.15.open and not win.15.minimized and win.15.screen == screen.index and win.15.pool == win.pool[screen.index]))
        // (One being carried is where it is drawn, under the mouse.)
        let wv.cx = mouse.x + mx[mon] - mx[screen.index] - grab.x
        let wv.cy = mouse.y - grab.y
        let wv.ax = if(dragging == wv.a and wire.$k.a >= 0, wv.cx, x[max(wv.a, 0)])
        let wv.ay = if(dragging == wv.a and wire.$k.a >= 0, wv.cy, y[max(wv.a, 0)])
        let wv.aw = w[max(wv.a, 0)]
        let wv.ah = h[max(wv.a, 0)]
        let wv.bx = if(dragging == wv.b and wire.$k.b >= 0, wv.cx, x[max(wv.b, 0)])
        let wv.by = if(dragging == wv.b and wire.$k.b >= 0, wv.cy, y[max(wv.b, 0)])
        let wv.bw = w[max(wv.b, 0)]
        let wv.bh = h[max(wv.b, 0)]
        let wv.acx = wv.ax + wv.aw / 2
        let wv.acy = wv.ay + wv.ah / 2
        let wv.bcx = wv.bx + wv.bw / 2
        let wv.bcy = wv.by + wv.bh / 2
        let wv.hz = abs(wv.bcx - wv.acx) / max(wv.aw + wv.bw, 1) >= abs(wv.bcy - wv.acy) / max(wv.ah + wv.bh, 1)
        let wv.p0x = if(wv.hz, if(wv.bcx >= wv.acx, wv.ax + wv.aw, wv.ax), wv.acx)
        let wv.p0y = if(wv.hz, wv.acy, if(wv.bcy >= wv.acy, wv.ay + wv.ah, wv.ay))
        let wv.p1x = if(wv.hz, if(wv.bcx >= wv.acx, wv.bx, wv.bx + wv.bw), wv.bcx)
        let wv.p1y = if(wv.hz, wv.bcy, if(wv.bcy >= wv.acy, wv.by, wv.by + wv.bh))
        let wv.mx = (wv.p0x + wv.p1x) / 2
        let wv.my = (wv.p0y + wv.p1y) / 2
        let wv.c1x = if(wv.hz, wv.mx, wv.p0x)
        let wv.c1y = if(wv.hz, wv.p0y, wv.my)
        let wv.c2x = if(wv.hz, wv.mx, wv.p1x)
        let wv.c2y = if(wv.hz, wv.p1y, wv.my)
        let wv.wait = ag[max(wv.a, 0)] > 2.5 or ag[max(wv.b, 0)] > 2.5
        let wv.go = wire.$k.flow != 0
        let wv.t = fract(time / 1.3)
        let wv.s = if(wire.$k.flow < 0, 1 - wv.t, wv.t)
        group {
            z: -1
            show: wv.on
            opacity: 1 - wcut.$k
            group {
                blur: 7
                path { stroke: 12; color: if(wv.wait, amber, mint); opacity: if(wv.go, 34%, 20%) + 10% * wv.wait
                    move wv.p0x, wv.p0y
                    curve wv.mx, wv.my via wv.c1x, wv.c1y
                    curve wv.p1x, wv.p1y via wv.c2x, wv.c2y
                }
            }
            path { stroke: 3 + 4 * (1 - wborn.$k); color: if(wv.wait, amber, mint); opacity: if(wv.go or wv.wait, 95%, 80%)
                move wv.p0x, wv.p0y
                curve wv.mx, wv.my via wv.c1x, wv.c1y
                curve wv.p1x, wv.p1y via wv.c2x, wv.c2y
            }
            ellipse { at: wv.p0x, wv.p0y; radius: 5.5; color: if(wv.wait, amber, mint) }
            ellipse { at: wv.p0x, wv.p0y; radius: 2.2; color: #f2fffa }
            ellipse { at: wv.p1x, wv.p1y; radius: 5.5; color: if(wv.wait, amber, mint) }
            ellipse { at: wv.p1x, wv.p1y; radius: 2.2; color: #f2fffa }
            // What goes along it: a drop of light and its trail.
            group {
                show: wv.go
                ellipse { at: if((max(wv.s - 0.06, 0)) < 0.5, (1 - (max(wv.s - 0.06, 0)) * 2) * (1 - (max(wv.s - 0.06, 0)) * 2) * wv.p0x + 2 * (max(wv.s - 0.06, 0)) * 2 * (1 - (max(wv.s - 0.06, 0)) * 2) * wv.c1x + (max(wv.s - 0.06, 0)) * 2 * (max(wv.s - 0.06, 0)) * 2 * wv.mx, (1 - ((max(wv.s - 0.06, 0)) * 2 - 1)) * (1 - ((max(wv.s - 0.06, 0)) * 2 - 1)) * wv.mx + 2 * ((max(wv.s - 0.06, 0)) * 2 - 1) * (1 - ((max(wv.s - 0.06, 0)) * 2 - 1)) * wv.c2x + ((max(wv.s - 0.06, 0)) * 2 - 1) * ((max(wv.s - 0.06, 0)) * 2 - 1) * wv.p1x), if((max(wv.s - 0.06, 0)) < 0.5, (1 - (max(wv.s - 0.06, 0)) * 2) * (1 - (max(wv.s - 0.06, 0)) * 2) * wv.p0y + 2 * (max(wv.s - 0.06, 0)) * 2 * (1 - (max(wv.s - 0.06, 0)) * 2) * wv.c1y + (max(wv.s - 0.06, 0)) * 2 * (max(wv.s - 0.06, 0)) * 2 * wv.my, (1 - ((max(wv.s - 0.06, 0)) * 2 - 1)) * (1 - ((max(wv.s - 0.06, 0)) * 2 - 1)) * wv.my + 2 * ((max(wv.s - 0.06, 0)) * 2 - 1) * (1 - ((max(wv.s - 0.06, 0)) * 2 - 1)) * wv.c2y + ((max(wv.s - 0.06, 0)) * 2 - 1) * ((max(wv.s - 0.06, 0)) * 2 - 1) * wv.p1y); radius: 2.5; color: #dffaf0; opacity: 35% }
                ellipse { at: if((max(wv.s - 0.03, 0)) < 0.5, (1 - (max(wv.s - 0.03, 0)) * 2) * (1 - (max(wv.s - 0.03, 0)) * 2) * wv.p0x + 2 * (max(wv.s - 0.03, 0)) * 2 * (1 - (max(wv.s - 0.03, 0)) * 2) * wv.c1x + (max(wv.s - 0.03, 0)) * 2 * (max(wv.s - 0.03, 0)) * 2 * wv.mx, (1 - ((max(wv.s - 0.03, 0)) * 2 - 1)) * (1 - ((max(wv.s - 0.03, 0)) * 2 - 1)) * wv.mx + 2 * ((max(wv.s - 0.03, 0)) * 2 - 1) * (1 - ((max(wv.s - 0.03, 0)) * 2 - 1)) * wv.c2x + ((max(wv.s - 0.03, 0)) * 2 - 1) * ((max(wv.s - 0.03, 0)) * 2 - 1) * wv.p1x), if((max(wv.s - 0.03, 0)) < 0.5, (1 - (max(wv.s - 0.03, 0)) * 2) * (1 - (max(wv.s - 0.03, 0)) * 2) * wv.p0y + 2 * (max(wv.s - 0.03, 0)) * 2 * (1 - (max(wv.s - 0.03, 0)) * 2) * wv.c1y + (max(wv.s - 0.03, 0)) * 2 * (max(wv.s - 0.03, 0)) * 2 * wv.my, (1 - ((max(wv.s - 0.03, 0)) * 2 - 1)) * (1 - ((max(wv.s - 0.03, 0)) * 2 - 1)) * wv.my + 2 * ((max(wv.s - 0.03, 0)) * 2 - 1) * (1 - ((max(wv.s - 0.03, 0)) * 2 - 1)) * wv.c2y + ((max(wv.s - 0.03, 0)) * 2 - 1) * ((max(wv.s - 0.03, 0)) * 2 - 1) * wv.p1y); radius: 3.5; color: #dffaf0; opacity: 55% }
                group {
                    blur: 4
                    ellipse { at: if((wv.s) < 0.5, (1 - (wv.s) * 2) * (1 - (wv.s) * 2) * wv.p0x + 2 * (wv.s) * 2 * (1 - (wv.s) * 2) * wv.c1x + (wv.s) * 2 * (wv.s) * 2 * wv.mx, (1 - ((wv.s) * 2 - 1)) * (1 - ((wv.s) * 2 - 1)) * wv.mx + 2 * ((wv.s) * 2 - 1) * (1 - ((wv.s) * 2 - 1)) * wv.c2x + ((wv.s) * 2 - 1) * ((wv.s) * 2 - 1) * wv.p1x), if((wv.s) < 0.5, (1 - (wv.s) * 2) * (1 - (wv.s) * 2) * wv.p0y + 2 * (wv.s) * 2 * (1 - (wv.s) * 2) * wv.c1y + (wv.s) * 2 * (wv.s) * 2 * wv.my, (1 - ((wv.s) * 2 - 1)) * (1 - ((wv.s) * 2 - 1)) * wv.my + 2 * ((wv.s) * 2 - 1) * (1 - ((wv.s) * 2 - 1)) * wv.c2y + ((wv.s) * 2 - 1) * ((wv.s) * 2 - 1) * wv.p1y); radius: 9; color: if(wv.wait, amber, mint); opacity: 70% }
                }
                ellipse { at: if((wv.s) < 0.5, (1 - (wv.s) * 2) * (1 - (wv.s) * 2) * wv.p0x + 2 * (wv.s) * 2 * (1 - (wv.s) * 2) * wv.c1x + (wv.s) * 2 * (wv.s) * 2 * wv.mx, (1 - ((wv.s) * 2 - 1)) * (1 - ((wv.s) * 2 - 1)) * wv.mx + 2 * ((wv.s) * 2 - 1) * (1 - ((wv.s) * 2 - 1)) * wv.c2x + ((wv.s) * 2 - 1) * ((wv.s) * 2 - 1) * wv.p1x), if((wv.s) < 0.5, (1 - (wv.s) * 2) * (1 - (wv.s) * 2) * wv.p0y + 2 * (wv.s) * 2 * (1 - (wv.s) * 2) * wv.c1y + (wv.s) * 2 * (wv.s) * 2 * wv.my, (1 - ((wv.s) * 2 - 1)) * (1 - ((wv.s) * 2 - 1)) * wv.my + 2 * ((wv.s) * 2 - 1) * (1 - ((wv.s) * 2 - 1)) * wv.c2y + ((wv.s) * 2 - 1) * ((wv.s) * 2 - 1) * wv.p1y); radius: 4.5; color: #f2fffa }
                // …and rings out where it arrives.
                ellipse { at: if(wire.$k.flow < 0, wv.p0x, wv.p1x), if(wire.$k.flow < 0, wv.p0y, wv.p1y); radius: 4 + 22 * wv.t; stroke: 2.2 * (1 - wv.t) + 0.3; color: if(wv.wait, amber, mint); opacity: 70% * (1 - wv.t) }
            }
        }
        // Its middle: its name in a pill, if it has one. The mouse there
        // shows it to write (or «name it») and a cut beside it; the name,
        // pressed, is written there (Enter keeps it, Escape leaves); the
        // cut, pressed, drains it away.
        let wl.has = wlm.$k.width > 0.5
        let wl.w = if(wl.has, min(wlm.$k.width, 220) + 26, 76)
        let wl.hov = max(max(wmid.$k.hover, wnamez.$k.hover), wcutz.$k.hover)
        zone box wmid.$k { at: wv.mx + 14, wv.my; size: wl.w + 52, 36; active: wv.on and not overview and wedit != k and wcut.$k < 0.01; role: region }
        zone box wnamez.$k { at: wv.mx, wv.my; size: wl.w, 24; cursor: text; active: wv.on and not overview and wedit != k and wcut.$k < 0.01; label: "Name this wire"; role: button }
        zone ellipse wcutz.$k { at: wv.mx + wl.w / 2 + 16, wv.my; radius: 11; cursor: pointer; active: wv.on and not overview and wedit != k and wcut.$k < 0.01; label: "Cut this wire"; role: button }
        group {
            show: wv.on and wedit != k
            opacity: max(if(wl.has, 1, 0), wl.hov) * (1 - wcut.$k)
            body {
                color: #0c0e10
                rim: 16%
                shadow: 0, 4, 12, 45%
                box { at: wv.mx, wv.my; size: wl.w, 24; corner: 12 }
            }
            box { at: wv.mx, wv.my; size: wl.w, 24; corner: 12; stroke: 1.2; color: if(wv.wait, amber, mint); opacity: 45% + 40% * wnamez.$k.hover }
            text "name it" { at: wv.mx, wv.my; anchor: center; size: 11; color: ink; opacity: 45%; show: not wl.has }
        }
        text wire.$k.label { at: wv.mx, wv.my; anchor: center; size: 11; weight: 600; color: ink; lines: 1; opacity: 1 - wcut.$k; show: wv.on and wedit != k }
        // (Measured always, off the screen, whether it is seen or not: an
        // empty name measures nothing.)
        text wire.$k.label { at: -4000, -4000; size: 11; weight: 600; color: ink; lines: 1; measure: wlm.$k }
        group {
            show: wv.on and wedit != k and wl.hov > 0.01
            opacity: wl.hov * (1 - wcut.$k)
            body {
                color: #0c0e10
                rim: 18%
                shadow: 0, 4, 12, 45%
                ellipse { at: wv.mx + wl.w / 2 + 16, wv.my; radius: 11 }
            }
            ellipse { at: wv.mx + wl.w / 2 + 16, wv.my; radius: 11; stroke: 1.3; color: coral; opacity: 60% + 40% * wcutz.$k.hover }
            box { at: wv.mx + wl.w / 2 + 16, wv.my; size: 8, 1.7; corner: 0.85; rotate: 45deg; color: coral }
            box { at: wv.mx + wl.w / 2 + 16, wv.my; size: 8, 1.7; corner: 0.85; rotate: -45deg; color: coral }
        }
        // Writing its name.
        group {
            show: wv.on and wedit == k
            body {
                color: #0c0e10
                rim: 18%
                shadow: 0, 6, 16, 50%
                box { at: wv.mx, wv.my; size: 236, 30; corner: 15 }
            }
            box { at: wv.mx, wv.my; size: 236, 30; corner: 15; stroke: 1.5; color: mint; opacity: 85% }
            input wire.$k.label { at: wv.mx - 104, wv.my - 9; width: 208; size: 12; color: ink; placeholder: "name this wire" }
        }
        on press wnamez.$k {
            wedit = k
            focus wire.$k.label
        }
        on submit wire.$k.label {
            wedit = -1
            blur
        }
        on press wcutz.$k { wcut.$k: 1 ~280ms }
        on change wcut.$k while wcut.$k > 0.99 {
            wire.$k.a = -1
            wire.$k.b = -1
            wire.$k.flow = 0
            wire.$k.label = ""
            wcut.$k: 0 ~0ms
        }
    }
    // Being wired: a thread of water from the port to the mouse, and the
    // window under it, lit.
    repeat q in 0..1 {
        let wg.w = max(wiring, 0)
        let wg.x = pick(wg.w, x.0 + 18, x.1 + 18, x.2 + 18, x.3 + 18, x.4 + 18, x.5 + 18, x.6 + 18, x.7 + 18, x.8 + 18, x.9 + 18, x.10 + 18, x.11 + 18, x.12 + 18, x.13 + 18, x.14 + 18, x.15 + 18)
        let wg.y = pick(wg.w, y.0 + tb / 2, y.1 + tb / 2, y.2 + tb / 2, y.3 + tb / 2, y.4 + tb / 2, y.5 + tb / 2, y.6 + tb / 2, y.7 + tb / 2, y.8 + tb / 2, y.9 + tb / 2, y.10 + tb / 2, y.11 + tb / 2, y.12 + tb / 2, y.13 + tb / 2, y.14 + tb / 2, y.15 + tb / 2)
        let wg.on = wiring >= 0 and mon == screen.index and win[max(wg.w, 0)].screen == screen.index
        let wg.t = max(wtgt, 0)
        group {
            show: wg.on
            group {
                blur: 6
                path { stroke: 8; color: mint; opacity: 18%
                    move wg.x, wg.y
                    curve (wg.x + mouse.x) / 2, (wg.y + mouse.y) / 2 via (wg.x + mouse.x) / 2, wg.y
                    curve mouse.x, mouse.y via (wg.x + mouse.x) / 2, mouse.y
                }
            }
            path { stroke: 2.5; color: mint; opacity: 90%
                move wg.x, wg.y
                curve (wg.x + mouse.x) / 2, (wg.y + mouse.y) / 2 via (wg.x + mouse.x) / 2, wg.y
                curve mouse.x, mouse.y via (wg.x + mouse.x) / 2, mouse.y
            }
            body {
                gradient: radial mouse.x - 2, mouse.y - 2 radius 8, #e8fff5, mint 45%, #3f8f76
                rim: 35%
                shadow: 0, 2, 6, 40%
                ellipse { at: mouse.x, mouse.y; radius: 6 }
            }
            box { from: x[max(wg.t, 0)] - 3, y[max(wg.t, 0)] - 3; size: w[max(wg.t, 0)] + 6, h[max(wg.t, 0)] + 6; corner: 14; stroke: 2.5; color: mint; opacity: 85%; show: wtgt >= 0 }
        }
    }
    // (Super+Shift+W, from before free was a canvas: the same as Super+W.)
    event toggle_canvas
    repeat k in 0..4 {
        on toggle_canvas while mon == k { free.$k = 1 - free.$k }
    }
    // Super+0 on a canvas: the camera takes in all of its windows (on the
    // pool it shows), as close as they fit, never closer than as they are.
    // Each one there says its box on the plane (`cvf`), then the camera goes.
    event canvas_fit
    fact cvf.k = -1
    fact cvf.n = 0
    // -1: the camera takes in all of its windows; a number: only that one (`cvc`).
    fact cvf.only = -1
    // One window centred: it is asked here, and the camera goes as for all of them.
    fact cvc.w = -1
    fact cvc.n = 0
    // Super and a double click on a window: two presses on it within 400 ms.
    fact dcl.w = -1
    prop dcl.t = 0 ~0ms
    fact cvf.l = 0
    fact cvf.t = 0
    fact cvf.r = 0
    fact cvf.b = 0
    prop cvf.go = 0 ~0ms
    on canvas_fit while cv[mon] > 0.5 and free[mon] > 0.5 {
        cvf.only = -1
        cvf.k = mon
        cvf.l = 1000000
        cvf.t = 1000000
        cvf.r = -1000000
        cvf.b = -1000000
        cvf.n = cvf.n + 1
        cvf.go: 0 ~0ms
        cvf.go: 1 after 16ms
    }
    repeat j in 0..4 {
        on change cvf.go while cvf.go > 0.5 and cvf.k == j and cvf.r > cvf.l {
            cvz.$j = clamp(min((mg.Ws - 2 * gap) / (cvf.r - cvf.l), (mg.ah - gap) / (cvf.b - cvf.t)), 0.1, 1)
            cvx.$j = (cvf.l + cvf.r) / 2 - win.reserved.$j.left - mg.Ws / 2 / cvz.$j
            cvy.$j = (cvf.t + cvf.b) / 2 - win.reserved.$j.top - bar - mg.ah / 2 / cvz.$j
            cvf.k = -1
        }
    }
    event ride
    event unride
    fact riding = false
    fact rider = -1
    fact homing = false
    fact falling = false
    fact from.x = 0
    fact from.y = 0
    fact fall.dir = 1
    prop hop = 1 ~650ms                  // from `from` to where she goes: 0 → 1
    prop drop = 0 ~1300ms                // falling off: 0 → 1
    // Leaning against the move, and swaying back when it stops.
    prop sway = 0 ~pop
    follow sway = clamp(-(mouse.x - lag.x) * 0.007, -0.55, 0.55) * (dragging == rider and rider >= 0)
    // Her real size, the one she has in her island: a 46 px body, eyes of
    // 5 × 13, 13 apart and 2.5 below the centre.
    let r.r = 23
    // Where Marea lives, as seen from the desktop: the island, just above the top edge.
    let r.isl = if(island.screen >= 0, island.screen, max(win[max(rider, 0)].screen, 0))
    let home.rx = mx[max(r.isl, 0)] + screen[max(r.isl, 0)].width / 2
    let home.ry = -40
    on ride while win.focus >= 0 and not riding {
        riding = true
        homing = false
        falling = false
        rider = win.focus
        from.x = mx[max(if(island.screen >= 0, island.screen, pick(win.focus, win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen, win.6.screen, win.7.screen, win.8.screen, win.9.screen, win.10.screen, win.11.screen, win.12.screen, win.13.screen, win.14.screen, win.15.screen)), 0)] + screen[max(if(island.screen >= 0, island.screen, pick(win.focus, win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen, win.6.screen, win.7.screen, win.8.screen, win.9.screen, win.10.screen, win.11.screen, win.12.screen, win.13.screen, win.14.screen, win.15.screen)), 0)].width / 2
        from.y = -40
        hop: 0 ~0ms
        hop: 1 ~800ms after 16ms
    }
    // Nothing to ride: she stays at home.
    on ride while win.focus < 0 and not riding and screen.index == 0 { launch "pleamar-wm --say marea 'emit ride_back'" }
    // Home: Marea takes over.
    on still hop for 60ms while riding and homing and hop > 0.97 {
        riding = false
        homing = false
        rider = -1
    }
    on still hop for 60ms while riding and homing and hop > 0.97 and screen.index == 0 { launch "pleamar-wm --say marea 'emit ride_back'" }
    on still drop for 60ms while falling and drop > 0.97 {
        falling = false
        riding = false
        rider = -1
    }
    on still drop for 60ms while falling and drop > 0.97 and screen.index == 0 { launch "pleamar-wm --say marea 'emit ride_back'" }
    repeat i in 0..16 {
        let sc = win.$i.screen
        let carried = dragging == i or (landing == i and win.$i.open and win.$i.screen != landing.to)
        // (On a workspace sliding away, she slides away with it.)
        let ride.slide = 0
        // The window's corner on the desktop: where it is laid out, or where
        // the hand carries it.
        let wx = if(carried, mouse.x + mx[mon] - grab.x, x.$i + dx.$i + ride.slide + mx[sc])
        let wy = if(carried, mouse.y - grab.y, y.$i + dy.$i)
        // Her seat: on the top edge, left of the buttons; with no room above
        // it (tiled, against the top of the monitor), in the title bar itself.
        let seat.x = wx + max(w.$i * 0.5, w.$i - 140)
        // (Tiled there is no title bar: she sits astride its top edge.)
        let seat.y = if(wy - r.r + 2 > 8, wy - r.r + 2, wy + tb * hb.$i / 2 - 1)
        let to.x = if(homing, home.rx, seat.x)
        let to.y = if(homing, home.ry, seat.y)
        // On her way she goes up and comes down, like something with weight.
        let at.x = from.x + (to.x - from.x) * hop
        let at.y = from.y + (to.y - from.y) * hop - 130 * 4 * hop * (1 - hop)
        let off = mx[screen.index]
        // Settling on another window: she hops over to it.
        on still win.focus for 350ms while riding and not homing and not falling and rider == i and win.focus >= 0 and win.focus != i and not win.$i.minimized {
            from.x = at.x
            from.y = at.y
            rider = win.focus
            hop: 0 ~0ms
            hop: 1 ~650ms after 16ms
        }
        // Hers goes away —closed, put away— or she is asked: home.
        on change bye.$i while riding and rider == i and not homing and bye.$i > 0.5 {
            from.x = at.x
            from.y = at.y
            homing = true
            hop: 0 ~0ms
            hop: 1 ~700ms after 16ms
        }
        on change win.$i.minimized while riding and rider == i and not homing and win.$i.minimized {
            from.x = at.x
            from.y = at.y
            homing = true
            hop: 0 ~0ms
            hop: 1 ~700ms after 16ms
        }
        on unride while riding and rider == i and not homing and not falling {
            from.x = at.x
            from.y = at.y
            homing = true
            hop: 0 ~0ms
            hop: 1 ~700ms after 16ms
        }
        // Shaken hard while carried: she lets go.
        on change mouse.x while riding and rider == i and carried and not homing and not falling and hop > 0.97 and abs(mouse.x - lag.x) > 120 {
            from.x = at.x
            from.y = at.y
            fall.dir = -sign(mouse.x - lag.x)
            falling = true
            drop: 0 ~0ms
            drop: 1 ~1300ms after 16ms
        }
        // Her, as Marea looks: a drop of coal with two eyes that follow the mouse.
        // Stretched while in the air, leaning while carried.
        let st = clamp(abs(vel(hop)) * 0.06, 0, 0.3) * (1 - falling)
        let px = if(falling, from.x + fall.dir * 90 * drop, at.x) - off
        let py = if(falling, from.y - 40 * drop + 1500 * drop * drop, at.y)
        let look = clamp((pointer.x - px) / 160, -1, 1) * 3
        group {
            z: 99999
            show: riding and rider == i
            opacity: if(falling, 1 - drop * drop, 1)
            pivot: px, py + r.r
            rotate: sway + if(falling, fall.dir * drop * 3, 0)
            scale: 1 - st * 0.4, 1 + st
            body {
                color: marea
                rim: 10%
                shadow: 0, 4, 10, 35%
                ellipse { at: px, py; radius: r.r }
            }
            box { at: px - 6.5 + look, py + 2.5; size: 5, 13 * (1 - 0.6 * st); corner: 2.5; color: #f5f7f5 }
            box { at: px + 6.5 + look, py + 2.5; size: 5, 13 * (1 - 0.6 * st); corner: 2.5; color: #f5f7f5 }
            zone ellipse rider_zone.$i { at: px, py; radius: r.r + 4; cursor: pointer; active: riding and rider == i and not homing and not falling }
        }
        on press rider_zone.$i { emit unride }
    }

    // ── the phone's own (see `phone`, above): its water, its status line,
    // the bar at the bottom, the cards' deck and what to open ──
    event phone_cards
    event phone_next
    event phone_prev
    event phone_taken_back
    // From the phone's bottom edge (the page): up, the cards —or back to the
    // app—; sideways, the next app or the one before. In the cards, sideways
    // goes along the deck.
    on phone_cards while phone >= 0 {
        ph.cards = if(ph.home and ph.front >= 0 and ph.n > 0, 0, 1)
        ph.at = clamp(ph.kf, 0, max(ph.n - 1, 0))
    }
    on phone_next while ph.home { ph.at = clamp(round(ph.at) + 1, 0, max(ph.n - 1, 0)) }
    on phone_prev while ph.home { ph.at = clamp(round(ph.at) - 1, 0, max(ph.n - 1, 0)) }
    // The phone arrives: everything that was open comes in as a deck of
    // cards, and a moment later the one that had the keyboard opens out of
    // it to all of the screen.
    fact ph.intro = 0
    on change phone while phone >= 0 {
        ph.front = if(win.focus >= 0, win.focus, -1)
        ph.cards = 1
        ph.intro = 1
        ph.side = -1
        ph.solo = 0
        ph.fl = 1
        ph.ratio = 0.5
        ph.at = clamp(ph.kf, 0, max(ph.n - 1, 0))
    }
    on still phone for 1300ms while ph.intro > 0.5 and phone >= 0 {
        ph.intro = 0
        ph.cards = if(ph.front >= 0 and ph.n > 0, 0, 1)
    }
    on change phone while phone < 0 {
        ph.front = -1
        ph.cards = 0
    }
    // The one with the keyboard on the phone is the one in front.
    // (`win.focus` itself, not `fscreen`: see the maximized window's rule.)
    on change win.focus while phone >= 0 and win.focus >= 0 and win[max(win.focus, 0)].screen == phone and not win[max(win.focus, 0)].dialog {
        // Two side by side and the other one touched: it is in front now,
        // and the one that was, beside it (each stays on its side).
        ph.fl = if(ph.split and win.focus == ph.sd, 1 - ph.fl, ph.fl)
        ph.side = if(ph.split and win.focus == ph.sd, ph.front, ph.side)
        ph.front = win.focus
    }
    // The deck goes along with a finger (the wheel, from the page), and
    // settles on a card.
    on scroll ph_deck while ph.n > 1 { ph.at = clamp(ph.at - wheel * 0.3, 0, ph.n - 1) }
    on still ph.at for 160ms while ph.at != round(ph.at) { ph.at = round(ph.at) }
    on release ph_bar {
        ph.cards = if(ph.home and ph.front >= 0 and ph.n > 0, 0, 1)
        ph.at = clamp(ph.kf, 0, max(ph.n - 1, 0))
    }
    // Two side by side: the line between them. Held and moved (a pointer, or
    // a finger held a moment first) or moved by a finger sideways, it makes
    // one wider; while it moves, the two wait under a veil with their names.
    let ph.lx = if(ph.lv >= 0, W * ph.lv, ph.xr)
    prop ph.veil = 0 ~220ms
    follow ph.veil = if(ph.lv >= 0, 1, 0)
    group {
        show: is.ph and ph.split and pc < 0.99
        z: 100600
        opacity: 1 - pc
        group {
            show: ph.veil > 0.01
            opacity: ph.veil
            box { from: 0, ph.sb; size: max(ph.lx - 4, 0), H - ph.sb - ph.hb; corner: 16; color: #0b1518; opacity: 92% }
            box { from: ph.lx + 4, ph.sb; size: max(W - ph.lx - 4, 0), H - ph.sb - ph.hb; corner: 16; color: #0b1518; opacity: 92% }
            group {
                show: ph.lx > 150
                opacity: smooth(150, 260, ph.lx)
                text pick(max(ph.front, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: ph.lx / 2, H / 2; anchor: center; size: 17; weight: 600; width: max(ph.lx - 60, 20); lines: 2; align: center; color: ink; show: ph.fl > 0.5 }
                text pick(max(ph.sd, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: ph.lx / 2, H / 2; anchor: center; size: 17; weight: 600; width: max(ph.lx - 60, 20); lines: 2; align: center; color: ink; show: ph.fl < 0.5 }
            }
            group {
                show: W - ph.lx > 150
                opacity: smooth(150, 260, W - ph.lx)
                text pick(max(ph.sd, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: (ph.lx + W) / 2, H / 2; anchor: center; size: 17; weight: 600; width: max(W - ph.lx - 60, 20); lines: 2; align: center; color: ink; show: ph.fl > 0.5 }
                text pick(max(ph.front, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: (ph.lx + W) / 2, H / 2; anchor: center; size: 17; weight: 600; width: max(W - ph.lx - 60, 20); lines: 2; align: center; color: ink; show: ph.fl < 0.5 }
            }
            // Near an edge, the one about to go fades out.
            box { from: 0, ph.sb; size: max(ph.lx - 4, 0), H - ph.sb - ph.hb; corner: 16; color: #05090b; opacity: 70% * (1 - smooth(0.08, 0.2, ph.lv)) }
            box { from: ph.lx + 4, ph.sb; size: max(W - ph.lx - 4, 0), H - ph.sb - ph.hb; corner: 16; color: #05090b; opacity: 70% * smooth(0.8, 0.92, ph.lv) }
        }
        // The line's handle, and which of the two has the keyboard.
        group {
            blur: 10
            box { at: ph.lx, (ph.sb + H - ph.hb) / 2; size: 8, 70; corner: 4; color: mint; opacity: 50% * ph.veil }
        }
        box { at: ph.lx, (ph.sb + H - ph.hb) / 2; size: 5, 52 + 18 * ph_div.hover + 18 * ph.veil; corner: 3; color: ink; opacity: 70% + 20% * ph_div.hover }
        box { at: ph.lx, (ph.sb + H - ph.hb) / 2; size: 5, 52 + 18 * ph_div.hover + 18 * ph.veil; corner: 3; color: mint; opacity: 90% * ph.veil }
        box { at: if(ph.fl > 0.5, ph.xr / 2, (ph.xr + W) / 2), ph.sb + 3; size: 40, 3; corner: 2; color: mint; opacity: 70% * (1 - ph.veil) }
        // (While it moves, all of the screen: the line goes from under the finger.)
        zone box ph_div { from: if(ph.lv >= 0, 0, ph.lx - 18), ph.sb; size: if(ph.lv >= 0, W, 36), H - ph.sb - ph.hb; cursor: grab; active: is.ph and ph.split and not ph.home; label: "The line between the two apps"; role: slider }
    }
    on press ph_div { ph.dv = 1 }
    on release ph_div while ph.dv > 0.5 {
        // To an edge, the other goes and the one left has all of it; else
        // the line settles at a third, the middle or two thirds.
        ph.front = if(ph.lv > 0.88, if(ph.fl > 0.5, ph.front, ph.sd), if(ph.lv < 0.12, if(ph.fl > 0.5, ph.sd, ph.front), ph.front))
        ph.solo = if(ph.lv > 0.88 or ph.lv < 0.12, 1, ph.solo)
        ph.side = if(ph.lv > 0.88 or ph.lv < 0.12, -1, ph.side)
        ph.ratio = if(ph.lv > 0.88 or ph.lv < 0.12, ph.ratio, if(ph.lv < 0.42, 0.34, if(ph.lv > 0.58, 0.66, 0.5)))
        ph.dv = 0
    }
    on scroll ph_div while ph.split { ph.wl = clamp(if(ph.wl < 0, ph.ratio, ph.wl) + wheel * 41 / max(W.ph, 1), 0.04, 0.96) }
    on still ph.wl for 380ms while ph.wl >= 0 and ph.dv < 0.5 {
        // To an edge, the other goes and the one left has all of it; else
        // the line settles at a third, the middle or two thirds.
        ph.front = if(ph.lv > 0.88, if(ph.fl > 0.5, ph.front, ph.sd), if(ph.lv < 0.12, if(ph.fl > 0.5, ph.sd, ph.front), ph.front))
        ph.solo = if(ph.lv > 0.88 or ph.lv < 0.12, 1, ph.solo)
        ph.side = if(ph.lv > 0.88 or ph.lv < 0.12, -1, ph.side)
        ph.ratio = if(ph.lv > 0.88 or ph.lv < 0.12, ph.ratio, if(ph.lv < 0.42, 0.34, if(ph.lv > 0.58, 0.66, 0.5)))
        ph.wl = -1
    }
    // The water behind: three soft lights that drift, now and then.
    prop phb.x.0 = 0.2 ~spring(8, 6)
    prop phb.y.0 = 0.25 ~spring(8, 6)
    prop phb.x.1 = 0.8 ~spring(7, 6)
    prop phb.y.1 = 0.55 ~spring(7, 6)
    prop phb.x.2 = 0.35 ~spring(9, 7)
    prop phb.y.2 = 0.85 ~spring(9, 7)
    fact phb.seed = 0
    // Only while it is seen (the cards, or no app): behind an app it kept the
    // phone's monitor put together, read back and encoded, frame after
    // frame, for a picture that did not change.
    every 4s..7s while phone >= 0 and ph.home {
        phb.seed = phb.seed + 1
        phb.x.0: 0.1 + 0.5 * random(phb.seed * 3 + 1)
        phb.y.0: 0.1 + 0.4 * random(phb.seed * 3 + 2)
        phb.x.1: 0.5 + 0.45 * random(phb.seed * 5 + 3)
        phb.y.1: 0.35 + 0.4 * random(phb.seed * 5 + 4)
        phb.x.2: 0.1 + 0.7 * random(phb.seed * 7 + 5)
        phb.y.2: 0.6 + 0.35 * random(phb.seed * 7 + 6)
    }
    group {
        show: is.ph
        z: 90000
        box { from: 0, 0; size: W, H; color: #071014 }
        group {
            blur: 70
            ellipse { at: W * phb.x.0, H * phb.y.0; radius: W * 0.55; color: #1f5a4c; opacity: 55% }
            ellipse { at: W * phb.x.1, H * phb.y.1; radius: W * 0.5; color: #173f5a; opacity: 50% }
            ellipse { at: W * phb.x.2, H * phb.y.2; radius: W * 0.45; color: #2a6b5b; opacity: 40% }
        }
        // Behind the cards the water darkens a little, as if it got deeper.
        box { from: 0, 0; size: W, H; color: #000000; opacity: 28% * pc }
        // Nothing open: the hour, large, and what can be done.
        group {
            show: ph.n < 1
            text now.time { at: W / 2, H * 0.3; anchor: center; size: 76; weight: 250; color: ink }
            text "Nothing open" { at: W / 2, H * 0.3 + 62; anchor: center; size: 15; weight: 600; color: ink; opacity: 75% }
            text "Open something from below" { at: W / 2, H * 0.3 + 86; anchor: center; size: 13; color: #9aa3a8 }
        }
        zone box ph_deck { from: 0, ph.sb; size: W, H - ph.sb - ph.hb - 92; active: is.ph and ph.home }
    }
    // What to open: the programs of the dock, along the bottom, under the cards.
    group {
        show: is.ph and pc > 0.01
        z: 180000
        opacity: pc
        group {
            blur: 24
            box { from: 18, H - ph.hb - 84 + 30 * (1 - pc); size: W - 36, 76; corner: 30; color: #000000; opacity: 35% }
        }
        body {
            color: #0d1519
            rim: 14%
            box { from: 18, H - ph.hb - 84 + 30 * (1 - pc); size: W - 36, 76; corner: 30 }
        }
        group {
            show: phone == 0 and 0 < win.docks.0
            let ax = W / 2 + (0 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.0.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.0.hover }
            image dockicon.0.0 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.0.windows > 0 }
            zone ellipse phapp.0.0 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.0.name}"; role: button }
        }
        group {
            show: phone == 0 and 1 < win.docks.0
            let ax = W / 2 + (1 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.1.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.1.hover }
            image dockicon.0.1 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.1.windows > 0 }
            zone ellipse phapp.0.1 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.1.name}"; role: button }
        }
        group {
            show: phone == 0 and 2 < win.docks.0
            let ax = W / 2 + (2 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.2.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.2.hover }
            image dockicon.0.2 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.2.windows > 0 }
            zone ellipse phapp.0.2 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.2.name}"; role: button }
        }
        group {
            show: phone == 0 and 3 < win.docks.0
            let ax = W / 2 + (3 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.3.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.3.hover }
            image dockicon.0.3 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.3.windows > 0 }
            zone ellipse phapp.0.3 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.3.name}"; role: button }
        }
        group {
            show: phone == 0 and 4 < win.docks.0
            let ax = W / 2 + (4 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.4.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.4.hover }
            image dockicon.0.4 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.4.windows > 0 }
            zone ellipse phapp.0.4 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.4.name}"; role: button }
        }
        group {
            show: phone == 0 and 5 < win.docks.0
            let ax = W / 2 + (5 - (min(win.docks.0, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.0.5.hover; color: #ffffff; opacity: 7% + 6% * phapp.0.5.hover }
            image dockicon.0.5 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.0.5.windows > 0 }
            zone ellipse phapp.0.5 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.0.5.name}"; role: button }
        }
        group {
            show: phone == 1 and 0 < win.docks.1
            let ax = W / 2 + (0 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.0.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.0.hover }
            image dockicon.1.0 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.0.windows > 0 }
            zone ellipse phapp.1.0 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.0.name}"; role: button }
        }
        group {
            show: phone == 1 and 1 < win.docks.1
            let ax = W / 2 + (1 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.1.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.1.hover }
            image dockicon.1.1 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.1.windows > 0 }
            zone ellipse phapp.1.1 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.1.name}"; role: button }
        }
        group {
            show: phone == 1 and 2 < win.docks.1
            let ax = W / 2 + (2 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.2.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.2.hover }
            image dockicon.1.2 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.2.windows > 0 }
            zone ellipse phapp.1.2 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.2.name}"; role: button }
        }
        group {
            show: phone == 1 and 3 < win.docks.1
            let ax = W / 2 + (3 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.3.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.3.hover }
            image dockicon.1.3 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.3.windows > 0 }
            zone ellipse phapp.1.3 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.3.name}"; role: button }
        }
        group {
            show: phone == 1 and 4 < win.docks.1
            let ax = W / 2 + (4 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.4.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.4.hover }
            image dockicon.1.4 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.4.windows > 0 }
            zone ellipse phapp.1.4 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.4.name}"; role: button }
        }
        group {
            show: phone == 1 and 5 < win.docks.1
            let ax = W / 2 + (5 - (min(win.docks.1, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.1.5.hover; color: #ffffff; opacity: 7% + 6% * phapp.1.5.hover }
            image dockicon.1.5 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.1.5.windows > 0 }
            zone ellipse phapp.1.5 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.1.5.name}"; role: button }
        }
        group {
            show: phone == 2 and 0 < win.docks.2
            let ax = W / 2 + (0 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.0.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.0.hover }
            image dockicon.2.0 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.0.windows > 0 }
            zone ellipse phapp.2.0 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.0.name}"; role: button }
        }
        group {
            show: phone == 2 and 1 < win.docks.2
            let ax = W / 2 + (1 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.1.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.1.hover }
            image dockicon.2.1 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.1.windows > 0 }
            zone ellipse phapp.2.1 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.1.name}"; role: button }
        }
        group {
            show: phone == 2 and 2 < win.docks.2
            let ax = W / 2 + (2 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.2.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.2.hover }
            image dockicon.2.2 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.2.windows > 0 }
            zone ellipse phapp.2.2 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.2.name}"; role: button }
        }
        group {
            show: phone == 2 and 3 < win.docks.2
            let ax = W / 2 + (3 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.3.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.3.hover }
            image dockicon.2.3 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.3.windows > 0 }
            zone ellipse phapp.2.3 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.3.name}"; role: button }
        }
        group {
            show: phone == 2 and 4 < win.docks.2
            let ax = W / 2 + (4 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.4.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.4.hover }
            image dockicon.2.4 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.4.windows > 0 }
            zone ellipse phapp.2.4 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.4.name}"; role: button }
        }
        group {
            show: phone == 2 and 5 < win.docks.2
            let ax = W / 2 + (5 - (min(win.docks.2, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.2.5.hover; color: #ffffff; opacity: 7% + 6% * phapp.2.5.hover }
            image dockicon.2.5 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.2.5.windows > 0 }
            zone ellipse phapp.2.5 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.2.5.name}"; role: button }
        }
        group {
            show: phone == 3 and 0 < win.docks.3
            let ax = W / 2 + (0 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.0.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.0.hover }
            image dockicon.3.0 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.0.windows > 0 }
            zone ellipse phapp.3.0 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.0.name}"; role: button }
        }
        group {
            show: phone == 3 and 1 < win.docks.3
            let ax = W / 2 + (1 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.1.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.1.hover }
            image dockicon.3.1 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.1.windows > 0 }
            zone ellipse phapp.3.1 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.1.name}"; role: button }
        }
        group {
            show: phone == 3 and 2 < win.docks.3
            let ax = W / 2 + (2 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.2.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.2.hover }
            image dockicon.3.2 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.2.windows > 0 }
            zone ellipse phapp.3.2 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.2.name}"; role: button }
        }
        group {
            show: phone == 3 and 3 < win.docks.3
            let ax = W / 2 + (3 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.3.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.3.hover }
            image dockicon.3.3 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.3.windows > 0 }
            zone ellipse phapp.3.3 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.3.name}"; role: button }
        }
        group {
            show: phone == 3 and 4 < win.docks.3
            let ax = W / 2 + (4 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.4.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.4.hover }
            image dockicon.3.4 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.4.windows > 0 }
            zone ellipse phapp.3.4 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.4.name}"; role: button }
        }
        group {
            show: phone == 3 and 5 < win.docks.3
            let ax = W / 2 + (5 - (min(win.docks.3, 6) - 1) / 2) * 64
            let ay = H - ph.hb - 46 + 30 * (1 - pc)
            ellipse { at: ax, ay; radius: 27 + 3 * phapp.3.5.hover; color: #ffffff; opacity: 7% + 6% * phapp.3.5.hover }
            image dockicon.3.5 { at: ax - 19, ay - 19; size: 38, 38 }
            ellipse { at: ax, ay + 33; radius: 2.2; color: mint; show: win.dock.3.5.windows > 0 }
            zone ellipse phapp.3.5 { at: ax, ay; radius: 29; cursor: pointer; active: is.ph and ph.home and pc > 0.9; label: "{win.dock.3.5.name}"; role: button }
        }
    }
    repeat j in 0..4 {
        repeat q in 0..6 {
            on release phapp.$j.$q {
                dock q on j
                ph.cards = 0
                ph.front = -1
            }
        }
    }
    // The status line and the bar at the bottom, over everything.
    group {
        show: is.ph
        z: 200000
        box { from: 0, 0; size: W, ph.sb; color: #05090b; opacity: 80% * (1 - pc) }
        text now.time { at: 22, ph.sb / 2 + 1; anchor: left center; size: 13.5; weight: 700; color: ink }
        // The app in front, beside the hour: the middle is Marea's (her island).
        text pick(max(ph.front, 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: 66, ph.sb / 2 + 1; anchor: left center; size: 12; weight: 600; width: W / 2 - 112; lines: 1; color: ink; opacity: 70% * (1 - pc); show: ph.front >= 0 }
        ellipse { at: W - 82, ph.sb / 2 + 1; radius: 3.5; color: mint }
        text "pleamar" { at: W - 74, ph.sb / 2 + 1; anchor: left center; size: 12.5; weight: 600; color: ink; opacity: 80% }
        box { from: 0, H - ph.hb; size: W, ph.hb; color: #05090b; opacity: 80% * (1 - pc) }
        box { at: W / 2, H - ph.hb / 2; size: 132 + 24 * ph_bar.hover, 5; corner: 3; color: ink; opacity: 75% }
        zone box ph_bar { from: W / 2 - 110, H - ph.hb - 6; size: 220, ph.hb + 6; cursor: pointer; active: is.ph; label: "Apps"; role: button }
    }

    // ── while the session is on the phone, the real monitors are covered:
    // whoever walks past sees where it went, not what is being done. A key
    // or the mouse here brings it back, locked (the session says so). ──
    prop curtain.wave = 0 ~2600ms
    prop curtain.float = 0 ~spring(6, 5)
    fact curtain.n = 0
    every 2600ms while phone >= 0 {
        curtain.n = curtain.n + 1
        curtain.wave: 0 ~0ms
        curtain.wave: 1 ~2600ms after 16ms
        curtain.float: if(mod(curtain.n, 2) == 0, -8, 8)
    }
    prop curtain.shown = 0 ~700ms
    follow curtain.shown = if(phone >= 0, 1, 0)
    surface phone_curtain {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 4
        open: curtain.shown > 0.001 and screen.index != phone
        // Nobody is at the desk to watch it: a few frames a second. At the
        // monitor's own rate (165 Hz) its blurs took most of the card while
        // the phone's monitor and its encoder were waiting for it.
        rate: 20
        // (Each copy, its own monitor's: the surface's own measure is one for all of them.)
        let cw.w = screen[screen.index].width
        let cw.h = screen[screen.index].height
        let cx = cw.w / 2
        let cy = cw.h / 2 - 40 + curtain.float
        box { from: 0, 0; size: cw.w, cw.h; color: #05090b; opacity: 94% * curtain.shown }
        // The windows that were here pour into the phone (over the dark,
        // not faded in with the rest).
        repeat i in 0..16 {
            let t = smooth(0, 1, pour.$i)
            let pw = mix(gw.$i, 18, t)
            let ph2 = mix(gh.$i, 30, t)
            let px = mix(gx.$i + gw.$i / 2, cx, t)
            let py = mix(gy.$i + gh.$i / 2, cy + 40 * t * (1 - t), t)
            group {
                show: pour.$i < 0.995 and sc.last.$i == screen.index and win.$i.open and not win.$i.dialog
                opacity: 1 - smooth(0.65, 1, pour.$i)
                body {
                    color: #0c0e10
                    shadow: 0, 18, 40, 50%
                    box { at: px, py; size: pw, ph2; corner: 12 + 10 * t }
                }
                group {
                    clip box { at: px, py; size: pw, ph2; corner: 12 + 10 * t }
                    window win.$i { at: px - pw / 2, py - ph2 / 2; size: pw, ph2; ask: -1, -1 }
                }
            }
        }
        group {
            opacity: curtain.shown
            group {
                blur: 90
                ellipse { at: cx, cy; radius: 260; color: #1f5a4c; opacity: 45% }
            }
            // Rings of water going out from it.
            ellipse { at: cx, cy; radius: 70 + 220 * curtain.wave; stroke: 1.5; color: mint; opacity: 30% * (1 - curtain.wave) }
            ellipse { at: cx, cy; radius: 70 + 110 * curtain.wave; stroke: 1; color: mint; opacity: 18% * (1 - curtain.wave) }
            // The phone.
            group {
                blur: 18
                box { at: cx, cy; size: 112, 214; corner: 22; stroke: 6; color: mint; opacity: 35% }
            }
            body {
                color: #0b1316
                rim: 20%
                box { at: cx, cy; size: 112, 214; corner: 22 }
            }
            box { at: cx, cy; size: 112, 214; corner: 22; stroke: 1.6; color: mint; opacity: 85% }
            box { at: cx, cy - 92; size: 30, 5; corner: 3; color: mint; opacity: 50% }
            box { at: cx, cy + 96; size: 34, 3; corner: 2; color: ink; opacity: 60% }
            // Its water, sloshing.
            group {
                clip box { at: cx, cy; size: 106, 208; corner: 19 }
                ellipse { at: cx - 20 + curtain.float * 2, cy + 74; radius: 90; scale: 1, 0.35; color: #2a6b5b; opacity: 70% }
                ellipse { at: cx + 26 - curtain.float * 2, cy + 86; radius: 80; scale: 1, 0.3; color: #9ed6bd; opacity: 35% }
            }
            text "Your session is on your phone" { at: cx, cy + 160; anchor: center; size: 24; weight: 650; color: ink }
            text "Touch a key or the mouse here to bring it back · it will ask you to unlock" { at: cx, cy + 194; anchor: center; size: 13.5; color: #9aa3a8 }
        }
    }

    // ── this desktop used from elsewhere (`pleamar-wm remote`) ──
    // While someone is in from another computer, whoever sits here sees it:
    // the edges glow amber —the monitor they look at, brighter— and a pill
    // says from where, and how to send them away. All of it on a surface
    // left out of captures: the one using it from elsewhere sees the desktop
    // as it is, without this over it. It takes no clicks (a button there
    // would be invisible from there, waiting to be pressed by mistake):
    // Super+Shift+Escape ends it.
    fact remote.on = 0
    fact remote.screen = -1
    text remote.who = ""
    prop remote.shown = 0 ~900ms
    follow remote.shown = remote.on
    surface remote_mark {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 4
        captures: hidden
        // Not on the phone's monitor: nobody sits at it, and a surface left out
        // of its pictures made each of them be drawn again without it,
        // instead of read straight from what was put together.
        open: remote.shown > 0.001 and screen.index != phone
        // Each copy its own monitor's size: `remote_mark.width` is one for all
        // of them, the last measured, and with a phone's monitor there the
        // desk got an amber frame the size of the phone in its corner.
        let rm.w = screen.width
        let rm.h = screen.height
        let rm.here = remote.screen == screen.index
        group {
            opacity: remote.shown * if(rm.here, 1, 0.45)
            group {
                blur: 20
                opacity: 38%
                box { from: 4, 4; size: rm.w - 8, rm.h - 8; corner: 18; stroke: 9; color: amber }
            }
            box { from: 2, 2; size: rm.w - 4, rm.h - 4; corner: 16; stroke: 1.5; color: amber; opacity: 60% }
        }
        group {
            opacity: remote.shown
            show: rm.here
            body {
                color: #0c0f12
                rim: 16%
                shadow: 0, 6, 18, 40%
                box { at: 186, rm.h - 30; size: 340, 38; corner: 19 }
            }
            ellipse { at: 34, rm.h - 30; radius: 5; color: amber }
            text "Used from elsewhere · {remote.who}" { at: 48, rm.h - 36; anchor: left center; size: 11.5; weight: 600; color: ink }
            text "Super+Shift+Esc sends them away" { at: 48, rm.h - 22; anchor: left center; size: 10.5; color: #9aa3a8 }
        }
    }

    // ── the canvas kept from the last session (pleamar-wm's keep.rs):
    // offered on the first monitor until brought back or let go ──
    fact kept.n = 0
    fact kept.w = 0
    prop keptv = 0 ~260ms
    follow keptv = if(kept.n > 0.5, 1, 0)
    group {
        z: 99990
        show: keptv > 0.01 and screen.index == 0
        opacity: keptv
        move: 0, -20 * (1 - keptv)
        body {
            color: #0c0e10
            rim: 16%
            shadow: 0, 10, 28, 50%
            box { at: W / 2, 52; size: 560, 56; corner: 28 }
        }
        box { at: W / 2, 52; size: 560, 56; corner: 28; stroke: 1.3; color: mint; opacity: 45% }
        // Three drops on a thread, the canvas's wires.
        ellipse { at: W / 2 - 244, 52; radius: 5; color: mint }
        ellipse { at: W / 2 - 226, 44; radius: 4; color: mint; opacity: 70% }
        ellipse { at: W / 2 - 226, 60; radius: 4; color: mint; opacity: 70% }
        text "Bring back your canvas" { at: W / 2 - 206, 43; anchor: left center; size: 13.5; weight: 650; color: ink }
        text "1 terminal and 1 wire, with its agent, as you left it" { at: W / 2 - 206, 62; anchor: left center; size: 10.5; color: ink; opacity: 60%; width: 300; lines: 1; show: kept.n < 1.5 and kept.w == 1 }
        text "1 terminal and {kept.w, 0} wires, with its agent, as you left it" { at: W / 2 - 206, 62; anchor: left center; size: 10.5; color: ink; opacity: 60%; width: 300; lines: 1; show: kept.n < 1.5 and kept.w != 1 }
        text "{kept.n, 0} terminals and 1 wire, with their agents, as you left them" { at: W / 2 - 206, 62; anchor: left center; size: 10.5; color: ink; opacity: 60%; width: 300; lines: 1; show: kept.n > 1.5 and kept.w == 1 }
        text "{kept.n, 0} terminals and {kept.w, 0} wires, with their agents, as you left them" { at: W / 2 - 206, 62; anchor: left center; size: 10.5; color: ink; opacity: 60%; width: 300; lines: 1; show: kept.n > 1.5 and kept.w != 1 }
        zone box kept_go { at: W / 2 + 170, 52; size: 128, 34; cursor: pointer; active: kept.n > 0.5; label: "Bring back your canvas"; role: button }
        box { at: W / 2 + 170, 52; size: 128, 34; corner: 17; color: mint; opacity: 85% + 15% * kept_go.hover }
        text "Bring back" { at: W / 2 + 170, 52; anchor: center; size: 12; weight: 650; color: #0c1a15 }
        zone ellipse kept_no { at: W / 2 + 254, 52; radius: 13; cursor: pointer; active: kept.n > 0.5; label: "Leave it"; role: button }
        ellipse { at: W / 2 + 254, 52; radius: 13; color: ink; opacity: 8% + 10% * kept_no.hover }
        box { at: W / 2 + 254, 52; size: 9, 1.6; corner: 0.8; rotate: 45deg; color: ink; opacity: 70% }
        box { at: W / 2 + 254, 52; size: 9, 1.6; corner: 0.8; rotate: -45deg; color: ink; opacity: 70% }
    }
    on press kept_go {
        launch "pleamar-wm link restore"
        kept.n = 0
    }
    on press kept_no {
        launch "pleamar-wm link restore --dismiss"
        kept.n = 0
    }

    // ── a computer-use agent's cursors (`agent on` in session.conf) ──
    // An agent (Cua Driver) drives the windows with a pointer of its own: the
    // compositor says where each of its cursors is, on which monitor, and
    // when it presses. It is drawn here, in mint, over everything: a second
    // cursor that moves on its own, a ring where it clicks, and its name. It
    // fades a few seconds after it last did something.
    // The monitor it works on says so, apart from its cursors: its edges
    // glow in mint, breathing slowly, a soft light goes round them, and a
    // pill says an agent is using it. The window it works on gets an outline
    // (in the windows' loop). It stays while the agent is at work —thinking
    // between one action and the next is working too: the compositor says
    // when it is (`agent.active`)— and fades slowly after.
    fact agent.seen = 0
    fact agent.screen = -1
    fact agent.win = -1
    fact agent.active = 0
    prop agent.on = 0 ~1600ms
    follow agent.on = agent.active
    prop agent.t = 0
    spin agent.t by if(agent.on > 0.01, 1, 0)
    let ag.here = agent.on > 0.01 and agent.screen == screen.index
    // Where the light that goes round the edges is: one lap every 30 s, calm.
    let ag.lap = fract(agent.t / 30) * 2 * (W + H)
    let ag.lx = if(ag.lap < W, ag.lap, if(ag.lap < W + H, W, if(ag.lap < 2 * W + H, 2 * W + H - ag.lap, 0)))
    let ag.ly = if(ag.lap < W, 0, if(ag.lap < W + H, ag.lap - W, if(ag.lap < 2 * W + H, H, 2 * (W + H) - ag.lap)))
    // A breath every 8 s.
    let ag.breath = 0.5 + 0.5 * sin(agent.t * 45)
    group {
        z: 99995
        show: ag.here
        opacity: agent.on
        // The edges: a wide soft glow, and a thin bright line on them.
        group {
            blur: 22
            opacity: 40% + 12% * ag.breath
            box { from: 4, 4; size: W - 8, H - 8; corner: 18; stroke: 10; color: mint }
        }
        box { from: 2, 2; size: W - 4, H - 4; corner: 16; stroke: 1.5; color: mint; opacity: 55% }
        // And the light going round them, soft.
        group {
            blur: 16
            ellipse { at: ag.lx, ag.ly; radius: 34; color: mint; opacity: 35% }
        }
        // The pill, in the bottom right corner (the top middle is Marea's): a
        // dot that beats, what is going on, and «Stop»: the agent's hands are
        // refused from then on (it hears that you stopped it), whoever it is.
        let ag.px = W - 196
        let ag.py = H - 30
        body {
            color: #0c0f12
            rim: 16%
            shadow: 0, 6, 18, 40%
            box { at: ag.px, ag.py; size: 340, 30; corner: 15 }
        }
        ellipse { at: ag.px - 152, ag.py; radius: 4 + 2 * ag.breath; color: mint }
        ellipse { at: ag.px - 152, ag.py; radius: 9 * ag.breath + 4; stroke: 1.2; color: mint; opacity: 60% * (1 - ag.breath) }
        text "An agent is using this monitor" { at: ag.px - 28, ag.py + 0.5; anchor: center; size: 11.5; weight: 600; color: ink }
        box { at: ag.px + 130, ag.py; size: 64, 22; corner: 11; color: #ef7a66; opacity: 18% + 30% * ag.stop.hover }
        box { at: ag.px + 109, ag.py; size: 7, 7; corner: 1.5; color: #ef7a66 }
        text "Stop" { at: ag.px + 136, ag.py + 0.5; anchor: center; size: 11.5; weight: 700; color: #ffb3a6 }
    }
    prop ag.stop.hover = 0 ~120ms
    zone box ag_stop { at: W - 66, H - 30; size: 64, 22; cursor: pointer; active: ag.here and agent.on > 0.5; agent: no }
    on enter ag_stop { ag.stop.hover: 1 }
    on leave ag_stop { ag.stop.hover: 0 }
    on press ag_stop { launch "pleamar-wm agent stop" }
    // Who it is (`PLEAMAR_AGENT_NAME`: Marea says hers), for its label.
    text agent.name = "agent"
    // Where each cursor is, as pleamar-wm says (on its monitor, in units).
    repeat k in 0..2 {
        fact agent.$k.x = 0
        fact agent.$k.y = 0
        fact agent.$k.screen = 0
        fact agent.$k.down = 0
        fact agent.$k.seen = 0
    }
    // The cursors on a surface of their own, over everything on the monitor:
    // over the programs' menus too (a browser's right-click menu hid it).
    // Only drawn: clicks go through.
    surface agent_hands {
        size: full, full
        anchor: top_left
        level: overlay
        screens: each max 4
        open: agent.on > 0.001 or agent.active
        repeat k in 0..2 {
            // `pleamar-wm agent` takes it along the way, as a hand would;
            // this only smooths the steps.
            prop ag.$k.x = 0 ~140ms
            prop ag.$k.y = 0 ~140ms
            prop ag.$k.on = 0 ~220ms
            prop ag.$k.press = 0 ~90ms
            prop ag.$k.ring = 1 ~560ms
            follow ag.$k.x = agent.$k.x
            follow ag.$k.y = agent.$k.y
            follow ag.$k.press = agent.$k.down
            // Seen again after a while, or on another monitor: where it is, at
            // once, not flying in from where it was.
            on change agent.$k.seen while ag.$k.on < 0.05 {
                ag.$k.x: agent.$k.x ~0ms
                ag.$k.y: agent.$k.y ~0ms
            }
            on change agent.$k.screen {
                ag.$k.x: agent.$k.x ~0ms
                ag.$k.y: agent.$k.y ~0ms
            }
            on change agent.$k.seen { ag.$k.on: 1 }
            // It stays while the agent is at work —it thinks between two steps,
            // and a cursor that went and came back did not seem to move—, and
            // goes when it is done.
            on change agent.active while not agent.active { ag.$k.on: 0 ~900ms }
            on change agent.$k.down while agent.$k.down > 0.5 {
                ag.$k.ring: 0 ~0ms
                ag.$k.ring: 1 after 16ms
            }
            let ax = ag.$k.x
            let ay = ag.$k.y
            measure tag.$k
            group {
                show: ag.$k.on > 0.01 and agent.$k.screen == screen.index
                opacity: ag.$k.on
                // Where it clicks: a ring that spreads.
                ellipse { at: ax, ay; radius: 4 + 22 * ag.$k.ring; stroke: 2.2 * (1 - ag.$k.ring) + 0.4; color: if(k == 0, mint, #c9b3f2); opacity: 80% * (1 - ag.$k.ring) }
                group {
                    pivot: ax, ay
                    scale: 1 - 0.12 * ag.$k.press, 1 - 0.12 * ag.$k.press
                    // A soft light under it, so it is found on any window.
                    ellipse { at: ax + 5, ay + 8; radius: 15; color: if(k == 0, mint, #c9b3f2); opacity: 16% }
                    // The arrow: dark edge, mint body, its tip on the point.
                    path { at: ax - 1.2, ay - 1.6; color: #0c0f12
                           move 0, 0; line 0, 21; line 5.6, 16; line 9.2, 24.2; line 13, 22.6; line 9.5, 14.6; line 16.4, 14.6; close }
                    path { at: ax, ay; color: if(k == 0, mint, #c9b3f2)
                           move 0, 0; line 0, 17.5; line 4.6, 13.4; line 7.8, 20.6; line 10.2, 19.6; line 7.1, 12.6; line 12.6, 12.6; close }
                }
                // Its name, up and to the right of the tip: a page's tooltip
                // opens below the pointer, and the name sat on it.
                body {
                    color: #0c0f12
                    rim: 14%
                    box { from: ax + 16, ay - 21; size: tag.$k.width + 16, 18; corner: 9 }
                }
                text agent.name { at: ax + 24, ay - 11.5; anchor: left center; size: 10; weight: 600; color: if(k == 0, mint, #c9b3f2); measure: tag.$k }
            }
        }
    }
}
