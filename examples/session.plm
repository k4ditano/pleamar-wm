            }
            measure tip.$s.4
            group {
                show: dk.on.$s and dk.hk.$s == 4 and 4 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq4.$s + dksz4.$s / 2 + 14 + (tip.$s.4.width + 22) / 2), dka4.$s), if(dkvert, dka4.$s, dk.cr.$s + dk.cs.$s * (dkiq4.$s + dksz4.$s / 2 + 41)); size: (tip.$s.4.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.4.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq4.$s + dksz4.$s / 2 + 14 + (tip.$s.4.width + 22) / 2), dka4.$s), if(dkvert, dka4.$s, dk.cr.$s + dk.cs.$s * (dkiq4.$s + dksz4.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.4; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.4.badge > 0 and 4 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq4.$s), dka4.$s) + 0.39 * dksz4.$s, if(dkvert, dka4.$s, dk.cr.$s + dk.cs.$s * (dkiq4.$s)) - 0.39 * dksz4.$s; radius: 8.5 }
                }
                text "{win.dock.$s.4.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq4.$s), dka4.$s) + 0.39 * dksz4.$s, if(dkvert, dka4.$s, dk.cr.$s + dk.cs.$s * (dkiq4.$s)) - 0.39 * dksz4.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            measure tip.$s.5
            group {
                show: dk.on.$s and dk.hk.$s == 5 and 5 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
