    prop shore.2 = 0 ~rise
    follow shore.2 = if(free.2 > 0.5, 1, 0)
    let dk.n.2 = win.docks.2
    let dk.m.2 = win.mins.2
    let dk.p.2 = max(win.pools.2, win.used.2 + 1)
    let dk.tw.2 = 28 + dk.n.2 * 60 + if(dk.m.2 > 0, 20 + dk.m.2 * 76, 0) + 20 + dk.p.2 * 26
    prop dkw.2 = 200 ~pop
    follow dkw.2 = dk.tw.2
    let dk.x0.2 = screen.2.width / 2 - dkw.2 / 2
    let dk.cy.2 = screen.2.height + 42 - 88 * shore.2
    let dk.on.2 = mon == 2 and shore.2 > 0.6 and mouse.y >= dk.cy.2 - 46 and mouse.x >= dk.x0.2 and mouse.x <= dk.x0.2 + dkw.2
    let dk.t.2 = (mouse.x - dk.x0.2 - 14) / 60 - 0.5
    let dk.px.2 = dk.x0.2 + dkw.2 - 14 - dk.p.2 * 26
    image dockicon.2.0 = from win.dock.2.0.icon, 96, 96
    prop buoy.2.0 = 0 ~pop
    follow buoy.2.0 = if(dk.on.2, pow(max(0, 1 - abs(0 - dk.t.2) / 1.8), 2), 0)
    prop here.2.0 = 0 ~pop
    follow here.2.0 = if(0 < dk.n.2, 1, 0)
    prop ring.2.0 = 1 ~760ms
    image dockicon.2.1 = from win.dock.2.1.icon, 96, 96
    prop buoy.2.1 = 0 ~pop
