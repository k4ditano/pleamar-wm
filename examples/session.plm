        zone ellipse dkpool.3.3 { at: (dk.px.3 + 3 * 26 + 13), dk.cy.3; radius: 12; cursor: pointer; active: shore.3 > 0.6 and 3 < dk.p.3 and not overview; label: "Workspace 4" }
