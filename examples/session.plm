// The same window manager as examples/windows.plm, as a session of its own:
// the whole monitor, with no compositor underneath. From a TTY of its own
// (Ctrl+Alt+F3, logged in there):
//
//   ./session.sh              ./session.sh --seconds 45   (leaves by itself)
//
//   Ctrl+Alt+Backspace  leave        Ctrl+Alt+F1…F12  another TTY
//
//   The keys below are keys.conf's (pleamar-wm's own, or yours in
//   ~/.config/pleamar/keys.conf): this scene only declares the actions.
//   Super+T / Super+Return  a terminal     Super+Q  close the one with the keyboard
//   Super+arrows        the keyboard to the next / previous window
//   Super+Shift+Left    make it lead (if it already leads, to the left monitor)
//   Super+Shift+Right   to the right monitor
//   Super+Shift+Up/Down change places with the one before / after it
//   Super+Tab  everything at a glance       Super+-/+  the leader narrower / wider
//   Super+1…9  that pool of this monitor    Super+Ctrl+Up/Down  the pool above / below
//   Super+Ctrl+Shift+Left/Right  the whole pool to the monitor beside
//   Super+F    fullscreen, and back
//   maximize   (no key of its own: bind one) the one with the keyboard takes
//              all of its monitor —bars and gaps kept— over the others, and back
//   Super+V    the window with the keyboard floats over the tiles, and back
//              (only it: its monitor stays tiled, the others close up)
//   Super+W    tiled or free windows on this monitor (also from Marea's menu):
//              free, each window stays where it is left and as big as it is
//              made —edges and corner—, the green button maximizes it, and
//              the one clicked comes over the rest. Back to tiled, each goes
//              to its place; free again, each to where it was. Only free do
//              windows have a title bar with buttons: tiled, the layout says
//              where each is, and the program has all of its tile.
//   Super+Space  Marea's search (the wallpaper and Marea start with it: autostart)
//   Touchpad: three fingers down close, up fullscreen; four
//   sideways, the keyboard to the next / previous window
//   The keyboard goes to the window the mouse is over, without a click.
//   A window that opens is born from the water at the nearest edge, as
//   Marea's panels come out of her: a drop, a neck, and it spreads into it.
//   With the mouse: carry a window by its title bar (free), by the gap just
//   above it (tiled), or from anywhere with Super held; let it go on another one
//   and they change places (on the other monitor too: each takes the other's),
//   or on an empty spot of the other monitor and it goes there. While
//   carried, a strip at the top offers five layouts —a leader on the left,
//   columns, rows, a grid, a leader on the right—: over one, the windows show
//   how they would be; let go there, and that monitor keeps it.
//
// What Hyprland does not do: its animations are curves of a fixed length that
// start again when interrupted, and its layout is code of its own. Here every
// window rides a spring —change your mind halfway and it turns without a jolt—,
// and the layout is twelve lines anyone can rewrite.
language 0.1
scene Session {
    // One copy per monitor: each lays out its own windows (`win.$i.screen`).
    surface { size: full, full; screens: each max 4 }
    windows win max 16

    let ink = #f5f7f5
    let mint = #9ed6bd
    let coral = #ef7a66
    let amber = #e8c26a
    let marea = #151616                  // Marea's skin (her palette's coal)
    // Windows start this far from the top (under what other programs' bars keep).
    let bar = 12
    let gap = 12
    let tb = 30                          // each window's title bar
    let W = screen.width
    let H = screen.height
    // Where each monitor starts on the desktop: left to right, each one after
    // the one before it.
    let mx.0 = 0
    let mx.1 = screen.0.width
    let mx.2 = screen.0.width + screen.1.width
    let mx.3 = screen.0.width + screen.1.width + screen.2.width
    // Where a window comes from and goes back to: the launcher on the left of the bar.
    let home.x = 24
    let home.y = 12
    spring glide = 210, 23
    spring pop = 320, 12
    // Marea's, for the water a window is born from: `splash` bounces the
    // surface twice before it lies flat; `homing` arrives overshooting a hair.
    spring splash = 420, 13
    spring homing = 165, 16

    fact ratio = 0.56                    // the leader's share of the width
    fact overview = false
    fact dragging = -1                   // the window being carried by its title bar
    // Super held (the compositor says): then a window is carried from
    // anywhere on it, tiled or free, even to the other monitor.
    fact keys.super = 0
    fact grab.x = 0                      // where it was taken from, from its corner
    fact grab.y = 0
    fact over = -1                       // the window under the one carried
    fact landing = -1                    // let go on the other monitor, and which
    fact landing.to = 0
    // It arrived, or it closed on the way, or the compositor never sent it: the
    // one left with the mouse goes. (A window closed while landing stayed as a
    // little picture after the pointer for good.)
    on still landing for 1500ms while landing >= 0 { landing = -1 }
    // The mouse on the whole desktop: which monitor, and where on it. Each
    // copy only knows its own; the one the mouse is over says it.
    fact mon = 0
    fact mouse.x = 0
    fact mouse.y = 0
    // (Over another program's surface —Marea— the scene has no mouse, and
    // then it reads 0, 0: the first monitor's corner. Taken for a real
    // place, Marea on the second monitor was told the mouse had gone to the
    // first the moment it came onto her, and left.)
    on change pointer.x + pointer.y * 8192 while pointer.x >= 0 and pointer.x < W and pointer.y >= 0 and pointer.y < H and pointer.x + pointer.y > 0 {
        mon = screen.index
        mouse.x = pointer.x
        mouse.y = pointer.y
    }
    prop ov = 0 ~calm
    follow ov = if(overview, 1, 0)

    // ── the phone (docs/phone.md) ──
    // While someone uses the session from a phone, the compositor puts up a
    // monitor for it (`phone`: which one; -1, none) and every window goes
    // there. On it each window is an app: all of the screen under a status
    // line, one at a time, the others waiting beside it, out of sight, to
    // slide in. A swipe up from the bottom (or a tap on the bar there) shows
    // them all as cards —a tap opens one, a flick up closes it— over the
    // programs pinned to the dock, to open another. The real monitors, while
    // the session is away, are covered (`phone_curtain`).
    fact phone = -1
    let is.ph = phone >= 0 and screen.index == phone
    let W.ph = pick(max(phone, 0), screen.0.width, screen.1.width, screen.2.width, screen.3.width)
    let H.ph = pick(max(phone, 0), screen.0.height, screen.1.height, screen.2.height, screen.3.height)
    let ph.sb = 34
    let ph.hb = 28
    // The app in front: the last one on the phone to take the keyboard.
    fact ph.front = -1
    // Each window going to the phone: the monitor and the place it left, and
    // how far it has poured into the phone on the curtain (1: all of it).
    fact sc.last.0 = 0
    fact gx.0 = 0
    fact gy.0 = 0
    fact gw.0 = 0
    fact gh.0 = 0
    fact was.ph.0 = 0
    prop pour.0 = 1 ~0ms
    fact sc.last.1 = 0
    fact gx.1 = 0
    fact gy.1 = 0
    fact gw.1 = 0
    fact gh.1 = 0
    fact was.ph.1 = 0
    prop pour.1 = 1 ~0ms
    fact sc.last.2 = 0
    fact gx.2 = 0
    fact gy.2 = 0
    fact gw.2 = 0
    fact gh.2 = 0
    fact was.ph.2 = 0
    prop pour.2 = 1 ~0ms
    fact sc.last.3 = 0
    fact gx.3 = 0
    fact gy.3 = 0
    fact gw.3 = 0
    fact gh.3 = 0
    fact was.ph.3 = 0
    prop pour.3 = 1 ~0ms
    fact sc.last.4 = 0
    fact gx.4 = 0
    fact gy.4 = 0
    fact gw.4 = 0
    fact gh.4 = 0
    fact was.ph.4 = 0
    prop pour.4 = 1 ~0ms
    fact sc.last.5 = 0
    fact gx.5 = 0
    fact gy.5 = 0
    fact gw.5 = 0
    fact gh.5 = 0
    fact was.ph.5 = 0
    prop pour.5 = 1 ~0ms
    fact sc.last.6 = 0
    fact gx.6 = 0
    fact gy.6 = 0
    fact gw.6 = 0
    fact gh.6 = 0
    fact was.ph.6 = 0
    prop pour.6 = 1 ~0ms
    fact sc.last.7 = 0
    fact gx.7 = 0
    fact gy.7 = 0
    fact gw.7 = 0
    fact gh.7 = 0
    fact was.ph.7 = 0
    prop pour.7 = 1 ~0ms
    fact sc.last.8 = 0
    fact gx.8 = 0
    fact gy.8 = 0
    fact gw.8 = 0
    fact gh.8 = 0
    fact was.ph.8 = 0
    prop pour.8 = 1 ~0ms
    fact sc.last.9 = 0
    fact gx.9 = 0
    fact gy.9 = 0
    fact gw.9 = 0
    fact gh.9 = 0
    fact was.ph.9 = 0
    prop pour.9 = 1 ~0ms
    fact sc.last.10 = 0
    fact gx.10 = 0
    fact gy.10 = 0
    fact gw.10 = 0
    fact gh.10 = 0
    fact was.ph.10 = 0
    prop pour.10 = 1 ~0ms
    fact sc.last.11 = 0
    fact gx.11 = 0
    fact gy.11 = 0
    fact gw.11 = 0
    fact gh.11 = 0
    fact was.ph.11 = 0
    prop pour.11 = 1 ~0ms
    fact sc.last.12 = 0
    fact gx.12 = 0
    fact gy.12 = 0
    fact gw.12 = 0
    fact gh.12 = 0
    fact was.ph.12 = 0
    prop pour.12 = 1 ~0ms
    fact sc.last.13 = 0
    fact gx.13 = 0
    fact gy.13 = 0
    fact gw.13 = 0
    fact gh.13 = 0
    fact was.ph.13 = 0
    prop pour.13 = 1 ~0ms
    fact sc.last.14 = 0
    fact gx.14 = 0
    fact gy.14 = 0
    fact gw.14 = 0
    fact gh.14 = 0
    fact was.ph.14 = 0
    prop pour.14 = 1 ~0ms
    fact sc.last.15 = 0
    fact gx.15 = 0
    fact gy.15 = 0
    fact gw.15 = 0
    fact gh.15 = 0
    fact was.ph.15 = 0
    prop pour.15 = 1 ~0ms
    // The cards, and which one is in the middle.
    fact ph.cards = 0
    fact ph.at = 0
    prop pc = 0 ~spring(230, 23)
    // (The hour, on the phone's status line.)
    permissions { services: "clock" }
    service clock as now { time: text; hour: number }
    // Each window's turn on the phone, left to right as they opened, and how many there are.
    let ph.on.0 = phone >= 0 and win.0.open and win.0.screen == phone and not win.0.dialog
    let ph.on.1 = phone >= 0 and win.1.open and win.1.screen == phone and not win.1.dialog
    let ph.on.2 = phone >= 0 and win.2.open and win.2.screen == phone and not win.2.dialog
    let ph.on.3 = phone >= 0 and win.3.open and win.3.screen == phone and not win.3.dialog
    let ph.on.4 = phone >= 0 and win.4.open and win.4.screen == phone and not win.4.dialog
    let ph.on.5 = phone >= 0 and win.5.open and win.5.screen == phone and not win.5.dialog
    let ph.on.6 = phone >= 0 and win.6.open and win.6.screen == phone and not win.6.dialog
    let ph.on.7 = phone >= 0 and win.7.open and win.7.screen == phone and not win.7.dialog
    let ph.on.8 = phone >= 0 and win.8.open and win.8.screen == phone and not win.8.dialog
    let ph.on.9 = phone >= 0 and win.9.open and win.9.screen == phone and not win.9.dialog
    let ph.on.10 = phone >= 0 and win.10.open and win.10.screen == phone and not win.10.dialog
    let ph.on.11 = phone >= 0 and win.11.open and win.11.screen == phone and not win.11.dialog
    let ph.on.12 = phone >= 0 and win.12.open and win.12.screen == phone and not win.12.dialog
    let ph.on.13 = phone >= 0 and win.13.open and win.13.screen == phone and not win.13.dialog
    let ph.on.14 = phone >= 0 and win.14.open and win.14.screen == phone and not win.14.dialog
    let ph.on.15 = phone >= 0 and win.15.open and win.15.screen == phone and not win.15.dialog
    let ph.n = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11 + ph.on.12 + ph.on.13 + ph.on.14 + ph.on.15
    let ph.k.0 = 0
    let ph.k.1 = ph.on.0
    let ph.k.2 = ph.on.0 + ph.on.1
    let ph.k.3 = ph.on.0 + ph.on.1 + ph.on.2
    let ph.k.4 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3
    let ph.k.5 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4
    let ph.k.6 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5
    let ph.k.7 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6
    let ph.k.8 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7
    let ph.k.9 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8
    let ph.k.10 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9
    let ph.k.11 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10
    let ph.k.12 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11
    let ph.k.13 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11 + ph.on.12
    let ph.k.14 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11 + ph.on.12 + ph.on.13
    let ph.k.15 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11 + ph.on.12 + ph.on.13 + ph.on.14
    let ph.kf = pick(max(ph.front, 0), ph.k.0, ph.k.1, ph.k.2, ph.k.3, ph.k.4, ph.k.5, ph.k.6, ph.k.7, ph.k.8, ph.k.9, ph.k.10, ph.k.11, ph.k.12, ph.k.13, ph.k.14, ph.k.15)
    // The cards (and what to open) instead of an app: asked for, or nothing in front.
    let ph.home = phone >= 0 and (ph.cards > 0.5 or ph.n < 1 or ph.front < 0)
    follow pc = if(ph.home, 1, 0)
    // A tablet lying down (see `phone`): room for two apps side by side,
    // the one in front and another, with a line between them that a finger
    // moves. Taller than wide —or a phone—, one at a time.
    let ph.wide = W.ph >= 900 and H.ph >= 560
    // Lying down, the cards go along in a row instead of a deck.
    let ph.row = W.ph > H.ph
    // The one beside (-1: by itself, the one before it in the deck), which
    // side the one in front is on, where the line is (of the width), and
    // whether it was asked to be alone.
    fact ph.side = -1
    fact ph.fl = 1
    fact ph.ratio = 0.5
    fact ph.solo = 0
    let ph.ka = if(ph.kf > 0, ph.kf - 1, 1)
    let ph.adj.0 = ph.on.0 and ph.front != 0 and ph.k.0 == ph.ka
    let ph.adj.1 = ph.on.1 and ph.front != 1 and ph.k.1 == ph.ka
    let ph.adj.2 = ph.on.2 and ph.front != 2 and ph.k.2 == ph.ka
    let ph.adj.3 = ph.on.3 and ph.front != 3 and ph.k.3 == ph.ka
    let ph.adj.4 = ph.on.4 and ph.front != 4 and ph.k.4 == ph.ka
    let ph.adj.5 = ph.on.5 and ph.front != 5 and ph.k.5 == ph.ka
    let ph.adj.6 = ph.on.6 and ph.front != 6 and ph.k.6 == ph.ka
    let ph.adj.7 = ph.on.7 and ph.front != 7 and ph.k.7 == ph.ka
    let ph.adj.8 = ph.on.8 and ph.front != 8 and ph.k.8 == ph.ka
    let ph.adj.9 = ph.on.9 and ph.front != 9 and ph.k.9 == ph.ka
    let ph.adj.10 = ph.on.10 and ph.front != 10 and ph.k.10 == ph.ka
    let ph.adj.11 = ph.on.11 and ph.front != 11 and ph.k.11 == ph.ka
    let ph.adj.12 = ph.on.12 and ph.front != 12 and ph.k.12 == ph.ka
    let ph.adj.13 = ph.on.13 and ph.front != 13 and ph.k.13 == ph.ka
    let ph.adj.14 = ph.on.14 and ph.front != 14 and ph.k.14 == ph.ka
    let ph.adj.15 = ph.on.15 and ph.front != 15 and ph.k.15 == ph.ka
    let ph.auto = -1 + 1 * ph.adj.0 + 2 * ph.adj.1 + 3 * ph.adj.2 + 4 * ph.adj.3 + 5 * ph.adj.4 + 6 * ph.adj.5 + 7 * ph.adj.6 + 8 * ph.adj.7 + 9 * ph.adj.8 + 10 * ph.adj.9 + 11 * ph.adj.10 + 12 * ph.adj.11 + 13 * ph.adj.12 + 14 * ph.adj.13 + 15 * ph.adj.14 + 16 * ph.adj.15
    let ph.sok = ph.side >= 0 and ph.side != ph.front and pick(max(ph.side, 0), ph.on.0, ph.on.1, ph.on.2, ph.on.3, ph.on.4, ph.on.5, ph.on.6, ph.on.7, ph.on.8, ph.on.9, ph.on.10, ph.on.11, ph.on.12, ph.on.13, ph.on.14, ph.on.15)
    let ph.sd = if(ph.sok, ph.side, ph.auto)
    let ph.split = phone >= 0 and ph.wide and ph.solo < 0.5 and ph.front >= 0 and ph.sd >= 0
    // The line held (a pointer, or a finger held first), or moved by a
    // finger sideways (the wheel): where it is while it moves.
    fact ph.dv = 0
    fact ph.wl = -1
    let ph.lv = if(ph.dv > 0.5, clamp(mouse.x / max(W.ph, 1), 0.04, 0.96), ph.wl)
    let ph.xr = W.ph * ph.ratio

    // ── rain: on the windows, as if they were glass, and falling in front of
    // everything. Marea turns it on and off (`emit toggle_rain`); it comes
    // and goes slowly ──
    shader rain = file "shaders/rain.wgsl"
    fact rain = false
    event toggle_rain
    on toggle_rain {
        snow = false
        toggle rain
    }
    prop wet = 0 ~2500ms
    follow wet = if(rain, 1, 0)
    // How hard it rains, from a drizzle to a downpour (`emit rain_level 0.3`,
    // Marea's menu): fewer beads on the glass, fewer streaks in front.
    fact rain.level = 1
    event rain_level
    on rain_level(v) { rain.level = clamp(v, 0.1, 1) }
    prop pour = 1 ~900ms
    follow pour = rain.level
    // ── or snow: frost creeping in from the edges, snow piling up on top of
    // each window, flakes stuck to the glass and falling (`emit toggle_snow`).
    // One weather at a time ──
    shader snow = file "shaders/snow.wgsl"
    fact snow = false
    event toggle_snow
    on toggle_snow {
        rain = false
        toggle snow
    }
    prop cold = 0 ~3000ms
    follow cold = if(snow, 1, 0)
    // How far the window being carried is behind the mouse: its water lags
    // behind, as water on a pane that is moved does.
    prop lag.x = 0 ~140ms
    prop lag.y = 0 ~140ms
    follow lag.x = mouse.x
    follow lag.y = mouse.y

    // ── the desk ──
    // Nothing: the wallpaper is a program's (swaybg, below everything). Only
    // a light that follows the keyboard: where you are typing is a little warmer.
    prop lx = 750 ~slow
    prop ly = 470 ~slow
    // The monitor of the one with the keyboard: only there the light shows.
    let fscreen = pick(win.focus, win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen, win.6.screen, win.7.screen, win.8.screen, win.9.screen, win.10.screen, win.11.screen, win.12.screen, win.13.screen, win.14.screen, win.15.screen)
    group {
        blur: 160
        opacity: 12% * min(win.count, 1) * (fscreen == screen.index) * (win.focus >= 0)
        mode: screen
        ellipse { at: lx, ly; radius: 420; color: #9ed6bd }
    }

    // Where the one with the keyboard is in the order of all of them, and how many there are.
    let focus_at = max(pick(max(win.focus, 0), win.0.rank, win.1.rank, win.2.rank, win.3.rank, win.4.rank, win.5.rank, win.6.rank, win.7.rank, win.8.rank, win.9.rank, win.10.rank, win.11.rank, win.12.rank, win.13.rank, win.14.rank, win.15.rank), 0)
    let all = max(win.count, 1)

    // ── the layouts, one for each monitor: 0 a leader on the left and the
    // rest stacked on the right, 1 columns, 2 rows, 3 a grid, 4 the leader
    // on the right. Carrying a window, a strip of them appears at the top of
    // the monitor under the mouse: over one, everything shows how it would
    // be; let go there, and it is so (with a leader, the one carried leads).
    fact lay.0 = 0
    fact lay.1 = 0
    fact lay.2 = 0
    fact lay.3 = 0
    // ── or free, as on Windows or KDE: each window where it is left and as big
    // as it is made, the one touched on top. Per monitor; Super+W or the
    // Marea's menu. Each window remembers where it was free.
    fact free.0 = 0
    fact free.1 = 0
    fact free.2 = 0
    fact free.3 = 0
    // The last one put away: Super+Shift+M brings it back.
    fact last_min = -1
    fact stamp.top = 0
    // Where a window being resized was when it was taken.
    fact g.x = 0
    fact g.y = 0
    fact g.w = 0
    fact g.h = 0
    fact sizing = -1
    let lay.here = pick(mon, lay.0, lay.1, lay.2, lay.3)
    let strip.x = pick(mon, screen.0.width, screen.1.width, screen.2.width, screen.3.width) / 2 - 5 * 60 / 2
    let strip.y = pick(mon, win.reserved.0.top, win.reserved.1.top, win.reserved.2.top, win.reserved.3.top) + 6
    // The one carried floats over the tiles (`float`): carried as a free one
    // is —no layouts to pick, no changing places, it stays where let go—.
    let dfl = dragging >= 0 and pick(max(dragging, 0), win.0.floating, win.1.floating, win.2.floating, win.3.floating, win.4.floating, win.5.floating, win.6.floating, win.7.floating, win.8.floating, win.9.floating, win.10.floating, win.11.floating, win.12.floating, win.13.floating, win.14.floating, win.15.floating) > 0.5
    // (Only over a tiled monitor: a free one has no layout to pick.)
    let on.strip = dragging >= 0 and not dfl and pick(mon, free.0, free.1, free.2, free.3) < 0.5 and mouse.y >= strip.y and mouse.y < strip.y + 44 and mouse.x >= strip.x and mouse.x < strip.x + 5 * 60
    let picked = if(on.strip, floor((mouse.x - strip.x) / 60), -1)
    let leads = picked == 0 or picked == 4
    // What it is over, kept: let go, `picked` is already gone (it needs the
    // window carried) by the time the rules that apply it read it.
    fact choice = -1
    on change picked {
        choice = picked
    }

    // ── carrying a window: how the others would be if it were let go here ──
    // Its monitor and place; each window's turn in the order of all of them.
    let dsc = pick(max(dragging, 0), win.0.screen, win.1.screen, win.2.screen, win.3.screen, win.4.screen, win.5.screen, win.6.screen, win.7.screen, win.8.screen, win.9.screen, win.10.screen, win.11.screen, win.12.screen, win.13.screen, win.14.screen, win.15.screen)
    let dplace = max(pick(max(dragging, 0), win.0.place, win.1.place, win.2.place, win.3.place, win.4.place, win.5.place, win.6.place, win.7.place, win.8.place, win.9.place, win.10.place, win.11.place, win.12.place, win.13.place, win.14.place, win.15.place), 0)
    let ordD = pick(max(dragging, 0), win.0.rank, win.1.rank, win.2.rank, win.3.rank, win.4.rank, win.5.rank, win.6.rank, win.7.rank, win.8.rank, win.9.rank, win.10.rank, win.11.rank, win.12.rank, win.13.rank, win.14.rank, win.15.rank)
    // Over the other monitor it would go there: there they make room for it,
    // and on its own the rest close up. Its turn there is its turn in the
    // order; first, if it is let go on a layout with a leader.
    let crossing = dragging >= 0 and mon != dsc and not dfl
    // Over a window of the other monitor: they change places —and
    // monitors—; there nothing makes room, and here nothing closes up.
    let xswap = crossing and over >= 0
    let landing.place = if(leads, 0, (win.0.open and win.0.screen == mon and win.0.rank >= 0 and win.0.rank < ordD) + (win.1.open and win.1.screen == mon and win.1.rank >= 0 and win.1.rank < ordD) + (win.2.open and win.2.screen == mon and win.2.rank >= 0 and win.2.rank < ordD) + (win.3.open and win.3.screen == mon and win.3.rank >= 0 and win.3.rank < ordD) + (win.4.open and win.4.screen == mon and win.4.rank >= 0 and win.4.rank < ordD) + (win.5.open and win.5.screen == mon and win.5.rank >= 0 and win.5.rank < ordD) + (win.6.open and win.6.screen == mon and win.6.rank >= 0 and win.6.rank < ordD) + (win.7.open and win.7.screen == mon and win.7.rank >= 0 and win.7.rank < ordD) + (win.8.open and win.8.screen == mon and win.8.rank >= 0 and win.8.rank < ordD) + (win.9.open and win.9.screen == mon and win.9.rank >= 0 and win.9.rank < ordD) + (win.10.open and win.10.screen == mon and win.10.rank >= 0 and win.10.rank < ordD) + (win.11.open and win.11.screen == mon and win.11.rank >= 0 and win.11.rank < ordD) + (win.12.open and win.12.screen == mon and win.12.rank >= 0 and win.12.rank < ordD) + (win.13.open and win.13.screen == mon and win.13.rank >= 0 and win.13.rank < ordD) + (win.14.open and win.14.screen == mon and win.14.rank >= 0 and win.14.rank < ordD) + (win.15.open and win.15.screen == mon and win.15.rank >= 0 and win.15.rank < ordD))
    let landing.n = pick(mon, win.on.0, win.on.1, win.on.2, win.on.3) + 1
    let landing.lay = if(picked >= 0, picked, lay.here)
    // A window fullscreen on the monitor under the mouse: the ones below it keep off the keyboard.
    let fs.on = (win.0.fullscreen and win.0.screen == mon and win.0.rank >= 0) + (win.1.fullscreen and win.1.screen == mon and win.1.rank >= 0) + (win.2.fullscreen and win.2.screen == mon and win.2.rank >= 0) + (win.3.fullscreen and win.3.screen == mon and win.3.rank >= 0) + (win.4.fullscreen and win.4.screen == mon and win.4.rank >= 0) + (win.5.fullscreen and win.5.screen == mon and win.5.rank >= 0) + (win.6.fullscreen and win.6.screen == mon and win.6.rank >= 0) + (win.7.fullscreen and win.7.screen == mon and win.7.rank >= 0) + (win.8.fullscreen and win.8.screen == mon and win.8.rank >= 0) + (win.9.fullscreen and win.9.screen == mon and win.9.rank >= 0) + (win.10.fullscreen and win.10.screen == mon and win.10.rank >= 0) + (win.11.fullscreen and win.11.screen == mon and win.11.rank >= 0) + (win.12.fullscreen and win.12.screen == mon and win.12.rank >= 0) + (win.13.fullscreen and win.13.screen == mon and win.13.rank >= 0) + (win.14.fullscreen and win.14.screen == mon and win.14.rank >= 0) + (win.15.fullscreen and win.15.screen == mon and win.15.rank >= 0)

    // ── pools: each monitor has its own, one below the other, as tide
    // pools are left along a shore. There are as many as hold windows, and
    // one more, empty, past the last; one left empty dries up and the ones
    // below move up. Super+1…9 shows that one on the monitor under the
    // mouse (no further than the empty one), Super+Shift+1…9 sends the window
    // with the keyboard there, Super+Ctrl+Up/Down goes to the one above or
    // below, and Super+Ctrl+Shift+Left/Right carries the whole pool to the
    // monitor beside. Changing, a wave crosses the monitor: in from below
    // going down the stack, from above going up; the windows change when the
    // water covers them all ──
    event workspace
    event move_to_workspace
    event workspace_next
    event workspace_previous
    event workspace_to_left
    event workspace_to_right
    on workspace(v) { workspace v }
    on move_to_workspace(v) while win.focus >= 0 { send win(win.focus) to workspace v }
    let ws.mon = pick(mon, win.shown.0, win.shown.1, win.shown.2, win.shown.3)
    let ws.last = pick(mon, win.used.0, win.used.1, win.used.2, win.used.3) + 1
    on workspace_next { workspace min(ws.mon + 1, ws.last) }
    on workspace_previous { workspace max(ws.mon - 1, 1) }
    on workspace_to_right while mon < screens.count - 1 { send workspace ws.mon on mon to mon + 1 }
    on workspace_to_left while mon > 0 { send workspace ws.mon on mon to mon - 1 }
    // The pool each monitor draws (see below): it starts on its first one.
    fact inpool.0 = 1
    fact inpool.1 = 2
    fact inpool.2 = 3
    fact inpool.3 = 4
    repeat s in 0..4 {
        // The pool drawn: the one shown, once the water has covered the one
        // before it (each monitor starts on its own first one). By identity, not
        // by turn: when one above dries up and it moves up, nothing moves.
        fact was.$s = 1
        fact dir.$s = 1
        prop tide.$s = 1 ~620ms
        prop flash.$s = 0 ~180ms
        on change win.pool.$s {
            dir.$s = if(win.shown.$s >= was.$s, 1, -1)
            was.$s = win.shown.$s
            tide.$s: 0 ~0ms
            tide.$s: 1 ~620ms after 16ms
            flash.$s: 1 ~140ms
            flash.$s: 0 ~420ms after 1200ms
        }
        on change win.shown.$s { was.$s = win.shown.$s }
        on change tide.$s > 0.5 while tide.$s > 0.5 { inpool.$s = win.pool.$s }
        on still tide.$s for 60ms while tide.$s > 0.98 and inpool.$s != win.pool.$s { inpool.$s = win.pool.$s }

        // The wave: black water, the same the windows are born from, with a
        // rolling crest on each side that melts into it, and its own rim of
        // light, as Marea's edge has.
        let wv = tide.$s
        //  Its back edge leaves before the spring's slow end (by 0.88): the
        //  spring already eases it out, and the two easings together had it
        //  crawling the last stretch.
        let lead = smooth(0, 0.5, wv)
        let trail = smooth(0.5, 0.88, wv)
        //  Both edges go all the way across, from past one side to past the
        //  other (`reach`: what its crests, its blend and its shadow stick
        //  out): it leaves the monitor whole while still moving, and the
        //  slow end of the spring happens out of sight. It ran up to the edge
        //  instead, and shrank there, a strip of crests standing still until
        //  `show` took it away.
        let reach = 160
        let top = if(dir.$s > 0, H + reach - (H + 2 * reach) * lead, (H + 2 * reach) * trail - reach)
        let bot = if(dir.$s > 0, H + reach - (H + 2 * reach) * trail, (H + 2 * reach) * lead - reach)
        let crest = W / 7
        group {
            z: 99980
            show: wv < 0.999 and screen.index == s and bot - top > 0.5 and bot > -reach and top < H + reach
            body {
                gradient: 0, top to 0, bot, #121517, #0c0e10 35%, #0a0b0d
                rim: 14%
                shadow: 0, 0, 36, 45%
                box { from: -60, top; size: W + 120, bot - top }
                // Its crests, rolling along as it goes.
                ellipse { at: (0 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(0 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (0 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(0 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (1 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(73 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (1 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(73 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (2 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(146 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (2 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(146 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (3 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(219 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (3 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(219 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (4 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(292 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (4 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(292 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (5 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(365 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (5 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(365 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (6 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(438 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (6 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(438 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (7 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(511 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (7 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(511 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (8 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(584 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (8 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(584 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
            }
        }

        // Where you are: a capsule at the right edge, a dot per pool —the
        // empty ones a ring— and the one shown drawn out, sliding to it.
        let nd = max(win.pools.$s, win.used.$s + 1)
        let cur = win.shown.$s
        prop at.$s = 1 ~pop
        follow at.$s = cur
        let dy0 = H / 2 - (nd - 1) * 9
        group {
            z: 99990
            show: flash.$s > 0.01 and screen.index == s
            opacity: flash.$s
            move: 12 * (1 - flash.$s), 0
            body {
                color: #0c0e10
                rim: 10%
                shadow: 0, 8, 24, 45%
                box { at: W - 28, H / 2; size: 24, nd * 18 + 14; corner: 12 }
            }
            ellipse { at: W - 28, dy0 + 0; radius: 3; color: ink; opacity: 45%; show: 1 <= nd and not (1 == nd and win.used.$s < 1 or 1 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 0; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 1 <= nd and (1 == nd and win.used.$s < 1 or 1 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 18; radius: 3; color: ink; opacity: 45%; show: 2 <= nd and not (2 == nd and win.used.$s < 2 or 2 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 18; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 2 <= nd and (2 == nd and win.used.$s < 2 or 2 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 36; radius: 3; color: ink; opacity: 45%; show: 3 <= nd and not (3 == nd and win.used.$s < 3 or 3 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 36; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 3 <= nd and (3 == nd and win.used.$s < 3 or 3 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 54; radius: 3; color: ink; opacity: 45%; show: 4 <= nd and not (4 == nd and win.used.$s < 4 or 4 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 54; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 4 <= nd and (4 == nd and win.used.$s < 4 or 4 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 72; radius: 3; color: ink; opacity: 45%; show: 5 <= nd and not (5 == nd and win.used.$s < 5 or 5 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 72; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 5 <= nd and (5 == nd and win.used.$s < 5 or 5 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 90; radius: 3; color: ink; opacity: 45%; show: 6 <= nd and not (6 == nd and win.used.$s < 6 or 6 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 90; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 6 <= nd and (6 == nd and win.used.$s < 6 or 6 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 108; radius: 3; color: ink; opacity: 45%; show: 7 <= nd and not (7 == nd and win.used.$s < 7 or 7 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 108; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 7 <= nd and (7 == nd and win.used.$s < 7 or 7 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 126; radius: 3; color: ink; opacity: 45%; show: 8 <= nd and not (8 == nd and win.used.$s < 8 or 8 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 126; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 8 <= nd and (8 == nd and win.used.$s < 8 or 8 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 144; radius: 3; color: ink; opacity: 45%; show: 9 <= nd and not (9 == nd and win.used.$s < 9 or 9 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 144; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 9 <= nd and (9 == nd and win.used.$s < 9 or 9 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 162; radius: 3; color: ink; opacity: 45%; show: 10 <= nd and not (10 == nd and win.used.$s < 10 or 10 == cur and win.used.$s < win.pools.$s) }
            ellipse { at: W - 28, dy0 + 162; radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: 10 <= nd and (10 == nd and win.used.$s < 10 or 10 == cur and win.used.$s < win.pools.$s) }
            box { at: W - 28, dy0 + (at.$s - 1) * 18; size: 6, 15; corner: 3; color: mint }
        }
    }

    // ── the shore: the dock of a free monitor. When a monitor goes free, the
    // water rises at its bottom edge and leaves the shore there, joined to it
    // by a neck, as Marea hangs from hers at the top: the programs pinned
    // (`dock …` in session.conf) and the others with windows on the pool
    // shown, each with a drop per window under it (mint, the one with the
    // keyboard); the windows put away, floating as they are; and the pools of
    // the monitor, last. Hovering, the icons rise like buoys on a passing
    // wave; pressed, one dips and rings the water. Tiled, there is no shore,
    // and nothing is put away ──
    spring rise = 190, 20
    prop shore.0 = 0 ~rise
    follow shore.0 = if(free.0 > 0.5, 1, 0)
    let dk.n.0 = win.docks.0
    let dk.m.0 = win.mins.0
    let dk.p.0 = max(win.pools.0, win.used.0 + 1)
    let dk.tw.0 = 28 + dk.n.0 * 60 + if(dk.m.0 > 0, 20 + dk.m.0 * 76, 0) + 20 + dk.p.0 * 26
    prop dkw.0 = 200 ~pop
    follow dkw.0 = dk.tw.0
    let dk.x0.0 = screen.0.width / 2 - dkw.0 / 2
    let dk.cy.0 = screen.0.height + 42 - 88 * shore.0
    let dk.on.0 = mon == 0 and shore.0 > 0.6 and mouse.y >= dk.cy.0 - 46 and mouse.x >= dk.x0.0 and mouse.x <= dk.x0.0 + dkw.0
    let dk.t.0 = (mouse.x - dk.x0.0 - 14) / 60 - 0.5
    let dk.px.0 = dk.x0.0 + dkw.0 - 14 - dk.p.0 * 26
    image dockicon.0.0 = from win.dock.0.0.icon, 96, 96
    prop buoy.0.0 = 0 ~pop
    follow buoy.0.0 = if(dk.on.0, pow(max(0, 1 - abs(0 - dk.t.0) / 1.8), 2), 0)
    prop here.0.0 = 0 ~pop
    follow here.0.0 = if(0 < dk.n.0, 1, 0)
    prop ring.0.0 = 1 ~760ms
    image dockicon.0.1 = from win.dock.0.1.icon, 96, 96
    prop buoy.0.1 = 0 ~pop
    follow buoy.0.1 = if(dk.on.0, pow(max(0, 1 - abs(1 - dk.t.0) / 1.8), 2), 0)
    prop here.0.1 = 0 ~pop
    follow here.0.1 = if(1 < dk.n.0, 1, 0)
    prop ring.0.1 = 1 ~760ms
    image dockicon.0.2 = from win.dock.0.2.icon, 96, 96
    prop buoy.0.2 = 0 ~pop
    follow buoy.0.2 = if(dk.on.0, pow(max(0, 1 - abs(2 - dk.t.0) / 1.8), 2), 0)
    prop here.0.2 = 0 ~pop
    follow here.0.2 = if(2 < dk.n.0, 1, 0)
    prop ring.0.2 = 1 ~760ms
    image dockicon.0.3 = from win.dock.0.3.icon, 96, 96
    prop buoy.0.3 = 0 ~pop
    follow buoy.0.3 = if(dk.on.0, pow(max(0, 1 - abs(3 - dk.t.0) / 1.8), 2), 0)
    prop here.0.3 = 0 ~pop
    follow here.0.3 = if(3 < dk.n.0, 1, 0)
    prop ring.0.3 = 1 ~760ms
    image dockicon.0.4 = from win.dock.0.4.icon, 96, 96
    prop buoy.0.4 = 0 ~pop
    follow buoy.0.4 = if(dk.on.0, pow(max(0, 1 - abs(4 - dk.t.0) / 1.8), 2), 0)
    prop here.0.4 = 0 ~pop
    follow here.0.4 = if(4 < dk.n.0, 1, 0)
    prop ring.0.4 = 1 ~760ms
    image dockicon.0.5 = from win.dock.0.5.icon, 96, 96
    prop buoy.0.5 = 0 ~pop
    follow buoy.0.5 = if(dk.on.0, pow(max(0, 1 - abs(5 - dk.t.0) / 1.8), 2), 0)
    prop here.0.5 = 0 ~pop
    follow here.0.5 = if(5 < dk.n.0, 1, 0)
    prop ring.0.5 = 1 ~760ms
    image dockicon.0.6 = from win.dock.0.6.icon, 96, 96
    prop buoy.0.6 = 0 ~pop
    follow buoy.0.6 = if(dk.on.0, pow(max(0, 1 - abs(6 - dk.t.0) / 1.8), 2), 0)
    prop here.0.6 = 0 ~pop
    follow here.0.6 = if(6 < dk.n.0, 1, 0)
    prop ring.0.6 = 1 ~760ms
    image dockicon.0.7 = from win.dock.0.7.icon, 96, 96
    prop buoy.0.7 = 0 ~pop
    follow buoy.0.7 = if(dk.on.0, pow(max(0, 1 - abs(7 - dk.t.0) / 1.8), 2), 0)
    prop here.0.7 = 0 ~pop
    follow here.0.7 = if(7 < dk.n.0, 1, 0)
    prop ring.0.7 = 1 ~760ms
    image dockicon.0.8 = from win.dock.0.8.icon, 96, 96
    prop buoy.0.8 = 0 ~pop
    follow buoy.0.8 = if(dk.on.0, pow(max(0, 1 - abs(8 - dk.t.0) / 1.8), 2), 0)
    prop here.0.8 = 0 ~pop
    follow here.0.8 = if(8 < dk.n.0, 1, 0)
    prop ring.0.8 = 1 ~760ms
    image dockicon.0.9 = from win.dock.0.9.icon, 96, 96
    prop buoy.0.9 = 0 ~pop
    follow buoy.0.9 = if(dk.on.0, pow(max(0, 1 - abs(9 - dk.t.0) / 1.8), 2), 0)
    prop here.0.9 = 0 ~pop
    follow here.0.9 = if(9 < dk.n.0, 1, 0)
    prop ring.0.9 = 1 ~760ms
    image dockicon.0.10 = from win.dock.0.10.icon, 96, 96
    prop buoy.0.10 = 0 ~pop
    follow buoy.0.10 = if(dk.on.0, pow(max(0, 1 - abs(10 - dk.t.0) / 1.8), 2), 0)
    prop here.0.10 = 0 ~pop
    follow here.0.10 = if(10 < dk.n.0, 1, 0)
