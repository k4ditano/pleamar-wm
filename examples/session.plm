                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq3.$s), dka3.$s) + 0.39 * dksz3.$s, if(dkvert, dka3.$s, dk.cr.$s + dk.cs.$s * (dkiq3.$s)) - 0.39 * dksz3.$s; radius: 8.5 }
