                    text pick(max(if(wire.0.a == i, wire.0.b, wire.0.a), 0), win.0.title, win.1.title, win.2.title, win.3.title, win.4.title, win.5.title, win.6.title, win.7.title, win.8.title, win.9.title, win.10.title, win.11.title, win.12.title, win.13.title, win.14.title, win.15.title) { at: pm.x + 17, y - gap / 2; anchor: left center; size: 8.5; color: ink; opacity: 70%; width: 78; lines: 1; show: wlm.0.width < 0.5 }
                }
                group {
                    show: (wire.1.a >= 0 and (wire.1.a == i or wire.1.b == i))
                    let pm.x = x + 14 + ((wire.0.a >= 0 and (wire.0.a == i or wire.0.b == i))) * 106
