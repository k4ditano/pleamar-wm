// The same window manager as examples/windows.plm, as a session of its own:
// the whole monitor, with no compositor underneath. From a TTY of its own
// (Ctrl+Alt+F3, logged in there):
//
//   ./session.sh              ./session.sh --seconds 45   (leaves by itself)
//
//   Ctrl+Alt+Backspace  leave        Ctrl+Alt+F1…F12  another TTY
//
//   The keys below are keys.conf's (pleamar-wm's own, or yours in
//   ~/.config/pleamar/keys.conf): this scene only declares the actions.
//   Super+T / Super+Return  a terminal     Super+Q  close the one with the keyboard
//   Super+arrows        the keyboard to the window that way (any layout, any monitor)
//   Super+Shift+Left    make it lead (if it already leads, to the left monitor)
//   Super+Shift+Right   to the right monitor
//   Super+Shift+Up/Down change places with the one before / after it
//   Super+Tab  everything at a glance       Super+-/+  the leader narrower / wider
//                                           (fractal: zoom out / in)
//   Super+I    the control centre (`pleamar-wm control`): each monitor's layout
//   Super+1…9  that pool of this monitor    Super+Ctrl+Up/Down  the pool above / below
//   Super+Ctrl+Shift+Left/Right  the whole pool to the monitor beside
//   Super+F    fullscreen, and back
//   maximize   (no key of its own: bind one) the one with the keyboard takes
//              all of its monitor —bars and gaps kept— over the others, and back
//   Super+V    the window with the keyboard floats over the tiles, and back
//   Free is a canvas: a plane with no edges that the monitor looks at
//              through a camera —Super and a drag on the empty plane to move
//              about, Super and the wheel to come closer or go further, Super+-/+ too, Super+0 to
//              see them all—; let go near another window's edge, it takes
//              its side; a window's port, dragged to another, wires them
//              (only it: its monitor stays tiled, the others close up)
//   Super+W    tiled or free windows on this monitor (also from Marea's menu):
//              free, each window stays where it is left and as big as it is
//              made —edges and corner—, the green button maximizes it, and
//              the one clicked comes over the rest. Back to tiled, each goes
//              to its place; free again, each to where it was. Only free do
//              windows have a title bar with buttons: tiled, the layout says
//              where each is, and the program has all of its tile.
//   Super+Space  Marea's search (the wallpaper and Marea start with it: autostart)
//   Touchpad: three fingers down close, up fullscreen; four
//   sideways, the keyboard to the next / previous window
//   The keyboard goes to the window the mouse is over, without a click.
//   A window that opens fills where it goes, like a tank: the water comes
//   up from the bottom with a wavy line and a bright edge, and in a quarter
//   of a second it is the window. One that closes drains the same way.
//   With the mouse: carry a window by its title bar (free), by the gap just
//   above it (tiled), or from anywhere with Super held; let it go on another one
//   and they change places, or anywhere on the other monitor —over a window
//   of it too— and it goes there, among the ones it has. While
//   carried, a strip at the top offers nine layouts —a leader on the left,
//   columns, rows, a grid, a leader on the right, scrolling, marea, fractal,
//   a canvas—:
//   over one, the windows show how they would be; let go there, and that
//   monitor keeps it. On a fractal monitor, let go near another window's edge,
//   it docks on that side of it; free, against an edge or a corner, it takes
//   that half or quarter (water magnets).
//
// What Hyprland does not do: its animations are curves of a fixed length that
// start again when interrupted, and its layout is code of its own. Here every
// window rides a spring —change your mind halfway and it turns without a jolt—,
// and the layout is twelve lines anyone can rewrite.
language 0.1
scene Session {
    // One copy per monitor: each lays out its own windows (`win.$i.screen`).
    surface { size: full, full; screens: each max 4 }
    // A new window waits out of the layout until it is given its place: at
    // once, or on a fractal monitor once its box is cut (`accept`).
    windows win max 16 placement manual

    let ink = #f5f7f5
    let mint = #9ed6bd
    let coral = #ef7a66
    let amber = #e8c26a
    let marea = #151616                  // Marea's skin (her palette's coal)
    // Windows start this far from the top (under what other programs' bars keep).
    let bar = 12
    let gap = 12
    let tb = 30                          // each window's title bar
    let W = screen.width
    let H = screen.height
    // Where each monitor starts on the desktop: left to right, each one after
    // the one before it.
    let mx.0 = 0
    let mx.1 = screen.0.width
    let mx.2 = screen.0.width + screen.1.width
    let mx.3 = screen.0.width + screen.1.width + screen.2.width
    // Where a window comes from and goes back to: the launcher on the left of the bar.
    let home.x = 24
    let home.y = 12
    spring glide = 210, 23
    spring pop = 320, 12
    // The water a window fills with as it opens.
    shader tide = file "shaders/tide.wgsl"

    fact ratio = 0.56                    // the leader's share of the width
    fact overview = false
    fact dragging = -1                   // the window being carried by its title bar
    fact tgrab = -1                      // the title bar pressed, until it is let go
    fact tsup = 0                        // and whether Super was held as it was (from anywhere on the window)
    // Super held (the compositor says): then a window is carried from
    // anywhere on it, tiled or free, even to the other monitor.
    fact keys.super = 0
    fact grab.x = 0                      // where it was taken from, from its corner
    fact grab.y = 0
    fact over = -1                       // the window under the one carried
    fact landing = -1                    // let go on the other monitor, and which
    fact landing.to = 0
    // It arrived, or it closed on the way, or the compositor never sent it: the
    // one left with the mouse goes. (A window closed while landing stayed as a
    // little picture after the pointer for good.)
    on still landing for 1500ms while landing >= 0 { landing = -1 }
    // The mouse on the whole desktop: which monitor, and where on it. Each
    // copy only knows its own; the one the mouse is over says it.
    fact mon = 0
    fact mouse.x = 0
    fact mouse.y = 0
    // (Over another program's surface —Marea— the scene has no mouse, and
    // then it reads 0, 0: the first monitor's corner. Taken for a real
    // place, Marea on the second monitor was told the mouse had gone to the
    // first the moment it came onto her, and left.)
    on change pointer.x + pointer.y * 8192 while pointer.x >= 0 and pointer.x < W and pointer.y >= 0 and pointer.y < H and pointer.x + pointer.y > 0 {
        mon = screen.index
        mouse.x = pointer.x
        mouse.y = pointer.y
    }
    prop ov = 0 ~calm
    follow ov = if(overview, 1, 0)

    // ── the phone (docs/phone.md) ──
    // While someone uses the session from a phone, the compositor puts up a
    // monitor for it (`phone`: which one; -1, none) and every window goes
    // there. On it each window is an app: all of the screen under a status
    // line, one at a time, the others waiting beside it, out of sight, to
    // slide in. A swipe up from the bottom (or a tap on the bar there) shows
    // them all as cards —a tap opens one, a flick up closes it— over the
    // programs pinned to the dock, to open another. The real monitors, while
    // the session is away, are covered (`phone_curtain`).
    fact phone = -1
    let is.ph = phone >= 0 and screen.index == phone
    let W.ph = screen[max(phone, 0)].width
    let H.ph = screen[max(phone, 0)].height
    let ph.sb = 34
    let ph.hb = 28
    // The app in front: the last one on the phone to take the keyboard.
    fact ph.front = -1
    // Each window going to the phone: the monitor and the place it left, and
    // how far it has poured into the phone on the curtain (1: all of it).
    repeat k in 0..16 {
        fact sc.last.$k = 0
        fact gx.$k = 0
        fact gy.$k = 0
        fact gw.$k = 0
        fact gh.$k = 0
        fact was.ph.$k = 0
        prop pour.$k = 1 ~0ms
    }
    // The cards, and which one is in the middle.
    fact ph.cards = 0
    fact ph.at = 0
    prop pc = 0 ~spring(230, 23)
    // (The hour, on the phone's status line.)
    permissions { services: "clock" }
    service clock as now { time: text; hour: number }
    // Each window's turn on the phone, left to right as they opened, and how many there are.
    let ph.on[16]
    repeat k in 0..16 {
        ph.on[k] = phone >= 0 and win.$k.open and win.$k.screen == phone and not win.$k.dialog
    }
    let ph.n = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11 + ph.on.12 + ph.on.13 + ph.on.14 + ph.on.15
    let ph.k.0 = 0
    let ph.k.1 = ph.on.0
    let ph.k.2 = ph.on.0 + ph.on.1
    let ph.k.3 = ph.on.0 + ph.on.1 + ph.on.2
    let ph.k.4 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3
    let ph.k.5 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4
    let ph.k.6 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5
    let ph.k.7 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6
    let ph.k.8 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7
    let ph.k.9 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8
    let ph.k.10 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9
    let ph.k.11 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10
    let ph.k.12 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11
    let ph.k.13 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11 + ph.on.12
    let ph.k.14 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11 + ph.on.12 + ph.on.13
    let ph.k.15 = ph.on.0 + ph.on.1 + ph.on.2 + ph.on.3 + ph.on.4 + ph.on.5 + ph.on.6 + ph.on.7 + ph.on.8 + ph.on.9 + ph.on.10 + ph.on.11 + ph.on.12 + ph.on.13 + ph.on.14
    let ph.kf = ph.k[max(ph.front, 0)]
    // The cards (and what to open) instead of an app: asked for, or nothing in front.
    let ph.home = phone >= 0 and (ph.cards > 0.5 or ph.n < 1 or ph.front < 0)
    follow pc = if(ph.home, 1, 0)
    // A tablet lying down (see `phone`): room for two apps side by side,
    // the one in front and another, with a line between them that a finger
    // moves. Taller than wide —or a phone—, one at a time.
    let ph.wide = W.ph >= 900 and H.ph >= 560
    // Lying down, the cards go along in a row instead of a deck.
    let ph.row = W.ph > H.ph
    // The one beside (-1: by itself, the one before it in the deck), which
    // side the one in front is on, where the line is (of the width), and
    // whether it was asked to be alone.
    fact ph.side = -1
    fact ph.fl = 1
    fact ph.ratio = 0.5
    fact ph.solo = 0
    let ph.ka = if(ph.kf > 0, ph.kf - 1, 1)
    let ph.adj[16]
    repeat j in 0..16 {
        ph.adj[j] = ph.on.$j and ph.front != j and ph.k.$j == ph.ka
    }
    let ph.auto = -1 + 1 * ph.adj.0 + 2 * ph.adj.1 + 3 * ph.adj.2 + 4 * ph.adj.3 + 5 * ph.adj.4 + 6 * ph.adj.5 + 7 * ph.adj.6 + 8 * ph.adj.7 + 9 * ph.adj.8 + 10 * ph.adj.9 + 11 * ph.adj.10 + 12 * ph.adj.11 + 13 * ph.adj.12 + 14 * ph.adj.13 + 15 * ph.adj.14 + 16 * ph.adj.15
    let ph.sok = ph.side >= 0 and ph.side != ph.front and ph.on[max(ph.side, 0)]
    let ph.sd = if(ph.sok, ph.side, ph.auto)
    let ph.split = phone >= 0 and ph.wide and ph.solo < 0.5 and ph.front >= 0 and ph.sd >= 0
    // The line held (a pointer, or a finger held first), or moved by a
    // finger sideways (the wheel): where it is while it moves.
    fact ph.dv = 0
    fact ph.wl = -1
    let ph.lv = if(ph.dv > 0.5, clamp(mouse.x / max(W.ph, 1), 0.04, 0.96), ph.wl)
    let ph.xr = W.ph * ph.ratio

    // ── rain: on the windows, as if they were glass, and falling in front of
    // everything. Marea turns it on and off (`emit toggle_rain`); it comes
    // and goes slowly ──
    shader rain = file "shaders/rain.wgsl"
    fact rain = false
    event toggle_rain
    on toggle_rain {
        snow = false
        toggle rain
    }
    prop wet = 0 ~2500ms
    follow wet = if(rain, 1, 0)
    // How hard it rains, from a drizzle to a downpour (`emit rain_level 0.3`,
    // Marea's menu): fewer beads on the glass, fewer streaks in front.
    fact rain.level = 1
    event rain_level
    on rain_level(v) { rain.level = clamp(v, 0.1, 1) }
    prop pour = 1 ~900ms
    follow pour = rain.level
    // ── or snow: frost creeping in from the edges, snow piling up on top of
    // each window, flakes stuck to the glass and falling (`emit toggle_snow`).
    // One weather at a time ──
    shader snow = file "shaders/snow.wgsl"
    fact snow = false
    event toggle_snow
    on toggle_snow {
        rain = false
        toggle snow
    }
    prop cold = 0 ~3000ms
    follow cold = if(snow, 1, 0)
    // How far the window being carried is behind the mouse: its water lags
    // behind, as water on a pane that is moved does.
    prop lag.x = 0 ~140ms
    prop lag.y = 0 ~140ms
    // Only while one is carried does anything read it: the rest of the time it
    // stands still. Chasing the mouse all day, each move of it was the whole
    // scene going round at the monitor's pace for 140 ms, painting nothing.
    let lagging = dragging >= 0 or landing >= 0
    follow lag.x = if(lagging, mouse.x, lag.x)
    follow lag.y = if(lagging, mouse.y, lag.y)
    on change dragging while dragging >= 0 {
        lag.x: mouse.x ~0ms
        lag.y: mouse.y ~0ms
    }

    // ── the desk ──
    // Nothing: the wallpaper is a program's (swaybg, below everything). Only
    // a light that follows the keyboard: where you are typing is a little warmer.
    prop lx = 750 ~slow
    prop ly = 470 ~slow
    // The monitor of the one with the keyboard: only there the light shows.
    let fscreen = win[max(win.focus, 0)].screen
    group {
        blur: 160
        opacity: 12% * min(win.count, 1) * (fscreen == screen.index) * (win.focus >= 0)
        mode: screen
        ellipse { at: lx, ly; radius: 420; color: #9ed6bd }
    }

    // ── wires, on a canvas: which windows are wired to each other —both
    // ways, up to eight—. A wire is what lets an agent in one of them read,
    // type in and hand tasks to the other (`pleamar-wm link`); `flow` is
    // what goes along it now: 1 from a to b, -1 back, 0 nothing. ──
    repeat k in 0..8 {
        fact wire.$k.a = -1
        fact wire.$k.b = -1
        fact wire.$k.flow = 0
        // What the person calls it («tests», «frontend»): an agent can name
        // the window at its other end by it.
        text wire.$k.label = ""
        measure wlm.$k
    }
    fact wedit = -1                      // the wire whose name is being written
    fact hovwin = -1                     // the window under the mouse
    // An agent answered what another window's agent asked its person, through
    // a wire (`pleamar-wm link answer`): window × 100 + who answered + 1.
    event answered
    fact wiring = -1                     // the window whose port is being dragged
    fact wtgt = -1                       // the one under the mouse meanwhile
    fact wnew.a = -1
    fact wnew.b = -1
    prop wnew.go = 0 ~0ms                // a frame later, it is put in place
    fact wgone = -1
    fact wgone.n = 0
    // ── the canvas's plane, under the windows: a faint grid of it, that
    // moves and comes closer with the camera; and the empty plane, dragged
    // with Super held, moves about, Super and the wheel zooms
    // where the pointer is ──
    repeat k in 0..4 {
        prop cvgx.$k = 0 ~glide
        prop cvgy.$k = 0 ~glide
        prop cvgz.$k = 1 ~glide
        follow cvgx.$k = cvx.$k
        follow cvgy.$k = cvy.$k
        follow cvgz.$k = cvz.$k
        prop cvin.$k = 0 ~260ms
        follow cvin.$k = if(cv.$k > 0.5 and free.$k > 0.5, 1, 0)
    }
    let cvh = cv[screen.index] > 0.5 and free[screen.index] > 0.5
    let cvh.z = cvgz[screen.index]
    let cvh.x0 = win.reserved[screen.index].left
    let cvh.y0 = win.reserved[screen.index].top + bar
    // A line every 96 px of the plane, or every two, four, eight: never
    // closer than 64 px on the monitor.
    let cvh.s0 = 96 * cvh.z
    let cvh.st = if(cvh.s0 < 16, cvh.s0 * 8, if(cvh.s0 < 32, cvh.s0 * 4, if(cvh.s0 < 64, cvh.s0 * 2, cvh.s0)))
    let cvh.ox = mod(cvh.x0 - cvgx[screen.index] * cvh.z, cvh.st)
    let cvh.oy = mod(cvh.y0 - cvgy[screen.index] * cvh.z, cvh.st)
    group {
        show: cvin[screen.index] > 0.01
        opacity: cvin[screen.index]
        repeat k in 0..64 {
            box { from: cvh.ox + k * cvh.st - 0.5, 0; size: 1, H; color: ink; opacity: 3.5%; show: cvh.ox + k * cvh.st < W }
        }
        repeat k in 0..36 {
            box { from: 0, cvh.oy + k * cvh.st - 0.5; size: W, 1; color: ink; opacity: 3.5%; show: cvh.oy + k * cvh.st < H }
        }
    }
    zone box canvas_bg { from: 0, 0; size: W, H; active: cvh and not overview; label: "The canvas"; role: region }
    // Dragged with Super held: the camera goes the other way, as if the plane
    // were held. Without Super a drag on the desktop leaves it where it is,
    // and Super let go on the way stops it there.
    fact cvp.k = -1
    fact cvp.x = 0
    fact cvp.y = 0
    on press canvas_bg while keys.super > 0.5 {
        cvp.k = mon
        cvp.x = cvx[mon]
        cvp.y = cvy[mon]
    }
    repeat j in 0..4 {
        on drag canvas_bg while cvp.k == j and keys.super > 0.5 {
            cvx.$j = cvp.x - drag.dx / cvz.$j
            cvy.$j = cvp.y - drag.dy / cvz.$j
        }
    }
    on drag canvas_bg while cvp.k >= 0 and keys.super < 0.5 { cvp.k = -1 }
    on release canvas_bg { cvp.k = -1 }
    on press canvas_bg while wedit >= 0 {
        wedit = -1
        blur
    }
    on key Escape while wedit >= 0 {
        wedit = -1
        blur
    }
    // The wheel, or a key: closer or further, keeping the point under the
    // pointer (with a key, the middle of the monitor) where it is.
    fact cvw.k = -1
    fact cvw.d = 0
    fact cvw.x = 0
    fact cvw.y = 0
    fact cvw.z = 1
    fact cvw.n = 0
    repeat j in 0..4 {
        on change cvw.n while cvw.k == j {
            cvw.z = clamp(cvz.$j * if(cvw.d > 0, 1 + 0.12 * cvw.d, 1 / (1 - 0.12 * cvw.d)), 0.1, 1)
            cvx.$j = cvx.$j + (cvw.x - win.reserved.$j.left) * (1 / cvz.$j - 1 / cvw.z)
            cvy.$j = cvy.$j + (cvw.y - win.reserved.$j.top - bar) * (1 / cvz.$j - 1 / cvw.z)
            cvz.$j = cvw.z
        }
    }

    // Where the one with the keyboard is in the order of all of them, and how many there are.
    let focus_at = max(win[max(win.focus, 0)].rank, 0)
    let all = max(win.count, 1)

    // ── the layouts, one for each monitor: 0 a leader on the left and the
    // rest stacked on the right, 1 columns, 2 rows, 3 a grid, 4 the leader
    // on the right, 5 scrolling (as niri: columns on a strip that goes on to
    // the right, as wide as the leader; it glides to keep the one with the
    // keyboard in sight), 6 «marea» (columns that share the width as a tide:
    // the one with the keyboard wide, and each one wider the more it is
    // used, narrower the longer it is left), 7 fractal (each window a box in
    // a square of its monitor that is split and split again: a new one halves
    // the one with the keyboard, one let go on another's edge docks there,
    // one that goes leaves its room to the ones beside it; and a camera that
    // zooms into any of them and out to see them all). Carrying a window, a strip of them appears at the top of
    // the monitor under the mouse: over one, everything shows how it would
    // be; let go there, and it is so (with a leader, the one carried leads).
    repeat k in 0..4 {
        fact lay.$k = 0
    }
    // Each monitor's name (the session says it at startup): for the control
    // centre, which picks a monitor's layout by its name.
    repeat k in 0..4 {
        text monname.$k = ""
    }
    // How far each monitor's strip has glided (scrolling), and where it is shown.
    repeat k in 0..4 {
        fact sco.$k = 0
    }
    repeat k in 0..4 {
        prop scr.$k = 0 ~glide
    }
    repeat k in 0..4 {
        follow scr.$k = sco.$k
    }
    // ── or free, as on Windows or KDE: each window where it is left and as big
    // as it is made, the one touched on top. Per monitor; Super+W or the
    // Marea's menu. Each window remembers where it was free.
    repeat k in 0..4 {
        fact free.$k = 0
    }
    // ── or a canvas (Super+Shift+W, or the last of the strip): free, on a
    // plane with no edges that the monitor looks at through a camera. Each
    // window keeps its place on the plane (`fx`… are the plane's then, not
    // the monitor's) and the program is asked that size; the monitor shows
    // it as the camera sees it, smaller the further away. The empty plane,
    // dragged with Super held, moves the camera; Super and the wheel —over the plane or a
    // window— brings it closer or further where the pointer is. ──
    repeat k in 0..4 {
        fact cv.$k = 0
    }
    // The camera: where it looks on the plane (0, 0 is where the monitor's
    // own windows are) and how close, from 0.1 to 1 (as they are).
    repeat k in 0..4 {
        fact cvx.$k = 0
        fact cvy.$k = 0
        fact cvz.$k = 1
    }
    // Free is a canvas, and a canvas is free: one follows the other. A canvas
    // starts where the monitor's windows are, as they are.
    repeat k in 0..4 {
        on change free.$k while free.$k < 0.5 { cv.$k = 0 }
        on change free.$k while free.$k > 0.5 { cv.$k = 1 }
        on change cv.$k while cv.$k > 0.5 {
            cvx.$k = 0
            cvy.$k = 0
            cvz.$k = 1
        }
    }
    // The last one put away: Super+Shift+M brings it back.
    fact last_min = -1
    fact stamp.top = 0
    // Where a window being resized was when it was taken.
    fact g.x = 0
    fact g.y = 0
    fact g.w = 0
    fact g.h = 0
    fact sizing = -1
    fact sedge = -1                      // which of its edges: 0 left · 1 right · 2 bottom · 3 corner
    let lay.here = lay[mon]
    let strip.x = screen[mon].width / 2 - 9 * 60 / 2
    let strip.y = win.reserved[mon].top + 6
    // The one carried floats over the tiles (`float`): carried as a free one
    // is —no layouts to pick, no changing places, it stays where let go—.
    let dfl = dragging >= 0 and win[max(dragging, 0)].floating > 0.5
    // (Only over a tiled monitor: a free one has no layout to pick.)
    let on.strip = dragging >= 0 and not dfl and free[mon] < 0.5 and mouse.y >= strip.y and mouse.y < strip.y + 44 and mouse.x >= strip.x and mouse.x < strip.x + 9 * 60
    let picked = if(on.strip, floor((mouse.x - strip.x) / 60), -1)
    let leads = picked == 0 or picked == 4
    // What it is over, kept: let go, `picked` is already gone (it needs the
    // window carried) by the time the rules that apply it read it.
    fact choice = -1
    on change picked {
        choice = picked
    }
    // ── water magnets, free: a window carried against an edge of its monitor
    // takes half of it, against a corner a quarter, against the top all of
    // it; while it is held there, a pool of water shows where it will be.
    // (Not on an edge that leads to another monitor: let go there, it goes
    // to that one.) 1 left half · 2 right half · 3 all · 4 top left · 5
    // bottom left · 6 top right · 7 bottom right. Only for one carried by its
    // title bar: one taken with Super from anywhere on it —meaning to move
    // a canvas, Super held over a window— came back half its size ──
    let mg.free = dragging >= 0 and tsup < 0.5 and (free[mon] > 0.5 or dfl)
    // (What the shore keeps clear on its edge, unless it hides: see the shore.)
    let mg.dk = (clamp(dock.size, 32, 72) + 48) * room[mon]
    let mg.Ws = screen[mon].width - win.reserved[mon].left - win.reserved[mon].right - mg.dk * (dock.side > 0.5)
    let mg.x0 = win.reserved[mon].left + mg.dk * (dock.side == 1)
    let mg.top = win.reserved[mon].top
    let mg.y0 = mg.top + bar
    let mg.ah = screen[mon].height - mg.top - win.reserved[mon].bottom - bar - gap - mg.dk * (dock.side < 0.5)
    let mg.Hm = screen[mon].height
    let mg.lin = mon > 0
    let mg.rin = pick(mon, screen.1.width, screen.2.width, screen.3.width, 0) > 0
    let mg.l = not mg.lin and mouse.x < mg.x0 + 6
    let mg.r = not mg.rin and mouse.x > mg.x0 + mg.Ws - 6
    let mg.t = mouse.y < mg.top + 6
    let mg.hi = mouse.y < mg.Hm * 0.22
    let mg.lo = mouse.y > mg.Hm * 0.78
    let mag = if(not mg.free or on.strip, 0, if(mg.l, if(mg.hi, 4, if(mg.lo, 5, 1)), if(mg.r, if(mg.hi, 6, if(mg.lo, 7, 2)), if(mg.t, 3, 0))))
    // ── fractal (7): each window's box in its monitor's square, 0 to 1, and
    // which monitor and pool that square is (a pool keeps its own) ──
    repeat k in 0..16 {
        fact tre.x.$k = 0
        fact tre.y.$k = 0
        fact tre.w.$k = 0
        fact tre.h.$k = 0
        fact tre.s.$k = -1
        fact tre.p.$k = -1
        fact tre.bye.$k = 0
    }
    // The camera of each monitor: the piece of the square its screen shows.
    repeat k in 0..4 {
        fact cam.$k.x = 0
        fact cam.$k.y = 0
        fact cam.$k.w = 1
        fact cam.$k.h = 1
    }
    // One change to the boxes at a time: the one leaving (and its turn), the
    // one arriving, where it docks if it was let go on another one's edge,
    // and what is kept while a change is made (a rule sees each fact it
    // sets at once, and the lets made from them).
    fact tre.lv = -1
    fact tre.n = 0
    fact tre.nw = -1
    fact tre.m = 0
    fact tre.dk.src = -1
    fact tre.dk.dst = -1
    fact tre.dk.side = 0
    fact tre.side = 0
    fact tre.t = -1
    fact tre.ax = 0
    fact tre.ay = 0
    fact tre.aw = 1
    fact tre.ah = 1
    fact tre.bx = 0
    fact tre.by = 0
    fact tre.bw = 0
    fact tre.bh = 0
    fact tre.as = 0
    fact tre.ap = 0
    // Groups: a window's box is drawn through its group's lens —from where
    // the boxes are split (`tre.x`…) to where it is seen, `o + s * x`— and
    // its group is the box (`tre.f…`) its fellows share as a screen of their
    // own, `d` of the square across. Outside any group, the lens is none and
    // the group is the whole square.
    repeat k in 0..16 {
        fact tre.ox.$k = 0
        fact tre.oy.$k = 0
        fact tre.sx.$k = 1
        fact tre.sy.$k = 1
        fact tre.d.$k = 1
        fact tre.fx.$k = 0
        fact tre.fy.$k = 0
        fact tre.fw.$k = 1
        fact tre.fh.$k = 1
    }
    // A group being made (let go in another's middle), and the lens and
    // box a window that comes takes.
    fact tre.dk.grp = 0
    fact tre.grp = 0
    fact tre.g.ox = 0
    fact tre.g.oy = 0
    fact tre.g.sx = 1
    fact tre.g.sy = 1
    fact tre.g.d = 1
    fact tre.g.fx = 0
    fact tre.g.fy = 0
    fact tre.g.fw = 1
    fact tre.g.fh = 1
    fact tre.g.i = -1
    // What each camera is on: 0 anywhere (the wheel), 1 a group, 2 a window;
    // and where it rests (what the programs are asked their size by, so a
    // wheel turning does not have them redraw at each notch).
    repeat k in 0..4 {
        fact cam.$k.m = 0
        fact camr.$k.w = 1
        fact camr.$k.h = 1
    }
    // Super and the wheel over a window: how much, on which monitor, and the
    // point under the pointer (in the square, as seen).
    // Super and the wheel on a scrolling monitor: the column it asks for, the
    // turn not yet a whole notch (fingers), and a moment in which the strip
    // gliding under the pointer does not take the keyboard elsewhere.
    fact zs.n = 0
    fact zs.k = 0
    fact zs.p = -1
    fact zs.acc = 0
    fact zs.quiet = 0
    on still zs.n for 600ms { zs.quiet = 0 }
    fact zw.n = 0
    fact zw.d = 0
    fact zw.k = 0
    fact zw.x = 0
    fact zw.y = 0
    fact zi.g = 0
    fact zi.b = 1
    fact zi.w = 1
    fact zi.h = 1
    // A window that leaves its square (closed, minimized, floated, gone to
    // another monitor or pool): the ones that cover one of its sides exactly
    // grow over its room. In a square made only by splitting there is always
    // one such side.
    let tre.in[16]
    repeat k in 0..16 {
        tre.in[k] = win.$k.open and win.$k.place >= 0 and win.$k.screen == tre.s.$k and win.$k.pool == tre.p.$k and tre.bye.$k < 0.5
        on change tre.in.$k while not tre.in.$k and tre.w.$k > 0.001 and tre.lv < 0 {
            tre.lv = k
            tre.n = tre.n + 1
        }
    }
    let tl.x = tre.x[max(tre.lv, 0)]
    let tl.y = tre.y[max(tre.lv, 0)]
    let tl.w = tre.w[max(tre.lv, 0)]
    let tl.h = tre.h[max(tre.lv, 0)]
    let tl.s = tre.s[max(tre.lv, 0)]
    let tl.p = tre.p[max(tre.lv, 0)]
    let tR[16]
    let tL[16]
    let tB[16]
    let tT[16]
    repeat k in 0..16 {
        tR[k] = (k != tre.lv and win.$k.open and tre.w.$k > 0.001 and tre.s.$k == tl.s and tre.p.$k == tl.p) and abs(tre.x.$k - tl.x - tl.w) < 0.002 and tre.y.$k > tl.y - 0.002 and tre.y.$k + tre.h.$k < tl.y + tl.h + 0.002
        tL[k] = (k != tre.lv and win.$k.open and tre.w.$k > 0.001 and tre.s.$k == tl.s and tre.p.$k == tl.p) and abs(tre.x.$k + tre.w.$k - tl.x) < 0.002 and tre.y.$k > tl.y - 0.002 and tre.y.$k + tre.h.$k < tl.y + tl.h + 0.002
        tB[k] = (k != tre.lv and win.$k.open and tre.w.$k > 0.001 and tre.s.$k == tl.s and tre.p.$k == tl.p) and abs(tre.y.$k - tl.y - tl.h) < 0.002 and tre.x.$k > tl.x - 0.002 and tre.x.$k + tre.w.$k < tl.x + tl.w + 0.002
        tT[k] = (k != tre.lv and win.$k.open and tre.w.$k > 0.001 and tre.s.$k == tl.s and tre.p.$k == tl.p) and abs(tre.y.$k + tre.h.$k - tl.y) < 0.002 and tre.x.$k > tl.x - 0.002 and tre.x.$k + tre.w.$k < tl.x + tl.w + 0.002
    }
    // How much of each side of the one leaving is covered.
    let tv.r = 0
    let tv.l = 0
    let tv.b = 0
    let tv.t = 0
    repeat k in 0..16 {
        tv.r += tR[k] * tre.h.$k
        tv.l += tL[k] * tre.h.$k
        tv.b += tB[k] * tre.w.$k
        tv.t += tT[k] * tre.w.$k
    }
    let tv.R = abs(tv.r - tl.h) < 0.003
    let tv.L = abs(tL.0 * tre.h.0 + tL.1 * tre.h.1 + tL.2 * tre.h.2 + tL.3 * tre.h.3 + tL.4 * tre.h.4 + tL.5 * tre.h.5 + tL.6 * tre.h.6 + tL.7 * tre.h.7 + tL.8 * tre.h.8 + tL.9 * tre.h.9 + tL.10 * tre.h.10 + tL.11 * tre.h.11 + tL.12 * tre.h.12 + tL.13 * tre.h.13 + tL.14 * tre.h.14 + tL.15 * tre.h.15 - tl.h) < 0.003
    let tv.B = abs(tB.0 * tre.w.0 + tB.1 * tre.w.1 + tB.2 * tre.w.2 + tB.3 * tre.w.3 + tB.4 * tre.w.4 + tB.5 * tre.w.5 + tB.6 * tre.w.6 + tB.7 * tre.w.7 + tB.8 * tre.w.8 + tB.9 * tre.w.9 + tB.10 * tre.w.10 + tB.11 * tre.w.11 + tB.12 * tre.w.12 + tB.13 * tre.w.13 + tB.14 * tre.w.14 + tB.15 * tre.w.15 - tl.w) < 0.003
    let tv.T = abs(tT.0 * tre.w.0 + tT.1 * tre.w.1 + tT.2 * tre.w.2 + tT.3 * tre.w.3 + tT.4 * tre.w.4 + tT.5 * tre.w.5 + tT.6 * tre.w.6 + tT.7 * tre.w.7 + tT.8 * tre.w.8 + tT.9 * tre.w.9 + tT.10 * tre.w.10 + tT.11 * tre.w.11 + tT.12 * tre.w.12 + tT.13 * tre.w.13 + tT.14 * tre.w.14 + tT.15 * tre.w.15 - tl.w) < 0.003
    let tl.ox = tre.ox[max(tre.lv, 0)]
    let tl.oy = tre.oy[max(tre.lv, 0)]
    let tl.sx = tre.sx[max(tre.lv, 0)]
    let tl.sy = tre.sy[max(tre.lv, 0)]
    let tl.d = tre.d[max(tre.lv, 0)]
    let tl.fx = tre.fx[max(tre.lv, 0)]
    let tl.fy = tre.fy[max(tre.lv, 0)]
    let tl.fw = tre.fw[max(tre.lv, 0)]
    let tl.fh = tre.fh[max(tre.lv, 0)]
    let tsm[16]
    let tpc[16]
    let tpa[16]
    repeat k in 0..16 {
        tsm[k] = (k != tre.lv and win.$k.open and tre.w.$k > 0.001 and tre.s.$k == tl.s and tre.p.$k == tl.p) and abs(tre.fx.$k - tl.fx) < 0.002 and abs(tre.fy.$k - tl.fy) < 0.002 and abs(tre.fw.$k - tl.fw) < 0.002 and abs(tre.fh.$k - tl.fh) < 0.002
        tpc[k] = (k != tre.lv and win.$k.open and tre.w.$k > 0.001 and tre.s.$k == tl.s and tre.p.$k == tl.p) and tre.fw.$k * tre.fh.$k > tl.fw * tl.fh + 0.0001 and tre.fx.$k < tl.fx + 0.002 and tre.fx.$k + tre.fw.$k > tl.fx + tl.fw - 0.002 and tre.fy.$k < tl.fy + 0.002 and tre.fy.$k + tre.fh.$k > tl.fy + tl.fh - 0.002
        tpa[k] = if(tpc.$k, tre.fw.$k * tre.fh.$k, 9)
    }
    // The same by its own group; how many of its group are left, and the
    // first of them; the smallest group around it, and which.
    let tvs.r = 0
    let tvs.l = 0
    let tvs.b = 0
    let tvs.t = 0
    let tl.cnt = 0
    let tl.one = -1
    let tp.min = 9
    repeat k in 0..16 {
        tvs.r += tR[k] * tsm[k] * tre.h.$k
        tvs.l += tL[k] * tsm[k] * tre.h.$k
        tvs.b += tB[k] * tsm[k] * tre.w.$k
        tvs.t += tT[k] * tsm[k] * tre.w.$k
        tl.cnt += tsm[k]
        tl.one = if(tl.one < 0 and tsm[k], k, tl.one)
        tp.min = min(tp.min, tpa[k])
    }
    let tp.i = -1
    repeat k in 0..16 {
        tp.i = if(tp.i < 0 and tpc[k] and tpa[k] == tp.min, k, tp.i)
    }
    let tvs.R = abs(tvs.r - tl.h) < 0.003
    let tvs.L = abs(tL.0 * tsm.0 * tre.h.0 + tL.1 * tsm.1 * tre.h.1 + tL.2 * tsm.2 * tre.h.2 + tL.3 * tsm.3 * tre.h.3 + tL.4 * tsm.4 * tre.h.4 + tL.5 * tsm.5 * tre.h.5 + tL.6 * tsm.6 * tre.h.6 + tL.7 * tsm.7 * tre.h.7 + tL.8 * tsm.8 * tre.h.8 + tL.9 * tsm.9 * tre.h.9 + tL.10 * tsm.10 * tre.h.10 + tL.11 * tsm.11 * tre.h.11 + tL.12 * tsm.12 * tre.h.12 + tL.13 * tsm.13 * tre.h.13 + tL.14 * tsm.14 * tre.h.14 + tL.15 * tsm.15 * tre.h.15 - tl.h) < 0.003
    let tvs.B = abs(tB.0 * tsm.0 * tre.w.0 + tB.1 * tsm.1 * tre.w.1 + tB.2 * tsm.2 * tre.w.2 + tB.3 * tsm.3 * tre.w.3 + tB.4 * tsm.4 * tre.w.4 + tB.5 * tsm.5 * tre.w.5 + tB.6 * tsm.6 * tre.w.6 + tB.7 * tsm.7 * tre.w.7 + tB.8 * tsm.8 * tre.w.8 + tB.9 * tsm.9 * tre.w.9 + tB.10 * tsm.10 * tre.w.10 + tB.11 * tsm.11 * tre.w.11 + tB.12 * tsm.12 * tre.w.12 + tB.13 * tsm.13 * tre.w.13 + tB.14 * tsm.14 * tre.w.14 + tB.15 * tsm.15 * tre.w.15 - tl.w) < 0.003
    let tvs.T = abs(tT.0 * tsm.0 * tre.w.0 + tT.1 * tsm.1 * tre.w.1 + tT.2 * tsm.2 * tre.w.2 + tT.3 * tsm.3 * tre.w.3 + tT.4 * tsm.4 * tre.w.4 + tT.5 * tsm.5 * tre.w.5 + tT.6 * tsm.6 * tre.w.6 + tT.7 * tsm.7 * tre.w.7 + tT.8 * tsm.8 * tre.w.8 + tT.9 * tsm.9 * tre.w.9 + tT.10 * tsm.10 * tre.w.10 + tT.11 * tsm.11 * tre.w.11 + tT.12 * tsm.12 * tre.w.12 + tT.13 * tsm.13 * tre.w.13 + tT.14 * tsm.14 * tre.w.14 + tT.15 * tsm.15 * tre.w.15 - tl.w) < 0.003
    let tside = if(tvs.R, 1, if(tvs.L, 2, if(tvs.B, 3, if(tvs.T, 4, if(tv.R, 1, if(tv.L, 2, if(tv.B, 3, if(tv.T, 4, 0))))))))
    on change tre.n while tre.lv >= 0 {
        tre.side = tside
        repeat k in 0..16 {
            tre.w.$k = if((tre.side == 1 and tR.$k) or (tre.side == 2 and tL.$k), tre.w.$k + tl.w, tre.w.$k)
        }
        repeat k in 0..16 {
            tre.h.$k = if((tre.side == 3 and tB.$k) or (tre.side == 4 and tT.$k), tre.h.$k + tl.h, tre.h.$k)
        }
        repeat k in 0..16 {
            tre.x.$k = if(tre.side == 1 and tR.$k, tl.x, tre.x.$k)
        }
        repeat k in 0..16 {
            tre.y.$k = if(tre.side == 3 and tB.$k, tl.y, tre.y.$k)
        }
        // (The last one left in a group: back to the group around it.)
        tre.g.i = if(tl.cnt == 1 and tl.fw * tl.fh < 0.9999, tl.one, -1)
        tre.g.ox = if(tp.i >= 0, tre.ox[max(tp.i, 0)], 0)
        tre.g.oy = if(tp.i >= 0, tre.oy[max(tp.i, 0)], 0)
        tre.g.sx = if(tp.i >= 0, tre.sx[max(tp.i, 0)], 1)
        tre.g.sy = if(tp.i >= 0, tre.sy[max(tp.i, 0)], 1)
        tre.g.d = if(tp.i >= 0, tre.d[max(tp.i, 0)], 1)
        tre.g.fx = if(tp.i >= 0, tre.fx[max(tp.i, 0)], 0)
        tre.g.fy = if(tp.i >= 0, tre.fy[max(tp.i, 0)], 0)
        tre.g.fw = if(tp.i >= 0, tre.fw[max(tp.i, 0)], 1)
        tre.g.fh = if(tp.i >= 0, tre.fh[max(tp.i, 0)], 1)
        tre.ox[tre.g.i] = tre.g.ox
        tre.oy[tre.g.i] = tre.g.oy
        tre.sx[tre.g.i] = tre.g.sx
        tre.sy[tre.g.i] = tre.g.sy
        tre.d[tre.g.i] = tre.g.d
        tre.fx[tre.g.i] = tre.g.fx
        tre.fy[tre.g.i] = tre.g.fy
        tre.fw[tre.g.i] = tre.g.fw
        tre.fh[tre.g.i] = tre.g.fh
        tre.w[tre.lv] = 0
        tre.lv = -1
    }
    // A window that comes to a fractal monitor without a box: it halves the
    // one with the keyboard there (across its longer side), or the one it was
    // let go on, on that side; alone, it has all of the square.
    let tre.need[16]
    repeat k in 0..16 {
        tre.need[k] = win.$k.open and (win.$k.place >= 0 or win.$k.pending) and lay[max(win.$k.screen, 0)] == 7 and tre.w.$k < 0.001 and tre.bye.$k < 0.5
        // (One that came while another change was being made: when that one ends.)
        on change tre.need.$k + 100 * (tre.nw + 100 * tre.lv) while tre.need.$k and tre.nw < 0 and tre.lv < 0 {
            tre.nw = k
            tre.m = tre.m + 1
        }
    }
    let tn.s = win[max(tre.nw, 0)].screen
    let tn.p = win[max(tre.nw, 0)].pool
    let tm[16]
    repeat k in 0..16 {
        tm[k] = k != tre.nw and win.$k.open and win.$k.place >= 0 and tre.w.$k > 0.001 and tre.s.$k == tn.s and tre.p.$k == tn.p
    }
    let tn.first = -1
    repeat k in 0..16 {
        tn.first = if(tn.first < 0 and tm[k], k, tn.first)
    }
    let tn.dock = tre.dk.src == tre.nw and tre.dk.dst >= 0 and tm[max(tre.dk.dst, 0)]
    let tn.t = if(tn.dock, tre.dk.dst, if(win.focus >= 0 and tm[max(win.focus, 0)], win.focus, tn.first))
    let tn.x = tre.x[max(tn.t, 0)]
    let tn.y = tre.y[max(tn.t, 0)]
    let tn.w = tre.w[max(tn.t, 0)]
    let tn.h = tre.h[max(tn.t, 0)]
    let tn.W = screen[max(tn.s, 0)].width
    let tn.H = screen[max(tn.s, 0)].height
    // 0 left · 1 right · 2 top · 3 bottom: where the new one goes in the one it halves.
    let tn.ox = tre.ox[max(tn.t, 0)]
    let tn.oy = tre.oy[max(tn.t, 0)]
    let tn.sx = tre.sx[max(tn.t, 0)]
    let tn.sy = tre.sy[max(tn.t, 0)]
    let tn.d = tre.d[max(tn.t, 0)]
    let tn.fx = tre.fx[max(tn.t, 0)]
    let tn.fy = tre.fy[max(tn.t, 0)]
    let tn.fw = tre.fw[max(tn.t, 0)]
    let tn.fh = tre.fh[max(tn.t, 0)]
    let tn.side = if(tn.dock, tre.dk.side, if(tn.w / max(tn.fw, 0.0001) * tn.W >= tn.h / max(tn.fh, 0.0001) * tn.H, 1, 3))
    on change tre.m while tre.nw >= 0 {
        tre.t = tn.t
        tre.side = tn.side
        tre.as = tn.s
        tre.ap = tn.p
        tre.grp = if(tn.dock and tre.dk.grp > 0.5 and tre.t >= 0, 1, 0)
        tre.g.fx = if(tre.grp > 0.5, tn.x, if(tre.t < 0, 0, tn.fx))
        tre.g.fy = if(tre.grp > 0.5, tn.y, if(tre.t < 0, 0, tn.fy))
        tre.g.fw = if(tre.grp > 0.5, tn.w, if(tre.t < 0, 1, tn.fw))
        tre.g.fh = if(tre.grp > 0.5, tn.h, if(tre.t < 0, 1, tn.fh))
        tre.g.d = if(tre.grp > 0.5, min(tn.sx * tn.w, tn.sy * tn.h), if(tre.t < 0, 1, tn.d))
        tre.g.sx = if(tre.grp > 0.5, tre.g.d / max(tn.w, 0.0001), if(tre.t < 0, 1, tn.sx))
        tre.g.sy = if(tre.grp > 0.5, tre.g.d / max(tn.h, 0.0001), if(tre.t < 0, 1, tn.sy))
        tre.g.ox = if(tre.grp > 0.5, tn.ox + tn.sx * (tn.x + (tn.w - tre.g.d / max(tn.sx, 0.0001)) / 2) - tn.x * tre.g.sx, if(tre.t < 0, 0, tn.ox))
        tre.g.oy = if(tre.grp > 0.5, tn.oy + tn.sy * (tn.y + (tn.h - tre.g.d / max(tn.sy, 0.0001)) / 2) - tn.y * tre.g.sy, if(tre.t < 0, 0, tn.oy))
        tre.ax = if(tre.t < 0, 0, if(tre.side == 1, tn.x + tn.w / 2, tn.x))
        tre.ay = if(tre.t < 0, 0, if(tre.side == 3, tn.y + tn.h / 2, tn.y))
        tre.aw = if(tre.t < 0, 1, if(tre.side < 1.5, tn.w / 2, tn.w))
        tre.ah = if(tre.t < 0, 1, if(tre.side > 1.5, tn.h / 2, tn.h))
        tre.bx = if(tre.side == 0, tn.x + tn.w / 2, tn.x)
        tre.by = if(tre.side == 2, tn.y + tn.h / 2, tn.y)
        tre.bw = if(tre.side < 1.5, tn.w / 2, tn.w)
        tre.bh = if(tre.side > 1.5, tn.h / 2, tn.h)
        // The one it halves keeps the other half; the new one takes its half.
        tre.x[tre.t] = tre.bx
        tre.y[tre.t] = tre.by
        tre.w[tre.t] = tre.bw
        tre.h[tre.t] = tre.bh
        tre.x[tre.nw] = tre.ax
        tre.y[tre.nw] = tre.ay
        tre.w[tre.nw] = tre.aw
        tre.h[tre.nw] = tre.ah
        tre.s[tre.nw] = tre.as
        tre.p[tre.nw] = tre.ap
        // Both through the new group's lens if they make one; the new one always.
        tre.ox[if(tre.grp > 0.5, tre.t, -1)] = tre.g.ox
        tre.ox[tre.nw] = tre.g.ox
        tre.oy[if(tre.grp > 0.5, tre.t, -1)] = tre.g.oy
        tre.oy[tre.nw] = tre.g.oy
        tre.sx[if(tre.grp > 0.5, tre.t, -1)] = tre.g.sx
        tre.sx[tre.nw] = tre.g.sx
        tre.sy[if(tre.grp > 0.5, tre.t, -1)] = tre.g.sy
        tre.sy[tre.nw] = tre.g.sy
        tre.d[if(tre.grp > 0.5, tre.t, -1)] = tre.g.d
        tre.d[tre.nw] = tre.g.d
        tre.fx[if(tre.grp > 0.5, tre.t, -1)] = tre.g.fx
        tre.fx[tre.nw] = tre.g.fx
        tre.fy[if(tre.grp > 0.5, tre.t, -1)] = tre.g.fy
        tre.fy[tre.nw] = tre.g.fy
        tre.fw[if(tre.grp > 0.5, tre.t, -1)] = tre.g.fw
        tre.fw[tre.nw] = tre.g.fw
        tre.fh[if(tre.grp > 0.5, tre.t, -1)] = tre.g.fh
        tre.fh[tre.nw] = tre.g.fh
        tre.dk.grp = if(tre.dk.src == tre.nw, 0, tre.dk.grp)
        tre.dk.src = if(tre.dk.src == tre.nw, -1, tre.dk.src)
        accept win(tre.nw)
        tre.nw = -1
    }
    // A monitor that becomes fractal starts as columns, in their order; and so
    // again if its square ever has a hole or an overlap (two windows gone at
    // once), and the camera sees all of it.
    let tre.area[4]
    let tre.a = 0
    let tre.u = 0
    let tre.unset[4]
    repeat k in 0..4 {
        on change lay.$k while lay.$k == 7 {
            repeat j in 0..16 {
                tre.x.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), win.$j.place / max(win.$j.among, 1), tre.x.$j)
                tre.y.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.y.$j)
                tre.w.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1 / max(win.$j.among, 1), tre.w.$j)
                tre.h.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.h.$j)
                tre.s.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), k, tre.s.$j)
                tre.p.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), win.$j.pool, tre.p.$j)
                tre.ox.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.ox.$j)
                tre.oy.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.oy.$j)
                tre.sx.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.sx.$j)
                tre.sy.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.sy.$j)
                tre.d.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.d.$j)
                tre.fx.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.fx.$j)
                tre.fy.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.fy.$j)
                tre.fw.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.fw.$j)
                tre.fh.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.fh.$j)
            }
            cam.$k.x = 0
            cam.$k.y = 0
            cam.$k.w = 1
            cam.$k.h = 1
            cam.$k.m = 0
        }
        // How much of its square its boxes cover, and how many have none.
        tre.a = 0
        tre.u = 0
        repeat j in 0..16 {
            tre.a += (win.$j.open and win.$j.place >= 0 and win.$j.screen == k and win.$j.pool == win.pool.$k and tre.w.$j > 0.001 and tre.s.$j == k and tre.p.$j == win.pool.$k) * tre.w.$j * tre.h.$j
            tre.u += win.$j.open and win.$j.place >= 0 and win.$j.screen == k and tre.w.$j < 0.001
        }
        tre.area[k] = tre.a
        tre.unset[k] = tre.u
        on still tre.area.$k for 600ms while lay.$k == 7 and tre.unset.$k < 0.5 and tre.area.$k > 0.001 and abs(tre.area.$k - 1) > 0.02 and tre.lv < 0 and tre.nw < 0 {
            repeat j in 0..16 {
                tre.x.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), win.$j.place / max(win.$j.among, 1), tre.x.$j)
                tre.y.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.y.$j)
                tre.w.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1 / max(win.$j.among, 1), tre.w.$j)
                tre.h.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.h.$j)
                tre.s.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), k, tre.s.$j)
                tre.p.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), win.$j.pool, tre.p.$j)
                tre.ox.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.ox.$j)
                tre.oy.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.oy.$j)
                tre.sx.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.sx.$j)
                tre.sy.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.sy.$j)
                tre.d.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.d.$j)
                tre.fx.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.fx.$j)
                tre.fy.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 0, tre.fy.$j)
                tre.fw.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.fw.$j)
                tre.fh.$j = if((win.$j.open and win.$j.place >= 0 and win.$j.screen == k), 1, tre.fh.$j)
            }
            cam.$k.x = 0
            cam.$k.y = 0
            cam.$k.w = 1
            cam.$k.h = 1
            cam.$k.m = 0
        }
    }
    // ── zoom: in a fractal monitor, into the one with the keyboard or its
    // group (it fills the screen) and out to all of the square; Super and the
    // wheel, anywhere, at the pointer. In any other, zooming out
    // is everything at a glance, and zooming in leaves it. (Super+-/+ zoom
    // a fractal monitor; a pinch of three fingers zooms anywhere.) ──
    event zoom_in
    event zoom_out
    let zf = win.focus >= 0 and lay[max(fscreen, 0)] == 7 and free[max(fscreen, 0)] < 0.5
    let zf.x = pick(max(win.focus, 0), tre.ox.0 + tre.sx.0 * tre.x.0, tre.ox.1 + tre.sx.1 * tre.x.1, tre.ox.2 + tre.sx.2 * tre.x.2, tre.ox.3 + tre.sx.3 * tre.x.3, tre.ox.4 + tre.sx.4 * tre.x.4, tre.ox.5 + tre.sx.5 * tre.x.5, tre.ox.6 + tre.sx.6 * tre.x.6, tre.ox.7 + tre.sx.7 * tre.x.7, tre.ox.8 + tre.sx.8 * tre.x.8, tre.ox.9 + tre.sx.9 * tre.x.9, tre.ox.10 + tre.sx.10 * tre.x.10, tre.ox.11 + tre.sx.11 * tre.x.11, tre.ox.12 + tre.sx.12 * tre.x.12, tre.ox.13 + tre.sx.13 * tre.x.13, tre.ox.14 + tre.sx.14 * tre.x.14, tre.ox.15 + tre.sx.15 * tre.x.15)
    let zf.y = pick(max(win.focus, 0), tre.oy.0 + tre.sy.0 * tre.y.0, tre.oy.1 + tre.sy.1 * tre.y.1, tre.oy.2 + tre.sy.2 * tre.y.2, tre.oy.3 + tre.sy.3 * tre.y.3, tre.oy.4 + tre.sy.4 * tre.y.4, tre.oy.5 + tre.sy.5 * tre.y.5, tre.oy.6 + tre.sy.6 * tre.y.6, tre.oy.7 + tre.sy.7 * tre.y.7, tre.oy.8 + tre.sy.8 * tre.y.8, tre.oy.9 + tre.sy.9 * tre.y.9, tre.oy.10 + tre.sy.10 * tre.y.10, tre.oy.11 + tre.sy.11 * tre.y.11, tre.oy.12 + tre.sy.12 * tre.y.12, tre.oy.13 + tre.sy.13 * tre.y.13, tre.oy.14 + tre.sy.14 * tre.y.14, tre.oy.15 + tre.sy.15 * tre.y.15)
    let zf.w = pick(max(win.focus, 0), tre.sx.0 * tre.w.0, tre.sx.1 * tre.w.1, tre.sx.2 * tre.w.2, tre.sx.3 * tre.w.3, tre.sx.4 * tre.w.4, tre.sx.5 * tre.w.5, tre.sx.6 * tre.w.6, tre.sx.7 * tre.w.7, tre.sx.8 * tre.w.8, tre.sx.9 * tre.w.9, tre.sx.10 * tre.w.10, tre.sx.11 * tre.w.11, tre.sx.12 * tre.w.12, tre.sx.13 * tre.w.13, tre.sx.14 * tre.w.14, tre.sx.15 * tre.w.15)
    let zf.h = pick(max(win.focus, 0), tre.sy.0 * tre.h.0, tre.sy.1 * tre.h.1, tre.sy.2 * tre.h.2, tre.sy.3 * tre.h.3, tre.sy.4 * tre.h.4, tre.sy.5 * tre.h.5, tre.sy.6 * tre.h.6, tre.sy.7 * tre.h.7, tre.sy.8 * tre.h.8, tre.sy.9 * tre.h.9, tre.sy.10 * tre.h.10, tre.sy.11 * tre.h.11, tre.sy.12 * tre.h.12, tre.sy.13 * tre.h.13, tre.sy.14 * tre.h.14, tre.sy.15 * tre.h.15)
    // (Its group, as seen: a small screen `d` across.)
    let zf.gd = tre.d[max(win.focus, 0)]
    let zf.g = zf.gd < 0.999
    let zf.gx = pick(max(win.focus, 0), tre.ox.0 + tre.sx.0 * tre.fx.0, tre.ox.1 + tre.sx.1 * tre.fx.1, tre.ox.2 + tre.sx.2 * tre.fx.2, tre.ox.3 + tre.sx.3 * tre.fx.3, tre.ox.4 + tre.sx.4 * tre.fx.4, tre.ox.5 + tre.sx.5 * tre.fx.5, tre.ox.6 + tre.sx.6 * tre.fx.6, tre.ox.7 + tre.sx.7 * tre.fx.7, tre.ox.8 + tre.sx.8 * tre.fx.8, tre.ox.9 + tre.sx.9 * tre.fx.9, tre.ox.10 + tre.sx.10 * tre.fx.10, tre.ox.11 + tre.sx.11 * tre.fx.11, tre.ox.12 + tre.sx.12 * tre.fx.12, tre.ox.13 + tre.sx.13 * tre.fx.13, tre.ox.14 + tre.sx.14 * tre.fx.14, tre.ox.15 + tre.sx.15 * tre.fx.15)
    let zf.gy = pick(max(win.focus, 0), tre.oy.0 + tre.sy.0 * tre.fy.0, tre.oy.1 + tre.sy.1 * tre.fy.1, tre.oy.2 + tre.sy.2 * tre.fy.2, tre.oy.3 + tre.sy.3 * tre.fy.3, tre.oy.4 + tre.sy.4 * tre.fy.4, tre.oy.5 + tre.sy.5 * tre.fy.5, tre.oy.6 + tre.sy.6 * tre.fy.6, tre.oy.7 + tre.sy.7 * tre.fy.7, tre.oy.8 + tre.sy.8 * tre.fy.8, tre.oy.9 + tre.sy.9 * tre.fy.9, tre.oy.10 + tre.sy.10 * tre.fy.10, tre.oy.11 + tre.sy.11 * tre.fy.11, tre.oy.12 + tre.sy.12 * tre.fy.12, tre.oy.13 + tre.sy.13 * tre.fy.13, tre.oy.14 + tre.sy.14 * tre.fy.14, tre.oy.15 + tre.sy.15 * tre.fy.15)
    // In: into its group first (if it is in one and the camera sees more),
    // then into it alone. Out: from it to its group, then twice as far each
    // time. The camera follows the keyboard while on a group or a window.
    repeat j in 0..4 {
        on zoom_in while zf and fscreen == j and zf.w > 0.001 {
            zi.g = if(zf.g and cam.$j.m < 1.5 and max(cam.$j.w, cam.$j.h) > zf.gd + 0.001, 1, 0)
            cam.$j.x = if(zi.g > 0.5, zf.gx, zf.x)
            cam.$j.y = if(zi.g > 0.5, zf.gy, zf.y)
            cam.$j.w = if(zi.g > 0.5, zf.gd, zf.w)
            cam.$j.h = if(zi.g > 0.5, zf.gd, zf.h)
            cam.$j.m = if(zi.g > 0.5, 1, 2)
        }
        on zoom_out while zf and fscreen == j {
            zi.g = if(cam.$j.m > 1.5 and zf.g, 1, 0)
            zi.b = min(1, max(cam.$j.w, cam.$j.h) * 2)
            cam.$j.x = if(zi.g > 0.5, zf.gx, clamp(cam.$j.x + cam.$j.w / 2 - zi.b / 2, 0, 1 - zi.b))
            cam.$j.y = if(zi.g > 0.5, zf.gy, clamp(cam.$j.y + cam.$j.h / 2 - zi.b / 2, 0, 1 - zi.b))
            cam.$j.w = if(zi.g > 0.5, zf.gd, zi.b)
            cam.$j.h = if(zi.g > 0.5, zf.gd, zi.b)
            cam.$j.m = if(zi.g > 0.5, 1, 0)
        }
        on change win.focus while zf and fscreen == j and cam.$j.m > 0.5 and zf.w > 0.001 {
            zi.g = if(cam.$j.m < 1.5 and zf.g, 1, 0)
            cam.$j.x = if(zi.g > 0.5, zf.gx, zf.x)
            cam.$j.y = if(zi.g > 0.5, zf.gy, zf.y)
            cam.$j.w = if(zi.g > 0.5, zf.gd, zf.w)
            cam.$j.h = if(zi.g > 0.5, zf.gd, zf.h)
            cam.$j.m = if(zi.g > 0.5, 1, 2)
        }
        // Super and the wheel: closer or further, keeping the point under the
        // pointer where it is.
        on change zw.n while zw.k == j and lay.$j == 7 and free.$j < 0.5 {
            zi.b = clamp(max(cam.$j.w, cam.$j.h) * if(zw.d > 0, 1 / (1 + 0.2 * zw.d), 1 - 0.2 * zw.d), 0.04, 1)
            zi.w = if(zi.b > 0.999, 1, min(1, cam.$j.w * zi.b / max(cam.$j.w, cam.$j.h)))
            zi.h = if(zi.b > 0.999, 1, min(1, cam.$j.h * zi.b / max(cam.$j.w, cam.$j.h)))
            cam.$j.x = clamp(zw.x - (zw.x - cam.$j.x) * zi.w / max(cam.$j.w, 0.0001), 0, 1 - zi.w)
            cam.$j.y = clamp(zw.y - (zw.y - cam.$j.y) * zi.h / max(cam.$j.h, 0.0001), 0, 1 - zi.h)
            cam.$j.w = zi.w
            cam.$j.h = zi.h
            cam.$j.m = 0
        }
        on still cam.$j.w for 250ms {
            camr.$j.w = cam.$j.w
            camr.$j.h = cam.$j.h
        }
        on still cam.$j.h for 250ms {
            camr.$j.w = cam.$j.w
            camr.$j.h = cam.$j.h
        }
    }
    // On a canvas (the monitor under the mouse): its camera, about its middle.
    let zc = cv[mon] > 0.5 and free[mon] > 0.5
    on zoom_out while not zf and not zc { overview = true }
    on zoom_in while not zf and not zc { overview = false }
    on zoom_in while zc {
        cvw.k = mon
        cvw.d = 2
        cvw.x = mg.x0 + mg.Ws / 2
        cvw.y = mg.y0 + mg.ah / 2
        cvw.n = cvw.n + 1
    }
    on zoom_out while zc {
        cvw.k = mon
        cvw.d = -2
        cvw.x = mg.x0 + mg.Ws / 2
        cvw.y = mg.y0 + mg.ah / 2
        cvw.n = cvw.n + 1
    }
    fact magnet = 0
    fact mg.cz = 1
    // (The canvas's magnets: the one let go, its box on the plane, and the
    // nearest offer so far each way.)
    fact cvs.i = -1
    fact cvs.n = 0
    fact cvs.ax = 0
    fact cvs.ay = 0
    fact cvs.aw = 0
    fact cvs.ah = 0
    fact cvs.dx = 0
    fact cvs.dy = 0
    fact cvs.bx = 0
    fact cvs.by = 0
    prop cvs.go = 0 ~0ms
    // «marea»: how much each window has been used lately, 0 to 2: each time
    // the keyboard goes to one, it grows and the rest ebb a little.
    repeat k in 0..16 {
        fact use.$k = 0
    }
    on change win.focus while win.focus >= 0 {
        repeat j in 0..16 {
            use.$j = min(2, use.$j * 0.9 + 0.35 * (win.focus == j))
        }
    }
    let mw[16]
    repeat j in 0..16 {
        mw[j] = 1 + use.$j + 1.6 * (win.focus == j)
    }
    on change mag {
        magnet = mag
    }
    // Where each one puts it.
    let mg.hw = (mg.Ws - 3 * gap) / 2
    let mg.qh = (mg.ah - gap) / 2
    let mg.x = mg.x0 + pick(mag, gap, gap, gap, gap, gap, gap, 2 * gap + mg.hw, 2 * gap + mg.hw)
    let mg.y = mg.y0 + pick(mag, 0, 0, 0, 0, 0, mg.qh + gap, 0, mg.qh + gap)
    let mg.w = pick(mag, 0, mg.hw, mg.hw, mg.Ws - 2 * gap, mg.hw, mg.hw, mg.hw, mg.hw)
    let mg.h = pick(mag, 0, mg.ah, mg.ah, mg.ah, mg.qh, mg.qh, mg.qh, mg.qh)
    prop mgo = 0 ~160ms
    follow mgo = if(mag > 0, 1, 0)
    prop mgx = 0 ~glide
    prop mgy = 0 ~glide
    prop mgw = 0 ~glide
    prop mgh = 0 ~glide
    follow mgx = if(mag > 0, mg.x, mouse.x)
    follow mgy = if(mag > 0, mg.y, mouse.y)
    follow mgw = if(mag > 0, mg.w, 0)
    follow mgh = if(mag > 0, mg.h, 0)

    // ── carrying a window: how the others would be if it were let go here ──
    // Its monitor and place; each window's turn in the order of all of them.
    let dsc = win[max(dragging, 0)].screen
    let dplace = max(win[max(dragging, 0)].place, 0)
    let ordD = win[max(dragging, 0)].rank
    // Over the other monitor it would go there: there they make room for it,
    // and on its own the rest close up. Its turn there is its turn in the
    // order; first, if it is let go on a layout with a leader.
    let crossing = dragging >= 0 and mon != dsc and not dfl
    let landing.place = if(leads, 0, (win.0.open and win.0.screen == mon and win.0.rank >= 0 and win.0.rank < ordD) + (win.1.open and win.1.screen == mon and win.1.rank >= 0 and win.1.rank < ordD) + (win.2.open and win.2.screen == mon and win.2.rank >= 0 and win.2.rank < ordD) + (win.3.open and win.3.screen == mon and win.3.rank >= 0 and win.3.rank < ordD) + (win.4.open and win.4.screen == mon and win.4.rank >= 0 and win.4.rank < ordD) + (win.5.open and win.5.screen == mon and win.5.rank >= 0 and win.5.rank < ordD) + (win.6.open and win.6.screen == mon and win.6.rank >= 0 and win.6.rank < ordD) + (win.7.open and win.7.screen == mon and win.7.rank >= 0 and win.7.rank < ordD) + (win.8.open and win.8.screen == mon and win.8.rank >= 0 and win.8.rank < ordD) + (win.9.open and win.9.screen == mon and win.9.rank >= 0 and win.9.rank < ordD) + (win.10.open and win.10.screen == mon and win.10.rank >= 0 and win.10.rank < ordD) + (win.11.open and win.11.screen == mon and win.11.rank >= 0 and win.11.rank < ordD) + (win.12.open and win.12.screen == mon and win.12.rank >= 0 and win.12.rank < ordD) + (win.13.open and win.13.screen == mon and win.13.rank >= 0 and win.13.rank < ordD) + (win.14.open and win.14.screen == mon and win.14.rank >= 0 and win.14.rank < ordD) + (win.15.open and win.15.screen == mon and win.15.rank >= 0 and win.15.rank < ordD))
    let landing.n = win.on[mon] + 1
    let landing.lay = if(picked >= 0 and picked < 8, picked, lay.here)
    // A window fullscreen on the monitor under the mouse: the ones below it keep off the keyboard.
    let fs.on = (win.0.fullscreen and win.0.screen == mon and win.0.rank >= 0) + (win.1.fullscreen and win.1.screen == mon and win.1.rank >= 0) + (win.2.fullscreen and win.2.screen == mon and win.2.rank >= 0) + (win.3.fullscreen and win.3.screen == mon and win.3.rank >= 0) + (win.4.fullscreen and win.4.screen == mon and win.4.rank >= 0) + (win.5.fullscreen and win.5.screen == mon and win.5.rank >= 0) + (win.6.fullscreen and win.6.screen == mon and win.6.rank >= 0) + (win.7.fullscreen and win.7.screen == mon and win.7.rank >= 0) + (win.8.fullscreen and win.8.screen == mon and win.8.rank >= 0) + (win.9.fullscreen and win.9.screen == mon and win.9.rank >= 0) + (win.10.fullscreen and win.10.screen == mon and win.10.rank >= 0) + (win.11.fullscreen and win.11.screen == mon and win.11.rank >= 0) + (win.12.fullscreen and win.12.screen == mon and win.12.rank >= 0) + (win.13.fullscreen and win.13.screen == mon and win.13.rank >= 0) + (win.14.fullscreen and win.14.screen == mon and win.14.rank >= 0) + (win.15.fullscreen and win.15.screen == mon and win.15.rank >= 0)
    // Whether each window is maximized while tiled (see `maximize`, further down).
    repeat k in 0..16 {
        fact tmax.$k = 0
    }
    // And one maximized (`maximize`) over its monitor: the ones beneath it are
    // covered, and the mouse going over where they are is not going to them
    // (it took the keyboard, and the maximized one went back to its tile).
    let max.on = (tmax.0 > 0.5 and win.0.screen == mon and win.0.rank >= 0 and not win.0.fullscreen and not win.0.minimized) + (tmax.1 > 0.5 and win.1.screen == mon and win.1.rank >= 0 and not win.1.fullscreen and not win.1.minimized) + (tmax.2 > 0.5 and win.2.screen == mon and win.2.rank >= 0 and not win.2.fullscreen and not win.2.minimized) + (tmax.3 > 0.5 and win.3.screen == mon and win.3.rank >= 0 and not win.3.fullscreen and not win.3.minimized) + (tmax.4 > 0.5 and win.4.screen == mon and win.4.rank >= 0 and not win.4.fullscreen and not win.4.minimized) + (tmax.5 > 0.5 and win.5.screen == mon and win.5.rank >= 0 and not win.5.fullscreen and not win.5.minimized) + (tmax.6 > 0.5 and win.6.screen == mon and win.6.rank >= 0 and not win.6.fullscreen and not win.6.minimized) + (tmax.7 > 0.5 and win.7.screen == mon and win.7.rank >= 0 and not win.7.fullscreen and not win.7.minimized) + (tmax.8 > 0.5 and win.8.screen == mon and win.8.rank >= 0 and not win.8.fullscreen and not win.8.minimized) + (tmax.9 > 0.5 and win.9.screen == mon and win.9.rank >= 0 and not win.9.fullscreen and not win.9.minimized) + (tmax.10 > 0.5 and win.10.screen == mon and win.10.rank >= 0 and not win.10.fullscreen and not win.10.minimized) + (tmax.11 > 0.5 and win.11.screen == mon and win.11.rank >= 0 and not win.11.fullscreen and not win.11.minimized) + (tmax.12 > 0.5 and win.12.screen == mon and win.12.rank >= 0 and not win.12.fullscreen and not win.12.minimized) + (tmax.13 > 0.5 and win.13.screen == mon and win.13.rank >= 0 and not win.13.fullscreen and not win.13.minimized) + (tmax.14 > 0.5 and win.14.screen == mon and win.14.rank >= 0 and not win.14.fullscreen and not win.14.minimized) + (tmax.15 > 0.5 and win.15.screen == mon and win.15.rank >= 0 and not win.15.fullscreen and not win.15.minimized)

    // ── pools: each monitor has its own, one below the other, as tide
    // pools are left along a shore. There are as many as hold windows, and
    // one more, empty, past the last; one left empty dries up and the ones
    // below move up. Super+1…9 shows that one on the monitor under the
    // mouse (no further than the empty one), Super+Shift+1…9 sends the window
    // with the keyboard there, Super+Ctrl+Up/Down goes to the one above or
    // below, and Super+Ctrl+Shift+Left/Right carries the whole pool to the
    // monitor beside. Changing, a wave crosses the monitor: in from below
    // going down the stack, from above going up; the windows change when the
    // water covers them all ──
    event workspace
    event move_to_workspace
    event workspace_next
    event workspace_previous
    event workspace_to_left
    event workspace_to_right
    on workspace(v) { workspace v }
    on move_to_workspace(v) while win.focus >= 0 { send win(win.focus) to workspace v }
    let ws.mon = win.shown[mon]
    let ws.last = win.used[mon] + 1
    on workspace_next { workspace min(ws.mon + 1, ws.last) }
    on workspace_previous { workspace max(ws.mon - 1, 1) }
    on workspace_to_right while mon < screens.count - 1 { send workspace ws.mon on mon to mon + 1 }
    on workspace_to_left while mon > 0 { send workspace ws.mon on mon to mon - 1 }
    // The pool each monitor draws (see below): it starts on its first one.
    fact inpool.0 = 1
    fact inpool.1 = 2
    fact inpool.2 = 3
    fact inpool.3 = 4
    repeat s in 0..4 {
        // The pool drawn: the one shown, once the water has covered the one
        // before it (each monitor starts on its own first one). By identity, not
        // by turn: when one above dries up and it moves up, nothing moves.
        fact was.$s = 1
        fact dir.$s = 1
        prop tide.$s = 1 ~620ms
        prop flash.$s = 0 ~180ms
        on change win.pool.$s {
            dir.$s = if(win.shown.$s >= was.$s, 1, -1)
            was.$s = win.shown.$s
            tide.$s: 0 ~0ms
            tide.$s: 1 ~620ms after 16ms
            flash.$s: 1 ~140ms
            flash.$s: 0 ~420ms after 1200ms
        }
        on change win.shown.$s { was.$s = win.shown.$s }
        on change tide.$s > 0.5 while tide.$s > 0.5 { inpool.$s = win.pool.$s }
        on still tide.$s for 60ms while tide.$s > 0.98 and inpool.$s != win.pool.$s { inpool.$s = win.pool.$s }

        // The wave: black water, the same the windows are born from, with a
        // rolling crest on each side that melts into it, and its own rim of
        // light, as Marea's edge has.
        let wv = tide.$s
        //  Its back edge leaves before the spring's slow end (by 0.88): the
        //  spring already eases it out, and the two easings together had it
        //  crawling the last stretch.
        let lead = smooth(0, 0.5, wv)
        let trail = smooth(0.5, 0.88, wv)
        //  Both edges go all the way across, from past one side to past the
        //  other (`reach`: what its crests, its blend and its shadow stick
        //  out): it leaves the monitor whole while still moving, and the
        //  slow end of the spring happens out of sight. It ran up to the edge
        //  instead, and shrank there, a strip of crests standing still until
        //  `show` took it away.
        let reach = 160
        let top = if(dir.$s > 0, H + reach - (H + 2 * reach) * lead, (H + 2 * reach) * trail - reach)
        let bot = if(dir.$s > 0, H + reach - (H + 2 * reach) * trail, (H + 2 * reach) * lead - reach)
        let crest = W / 7
        group {
            z: 99980
            show: wv < 0.999 and screen.index == s and bot - top > 0.5 and bot > -reach and top < H + reach
            body {
                gradient: 0, top to 0, bot, #121517, #0c0e10 35%, #0a0b0d
                rim: 14%
                shadow: 0, 0, 36, 45%
                box { from: -60, top; size: W + 120, bot - top }
                // Its crests, rolling along as it goes.
                ellipse { at: (0 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(0 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (0 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(0 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (1 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(73 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (1 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(73 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (2 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(146 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (2 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(146 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (3 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(219 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (3 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(219 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (4 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(292 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (4 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(292 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (5 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(365 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (5 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(365 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (6 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(438 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (6 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(438 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (7 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(511 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (7 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(511 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
                ellipse { at: (8 - 0.5 + wv * 1.4) * W / 7.5, top; radius: crest; scale: 1, (0.16 + 0.1 * sin(584 + wv * 320)) * min((bot - top) / 90, 1); blend: 46; show: top > -crest }
                ellipse { at: (8 - 0.5 + wv * 1.4) * W / 7.5 + crest * 0.5, bot; radius: crest; scale: 1, (0.26 - (0.16 + 0.1 * sin(584 + wv * 320))) * min((bot - top) / 90, 1); blend: 46; show: bot < H + crest }
            }
        }

        // Where you are: a capsule at the right edge, a dot per pool —the
        // empty ones a ring— and the one shown drawn out, sliding to it.
        let nd = max(win.pools.$s, win.used.$s + 1)
        let cur = win.shown.$s
        prop at.$s = 1 ~pop
        follow at.$s = cur
        let dy0 = H / 2 - (nd - 1) * 9
        group {
            z: 99990
            show: flash.$s > 0.01 and screen.index == s
            opacity: flash.$s
            move: 12 * (1 - flash.$s), 0
            body {
                color: #0c0e10
                rim: 10%
                shadow: 0, 8, 24, 45%
                box { at: W - 28, H / 2; size: 24, nd * 18 + 14; corner: 12 }
            }
            repeat j in 0..10 {
                ellipse { at: W - 28, dy0 + (18 * j); radius: 3; color: ink; opacity: 45%; show: (j + 1) <= nd and not ((j + 1) == nd and win.used.$s < (j + 1) or (j + 1) == cur and win.used.$s < win.pools.$s) }
                ellipse { at: W - 28, dy0 + (18 * j); radius: 3; stroke: 1.2; color: ink; opacity: 45%; show: (j + 1) <= nd and ((j + 1) == nd and win.used.$s < (j + 1) or (j + 1) == cur and win.used.$s < win.pools.$s) }
            }
            box { at: W - 28, dy0 + (at.$s - 1) * 18; size: 6, 15; corner: 3; color: mint }
        }
    }

    // ── the shore: the dock of a free monitor. When a monitor goes free, the
    // water rises at its edge and leaves the shore there, joined to it by a
    // neck, as Marea hangs from hers at the top: the programs pinned (`dock …`
    // in session.conf) and the others with windows on the pool shown, each
    // with a drop per window under it (mint, the one with the keyboard); the
    // windows put away, floating as they are; and the pools of the monitor,
    // last. Hovering, the icons rise like buoys on a passing wave —or swell,
    // the nearest most, with magnification—; pressed, one dips and rings the
    // water, and while its program starts it hops. Tiled, there is no shore,
    // and nothing is put away.
    // How it behaves is the control centre's (`dock-style …` in
    // session.conf, given here at the start as facts): hidden until the mouse
    // is pushed against its edge, magnified, with or without the drops, the
    // windows put away into their program's icon, its size, and which edge
    // —bottom, left or right—. ──
    spring rise = 190, 20
    fact dock.hide = 0
    fact dock.mag = 0
    fact dock.dots = 1
    fact dock.into = 0
    fact dock.size = 44
    fact dock.side = 0                   // 0 bottom · 1 left · 2 right
    // An icon, the room it has along the shore, the shore across, the room
    // of a window put away; and how much the one under the mouse swells.
    let dkic = clamp(dock.size, 32, 72)
    let dkf = dkic / 44
    let dkcell = dkic + 16
    let dkpl = dkic + 20
    let dkmc = dkic + 32
    let dkvert = dock.side > 0.5
    let dklift = if(dock.mag > 0.5, 0.75, 0)
    let dkreach = dkcell * 2.6

    // Each monitor's shore.
    // What the rest of the scene reads of it: where it is, across and along.
    let dk.a0[4]
    let dk.cr[4]
    let dk.cs[4]
    let dk.K[4]
    let dk.ma[4]
    let dk.q[4]
    let mn.x[4]
    let mn.y[4]
    let pv.bx[4]
    let pv.by[4]
    let pv.n[4]
    let pv.ox[4]
    let pv.oy[4]
    let pv.sx[4]
    repeat s in 0..4 {
        // Shown while the monitor is free, unless it hides: then while the
        // mouse pushes against its edge, or its menu, previews or a carried icon
        // are out. What it keeps clear for the windows, only when it does not hide.
        prop shore.$s = 0 ~rise
        follow shore.$s = if(free.$s > 0.5 and (dock.hide < 0.5 or dk.open.$s or dmenu.$s >= 0 or pv.$s >= 0 or dkdrag.$s >= 0), 1, 0)
        prop room.$s = 0 ~rise
        follow room.$s = if(free.$s > 0.5 and dock.hide < 0.5, 1, 0)
        fact dk.open.$s = false
        // The item being carried out of it, the one whose windows rise from the
        // water, the one whose menu is open (and the one it was for).
        fact dkdrag.$s = -1
        fact pv.$s = -1
        fact dmenu.$s = -1
        fact dmk.$s = 0
        fact poofx.$s = 0
        fact poofy.$s = 0
        prop poof.$s = 1 ~700ms
        prop pvup.$s = 0 ~pop
        follow pvup.$s = if(pv.$s >= 0, 1, 0)
        prop mnup.$s = 0 ~pop
        follow mnup.$s = if(dmenu.$s >= 0, 1, 0)
        let dk.n.$s = win.docks.$s
        let dk.m.$s = if(dock.into > 0.5, 0, win.mins.$s)
        let dk.p.$s = max(win.pools.$s, win.used.$s + 1)
        let dk.tw.$s = 28 + dk.n.$s * dkcell + if(dk.m.$s > 0, 20 + dk.m.$s * dkmc, 0) + 20 + dk.p.$s * 26
        prop dkw.$s = 200 ~pop
        follow dkw.$s = dk.tw.$s
        // Across: a point `q` out from its edge is at dk.cr + dk.cs · q, in x on
        // a side and in y at the bottom. Along: from dk.a0, centred.
        dk.cr[s] = if(dock.side == 1, 0, if(dock.side == 2, screen.$s.width, screen.$s.height))
        dk.cs[s] = if(dock.side == 1, 1, -1)
        dk.a0[s] = if(dkvert, screen.$s.height, screen.$s.width) / 2 - dkw.$s / 2
        dk.q[s] = 0 - (dkpl / 2 + 10) + (dkpl + 24) * shore.$s
        // Where the mouse is along it and how far from its edge.
        dk.ma[s] = if(dkvert, mouse.y, mouse.x)
        let dk.mq.$s = if(dock.side == 1, mouse.x, if(dock.side == 2, screen.$s.width - mouse.x, screen.$s.height - mouse.y))
        // Magnified, how much the icons before a point have moved aside, and
        // how much longer the whole shore is.
        prop dk.near.$s = 0 ~180ms
        dk.K[s] = dk.near.$s * dklift * dkic * dkreach / dkcell
        let dk.grow.$s = dk.K.$s * 2 / 3
        let dk.on.$s = mon == s and shore.$s > 0.6 and dk.mq.$s <= dk.q.$s + dkpl / 2 + 6 and dk.ma.$s >= dk.a0.$s - dk.grow.$s / 2 - 10 and dk.ma.$s <= dk.a0.$s + dkw.$s + dk.grow.$s / 2 + 10
        follow dk.near.$s = if(dk.on.$s and dkdrag.$s < 0, 1, 0)
        let dk.t.$s = (dk.ma.$s - dk.a0.$s - 14) / dkcell - 0.5
        let dk.hk.$s = clamp(floor(dk.t.$s + 0.5), 0, 11)
        // Hidden, it comes out while the mouse is pushed against its edge, and
        // goes once the mouse has left it (not while one of its menus is out).
        on change mouse.x + mouse.y * 8192 while dock.hide > 0.5 and not dk.open.$s and free.$s > 0.5 and mon == s and dk.mq.$s <= 2 and dragging < 0 { dk.open.$s = true }
        on change mouse.x + mouse.y * 8192 while dk.open.$s and (mon != s or dk.mq.$s > dk.q.$s + dkpl / 2 + 60) and dmenu.$s < 0 and pv.$s < 0 and dkdrag.$s < 0 { dk.open.$s = false }
        on change dock.hide while dock.hide < 0.5 { dk.open.$s = false }
        image dockicon.$s.0 = from win.dock.$s.0.icon, 96, 96
        prop buoy.$s.0 = 0 ~pop
        follow buoy.$s.0 = if(dk.on.$s and dock.mag < 0.5, pow(max(0, 1 - abs(0 - dk.t.$s) / 1.8), 2), 0)
        prop here.$s.0 = 0 ~pop
        follow here.$s.0 = if(0 < dk.n.$s, 1, 0)
        prop ring.$s.0 = 1 ~760ms
        prop hop.$s.0 = 0 ~560ms
        follow hop.$s.0 = 0
        fact hops.$s.0 = 0
        let dka0.c.$s = dk.a0.$s + 14 + 0 * dkcell + dkcell / 2
        let dka0.d.$s = (dka0.c.$s - dk.ma.$s) / dkreach
        let dka0.$s = dka0.c.$s + dk.K.$s * (if(dka0.d.$s < -1, 0, if(dka0.d.$s < 0, pow(1 + dka0.d.$s, 3) / 3, if(dka0.d.$s < 1, (2 - pow(1 - dka0.d.$s, 3)) / 3, 2 / 3))) - 1 / 3)
        let dksz0.$s = dkic * (1 + dklift * dk.near.$s * pow(max(0, 1 - abs(dka0.d.$s)), 2)) * (1 + 0.14 * buoy.$s.0)
        let dkiq0.$s = dk.q.$s + 3 + 12 * buoy.$s.0 + (dksz0.$s - dkic) * 0.55 + 104 * dkf * hop.$s.0 * (1 - hop.$s.0)
        image dockicon.$s.1 = from win.dock.$s.1.icon, 96, 96
        prop buoy.$s.1 = 0 ~pop
        follow buoy.$s.1 = if(dk.on.$s and dock.mag < 0.5, pow(max(0, 1 - abs(1 - dk.t.$s) / 1.8), 2), 0)
        prop here.$s.1 = 0 ~pop
        follow here.$s.1 = if(1 < dk.n.$s, 1, 0)
        prop ring.$s.1 = 1 ~760ms
        prop hop.$s.1 = 0 ~560ms
        follow hop.$s.1 = 0
        fact hops.$s.1 = 0
        let dka1.c.$s = dk.a0.$s + 14 + 1 * dkcell + dkcell / 2
        let dka1.d.$s = (dka1.c.$s - dk.ma.$s) / dkreach
        let dka1.$s = dka1.c.$s + dk.K.$s * (if(dka1.d.$s < -1, 0, if(dka1.d.$s < 0, pow(1 + dka1.d.$s, 3) / 3, if(dka1.d.$s < 1, (2 - pow(1 - dka1.d.$s, 3)) / 3, 2 / 3))) - 1 / 3)
        let dksz1.$s = dkic * (1 + dklift * dk.near.$s * pow(max(0, 1 - abs(dka1.d.$s)), 2)) * (1 + 0.14 * buoy.$s.1)
        let dkiq1.$s = dk.q.$s + 3 + 12 * buoy.$s.1 + (dksz1.$s - dkic) * 0.55 + 104 * dkf * hop.$s.1 * (1 - hop.$s.1)
        image dockicon.$s.2 = from win.dock.$s.2.icon, 96, 96
        prop buoy.$s.2 = 0 ~pop
        follow buoy.$s.2 = if(dk.on.$s and dock.mag < 0.5, pow(max(0, 1 - abs(2 - dk.t.$s) / 1.8), 2), 0)
        prop here.$s.2 = 0 ~pop
        follow here.$s.2 = if(2 < dk.n.$s, 1, 0)
        prop ring.$s.2 = 1 ~760ms
        prop hop.$s.2 = 0 ~560ms
        follow hop.$s.2 = 0
        fact hops.$s.2 = 0
        let dka2.c.$s = dk.a0.$s + 14 + 2 * dkcell + dkcell / 2
        let dka2.d.$s = (dka2.c.$s - dk.ma.$s) / dkreach
        let dka2.$s = dka2.c.$s + dk.K.$s * (if(dka2.d.$s < -1, 0, if(dka2.d.$s < 0, pow(1 + dka2.d.$s, 3) / 3, if(dka2.d.$s < 1, (2 - pow(1 - dka2.d.$s, 3)) / 3, 2 / 3))) - 1 / 3)
        let dksz2.$s = dkic * (1 + dklift * dk.near.$s * pow(max(0, 1 - abs(dka2.d.$s)), 2)) * (1 + 0.14 * buoy.$s.2)
        let dkiq2.$s = dk.q.$s + 3 + 12 * buoy.$s.2 + (dksz2.$s - dkic) * 0.55 + 104 * dkf * hop.$s.2 * (1 - hop.$s.2)
        image dockicon.$s.3 = from win.dock.$s.3.icon, 96, 96
        prop buoy.$s.3 = 0 ~pop
        follow buoy.$s.3 = if(dk.on.$s and dock.mag < 0.5, pow(max(0, 1 - abs(3 - dk.t.$s) / 1.8), 2), 0)
        prop here.$s.3 = 0 ~pop
        follow here.$s.3 = if(3 < dk.n.$s, 1, 0)
        prop ring.$s.3 = 1 ~760ms
        prop hop.$s.3 = 0 ~560ms
        follow hop.$s.3 = 0
        fact hops.$s.3 = 0
        let dka3.c.$s = dk.a0.$s + 14 + 3 * dkcell + dkcell / 2
        let dka3.d.$s = (dka3.c.$s - dk.ma.$s) / dkreach
        let dka3.$s = dka3.c.$s + dk.K.$s * (if(dka3.d.$s < -1, 0, if(dka3.d.$s < 0, pow(1 + dka3.d.$s, 3) / 3, if(dka3.d.$s < 1, (2 - pow(1 - dka3.d.$s, 3)) / 3, 2 / 3))) - 1 / 3)
        let dksz3.$s = dkic * (1 + dklift * dk.near.$s * pow(max(0, 1 - abs(dka3.d.$s)), 2)) * (1 + 0.14 * buoy.$s.3)
        let dkiq3.$s = dk.q.$s + 3 + 12 * buoy.$s.3 + (dksz3.$s - dkic) * 0.55 + 104 * dkf * hop.$s.3 * (1 - hop.$s.3)
        image dockicon.$s.4 = from win.dock.$s.4.icon, 96, 96
        prop buoy.$s.4 = 0 ~pop
        follow buoy.$s.4 = if(dk.on.$s and dock.mag < 0.5, pow(max(0, 1 - abs(4 - dk.t.$s) / 1.8), 2), 0)
