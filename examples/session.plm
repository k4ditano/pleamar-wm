            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.5.badge > 0 and 5 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq5.$s), dka5.$s) + 0.39 * dksz5.$s, if(dkvert, dka5.$s, dk.cr.$s + dk.cs.$s * (dkiq5.$s)) - 0.39 * dksz5.$s; radius: 8.5 }
                }
                text "{win.dock.$s.5.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq5.$s), dka5.$s) + 0.39 * dksz5.$s, if(dkvert, dka5.$s, dk.cr.$s + dk.cs.$s * (dkiq5.$s)) - 0.39 * dksz5.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            measure tip.$s.6
            group {
                show: dk.on.$s and dk.hk.$s == 6 and 6 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq6.$s + dksz6.$s / 2 + 14 + (tip.$s.6.width + 22) / 2), dka6.$s), if(dkvert, dka6.$s, dk.cr.$s + dk.cs.$s * (dkiq6.$s + dksz6.$s / 2 + 41)); size: (tip.$s.6.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.6.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq6.$s + dksz6.$s / 2 + 14 + (tip.$s.6.width + 22) / 2), dka6.$s), if(dkvert, dka6.$s, dk.cr.$s + dk.cs.$s * (dkiq6.$s + dksz6.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.6; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.6.badge > 0 and 6 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq6.$s), dka6.$s) + 0.39 * dksz6.$s, if(dkvert, dka6.$s, dk.cr.$s + dk.cs.$s * (dkiq6.$s)) - 0.39 * dksz6.$s; radius: 8.5 }
                }
                text "{win.dock.$s.6.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq6.$s), dka6.$s) + 0.39 * dksz6.$s, if(dkvert, dka6.$s, dk.cr.$s + dk.cs.$s * (dkiq6.$s)) - 0.39 * dksz6.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            measure tip.$s.7
            group {
                show: dk.on.$s and dk.hk.$s == 7 and 7 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq7.$s + dksz7.$s / 2 + 14 + (tip.$s.7.width + 22) / 2), dka7.$s), if(dkvert, dka7.$s, dk.cr.$s + dk.cs.$s * (dkiq7.$s + dksz7.$s / 2 + 41)); size: (tip.$s.7.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.7.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq7.$s + dksz7.$s / 2 + 14 + (tip.$s.7.width + 22) / 2), dka7.$s), if(dkvert, dka7.$s, dk.cr.$s + dk.cs.$s * (dkiq7.$s + dksz7.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.7; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.7.badge > 0 and 7 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq7.$s), dka7.$s) + 0.39 * dksz7.$s, if(dkvert, dka7.$s, dk.cr.$s + dk.cs.$s * (dkiq7.$s)) - 0.39 * dksz7.$s; radius: 8.5 }
                }
                text "{win.dock.$s.7.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq7.$s), dka7.$s) + 0.39 * dksz7.$s, if(dkvert, dka7.$s, dk.cr.$s + dk.cs.$s * (dkiq7.$s)) - 0.39 * dksz7.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            measure tip.$s.8
            group {
                show: dk.on.$s and dk.hk.$s == 8 and 8 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq8.$s + dksz8.$s / 2 + 14 + (tip.$s.8.width + 22) / 2), dka8.$s), if(dkvert, dka8.$s, dk.cr.$s + dk.cs.$s * (dkiq8.$s + dksz8.$s / 2 + 41)); size: (tip.$s.8.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.8.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq8.$s + dksz8.$s / 2 + 14 + (tip.$s.8.width + 22) / 2), dka8.$s), if(dkvert, dka8.$s, dk.cr.$s + dk.cs.$s * (dkiq8.$s + dksz8.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.8; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.8.badge > 0 and 8 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq8.$s), dka8.$s) + 0.39 * dksz8.$s, if(dkvert, dka8.$s, dk.cr.$s + dk.cs.$s * (dkiq8.$s)) - 0.39 * dksz8.$s; radius: 8.5 }
                }
                text "{win.dock.$s.8.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq8.$s), dka8.$s) + 0.39 * dksz8.$s, if(dkvert, dka8.$s, dk.cr.$s + dk.cs.$s * (dkiq8.$s)) - 0.39 * dksz8.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            measure tip.$s.9
            group {
                show: dk.on.$s and dk.hk.$s == 9 and 9 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq9.$s + dksz9.$s / 2 + 14 + (tip.$s.9.width + 22) / 2), dka9.$s), if(dkvert, dka9.$s, dk.cr.$s + dk.cs.$s * (dkiq9.$s + dksz9.$s / 2 + 41)); size: (tip.$s.9.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.9.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq9.$s + dksz9.$s / 2 + 14 + (tip.$s.9.width + 22) / 2), dka9.$s), if(dkvert, dka9.$s, dk.cr.$s + dk.cs.$s * (dkiq9.$s + dksz9.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.9; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.9.badge > 0 and 9 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq9.$s), dka9.$s) + 0.39 * dksz9.$s, if(dkvert, dka9.$s, dk.cr.$s + dk.cs.$s * (dkiq9.$s)) - 0.39 * dksz9.$s; radius: 8.5 }
                }
                text "{win.dock.$s.9.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq9.$s), dka9.$s) + 0.39 * dksz9.$s, if(dkvert, dka9.$s, dk.cr.$s + dk.cs.$s * (dkiq9.$s)) - 0.39 * dksz9.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            measure tip.$s.10
            group {
                show: dk.on.$s and dk.hk.$s == 10 and 10 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq10.$s + dksz10.$s / 2 + 14 + (tip.$s.10.width + 22) / 2), dka10.$s), if(dkvert, dka10.$s, dk.cr.$s + dk.cs.$s * (dkiq10.$s + dksz10.$s / 2 + 41)); size: (tip.$s.10.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.10.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq10.$s + dksz10.$s / 2 + 14 + (tip.$s.10.width + 22) / 2), dka10.$s), if(dkvert, dka10.$s, dk.cr.$s + dk.cs.$s * (dkiq10.$s + dksz10.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.10; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.10.badge > 0 and 10 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq10.$s), dka10.$s) + 0.39 * dksz10.$s, if(dkvert, dka10.$s, dk.cr.$s + dk.cs.$s * (dkiq10.$s)) - 0.39 * dksz10.$s; radius: 8.5 }
                }
                text "{win.dock.$s.10.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq10.$s), dka10.$s) + 0.39 * dksz10.$s, if(dkvert, dka10.$s, dk.cr.$s + dk.cs.$s * (dkiq10.$s)) - 0.39 * dksz10.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            measure tip.$s.11
            group {
                show: dk.on.$s and dk.hk.$s == 11 and 11 < dk.n.$s and pv.$s < 0 and dmenu.$s < 0 and dkdrag.$s < 0
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 6, 16, 40%
                    box { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq11.$s + dksz11.$s / 2 + 14 + (tip.$s.11.width + 22) / 2), dka11.$s), if(dkvert, dka11.$s, dk.cr.$s + dk.cs.$s * (dkiq11.$s + dksz11.$s / 2 + 41)); size: (tip.$s.11.width + 22), 26; corner: 13 }
                }
                text win.dock.$s.11.name { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq11.$s + dksz11.$s / 2 + 14 + (tip.$s.11.width + 22) / 2), dka11.$s), if(dkvert, dka11.$s, dk.cr.$s + dk.cs.$s * (dkiq11.$s + dksz11.$s / 2 + 41)); anchor: center; size: 12; weight: 600; color: ink; measure: tip.$s.11; lines: 1 }
            }
            // Unread, a drop of coral on its corner.
            group {
                show: win.dock.$s.11.badge > 0 and 11 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq11.$s), dka11.$s) + 0.39 * dksz11.$s, if(dkvert, dka11.$s, dk.cr.$s + dk.cs.$s * (dkiq11.$s)) - 0.39 * dksz11.$s; radius: 8.5 }
                }
                text "{win.dock.$s.11.badge, 0}" { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq11.$s), dka11.$s) + 0.39 * dksz11.$s, if(dkvert, dka11.$s, dk.cr.$s + dk.cs.$s * (dkiq11.$s)) - 0.39 * dksz11.$s; anchor: center; size: 10; weight: 700; color: #1a0c09 }
            }
            // Carried out of the shore: the icon at the mouse, and far enough, it
            // says it will go.
            group {
                show: dkdrag.$s >= 0 and mon == s
                opacity: if(dk.mq.$s > dk.q.$s + dkpl / 2 + 78, 55%, 90%)
                repeat j in 0..12 {
                    image dockicon.$s.$j { at: mouse.x - 24, mouse.y - 24; size: 48, 48; show: dkdrag.$s == j }
                }
            }
            // Unpinned, it bursts into drops where it was let go.
            group {
                show: poof.$s < 0.99
                opacity: 1 - poof.$s
                ellipse { at: poofx.$s, poofy.$s; radius: 10 + 34 * poof.$s; stroke: 2 * (1 - poof.$s) + 0.4; color: ink; opacity: 60% }
                ellipse { at: poofx.$s - 22 * poof.$s, poofy.$s - 16 * poof.$s + 30 * poof.$s * poof.$s; radius: 3.5 * (1 - poof.$s); color: ink }
                ellipse { at: poofx.$s + 20 * poof.$s, poofy.$s - 20 * poof.$s + 34 * poof.$s * poof.$s; radius: 3 * (1 - poof.$s); color: ink }
                ellipse { at: poofx.$s + 4 * poof.$s, poofy.$s - 28 * poof.$s + 40 * poof.$s * poof.$s; radius: 2.5 * (1 - poof.$s); color: ink }
            }
            // Its menu.
            group {
                show: mnup.$s > 0.01
                opacity: mnup.$s
                pivot: if(dkvert, dk.cr.$s + dk.cs.$s * (dk.q.$s), mn.ia.$s), if(dkvert, mn.ia.$s, dk.cr.$s + dk.cs.$s * (dk.q.$s))
                scale: 0.9 + 0.1 * mnup.$s
                body {
                    color: #0c0e10
                    rim: 12%
                    shadow: 0, 10, 26, 45%
                    box { from: mn.x.$s, mn.y.$s; size: 220, mn.h.$s; corner: 12 }
                }
                box { from: mn.x.$s + 12, mn.y.$s + mn.base.$s - 6; size: 196, 1; color: ink; opacity: 10%; show: mn.wn.$s > 0 }
                zone box dmr0.$s { from: mn.x.$s + 6, mn.y.$s + mn.base.$s + 0 * 28; size: 208, 28; corner: 8; cursor: pointer; active: dmenu.$s >= 0 and true; label: "A dock menu item" }
                box { from: mn.x.$s + 6, mn.y.$s + mn.base.$s + 0 * 28; size: 208, 28; corner: 8; color: ink; opacity: 8% * dmr0.$s.hover; show: true }
                zone box dmr1.$s { from: mn.x.$s + 6, mn.y.$s + mn.base.$s + 1 * 28; size: 208, 28; corner: 8; cursor: pointer; active: dmenu.$s >= 0 and true; label: "A dock menu item" }
                box { from: mn.x.$s + 6, mn.y.$s + mn.base.$s + 1 * 28; size: 208, 28; corner: 8; color: ink; opacity: 8% * dmr1.$s.hover; show: true }
                zone box dmr2.$s { from: mn.x.$s + 6, mn.y.$s + mn.base.$s + 2 * 28; size: 208, 28; corner: 8; cursor: pointer; active: dmenu.$s >= 0 and mn.run.$s; label: "A dock menu item" }
                box { from: mn.x.$s + 6, mn.y.$s + mn.base.$s + 2 * 28; size: 208, 28; corner: 8; color: ink; opacity: 8% * dmr2.$s.hover; show: mn.run.$s }
                zone box dmr3.$s { from: mn.x.$s + 6, mn.y.$s + mn.base.$s + 3 * 28; size: 208, 28; corner: 8; cursor: pointer; active: dmenu.$s >= 0 and mn.run.$s; label: "A dock menu item" }
                box { from: mn.x.$s + 6, mn.y.$s + mn.base.$s + 3 * 28; size: 208, 28; corner: 8; color: #ef7a66; opacity: 12% * dmr3.$s.hover; show: mn.run.$s }
                text "New window" { at: mn.x.$s + 18, mn.y.$s + mn.base.$s + 0 * 28 + 14; anchor: left center; size: 12; weight: 500; color: ink; show: mn.run.$s }
                text "Open" { at: mn.x.$s + 18, mn.y.$s + mn.base.$s + 0 * 28 + 14; anchor: left center; size: 12; weight: 500; color: ink; show: not mn.run.$s }
                text "Hide" { at: mn.x.$s + 18, mn.y.$s + mn.base.$s + 1 * 28 + 14; anchor: left center; size: 12; weight: 500; color: ink; show: mn.run.$s }
                text "Take off the shore" { at: mn.x.$s + 18, mn.y.$s + mn.base.$s + 1 * 28 + 14; anchor: left center; size: 12; weight: 500; color: ink; show: not mn.run.$s and mn.pin.$s }
                text "Keep on the shore" { at: mn.x.$s + 18, mn.y.$s + mn.base.$s + 1 * 28 + 14; anchor: left center; size: 12; weight: 500; color: ink; show: not mn.run.$s and not mn.pin.$s }
                text "Take off the shore" { at: mn.x.$s + 18, mn.y.$s + mn.base.$s + 2 * 28 + 14; anchor: left center; size: 12; weight: 500; color: ink; show: mn.run.$s and mn.pin.$s }
                text "Keep on the shore" { at: mn.x.$s + 18, mn.y.$s + mn.base.$s + 2 * 28 + 14; anchor: left center; size: 12; weight: 500; color: ink; show: mn.run.$s and not mn.pin.$s }
                text "Close windows" { at: mn.x.$s + 18, mn.y.$s + mn.base.$s + 3 * 28 + 14; anchor: left center; size: 12; weight: 500; color: #ef7a66; show: mn.run.$s }
            }
        }
        on press dmr0.$s while mn.run.$s { dock dmk.$s on s new }
        on press dmr0.$s while not mn.run.$s { dock dmk.$s on s }
        on press dmr1.$s while mn.run.$s { dock dmk.$s on s hide }
        on press dmr1.$s while not mn.run.$s and mn.pin.$s { dock dmk.$s on s unpin }
        on press dmr1.$s while not mn.run.$s and not mn.pin.$s { dock dmk.$s on s pin }
        on press dmr2.$s while mn.run.$s and mn.pin.$s { dock dmk.$s on s unpin }
        on press dmr2.$s while mn.run.$s and not mn.pin.$s { dock dmk.$s on s pin }
        on press dmr3.$s while mn.run.$s { dock dmk.$s on s close }
        on press dmr0.$s { dmenu.$s = -1 }
        on press dmr1.$s { dmenu.$s = -1 }
        on press dmr2.$s { dmenu.$s = -1 }
        on press dmr3.$s { dmenu.$s = -1 }
    }

    // ── the pools at a glance (Super+Tab): beside the windows of the pool
    // shown, a column of cards at the right of each monitor, one per pool,
    // each with its windows as they are laid out and their programs' icons
    // —that is its name—, the empty one last with a +. A card pressed shows
    // its pool; dragged to the other monitor, the whole pool goes there. A
    // window dragged onto a card goes to that pool, on either monitor ──
    fact ovdrag = -1
    fact pdrag.s = -1
    fact pdrag.k = 0
    repeat k in 0..16 {
        image appicon.$k = from win.$k.icon, 64, 64
    }
    let pc.n[4]
    let pc.w[4]
    let pc.h[4]
    let pc.x[4]
    let pc.y[4]
    repeat k in 0..4 {
        pc.n[k] = max(win.pools.$k, win.used.$k + 1)
        pc.w[k] = min(screen.$k.width * 0.12, (screen.$k.height - 160 - (pc.n.$k - 1) * 20) / pc.n.$k * screen.$k.width / max(screen.$k.height, 1))
        pc.h[k] = pc.w.$k * screen.$k.height / max(screen.$k.width, 1)
        pc.x[k] = screen.$k.width - pc.w.$k - 40
        pc.y[k] = screen.$k.height / 2 - (pc.n.$k * pc.h.$k + (pc.n.$k - 1) * 20) / 2
    }
    // Where the mouse is among its monitor's cards: which one it is over.
    let pc.mn = pc.n[mon]
    let pc.mw = pc.w[mon]
    let pc.mh = pc.h[mon]
    let pc.mx = pc.x[mon]
    let pc.my = pc.y[mon]
    let on.col = overview and mouse.x >= pc.mx - 24 and mouse.x <= pc.mx + pc.mw + 24
    let drop.k = if(on.col, floor((mouse.y - pc.my + 10) / (pc.mh + 20)) + 1, 0)
    let drop.ok = drop.k >= 1 and drop.k <= pc.mn
    // (A drag only past a few pixels, as the dock's: a click that moved one
    // was taken for one, and chose nothing.)
    repeat s in 0..4 {
        group {
            z: 99985
            show: ov > 0.01 and screen.index == s
            repeat k in 0..10 {
                group {
                    show: k < pc.n.$s
                    opacity: smooth(0.05 * k, 0.05 * k + 0.55, ov) * if(pdrag.s == s and pdrag.k == k, 40%, 100%)
                    move: 70 * (1 - smooth(0.05 * k, 0.05 * k + 0.55, ov)), 0
                    body {
                        color: #0c0e10
                        rim: 10% + 12% * max(pcard.$k.$s.hover, (overview and drop.ok and mon == s and drop.k == (k + 1) and (ovdrag >= 0 or pdrag.s >= 0)))
                        shadow: 0, 10 + 6 * pcard.$k.$s.hover, 28, 45%
                        box { from: pc.x.$s, (pc.y.$s + k * (pc.h.$s + 20)); size: pc.w.$s, pc.h.$s; corner: 10 }
                    }
                    box { from: pc.x.$s - 3, (pc.y.$s + k * (pc.h.$s + 20)) - 3; size: pc.w.$s + 6, pc.h.$s + 6; corner: 13; stroke: 1.6; color: mint; opacity: if((k + 1) == win.shown.$s, 85%, 0%) + 60% * (overview and drop.ok and mon == s and drop.k == (k + 1) and (ovdrag >= 0 or pdrag.s >= 0)) }
                    box { at: pc.x.$s + pc.w.$s / 2, (pc.y.$s + k * (pc.h.$s + 20)) + pc.h.$s / 2; size: 16, 1.6; corner: 0.8; color: ink; opacity: 45%; show: (k + 1) == pc.n.$s and win.used.$s < (k + 1) }
                    box { at: pc.x.$s + pc.w.$s / 2, (pc.y.$s + k * (pc.h.$s + 20)) + pc.h.$s / 2; size: 1.6, 16; corner: 0.8; color: ink; opacity: 45%; show: (k + 1) == pc.n.$s and win.used.$s < (k + 1) }
                    text "{k + 1}" { at: pc.x.$s - 12, (pc.y.$s + k * (pc.h.$s + 20)) + pc.h.$s / 2; anchor: right center; size: 11; weight: 600; color: ink; opacity: if((k + 1) == win.shown.$s, 85%, 40%) }
                    zone box pcard.$k.$s { from: pc.x.$s, (pc.y.$s + k * (pc.h.$s + 20)); size: pc.w.$s, pc.h.$s; corner: 10; cursor: pointer; active: overview and not sharing and k < pc.n.$s; label: "Workspace {k + 1}"; role: item }
                }
            }
        }
        repeat k in 0..10 {
            on drag pcard.$k.$s while pdrag.s < 0 and (abs(drag.dx) > 6 or abs(drag.dy) > 6) {
                pdrag.s = s
                pdrag.k = k
            }
            on release pcard.$k.$s while pdrag.s < 0 {
                workspace (k + 1) on s
                overview = false
            }
            on release pcard.$k.$s while pdrag.s == s and mon != s and k < win.used.$s { send workspace (k + 1) on s to mon }
            on release pcard.$k.$s { pdrag.s = -1 }
        }
    }
    // The card being carried, under the mouse, on whichever monitor it is.
    group {
        z: 99987
        show: pdrag.s >= 0 and screen.index == mon
        opacity: 90%
        body {
            color: #0c0e10
            rim: 18%
            shadow: 0, 18, 40, 55%
            box { at: mouse.x, mouse.y; size: pc.w[max(pdrag.s, 0)], pc.h[max(pdrag.s, 0)]; corner: 10 }
        }
        box { at: mouse.x, mouse.y; size: pc.w[max(pdrag.s, 0)] + 6, pc.h[max(pdrag.s, 0)] + 6; corner: 13; stroke: 1.6; color: mint; opacity: 70% }
        text "{pdrag.k + 1, 0}" { at: mouse.x, mouse.y; anchor: center; size: 15; weight: 700; color: mint }
    }

    // The mouse over a dialog (they are in the middle of their monitor): the
    // window under it does not take the keyboard from it. Without this,
    // going into a «Save as» to type a name gave the keys to the window
    // beneath it.
    let Wmon = screen[mon].width
    let Hmon = screen[mon].height
    let on.dialog = (win.0.dialog and win.0.open and win.0.screen == mon and win.0.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.0.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.0.height, 40) + tb) / 2) + (win.1.dialog and win.1.open and win.1.screen == mon and win.1.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.1.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.1.height, 40) + tb) / 2) + (win.2.dialog and win.2.open and win.2.screen == mon and win.2.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.2.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.2.height, 40) + tb) / 2) + (win.3.dialog and win.3.open and win.3.screen == mon and win.3.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.3.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.3.height, 40) + tb) / 2) + (win.4.dialog and win.4.open and win.4.screen == mon and win.4.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.4.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.4.height, 40) + tb) / 2) + (win.5.dialog and win.5.open and win.5.screen == mon and win.5.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.5.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.5.height, 40) + tb) / 2) + (win.6.dialog and win.6.open and win.6.screen == mon and win.6.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.6.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.6.height, 40) + tb) / 2) + (win.7.dialog and win.7.open and win.7.screen == mon and win.7.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.7.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.7.height, 40) + tb) / 2) + (win.8.dialog and win.8.open and win.8.screen == mon and win.8.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.8.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.8.height, 40) + tb) / 2) + (win.9.dialog and win.9.open and win.9.screen == mon and win.9.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.9.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.9.height, 40) + tb) / 2) + (win.10.dialog and win.10.open and win.10.screen == mon and win.10.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.10.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.10.height, 40) + tb) / 2) + (win.11.dialog and win.11.open and win.11.screen == mon and win.11.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.11.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.11.height, 40) + tb) / 2) + (win.12.dialog and win.12.open and win.12.screen == mon and win.12.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.12.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.12.height, 40) + tb) / 2) + (win.13.dialog and win.13.open and win.13.screen == mon and win.13.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.13.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.13.height, 40) + tb) / 2) + (win.14.dialog and win.14.open and win.14.screen == mon and win.14.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.14.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.14.height, 40) + tb) / 2) + (win.15.dialog and win.15.open and win.15.screen == mon and win.15.workspace == win.shown[mon] and abs(mouse.x - Wmon / 2) <= max(win.15.width, 120) / 2 and abs(mouse.y - Hmon / 2) <= (max(win.15.height, 40) + tb) / 2) > 0.5

    // The workspace of the window with the keyboard, and whether it is a
    // dialog or floats: another one taking the keyboard there puts a
    // maximized one back.
    let focus.pool = win[max(win.focus, 0)].pool
    let focus.dialog = win[max(win.focus, 0)].dialog
    let focus.floats = win[max(win.focus, 0)].floating
    // («marea»: each tiled window's share of its monitor's pool. The windows
    // in order of their group —monitor and pool— and their place in it;
    // going forward, what the ones before each take; going back, the whole
    // group's.)
    let td.g[16]
    repeat i in 0..16 {
        td.g[i] = if(win[i].place >= 0 and not win[i].minimized, win[i].screen * 100000 + win[i].pool, -2 - i)
    }
    let td.ord[16] = sort(i in win by td.g[i], win[i].place)
    let td.run = 0
    let td.before[16]
    repeat p in 0..16 {
        let s = td.ord[p]
        td.run = if(td.g[s] == td.g[td.ord[p - 1]], td.run, 0)
        td.before[p] = td.run
        td.run += (td.g[s] >= 0) * mw[s]
    }
    let td.left = 0
    let td.all[16]
    repeat r in 0..16 {
        let q = 15 - r
        let s = td.ord[q]
        td.left = if(td.g[s] == td.g[td.ord[q + 1]], td.left, td.before[q] + (td.g[s] >= 0) * mw[s])
        td.all[q] = td.left
    }
    // (Super+arrows: each window's middle on the whole desktop, and how
    // near it is the way asked; see the actions.)
    let dir.cx[16]
    let dir.cy[16]
    let dir.score[16]
    repeat i in 0..16 {
        // A window is laid out on its own monitor: how big that one is and how
        // many windows share it. Each copy of the scene draws only its own.
        let sc = win.$i.screen
        // On the phone (see `phone`): an app, whatever its pool.
        let onph = phone >= 0 and sc == phone
        // (Asked to close: see `seen`.)
        prop bye.$i = 0 ~0ms
        // On the workspace its monitor shows; or how far from it, while they slide.
        // On the pool its monitor shows; and drawn, the one the water has left.
        let ws.here = win.$i.pool == win.pool[sc]
        let ws.vis = win.$i.pool == inpool[sc] or onph
        // (On the phone its zones are the phone's: no title bars, no edges.)
        let here = win.$i.open and sc == screen.index and not win.$i.minimized and bye.$i < 0.5 and ws.vis and not onph
        // (Drawn while it goes away into the island, too.)
        let drawn = win.$i.open and sc == screen.index and ws.vis
        let n = max(win.$i.among, 1)
        let p = max(win.$i.place, 0)
        let L = lay[sc]
        // ── where it goes, in its monitor's layout ──
        let Ws = screen[sc].width - win.reserved[sc].left - win.reserved[sc].right
        let Hs = screen[sc].height - win.reserved[sc].top - win.reserved[sc].bottom
        let x0 = win.reserved[sc].left
        let y0 = win.reserved[sc].top + bar
        let ah = Hs - bar - gap
        let lw = if(n < 1.5, Ws - 2 * gap, (Ws - 3 * gap) * ratio)
        let sw = Ws - 3 * gap - lw
        let sh = (ah - (n - 2) * gap) / max(n - 1, 1)
        let cw = (Ws - (n + 1) * gap) / max(n, 1)
        let rh = (ah - (n - 1) * gap) / max(n, 1)
        let gc = ceil(sqrt(n))
        let gw = (Ws - (gc + 1) * gap) / gc
        let gh = (ah - (ceil(n / gc) - 1) * gap) / ceil(n / gc)
        // (Scrolling: how far its monitor's strip has glided.)
        let glided = scr[sc]
        // («marea»: the share of the width of those before it, and its own.)
        let tide.all = max(td.all[td.ord.pos[i]], 1)
        let tide.before = td.before[td.ord.pos[i]]
        let tide.room = Ws - (n + 1) * gap
        let tide.x = gap + p * gap + tide.room * tide.before / tide.all
        let tide.w = tide.room * mw[i] / tide.all
        // (Fractal: its box in its monitor's square, as that monitor's camera
        // sees it; columns until it has one.)
        let fz.has = tre.w.$i > 0.001 and tre.s.$i == sc
        let fz.cx = cam[sc].x
        let fz.cy = cam[sc].y
        let fz.cw = max(cam[sc].w, 0.01)
        let fz.ch = max(cam[sc].h, 0.01)
        let fz.dx = tre.ox.$i + tre.sx.$i * tre.x.$i
        let fz.dy = tre.oy.$i + tre.sy.$i * tre.y.$i
        let fz.dw = tre.sx.$i * tre.w.$i
        let fz.dh = tre.sy.$i * tre.h.$i
        let fz.x = if(fz.has, gap + (fz.dx - fz.cx) / fz.cw * (Ws - gap), gap + p * (cw + gap))
        let fz.y = if(fz.has, (fz.dy - fz.cy) / fz.ch * (ah + gap), 0)
        let fz.w = if(fz.has, fz.dw / fz.cw * (Ws - gap) - gap, cw)
        let fz.h = if(fz.has, fz.dh / fz.ch * (ah + gap) - gap, ah)
        // (The size the program is asked: as its group fills the screen, or as
        // the resting camera shows it if bigger; never more than the screen.)
        let fz.rw = max(camr[sc].w, 0.01)
        let fz.rh = max(camr[sc].h, 0.01)
        let fz.aw = min(Ws - 2 * gap, max(fz.dw / fz.rw, tre.w.$i / max(tre.fw.$i, 0.0001)) * (Ws - gap) - gap)
        let fz.ah = min(ah, max(fz.dh / fz.rh, tre.h.$i / max(tre.fh.$i, 0.0001)) * (ah + gap) - gap)
        let tx = x0 + pick(L, if(p < 0.5, gap, 2 * gap + lw), gap + p * (cw + gap), gap, gap + mod(p, gc) * (gw + gap), if(p < 0.5, 2 * gap + sw, gap), gap + p * (lw + gap) - glided, tide.x, fz.x)
        let ty = y0 + pick(L, if(p < 0.5, 0, (p - 1) * (sh + gap)), 0, p * (rh + gap), floor(p / gc) * (gh + gap), if(p < 0.5, 0, (p - 1) * (sh + gap)), 0, 0, fz.y)
        let tw = pick(L, if(p < 0.5, lw, sw), cw, Ws - 2 * gap, gw, if(p < 0.5, lw, sw), lw, tide.w, fz.w)
        let th = pick(L, if(p < 0.5, ah, sh), ah, rh, gh, if(p < 0.5, ah, sh), ah, ah, fz.h)
        // Under the mouse while another is carried —measured on where it is,
        // not where it is shown moving aside—: it would change places with it.
        let under = dragging >= 0 and not dfl and dragging != i and win.$i.open and sc == mon and not on.strip and free[sc] < 0.5 and mouse.x >= tx and mouse.x < tx + tw and mouse.y >= ty and mouse.y < ty + th
        on change under {
            over = if(under, i, if(over == i, -1, over))
        }
        // ── where it is shown going, while one is carried ── (the program is
        // asked for that size too: it changes only when the mouse goes onto
        // another window, monitor or layout, so it draws itself as it would
        // be instead of being stretched)
        let ord.me = win.$i.rank
        let swaps = over == i and sc == mon and not crossing
        let promoted = leads and not crossing and sc == dsc and dragging >= 0
        let n.shown = max(if(crossing and sc == mon, n + 1, if(crossing and sc == dsc, n - 1, n)), 1)
        let p.shown = if(dragging == i and promoted, 0, if(promoted, p + (p < dplace), if(swaps and not crossing, dplace, if(crossing and sc == mon, p + if(leads, 1, ordD < ord.me), if(crossing and sc == dsc, p - (ord.me > ordD), p)))))
        let L.shown = if(dragging >= 0 and picked >= 0 and picked < 8 and sc == mon, picked, L)
        let Wsv = screen[sc].width - win.reserved[sc].left - win.reserved[sc].right
        let Hsv = screen[sc].height - win.reserved[sc].top - win.reserved[sc].bottom
        let x0v = win.reserved[sc].left
        let y0v = win.reserved[sc].top + bar
        let ahv = Hsv - bar - gap
        let lwv = if(n.shown < 1.5, Wsv - 2 * gap, (Wsv - 3 * gap) * ratio)
        let swv = Wsv - 3 * gap - lwv
        let shv = (ahv - (n.shown - 2) * gap) / max(n.shown - 1, 1)
        let cwv = (Wsv - (n.shown + 1) * gap) / max(n.shown, 1)
        let rhv = (ahv - (n.shown - 1) * gap) / max(n.shown, 1)
        let gcv = ceil(sqrt(n.shown))
        let gwv = (Wsv - (gcv + 1) * gap) / gcv
        let ghv = (ahv - (ceil(n.shown / gcv) - 1) * gap) / ceil(n.shown / gcv)
        let txv = x0v + pick(L.shown, if(p.shown < 0.5, gap, 2 * gap + lwv), gap + p.shown * (cwv + gap), gap, gap + mod(p.shown, gcv) * (gwv + gap), if(p.shown < 0.5, 2 * gap + swv, gap), gap + p.shown * (lwv + gap) - glided, if(dragging >= 0, gap + p.shown * (cwv + gap), tide.x), fz.x)
        let tyv = y0v + pick(L.shown, if(p.shown < 0.5, 0, (p.shown - 1) * (shv + gap)), 0, p.shown * (rhv + gap), floor(p.shown / gcv) * (ghv + gap), if(p.shown < 0.5, 0, (p.shown - 1) * (shv + gap)), 0, 0, fz.y)
        let twv = pick(L.shown, if(p.shown < 0.5, lwv, swv), cwv, Wsv - 2 * gap, gwv, if(p.shown < 0.5, lwv, swv), lwv, if(dragging >= 0, cwv, tide.w), fz.w)
        let thv = pick(L.shown, if(p.shown < 0.5, ahv, shv), ahv, rhv, ghv, if(p.shown < 0.5, ahv, shv), ahv, ahv, fz.h)
        // Where the carried one would land on the other monitor.
        let Wsg = screen[mon].width - win.reserved[mon].left - win.reserved[mon].right
        let Hsg = screen[mon].height - win.reserved[mon].top - win.reserved[mon].bottom
        let x0g = win.reserved[mon].left
        let y0g = win.reserved[mon].top + bar
        let ahg = Hsg - bar - gap
        let lwg = if(landing.n < 1.5, Wsg - 2 * gap, (Wsg - 3 * gap) * ratio)
        let swg = Wsg - 3 * gap - lwg
        let shg = (ahg - (landing.n - 2) * gap) / max(landing.n - 1, 1)
        let cwg = (Wsg - (landing.n + 1) * gap) / max(landing.n, 1)
        let rhg = (ahg - (landing.n - 1) * gap) / max(landing.n, 1)
        let gcg = ceil(sqrt(landing.n))
        let gwg = (Wsg - (gcg + 1) * gap) / gcg
        let ghg = (ahg - (ceil(landing.n / gcg) - 1) * gap) / ceil(landing.n / gcg)
        let txg = x0g + pick(landing.lay, if(landing.place < 0.5, gap, 2 * gap + lwg), gap + landing.place * (cwg + gap), gap, gap + mod(landing.place, gcg) * (gwg + gap), if(landing.place < 0.5, 2 * gap + swg, gap), gap + landing.place * (lwg + gap) - scr[mon], gap + landing.place * (cwg + gap), gap + landing.place * (cwg + gap))
        let tyg = y0g + pick(landing.lay, if(landing.place < 0.5, 0, (landing.place - 1) * (shg + gap)), 0, landing.place * (rhg + gap), floor(landing.place / gcg) * (ghg + gap), if(landing.place < 0.5, 0, (landing.place - 1) * (shg + gap)), 0, 0, 0)
        let twg = pick(landing.lay, if(landing.place < 0.5, lwg, swg), cwg, Wsg - 2 * gap, gwg, if(landing.place < 0.5, lwg, swg), lwg, cwg, cwg)
        let thg = pick(landing.lay, if(landing.place < 0.5, ahg, shg), ahg, rhg, ghg, if(landing.place < 0.5, ahg, shg), ahg, ahg, ahg)
        // (the grid at a glance)
        let cols = ceil(sqrt(n))
        let rows = ceil(n / cols)
        let cell.w = (Ws - 80 - pc.w[sc] - 70 - (cols - 1) * 30) / cols
        let cell.h = (ah - 40 - (rows - 1) * 30) / rows
        // ── and at a glance: in a grid, each one keeping its shape ──
        let s = min(cell.w / tw, cell.h / th)
        let ox = win.reserved[sc].left + 40 + mod(p, cols) * (cell.w + 30) + (cell.w - tw * s) / 2
        let oy = win.reserved[sc].top + bar + 20 + floor(p / cols) * (cell.h + 30) + (cell.h - th * s) / 2

        // ── free: where it was left, as big as it was made (all of the
        // monitor, maximized) ──
        fact fx.$i = 0
        fact fy.$i = 0
        fact fw.$i = 0
        fact fh.$i = 0
        fact maxed.$i = 0
        // Its agent, if one runs in it (a terminal through the layer, term.rs,
        // says so): 0 none, 1 working, 2 ready, 3 waiting for the person; and
        // what and where («claude · ~/Proyectos/pleamar»).
        fact ag.$i = 0
        text agt.$i = ""
        // What it asked was answered by another window's agent: said on it a while.
        fact ansby.$i = -1
        prop ansv.$i = 0 ~260ms
        on answered(v) while floor(v / 100) == i {
            ansby.$i = mod(v, 100) - 1
            ansv.$i: 1 ~0ms
            ansv.$i: 0 after 8000ms
        }
        fact stamp.$i = 0
        // Which monitor its free place was made on: monitors differ in size,
        // so a place from the other one is not a place here.
        fact fsc.$i = -1
        //  Free: its monitor is (`Fm`), or this window floats on its own over
        //  the tiles (`float`, Super+V). Floating, it is as a free one: a place
        //  of its own, a title bar, carried and resized; the others close up.
        let Fm = free[sc]
        let F = if(win.$i.floating, 1, Fm)
        // (Only once it has a place of its own on this monitor: the frame free
        // is taken, it has none yet, and it headed for the corner.)
        let fr = F > 0.5 and fw.$i > 0.5 and fsc.$i == sc and not win.$i.fullscreen and not win.$i.dialog
        // On a canvas, its free place is on the plane: shown as the camera sees
        // it (`cz` how close; 1 anywhere else), nowhere kept inside the monitor.
        let C = cv[sc] > 0.5 and Fm > 0.5
        let cz = if(C, cvz[sc], 1)
        let ccx = cvx[sc]
        let ccy = cvy[sc]
        // Free, it has our title bar if the program lets us draw its frame;
        // one that draws its own (a GTK 4 header bar, a browser's tabs) is
        // carried and stretched from its own (`handle:`, on the zones below).
        let ours = F > 0.5 and win.$i.framed
        // Never lost: no bigger than its monitor, and always with a good
        // piece of it —and all of its title bar— inside, to take it by.
        // (Free, the shore on its edge is kept clear, unless it hides.)
        let shr = (dkpl + 28) * room[sc]
        let ahf = ah - shr * (dock.side < 0.5)
        let fgw = if(maxed.$i, Ws - 2 * gap - shr * (dock.side > 0.5), if(C, fw.$i * cz, min(fw.$i, Ws - 2 * gap)))
        // (On a canvas the title bar stays as it is: only what the program shows is smaller.)
        let fgh = if(maxed.$i, ahf, if(C, (fh.$i - tb * ours) * cz + tb * ours, min(fh.$i, ahf)))
        let fgx = if(maxed.$i, x0 + gap + shr * (dock.side == 1), if(C, x0 + (fx.$i - x0 - ccx) * cz, clamp(fx.$i, x0 + 160 - fgw, x0 + Ws - 160)))
        let fgy = if(maxed.$i, y0, if(C, y0 + (fy.$i - y0 - ccy) * cz, clamp(fy.$i, win.reserved[sc].top, y0 + ahf - tb - 40)))
        // ── tiled, maximized (`maximize`): all of its monitor's room —the
        // bars and the gaps kept, as one window alone has it—, over the
        // others, which keep their places beneath. Again, back to its tile;
        // and so too when another one there takes the keyboard (it would be
        // under it), or when it is carried. ──
        // (`tmax.$i` is declared further up, before `max.on`, which reads them all.)
        let tm = tmax.$i > 0.5 and F < 0.5 and not win.$i.fullscreen and not win.$i.dialog and not win.$i.minimized
        // (Free or floating, the same as its green button.)
        on maximize while win.focus == i and not win.$i.dialog and (F < 0.5 or fr) {
            tmax.$i = if(F < 0.5, 1 - tmax.$i, tmax.$i)
            maxed.$i = if(fr, 1 - maxed.$i, maxed.$i)
            wave.$i: 0 ~0ms
            wave.$i: 1 after 16ms
        }
        // (Read here from `win.focus` itself, not through `fscreen` and the
        // others: a rule that follows a fact sees the `let`s made from it as
        // they were before it changed. The keyboard going to a window on the
        // other monitor looked like one on this one, and the maximized window
        // went back to its tile.)
        // A new window takes its place at once, except on a fractal monitor
        // (it does once its box is cut); a dialog or a floating one at once
        // there too. Never left waiting.
        on change win.$i.open while win.$i.pending and lay[max(win.$i.screen, 0)] != 7 { accept win(i) }
        on change win.$i.dialog + win.$i.floating while win.$i.pending and (win.$i.dialog or win.$i.floating) { accept win(i) }
        on still win.$i.pending for 1s while win.$i.pending { accept win(i) }
        on change win.focus while tmax.$i > 0.5 and win.focus >= 0 and win.focus != i and win[max(win.focus, 0)].screen == sc and win[max(win.focus, 0)].pool == win.$i.pool and not win[max(win.focus, 0)].dialog and not win[max(win.focus, 0)].floating { tmax.$i = 0 }
        on change dragging while dragging == i { tmax.$i = 0 }
        // Put away, it stays where it was (the others close up without it),
        // and flies from there into Marea's island.
        fact put.x.$i = 0
        fact put.y.$i = 0
        fact put.w.$i = 0
        fact put.h.$i = 0
        on change win.$i.minimized while win.$i.minimized {
            put.x.$i = x.$i
            put.y.$i = y.$i
            put.w.$i = w.$i
            put.h.$i = h.$i
            last_min = i
        }
        // Back to tiled, what was put away comes out of the island to its
        // place: tiled, every window has one.
        on change Fm while Fm < 0.5 and win.$i.minimized { restore win.$i }
        // Tiled there is no putting away: whoever asks (a program, a dock), it comes back.
        on change win.$i.minimized while win.$i.minimized and Fm < 0.5 { restore win.$i }
        // On the phone: all of it under the status line; the ones that are
        // not in front wait beside it, the earlier ones to the left.
        let ph.rel = ph.k.$i - ph.kf
        // Two side by side (a tablet lying down): the one in front on its
        // side of the line, the other on the other.
        let ph.pair = ph.split and (ph.front == i or ph.sd == i)
        let ph.lft = (ph.front == i) == (ph.fl > 0.5)
        let ph.px = if(ph.lft, 0, ph.xr + 4)
        let ph.pw = if(ph.lft, ph.xr - 4, W.ph - ph.xr - 4)
        let ph.gx = if(ph.pair, ph.px, if(ph.front == i or ph.front < 0, 0, if(ph.rel > 0, W.ph + 40, 0 - W.ph - 40)))
        let goal.x = if(onph, ph.gx, if(win.$i.minimized, put.x.$i, if(fr, fgx, if(tm, x0 + gap, txv))))
        let goal.y = if(onph, ph.sb, if(win.$i.minimized, put.y.$i, if(fr, fgy, if(tm, y0, tyv))))
        let goal.w = if(onph, if(ph.pair, ph.pw, W.ph), if(win.$i.minimized, put.w.$i, if(fr, fgw, if(tm, Ws - 2 * gap, twv))))
        let goal.h = if(onph, H.ph - ph.sb - ph.hb, if(win.$i.minimized, put.h.$i, if(fr, fgh, if(tm, ah, thv))))
        // (Fractal: in a group it is drawn smaller than the size it is asked.)
        let fz.ask = L.shown == 7 and fz.has and not onph and not win.$i.minimized and not fr and not tm
        // (Canvas: the program is asked its size on the plane, and drawn as far away as it is.)
        let cv.ask = C and fr and not maxed.$i and not onph and not win.$i.minimized
        let ask.w = if(fz.ask, fz.aw, if(cv.ask, fw.$i, goal.w))
        let ask.h = if(fz.ask, fz.ah, if(cv.ask, fh.$i, goal.h))
        // As a card, in a deck: each one a step below the one before, the
        // one at `ph.at` whole near the top, the ones behind it piled up
        // above, a little smaller. Lying down, in a row: the one at `ph.at`
        // in the middle, the others beside it, a little smaller.
        let ph.d = ph.k.$i - ph.at
        let ph.r0 = min(0.62, (H.ph - ph.sb - ph.hb - 200) / max(H.ph - ph.sb - ph.hb, 1))
        let ph.cs = if(ph.row, ph.r0 * (1 - 0.08 * min(abs(ph.d), 1)), 0.84 * (1 - 0.06 * clamp(0 - ph.d, 0, 4)))
        let ph.cw = W.ph * ph.cs
        let ph.ch = (H.ph - ph.sb - ph.hb) * ph.cs
        let ph.cx = if(ph.row, (W.ph - ph.cw) / 2 + ph.d * (W.ph * ph.r0 + 36), (W.ph - ph.cw) / 2)
        let ph.cy = if(ph.row, (ph.sb + H.ph - ph.hb - 62) / 2 - ph.ch / 2, ph.sb + 96 + if(ph.d < 0, max(ph.d, -4) * 26, ph.d * 150))
        let card = onph and ph.home
        // Over the others: on the phone, the app in front; as cards, each over the one before.
        let zz = if(onph, if(card, 100000 + ph.k.$i * 10, if(ph.front == i or ph.pair, 100500, 100000)), stamp.$i)
        // How far into the island: 0 here, 1 put away.
        prop mini.$i = 0 ~720ms
        follow mini.$i = if(win.$i.minimized, 1, 0)
        // Free for the first time: where it is now. Opened free: in the middle, a step down per slot.
        // (A little smaller than its tile, in the middle of it: it is seen
        // coming off.)
        // From where its tile is on this monitor —not from where it is shown
        // going, which may be mid-glide or on the other monitor—. The same
        // when it arrives free on a monitor its place was not made on
        // (unless it was let go there: then that is its place).
        let unplaced = F > 0.5 and win.$i.open and (fw.$i < 1 or fsc.$i != sc) and dragging != i and not (landing == i and sc != landing.to)
        on change unplaced while unplaced and Fm > 0.5 {
            fx.$i = if(C, x0 + ccx + (tx + tw * 0.07 - x0) / cz, tx + tw * 0.07)
            fy.$i = if(C, y0 + ccy + (ty + th * 0.06 - y0) / cz, ty + th * 0.06)
            fw.$i = tw * 0.86 / cz
            fh.$i = th * 0.88 / cz
            fsc.$i = sc
            maxed.$i = 0
        }
        // Tiled to free and back, each one gives a little jump, and free it
        // floats: a deeper shadow.
        prop lift.$i = 0 ~pop
        follow lift.$i = F
        // Its title bar, with its buttons, only free: tiled, the layout already
        // says where each one is, and the program has all of its tile. It
        // unrolls when the monitor goes free, and rolls up when it goes back.
        prop hb.$i = 0 ~glide
        // (On a canvas, room for its port at the start of its title bar.)
        prop cvpt.$i = 0 ~glide
        follow cvpt.$i = if(fr and ours, 1, 0)
        // Carried at a glance over the cards, it shrinks towards them.
        prop ovcarry.$i = 0 ~pop
        follow ovcarry.$i = if(ovdrag == i and on.col, 1, 0)
        follow hb.$i = if(ours, 1, 0)
        // ── a window that opens fills where it goes, like a tank: the water
        // comes up from the bottom with a wavy line and a bright edge where it
        // meets the air (shaders/tide.wgsl); one that closes drains the same
        // way. `fill` 0 empty → 1 the window (closing: `seen`, below).
        prop fill.$i = 1 ~260ms
        // As it opens, its place among the others is not known yet —a slot
        // used before still says the place of the window it held—: it waits,
        // empty, a few frames, until the compositor has laid it out.
        fact fresh.$i = 0
        on change win.$i.open while win.$i.open and not win.$i.dialog {
            fresh.$i = 1
            fill.$i: 0 ~0ms
        }
        on still fill.$i for 50ms while fresh.$i > 0.5 and fill.$i < 0.01 {
            fresh.$i = 0
            // Where it goes, at once: it is the water that moves.
            x.$i: goal.x ~0ms
            y.$i: goal.y ~0ms
            w.$i: goal.w ~0ms
            h.$i: goal.h ~0ms
            fill.$i: 1 ~260ms
        }
        // Never empty for good: whatever kept it waiting, it is there.
        on still fill.$i for 2500ms while fill.$i < 0.01 and win.$i.open {
            fresh.$i = 0
            fill.$i: 1
        }
        // (What comes from the compositor is already new when the rules look.)
        on change win.$i.open while win.$i.open and F > 0.5 {
            fw.$i = Ws * 0.6
            fh.$i = ah * 0.7
            fx.$i = if(C, x0 + ccx + (Ws / 2 + 28 * i) / cz - Ws * 0.3, x0 + Ws * 0.2 + 28 * i)
            fy.$i = if(C, y0 + ccy + (ah / 2 + 28 * i) / cz - ah * 0.35, y0 + ah * 0.1 + 28 * i)
            fsc.$i = sc
            maxed.$i = 0
        }
        on change win.$i.open while not win.$i.open {
            fw.$i = 0
            maxed.$i = 0
            tmax.$i = 0
        }
        // Carried or being resized when it goes —closed, put away—: nothing
        // is carried any more (the release would never come to it).
        on change win.$i.open while not win.$i.open and dragging == i { dragging = -1 }
        on change win.$i.open while not win.$i.open and sizing == i { sizing = -1 }
        on change win.$i.minimized while win.$i.minimized and dragging == i { dragging = -1 }
        on change win.$i.minimized while win.$i.minimized and sizing == i { sizing = -1 }
        // The one that gets the keyboard comes over the rest.
        on change win.$i.focused while win.$i.focused {
            stamp.$i = stamp.top + 1
            stamp.top = stamp.top + 1
        }

        prop x.$i = 24 ~glide
        prop y.$i = 12 ~glide
        prop w.$i = 60 ~glide
        prop h.$i = 34 ~glide
        // (Super+arrows: where its middle is on the whole desktop, and how
        // near it is the way asked, from the one with the keyboard.)
        let dirc.x = mx[sc] + x.$i + w.$i / 2
        let dirc.y = y.$i + h.$i / 2
        let dirc.ok = win.$i.open and not win.$i.minimized and win.$i.pool == win.pool[sc] and win.focus != i
        let dirc.main = pick(max(dir.q - 1, 0), dir.fx - dirc.x, dirc.x - dir.fx, dir.fy - dirc.y, dirc.y - dir.fy)
        let dirc.cross = pick(max(dir.q - 1, 0), abs(dirc.y - dir.fy), abs(dirc.y - dir.fy), abs(dirc.x - dir.fx), abs(dirc.x - dir.fx))
        let dirc.score = if(dirc.ok and dirc.main > 8, dirc.main + 3 * dirc.cross, 1000000)
        dir.cx[i] = dirc.x
        dir.cy[i] = dirc.y
        dir.score[i] = dirc.score
        //  Floated off a tiled monitor: it lifts off its tile, smaller, in the
        //  middle of where it was (its tile is the others' now).
        let flw = min(w.$i * 0.86, Ws * 0.62)
        let flh = min(h.$i * 0.88, ah * 0.72)
        on change unplaced while unplaced and Fm < 0.5 {
            fx.$i = x.$i + (w.$i - flw) / 2
            fy.$i = y.$i + (h.$i - flh) / 2
            fw.$i = flw
            fh.$i = flh
            fsc.$i = sc
            maxed.$i = 0
        }
        follow x.$i = if(win.$i.open, if(card, ph.cx, if(overview, ox, goal.x)), home.x)
        follow y.$i = if(win.$i.open, if(card, ph.cy, if(overview, oy, goal.y)), home.y)
        follow w.$i = if(win.$i.open, if(card, ph.cw, if(overview, tw * s, goal.w)), 60)
        follow h.$i = if(win.$i.open, if(card, ph.ch, if(overview, th * s, goal.h)), 34)
        // Carried with the mouse: how far from its place.
        prop dx.$i = 0 ~glide
        prop dy.$i = 0 ~glide
        // Asked to close, it goes at once: the program may take its time to
        // leave (a browser, a second), and nobody should wait for it. If it
        // is still there a while later —it asked whether to save—, it is back.
        on change win.$i.open while win.$i.open { bye.$i: 0 }
        // (Fractal: asked to close, its box goes to the ones beside it at once,
        // as the other layouts close up at once.)
        on change bye.$i { tre.bye.$i = if(bye.$i > 0.5, 1, 0) }
        prop seen.$i = 0 ~260ms
        follow seen.$i = if(win.$i.open and bye.$i < 0.5, 1, 0)
        // How full of water it is: filling as it opens, draining as it goes
        // (and filling again if it stays, because it asked whether to save).
        let water = min(fill.$i, seen.$i)
        prop lit.$i = 0 ~220ms
        // Maximized or back: a wave runs through it from the button, and
        // it swells a little as it passes, like water filling a basin.
        prop wave.$i = 1 ~720ms
        follow lit.$i = if(win.$i.focused and not overview, 1, if(overview, 1, 0))

        let x = x.$i + dx.$i
        let y = y.$i + dy.$i
        let w = w.$i
        let h = h.$i
        // A hollow where the carried one would land: where this one is, if it
        // is under it; its own place, if it is under nothing; its place on the
        // other monitor, if it is over that one.
        // (A prop is one for every monitor's copy: what it follows cannot
        // depend on which copy it is. Which monitor shows it goes in `show`.)
        let hollow.there = dragging == i and crossing
        prop hollow.$i = 0 ~140ms
        follow hollow.$i = if(not fr and (swaps or (dragging == i and over < 0 and not crossing) or hollow.there), 1, 0)
        // (Its own place as it would be: in the layout picked, if one is.)
        let hx = if(hollow.there, txg, if(dragging == i, txv, tx))
        let hy = if(hollow.there, tyg, if(dragging == i, tyv, ty))
        let hw = if(hollow.there, twg, if(dragging == i, twv, tw))
        let hh = if(hollow.there, thg, if(dragging == i, thv, th))
        group {
            show: hollow.$i > 0.01 and if(hollow.there, mon, sc) == screen.index
            opacity: hollow.$i
            box { from: hx + 4, hy + 4; size: hw - 8, hh - 8; corner: 12; color: mint; opacity: 7% }
            box { from: hx + 4, hy + 4; size: hw - 8, hh - 8; corner: 12; stroke: 1.5; color: mint; opacity: 55% }
        }
        // Where it is laid out, not where it is carried: a drag goes on while
        // its zone still holds the point it was pressed on.
        // (In a group of their own, just over the window's `z:`: where
        // windows overlap, the one on top takes the mouse, and on its own
        // window its edges and buttons go before what the program shows.)
        group {
            z: zz + 0.5 + if(win.$i.floating, 50000, 0)
            // Free, it is carried by its title bar; tiled, by the gap just
            // above it, which takes nothing from the program.
            // With Super held, all of it.
            let whole = keys.super > 0.5 or dragging == i
            zone box title.$i { from: x.$i + if(whole or F > 0.5, 0, 12) + if(not whole and fr and ours, 32, 0), y.$i - if(whole or F > 0.5, 0, gap - 1); size: if(whole, w, if(F > 0.5, w - 76, w - 24)) - if(not whole and fr and ours, 32, 0), if(whole, h, if(F > 0.5, tb, gap - 2)); cursor: pointer; active: here and not overview and not win.$i.dialog and (ours or F < 0.5 or whole or win.$i.held > 0.5) and wiring < 0; label: "{win.$i.title}"; role: button; handle: i }
            // Free, its port: a drop at the start of its title bar, dragged to
            // another window to wire the two. The title bar's own zone starts
            // after it: under it, a press and the first move of a real mouse
            // in the same frame carried the window instead.
            zone ellipse port.$i { at: x + 18, y + tb / 2; radius: 12; cursor: grab; active: here and not overview and fr and ours and not win.$i.dialog; label: "Wire {win.$i.title} to another window"; role: button }
            zone ellipse lead_zone.$i { at: x + w - 40, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview and not win.$i.dialog and ours; label: "Enlarge {win.$i.title}" }
            zone ellipse mini_zone.$i { at: x + w - 60, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview and not win.$i.dialog and Fm > 0.5 and ours; label: "Minimize {win.$i.title}" }
            zone ellipse close_zone.$i { at: x + w - 20, y + tb / 2; radius: 10; cursor: pointer; active: here and not overview and not win.$i.dialog and ours; label: "Close {win.$i.title}" }
            // At a glance, the whole window is a button: pressing it chooses it.
            zone box choose.$i { from: x, y; size: w, h; cursor: pointer; active: here and overview and not win.$i.dialog; label: "{win.$i.title}"; role: item }
            // (A program that draws its own title bar and edges —a GTK 4
            // header bar, a browser's tabs— asks to be carried or stretched
            // from them: `handle:` says which of these is pressed for it.)
            // Free: its edges and its corner make it bigger or smaller.
            // (While it is being resized, where they were when taken: a drag
            // goes on while its zone holds the point it was pressed on.)
            let ex = if(sizing == i, g.x, x)
            let ey = if(sizing == i, g.y, y)
            let ew = if(sizing == i, g.w, w)
            let eh = if(sizing == i, g.h, h)
            zone box left_edge.$i { from: ex - 5, ey + tb; size: 10, eh - tb - 12; cursor: grab; active: here and fr and not maxed.$i and not overview; label: "Resize {win.$i.title}"; role: region; handle: i, left }
            zone box right_edge.$i { from: ex + ew - 5, ey + tb; size: 10, eh - tb - 12; cursor: grab; active: here and fr and not maxed.$i and not overview; label: "Resize {win.$i.title}"; role: region; handle: i, right }
            zone box bottom_edge.$i { from: ex + 12, ey + eh - 5; size: ew - 24, 10; cursor: grab; active: here and fr and not maxed.$i and not overview; label: "Resize {win.$i.title}"; role: region; handle: i, bottom }
            zone box corner.$i { from: ex + ew - 14, ey + eh - 14; size: 20, 20; cursor: grab; active: here and fr and not maxed.$i and not overview; label: "Resize {win.$i.title}"; role: region; handle: i, bottom_right }
        }
        group {
            // Over the others as it was last touched (free, they overlap).
            z: zz + if(win.$i.floating, 50000, 0)
            // Carried, it is drawn over the others, further down; flying into
            // the island or out of it, too.
            show: seen.$i > 0.01 and sc == screen.index and ws.vis and dragging != i and not (landing == i and sc != landing.to) and not win.$i.dialog and mini.$i <= 0.02
            // Filling, in the rain or the snow (their glass has its own
            // shader): it simply comes in.
            opacity: smooth(0, 0.3, seen.$i) * if(wet > 0.001 or cold > 0.001, water, 1) * (1 - 0.25 * ovcarry.$i) * if(card, if(ph.row, clamp(1.2 - 0.35 * abs(ph.d), 0.4, 1), clamp(1 + 0.2 * ph.d, 0.3, 1)), 1)
            pivot: x + w / 2, y + h / 2
            scale: (1 + 0.025 * choose.$i.hover * ov) * (1 + 0.05 * (lift.$i - F)) * (1 + 0.012 * sin(180 * wave.$i)) * (1 - 0.6 * ovcarry.$i), (1 + 0.025 * choose.$i.hover * ov) * (1 + 0.05 * (lift.$i - F)) * (1 + 0.012 * sin(180 * wave.$i)) * (1 - 0.6 * ovcarry.$i)
            body {
                color: #0c0e10
                shadow: 0, 14 + 8 * lit.$i + 10 * lift.$i, 34 + 18 * lift.$i, 45% + 20% * lit.$i + 10% * lift.$i
                show: water >= 0.999
                box { from: x, y; size: w, h; corner: 12 }
            }
            // Filling, only what is under the water (the line is the shader's,
            // a little above this).
            let fill.y = y + (h + 32) * (1 - water) - 16
            group {
                show: water < 0.999
                mask: x, fill.y + 18 to x, fill.y + 6
                body {
                    color: #0c0e10
                    shadow: 0, 14 + 8 * lit.$i + 10 * lift.$i, 34 + 18 * lift.$i, 45% + 20% * lit.$i + 10% * lift.$i
                    box { from: x, y; size: w, h; corner: 12 }
                }
            }
            // Without the keyboard, only its title bar steps back: what it shows
            // stays as it is (a video left playing on another monitor, full colour).
            group {
                show: wet <= 0.001 and cold <= 0.001
                shader: tide, water while water < 0.999
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: mix(#1a1e22, #1d2b27, lit.$i); show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14 + 28 * cvpt.$i, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 110 - 24 * cvpt.$i - 170 * (ag.$i > 0.5) * (w > 400) * hb.$i, 10); lines: 1; color: ink; opacity: (55% + 45% * lit.$i) * hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: ask.w, ask.h - tb * ours; show: drawn and not win.$i.fullscreen and wet <= 0.001 and cold <= 0.001 }
            }
            // The same, in the rain: the window seen through wet glass.
            group {
                show: wet > 0.001
                shader: rain, wet * pour
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: mix(#1a1e22, #1d2b27, lit.$i); show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14 + 28 * cvpt.$i, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 110 - 24 * cvpt.$i - 170 * (ag.$i > 0.5) * (w > 400) * hb.$i, 10); lines: 1; color: ink; opacity: (55% + 45% * lit.$i) * hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: ask.w, ask.h - tb * ours; show: drawn and not win.$i.fullscreen and wet > 0.001 }
            }
            // And in the snow: frosted glass with snow on top.
            group {
                show: cold > 0.001 and wet <= 0.001
                shader: snow, cold
                clip box { from: x, y; size: w, h; corner: 12 }
                box { from: x, y; size: w, tb * hb.$i; color: mix(#1a1e22, #1d2b27, lit.$i); show: hb.$i > 0.01 }
                text win.$i.title { at: x + 14 + 28 * cvpt.$i, y + tb / 2 - tb * (1 - hb.$i); anchor: left center; size: 12; weight: 500; width: max(w - 110 - 24 * cvpt.$i - 170 * (ag.$i > 0.5) * (w > 400) * hb.$i, 10); lines: 1; color: ink; opacity: (55% + 45% * lit.$i) * hb.$i; show: hb.$i > 0.01 }
                window win.$i { at: x, y + tb * hb.$i; size: w, max(h - tb * hb.$i, 1); ask: ask.w, ask.h - tb * ours; show: drawn and not win.$i.fullscreen and cold > 0.001 and wet <= 0.001 }
            }
            // (The wave: two soft crests of light, the second behind the first.)
            group {
                show: wave.$i > 0.001 and wave.$i < 0.999
                blur: 6
                mode: screen
                clip box { from: x, y; size: w, h; corner: 12 }
                ellipse { at: x + w - 40, y + tb / 2; radius: 20 + wave.$i * (w + h); stroke: 44 * (1 - wave.$i) + 4; color: mint; opacity: 55% * (1 - wave.$i) }
                ellipse { at: x + w - 40, y + tb / 2; radius: 10 + max(wave.$i - 0.2, 0) * (w + h); stroke: 20 * (1 - wave.$i) + 2; color: #dffaf0; opacity: 40% * (1 - wave.$i) }
            }
            // Its three buttons, three drops of water: put away (into
            // Marea), to the front (free, the whole monitor), and away for
            // good. Lit from above, a glint on top; the mouse over one, it
            // swells, a halo spreads round it and it shows what it does.
            let by = y + tb / 2
            let b.any = max(max(mini_zone.$i.hover, lead_zone.$i.hover), close_zone.$i.hover)
            group {
                show: hb.$i > 0.01
                opacity: (45% + 55% * max(lit.$i, b.any)) * hb.$i * smooth(0.75, 1, water)
                ellipse { at: x + w - 60, by; radius: 8 + 3 * mini_zone.$i.hover; stroke: 1.2; color: amber; opacity: 55% * mini_zone.$i.hover }
                ellipse { at: x + w - 40, by; radius: 8 + 3 * lead_zone.$i.hover; stroke: 1.2; color: mint; opacity: 55% * lead_zone.$i.hover }
                ellipse { at: x + w - 20, by; radius: 8 + 3 * close_zone.$i.hover; stroke: 1.2; color: coral; opacity: 55% * close_zone.$i.hover }
                //  (Floating on a tiled monitor there is no putting away: no amber.)
                body {
                    gradient: radial x + w - 62, by - 3 radius 10, #fff3d6, amber 45%, #a8781f
                    rim: 35%
                    shadow: 0, 1, 3, 40%
                    opacity: if(Fm > 0.5, 1, 0)
                    ellipse { at: x + w - 60, by; radius: 6 + 1.5 * mini_zone.$i.hover }
                }
                body {
                    gradient: radial x + w - 42, by - 3 radius 10, #e8fff5, mint 45%, #3f8f76
                    rim: 35%
                    shadow: 0, 1, 3, 40%
                    ellipse { at: x + w - 40, by; radius: 6 + 1.5 * lead_zone.$i.hover }
                }
                body {
                    gradient: radial x + w - 22, by - 3 radius 10, #ffe4dc, coral 45%, #b0412f
                    rim: 35%
                    shadow: 0, 1, 3, 40%
                    ellipse { at: x + w - 20, by; radius: 6 + 1.5 * close_zone.$i.hover }
                }
                ellipse { at: x + w - 62, by - 3; radius: 2; scale: 1.3, 0.75; color: #fff; opacity: 75% * if(Fm > 0.5, 1, 0) }
                ellipse { at: x + w - 42, by - 3; radius: 2; scale: 1.3, 0.75; color: #fff; opacity: 75% }
                ellipse { at: x + w - 22, by - 3; radius: 2; scale: 1.3, 0.75; color: #fff; opacity: 75% }
                // What each does, over the one the mouse is on.
                box { at: x + w - 60, by + 0.5; size: 6.5, 1.6; corner: 0.8; color: #4a3308; opacity: mini_zone.$i.hover }
                box { at: x + w - 40, by + 0.5; size: 6.5, 6.5; corner: 1.5; stroke: 1.4; color: #0f3d2f; opacity: lead_zone.$i.hover * (1 - maxed.$i) }
                box { at: x + w - 41.2, by + 1.7; size: 5, 5; corner: 1.2; stroke: 1.3; color: #0f3d2f; opacity: lead_zone.$i.hover * maxed.$i }
                box { at: x + w - 38.8, by - 0.7; size: 5, 5; corner: 1.2; stroke: 1.3; color: #0f3d2f; opacity: lead_zone.$i.hover * maxed.$i * 0.6 }
                box { at: x + w - 20, by + 0.3; size: 7.5, 1.6; corner: 0.8; rotate: 45deg; color: #4a140b; opacity: close_zone.$i.hover }
                box { at: x + w - 20, by + 0.3; size: 7.5, 1.6; corner: 0.8; rotate: -45deg; color: #4a140b; opacity: close_zone.$i.hover }
            }
            box { from: x, y; size: w, h; corner: 12; stroke: 1.5; color: mint; opacity: lit.$i * 70% * (1 - ov) * smooth(0.75, 1, water) }
            // ── on a canvas: its port, and its agent's state ──
            // The port: a drop, fuller over it, while wiring from it, and once
            // it has wires.
            let wl.lit = ((wire.0.a >= 0 and (wire.0.a == i or wire.0.b == i)) * (if(wire.0.a == i, wire.0.b, wire.0.a) == hovwin) + (wire.1.a >= 0 and (wire.1.a == i or wire.1.b == i)) * (if(wire.1.a == i, wire.1.b, wire.1.a) == hovwin) + (wire.2.a >= 0 and (wire.2.a == i or wire.2.b == i)) * (if(wire.2.a == i, wire.2.b, wire.2.a) == hovwin) + (wire.3.a >= 0 and (wire.3.a == i or wire.3.b == i)) * (if(wire.3.a == i, wire.3.b, wire.3.a) == hovwin) + (wire.4.a >= 0 and (wire.4.a == i or wire.4.b == i)) * (if(wire.4.a == i, wire.4.b, wire.4.a) == hovwin) + (wire.5.a >= 0 and (wire.5.a == i or wire.5.b == i)) * (if(wire.5.a == i, wire.5.b, wire.5.a) == hovwin) + (wire.6.a >= 0 and (wire.6.a == i or wire.6.b == i)) * (if(wire.6.a == i, wire.6.b, wire.6.a) == hovwin) + (wire.7.a >= 0 and (wire.7.a == i or wire.7.b == i)) * (if(wire.7.a == i, wire.7.b, wire.7.a) == hovwin)) > 0.5
            let nwired = (wire.0.a == i or wire.0.b == i) + (wire.1.a == i or wire.1.b == i) + (wire.2.a == i or wire.2.b == i) + (wire.3.a == i or wire.3.b == i) + (wire.4.a == i or wire.4.b == i) + (wire.5.a == i or wire.5.b == i) + (wire.6.a == i or wire.6.b == i) + (wire.7.a == i or wire.7.b == i)
            group {
                show: hb.$i > 0.01 and cvpt.$i > 0.01
                opacity: cvpt.$i * hb.$i
                // A connector: a ring with a drop in it, and a short stem out to
                // the left edge, where wires leave from.
                box { from: x, y + tb / 2 - 1; size: 10, 2; corner: 1; color: mint; opacity: 50% + 40% * max(port.$i.hover, wiring == i) }
                ellipse { at: x + 18, y + tb / 2; radius: 8 + 2 * max(port.$i.hover, wiring == i); stroke: 1.6; color: mint; opacity: 55% + 40% * max(port.$i.hover, wiring == i) }
                body {
                    gradient: radial x + 17, y + tb / 2 - 1.5 radius 7, #e8fff5, mint 45%, #3f8f76
                    rim: 35%
                    ellipse { at: x + 18, y + tb / 2; radius: 3.5 + 1.2 * min(nwired, 1) + 1.5 * max(port.$i.hover, wiring == i) }
                }
                // What it does, over it.
                group {
                    show: port.$i.hover > 0.01 and wiring < 0
                    opacity: port.$i.hover
                    body {
                        color: #0c0e10
                        rim: 16%
                        shadow: 0, 4, 12, 45%
                        box { from: x + 6, y - 30; size: 196, 24; corner: 12 }
                    }
                    text "Drag to another window to wire them" { at: x + 104, y - 18; anchor: center; size: 10.5; color: ink }
                }
            }
            // Its agent: what and where, dim, and a little basin of water —low
            // and still when ready, a wave running through it while it works,
            // amber and full, beating, when it waits for you—.
            let ag.lvl = pick(max(ag.$i - 1, 0), 6 + 1.5 * sin(time * 300), 3.5, 9.5)
            group {
                show: hb.$i > 0.01 and ag.$i > 0.5
                opacity: hb.$i * if(ag.$i > 2.5, 0.75 + 0.25 * sin(time * 240), 1)
                text agt.$i { at: x + w - 104, y + tb / 2; anchor: right center; size: 10.5; color: ink; opacity: 55%; width: min(150, w - 280); lines: 1; show: w > 400 }
                group {
                    clip box { from: x + w - 98, y + tb / 2 - 6; size: 14, 12; corner: 3.5 }
                    box { from: x + w - 98, y + tb / 2 - 6 + 12 - ag.lvl * 1; size: 14, 12; color: if(ag.$i > 2.5, amber, mint); opacity: 85% }
                    ellipse { at: x + w - 98 + 7 + 5 * sin(time * 260), y + tb / 2 - 6 + 12 - ag.lvl * 1; radius: 4; scale: 1.7, 0.45; color: #dffaf0; opacity: 70%; show: ag.$i > 0.5 and ag.$i < 1.5 }
                }
                box { from: x + w - 98, y + tb / 2 - 6; size: 14, 12; corner: 3.5; stroke: 1.2; color: if(ag.$i > 2.5, amber, mint); opacity: 85% }
            }
            // Tiled, with no title bar: what it is wired to, in small pills in
