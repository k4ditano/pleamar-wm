    fact dkdrag.3 = -1
    fact pv.3 = -1
    fact dmenu.3 = -1
    fact poofx.3 = 0
    fact poofy.3 = 0
    prop poof.3 = 1 ~700ms
    prop pvup.3 = 0 ~pop
    follow pvup.3 = if(pv.3 >= 0, 1, 0)
    prop mnup.3 = 0 ~pop
    follow mnup.3 = if(dmenu.3 >= 0, 1, 0)
