                show: win.dock.$s.2.badge > 0 and 2 < dk.n.$s
                body {
                    color: #ef7a66
                    rim: 20%
                    shadow: 0, 2, 5, 40%
                    ellipse { at: if(dkvert, dk.cr.$s + dk.cs.$s * (dkiq2.$s), dka2.$s) + 0.39 * dksz2.$s, if(dkvert, dka2.$s, dk.cr.$s + dk.cs.$s * (dkiq2.$s)) - 0.39 * dksz2.$s; radius: 8.5 }
                }
